#% text_encoding = iso8859_1

_package user
$

## Example script for running SUBFEEDER data migration
## Copy and paste this into Magik prompt or compile with F7 in Emacs

##
## STEP 1: Get the database
##
ds << gis_program_manager.cached_dataset(:gis)
write("Database: ", ds)
$

##
## STEP 2: Create migrator instance
##
migrator << astri_data_migrator.new(ds)
write("Migrator created")
$

##
## STEP 3: Run SUBFEEDER migration (this will connect to PostgreSQL and migrate all SUBFEEDERs)
##
migrator.migrate_subfeeders()
$

##
## STEP 4: Show statistics
##
migrator.show_statistics()
$

##
## Optional: Verify migration results
##
ds << gis_program_manager.cached_dataset(:gis)
subfeeder_col << ds.collections[:master_subfeeder]
write("Total master_subfeeder records after migration: ", subfeeder_col.size)
$

##
## Optional: Check a specific SUBFEEDER by subfeeder_code
##
ds << gis_program_manager.cached_dataset(:gis)
subfeeder_col << ds.collections[:master_subfeeder]

# Replace "SUBFEEDER-001" with actual subfeeder_code from your data
subfeeder_code_to_check << "SUBFEEDER-001"

pred << predicate.eq(:subfeeder_code, subfeeder_code_to_check)
subfeeder << subfeeder_col.select(pred).an_element()

_if subfeeder _isnt _unset
_then
	write("Found SUBFEEDER: ", subfeeder.subfeeder_code)
	write("  Name: ", subfeeder.subfeeder_name)
	write("  OLT Code: ", subfeeder.olt_code)
	write("  Feeder Code: ", subfeeder.feeder_code)
	write("  Region: ", subfeeder.region)
	write("  Status: ", subfeeder.subfeeder_status)
	write("  Cable Type: ", subfeeder.subfeeder_cable_type)
	write("  Length: ", subfeeder.subfeeder_length)
_else
	write("SUBFEEDER not found: ", subfeeder_code_to_check)
_endif
$

##
## Optional: Verify all migrated subfeeders have status "NEW"
##
ds << gis_program_manager.cached_dataset(:gis)
subfeeder_col << ds.collections[:master_subfeeder]

pred << predicate.eq(:subfeeder_status, "NEW")
new_subfeeders << subfeeder_col.select(pred)
write("Subfeeders with status 'NEW': ", new_subfeeders.size)
$
