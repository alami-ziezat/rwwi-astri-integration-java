##
## Search mode
##

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.mode_changed(selected_value)
	## Handle mode dropdown change  -  sw_text_item passes the selected string.
	## "Area" -> area mode; anything else -> cluster_code mode (default).

	_if selected_value = "Area"
	_then
		.search_mode << :area
	_else
		.search_mode << :cluster_code
	_endif
	_self.reset()
_endmethod
$

##
## Area search
##

_pragma(classify_level=basic, topic={nisa_integration})
_private _method rwwi_nisa_dialog.search_by_area(area_name)
	## Area-mode search flow:
	##   1. Call NISA area search API -> list of mass problems with sites
	##   2. Collect unique clusterids from all sites
	##   3. Query PostgreSQL for those clusters -> build db_lookup (clusterid -> DB pl)
	##   4. Flat-expand: one result_row per site (MP fields + site fields + DB fields)
	##   5. Sort result_rows by mp_no then cluster_code
	##   6. Pre-populate outage_cache (no manual "Check All" needed in area mode)

	_self.log_separator()
	_self.log_info("Searching by area: '" + area_name + "'")

	## Step 1: Call NISA area search API
	_local json_result   << nisa_search_massproblem_by_area(area_name)
	_local area_response << _self.parse_area_search_response(json_result)

	_if _not area_response[:success]
	_then
		_self.log_error("NISA area search failed: " + area_response[:msg])
		_return
	_endif

	_local mp_list << area_response[:data]
	_self.log_info(write_string("NISA returned ", mp_list.size, " mass problems"))

	## Step 2: Collect unique clusterids from all sites
	_local clusterid_set << equality_hash_table.new()
	_for mp_pl _over mp_list.fast_elements()
	_loop
		_for site_pl _over mp_pl[:sites].fast_elements()
		_loop
			_local cid << site_pl[:clusterid]
			_if cid _isnt _unset _andif cid <> ""
			_then
				clusterid_set[cid] << _true
			_endif
		_endloop
	_endloop

	_if clusterid_set.empty?
	_then
		_self.log_warning("No cluster IDs found in NISA area response.")
		_return
	_endif

	_self.log_info(write_string("Found ", clusterid_set.size, " unique cluster IDs from sites"))

	## Step 3: Query DB -> build db_lookup (clusterid -> DB property_list)
	_local db_lookup << equality_hash_table.new()
	_local db_conn   << _unset
	_protect
		_try _with errCon

			_local is_connect?
			(is_connect?, db_conn) << user:rwwi_external_ds_manager.open_connection_for("[POSTGRESQL_ASTRI_DB]")
			_if _not is_connect?
			_then
				_self.log_error("Failed to connect to POSTGRESQL_ASTRI_DB")
				_return
			_endif

			## Build safe IN clause  -  values from trusted NISA API, validated char-by-char
			_local safe_parts << rope.new()
			_for cid, dummy _over clusterid_set.fast_keys_and_elements()
			_loop
				_if _self.int!safe_cluster_id?(cid)
				_then
					safe_parts.add_last("'" + cid + "'")
				_endif
			_endloop

			_if safe_parts.empty?
			_then
				_self.log_warning("No valid cluster IDs after safety check.")
				_return
			_endif

			## Batch IN clauses to avoid large query I/O errors over network (max 50 per batch)
			_local batch_size  << 50
			_local batch_start << 1
			_loop
				_if batch_start > safe_parts.size _then _leave _endif
				_local batch_end << (batch_start + batch_size - 1).min(safe_parts.size)

				_local in_clause << ""
				_for i _over batch_start.upto(batch_end)
				_loop
					_if i > batch_start _then in_clause << in_clause + ", " _endif
					in_clause << in_clause + safe_parts[i]
				_endloop

				_local sql << write_string(
					"SELECT cluster_id_stella, cluster_code_astri, olt_code, fdt_code, ",
					"cluster_latitude, cluster_longitude, olt_hostname, homepass_total ",
					"FROM smallworld.dim_cluster_stella_master_smallworld ",
					"WHERE cluster_id_stella IN (", in_clause, ") ",
					"ORDER BY cluster_code_astri")

				_local recs << db_conn.sql_select(sql)
				_loop
					_local rec    << recs.get()
					_if rec _is _unset _then _leave _endif
					_local stella_id << rec.cluster_id_stella.default("").write_string
					_local cc        << rec.cluster_code_astri.default("").write_string
					_local db_pl << property_list.new_with(
						:cluster_id_stella, stella_id,
						:cluster_code,      cc,
						:olt_code,          rec.olt_code.default("").write_string,
						:fdt_code,          rec.fdt_code.default("").write_string,
						:lat,               rec.cluster_latitude.default("").write_string,
						:lon,               rec.cluster_longitude.default("").write_string,
						:olt_hostname,      rec.olt_hostname.default("").write_string,
						:homepass_total,    rec.homepass_total.default("").write_string,
						:zone_rwo,          _unset)

					# Zone lookup  -  non-fatal if GIS DB is unavailable
					_try
						db_pl[:zone_rwo] << _self.find_zone_rwo(cc, db_pl[:lat], db_pl[:lon])
						#write("Zone RWO for cluster ", cc, " = ", db_pl[:zone_rwo], %newline.write_string)
					_when error
					_endtry

					db_lookup[stella_id] << db_pl
				_endloop
				recs.close()

				batch_start << batch_end + 1
			_endloop

			_try
				db_conn.commit()
			_when error
				db_conn.rollback()
			_endtry

		_when error
			_self.log_error("Area search DB error: " + errCon.report_contents_string)
		_endtry

	_protection
		_if db_conn _isnt _unset
		_then
			_try
				db_conn.rollback()
				db_conn.close()
				extdb_java_acp.close_all()
			_when error
			_endtry
		_endif
	_endprotect

	_self.log_info(write_string("Loaded ", db_lookup.size, " clusters from DB"))

	## Step 4: Flat-expand all sites into result_rows (one row per site)
	.result_rows.empty()
	_for mp_pl _over mp_list.fast_elements()
	_loop
		_local mp_no    << mp_pl[:mp_no]
		_local mp_event << mp_pl[:event]
		_local mp_area  << mp_pl[:area]
		_local mp_cat   << mp_pl[:category]
		_local mp_sdate << mp_pl[:start_date]
		_local mp_stime << mp_pl[:start_time]
		_local mp_eta   << mp_pl[:estimation]

		_for site_pl _over mp_pl[:sites].fast_elements()
		_loop
			_local cid   << site_pl[:clusterid]
			_local db_pl << db_lookup[cid]
			_if db_pl _is _unset _then _continue _endif

			_local row_pl << property_list.new_with(
				:mp_no,             mp_no,
				:cluster_id_stella, db_pl[:cluster_id_stella],
				:cluster_code,      db_pl[:cluster_code],
				:olt_code,          db_pl[:olt_code],
				:fdt_code,          db_pl[:fdt_code],
				:lat,               db_pl[:lat],
				:lon,               db_pl[:lon],
				:olt_hostname,      db_pl[:olt_hostname],
				:homepass_total,    db_pl[:homepass_total],
				:zone_rwo,          db_pl[:zone_rwo],
				:site_olt_name,     site_pl[:olt_name],
				:site_cluster_name, site_pl[:cluster_name],
				:frame,             site_pl[:frame],
				:slot,              site_pl[:slot],
				:port,              site_pl[:port])
			.result_rows.add_last(row_pl)
		_endloop
	_endloop

	## Step 5: Sort result_rows by mp_no then cluster_code
	_local sort_proc << _proc(a, b)
		>> a[:mp_no].default("") _cf b[:mp_no].default("")
	_endproc
	_local sorted_col << .result_rows.as_sorted_collection(sort_proc)
	.result_rows.empty()
	_for pl _over sorted_col.fast_elements()
	_loop
		.result_rows.add_last(pl)
	_endloop

	## Step 6: Pre-populate outage_cache so icons appear immediately
	_self.int!prepopulate_outage_cache(mp_list, db_lookup)

	_local n << .result_rows.size
	.items[:count_label].value << write_string("  ", n, " sites found  ")
	_self.log_success(write_string("Found ", n, " sites via area '", area_name, "'"))
	_self.changed(:cluster_list, :renew)
	_self.manage_actions()
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_private _method rwwi_nisa_dialog.parse_area_search_response(json_string)
	## Parse NISA area search response JSON.
	## Same structure as parse_massproblem_response but sites also include :clusterid
	## (the stella ID, e.g. "JKT.0123.JGO06.007") used to join back to the DB.

	_local result << property_list.new()
	result[:success] << _false
	result[:msg]     << ""
	result[:data]    << rope.new()

	_if json_string _is _unset _orif json_string.empty?
	_then
		result[:msg] << "No response"
		_return result
	_endif

	_try _with errCon
		_local json_obj << json_parser.parse(json_string)
		result[:success] << json_obj[:success].default(_false)
		result[:msg]     << json_obj[:msg].default("").write_string

		_local json_data << json_obj[:data]
		_if json_data _is _unset _then _return result _endif

		_local data_rope << rope.new()
		_for mp_item _over json_data.fast_elements()
		_loop
			_local mp_pl << property_list.new()
			mp_pl[:mp_no]      << mp_item[:mp_no].default("").write_string
			mp_pl[:event]      << mp_item[:event].default("").write_string
			mp_pl[:area]       << mp_item[:area].default("").write_string
			mp_pl[:category]   << mp_item[:category].default("").write_string
			mp_pl[:start_date] << mp_item[:start_date].default("").write_string
			mp_pl[:start_time] << mp_item[:start_time].default("").write_string
			mp_pl[:estimation] << mp_item[:estimation].default("").write_string

			_local json_sites << mp_item[:sites]
			_local sites_rope << rope.new()
			_if json_sites _isnt _unset
			_then
				_for site_item _over json_sites.fast_elements()
				_loop
					_local site_pl << property_list.new()
					site_pl[:olt_name]     << site_item[:olt_name].default("").write_string
					site_pl[:cluster_name] << site_item[:cluster_name].default("").write_string
					site_pl[:clusterid]    << site_item[:clusterid].default("").write_string
					site_pl[:frame]        << site_item[:frame].default(0).write_string
					site_pl[:slot]         << site_item[:slot].default(0).write_string
					site_pl[:port]         << site_item[:port].default(0).write_string
					sites_rope.add_last(site_pl)
				_endloop
			_endif

			mp_pl[:sites] << sites_rope
			data_rope.add_last(mp_pl)
		_endloop
		result[:data] << data_rope

	_when error
		result[:msg] << "Parse error: " + errCon.report_contents_string
		_self.log_error("parse_area_search_response: " + errCon.report_contents_string)
	_endtry

	>> result
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_private _method rwwi_nisa_dialog.int!prepopulate_outage_cache(mp_list, db_lookup)
	## Pre-populate outage_cache from area search results.
	## Groups mass problems by cluster_code using db_lookup (clusterid -> DB pl).
	## Each MP is added at most once per cluster (deduped by mp_no).
	##
	## Parameters:
	##   mp_list   - Rope of parsed MP property_lists (from parse_area_search_response)
	##   db_lookup - equality_hash_table: clusterid -> DB property_list (has :cluster_code)

	# cache_entries:       cluster_code -> rope of matched MP property_lists (deduped)
	# seen_mp_per_cluster: cluster_code -> equality_hash_table of mp_no -> _true
	_local cache_entries       << equality_hash_table.new()
	_local seen_mp_per_cluster << equality_hash_table.new()

	_for mp_pl _over mp_list.fast_elements()
	_loop
		_local mp_no << mp_pl[:mp_no]
		_for site_pl _over mp_pl[:sites].fast_elements()
		_loop
			_local cid      << site_pl[:clusterid]
			_local db_pl    << db_lookup[cid]
			_if db_pl _is _unset _then _continue _endif

			# Area mode always uses stella_id as the outage_cache key
			_local stella_id << db_pl[:cluster_id_stella]
			_if stella_id _is _unset _orif stella_id = "" _then _continue _endif

			# Init tracking structures for this cluster on first encounter
			_if cache_entries[stella_id] _is _unset
			_then
				cache_entries[stella_id]       << rope.new()
				seen_mp_per_cluster[stella_id] << equality_hash_table.new()
			_endif

			# Add each MP only once per cluster (same MP may have multiple sites in same cluster)
			_if seen_mp_per_cluster[stella_id][mp_no] _is _unset
			_then
				cache_entries[stella_id].add_last(mp_pl)
				seen_mp_per_cluster[stella_id][mp_no] << _true
			_endif
		_endloop
	_endloop

	# Populate outage_cache from accumulated entries
	_for cc, matched_mps _over cache_entries.fast_keys_and_elements()
	_loop
		.outage_cache[cc] << property_list.new_with(
			:success, _true,
			:msg,     "area search",
			:data,    matched_mps)
	_endloop
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_private _method rwwi_nisa_dialog.int!safe_cluster_id?(id)
	## Return _true if id contains only alphanumeric, '.', '-', '_'.
	## Guards against unexpected characters in clusterid values from the NISA API.

	_if id _is _unset _orif id = "" _then _return _false _endif
	_for i _over 1.upto(id.size)
	_loop
		_local c << id[i]
		_if _not (c.alphanumeric? _orif c = %. _orif c = %- _orif c = %_)
		_then
			_return _false
		_endif
	_endloop
	>> _true
_endmethod
$
