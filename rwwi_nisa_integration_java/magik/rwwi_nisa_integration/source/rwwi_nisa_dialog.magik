#% text_encoding = iso8859_1
_package user
$

## NISA Mass Problem Monitoring Dialog
## UI layer for querying NISA mass problem (outage) status per cluster.
## Searches clusters from PostgreSQL dim_cluster_stella_master_smallworld,
## calls NISA API to check outage status, and shows results in a table.
## Fires show_map() to let the plugin render impacted clusters on the map.

remex(:rwwi_nisa_dialog)
$

def_slotted_exemplar(:rwwi_nisa_dialog,
{
	{:owner,            _unset, :writable},   # Parent plugin
	{:items,            _unset, :writable},   # UI widget cache (property_list)
	{:cluster_cache,    _unset, :writable},   # Row number -> cluster property_list
	{:result_rows,      _unset, :writable},   # Current search results (rope of pl)
	{:outage_cache,     _unset, :writable},   # cluster_code -> outage result pl
	{:selected_cluster,  _unset, :writable},   # Single selected cluster pl (set only when exactly 1 row selected)
	{:selected_clusters, _unset, :writable},  # All currently selected cluster pls (rope)
	{:database,         _unset},              # GIS database (gis_program_manager.databases[:gis])
	{:view,             _unset},              # ACE view (gis_program_manager.ace_view)
	{:cs_transform,     _unset},              # WGS84 -> local CS transform (built once, reused)
	{:search_mode,      _unset, :writable},   # :cluster_code (default) or :area
	{:blink_active,     _false}               # _true when blink animation is running
}, :model)
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.new(_optional owner)
	## Create new dialog
	## Parameters:
	##   owner - Parent plugin instance
	>> _clone.init(owner)
_endmethod
$

_private _method rwwi_nisa_dialog.init(owner)
	## Initialise slots
	.owner         << owner
	.items         << property_list.new()
	.cluster_cache << equality_hash_table.new()
	.result_rows   << rope.new()
	.outage_cache  << equality_hash_table.new()
	.search_mode        << :area
	.selected_clusters  << rope.new()
	.blink_active       << _false

	_self.add_dependent(.owner)
	>> _super.init()
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.activate_in(frame)
	## Build and activate Mass Problem Monitoring UI in frame

	frame.title << "Mass Problem Monitoring (NISA)"

	# Top-level canvas container (SWIFT requirement)
	.items[:top] << top_c << sw_canvas_container.new(
		frame, 4, 1,
		:width,          950,
		:height,         650,
		:outer_spacing,  5,
		:row_spacing,    5,
		:identifier,     :nisa_top_container,
		:model,          _self)

	# Outer container: 4 rows - toolbar, table, actions, log
	.items[:outer] << outer << sw_container.new(top_c, 4, 1,
		:row_resize_values, {0, 1, 0, 1})

	_self.build_toolbar(outer)
	_self.build_table(outer)
	_self.build_log(outer)

	_self.log_info("Mass Problem Monitoring (NISA) - Ready")
	_self.log_info("Enter a cluster code and click Search to begin.")

	_return top_c
_endmethod
$

_private _method rwwi_nisa_dialog.build_toolbar(parent)
	## Build search toolbar: cluster code field + Search + Reset + count label

	toolbar_con << sw_toolbar_container.new(parent, _false,
		:background_type,     :button_group,
		:show_separators?,   _true,
		:enable_action_menu?, _false)

	tb << toolbar_con.create_toolbar()

	sw_label_item.new(tb, "  Search by: ")
	.items[:mode_selector] << sw_text_item.new(tb,
		:model,           _self,
		:display_length,  14,
		:editable?,       _false,
		:change_selector, {:|mode_changed()|})
	.items[:mode_selector].text_items << {"Cluster Code", "Area"}
	.items[:mode_selector].value      << "Area"

	.items[:search_field] << sw_text_item.new(tb,
		:model,          _self,
		:display_length, 25,
		:editable?,      _true)

	.items[:search_btn] << sw_button_item.new(tb,
		:image,    {:find, :ui_resources},
		#:label,    "Search",
		:model,    _self,
		:selector, :search_clusters|()|,
		:tooltip,  "Search clusters in database")

	.items[:reset_btn] << sw_button_item.new(tb,
		:image,    {:clear, :ui_resources},
		#:label,    "Reset",
		:model,    _self,
		:selector, :reset|()|,
		:tooltip,  "Clear results and cache")

	.items[:run_btn] << sw_button_item.new(tb,
		:image,    {:run, :ui_resources},
		#:label,    "Check All Outages",
		:model,    _self,
		:selector, :check_outage_all|()|,
		:tooltip,  "Check NISA outage status for all clusters in list")
	.items[:run_btn].enabled? << _false

	.items[:goto_btn] << sw_button_item.new(tb,
		:image,    {:goto_object, :ui_resources},
		#:label,    "Go To Selected",
		:model,    _self,
		:selector, :goto_selected|()|,
		:tooltip,  "Navigate map to selected cluster")
	.items[:goto_btn].enabled? << _false

	.items[:highlight_btn] << sw_image_toggle_item.new(tb,
		:image,    {:highlight, :ui_resources},
		#:label,    "Show on Map",
		:model,    _self,
		:change_selector, :show_map|()|,
		:value, _false,
		:tooltip,  "Show/highlight cluster outage status on map")
	.items[:highlight_btn].enabled? << _false

	.items[:count_label] << sw_label_item.new(tb, "  0 clusters found  ")

	sw_label_item.new(tb, "  |  ")

	.items[:start_btn] << sw_button_item.new(tb,
		:image,    {:run, :ui_resources},
		:model,    _self,
		:selector, :go|()|,
		:tooltip,  "Start blink animation")
	.items[:start_btn].enabled? << _false

	.items[:stop_btn] << sw_button_item.new(tb,
		:image,    {:stop, :ui_resources},
		:model,    _self,
		:selector, :stop|()|,
		:tooltip,  "Stop blink animation")
	.items[:stop_btn].enabled? << _false
_endmethod
$

_private _method rwwi_nisa_dialog.build_table(parent)
	## Build 8-column result table (lat/lon cached in result_rows but not displayed)

	.items[:table] << sw_table.new(parent,
		:row_height,                   22,
		:selection_type,               :row,
		:selection_mode,               :many,
		:model,                        _self,
		:aspect,                       :cluster_list,
		:row_lines?,                   _true,
		:column_lines?,                _true,
		:row_stripes?,                 _true,
		:enable_horizontal_scrollbar?, _true,
		:data_selector,                :|cluster_list_data()|,
		:selection_notifier,           :cluster_selected|()|,
		:enable_manage_columns?,       _true,
		:min_height,                   250)

	.items[:table].set_column_labels({
		"#", "MP No", "Cluster Code", "Stella ID", "OLT Code", "FDT Code",
		"OLT Hostname", "Homepass", "Outage Status"})

	.items[:table].col_resize_values << {0, 1.5, 2, 1.5, 1.5, 1.5, 2, 1, 1}

	.items[:table].enable_column_filter(2, _true)   # MP No
	.items[:table].enable_column_filter(3, _true)   # Cluster Code
	.items[:table].enable_column_filter(4, _true)   # Stella ID
	.items[:table].enable_column_filter(5, _true)   # OLT Code
	.items[:table].enable_sort? << _true
_endmethod
$

_private _method rwwi_nisa_dialog.build_log(parent)
	## Build read-only log text window

	.items[:log] << sw_text_window.new(parent)
	.items[:log].show_border?                  << _true
	.items[:log].enable_horizontal_scrollbar?  << _false
	.items[:log].enable_vertical_scrollbar?    << _true
	.items[:log].min_height                    << 120
	.items[:log].editable?                     << _false
	.items[:log].colour                        << colour.called(:white)
_endmethod
$

##
## Data / search
##

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.search_clusters()
	## Dispatch to cluster-code or area search based on current mode.

	_local term << .items[:search_field].value.default("").trim_spaces()

	_if term.size < 3
	_then
		_self.log_separator()
		_self.show_alert("Please enter at least 3 characters to search.")
		_return
	_endif

	_if .search_mode _is :area
	_then
		_self.search_by_area(term)
	_else
		_self.search_by_cluster_code(term)
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_private _method rwwi_nisa_dialog.search_by_cluster_code(search_term)
	## Query PostgreSQL dim_cluster_stella_master_smallworld
	## by the value in the search field (ILIKE match on cluster_code).

	_self.log_separator()
	_self.log_info("Searching clusters: '" + search_term + "'")

	_local db_conn << _unset

	_protect
		_try _with errCon

			_local is_connect?
			(is_connect?, db_conn) << user:rwwi_external_ds_manager.open_connection_for("[POSTGRESQL_ASTRI_DB]")

			_if _not is_connect?
			_then
				_self.log_error("Failed to connect to POSTGRESQL_ASTRI_DB")
				_return
			_endif

			_local sql << write_string(
				"SELECT cluster_id_stella, cluster_code_astri, olt_code, fdt_code, ",
				"cluster_latitude, cluster_longitude, olt_hostname, homepass_total ",
				"FROM smallworld.dim_cluster_stella_master_smallworld ",
				"WHERE cluster_code_astri ILIKE ? OR cluster_id_stella ILIKE ? ",
				"ORDER BY cluster_code_astri ",
				"LIMIT 25")

			_local pattern << search_term + "%"
			_local recs << db_conn.sql_select(sql, pattern, pattern)

			.result_rows.empty()
			_loop
				_local rec << recs.get()
				_if rec _is _unset _then _leave _endif
				_local cc << rec.cluster_code_astri.default("").write_string
				_local pl << property_list.new_with(
					:cluster_id_stella, rec.cluster_id_stella.default("").write_string,
					:cluster_code,      cc,
					:olt_code,          rec.olt_code.default("").write_string,
					:fdt_code,          rec.fdt_code.default("").write_string,
					:lat,               rec.cluster_latitude.default("").write_string,
					:lon,               rec.cluster_longitude.default("").write_string,
					:olt_hostname,      rec.olt_hostname.default("").write_string,
					:homepass_total,    rec.homepass_total.default("").write_string,
					:zone_rwo,          _unset)

				# Zone lookup  -  non-fatal if GIS DB is unavailable
				_try
					pl[:zone_rwo] << _self.find_zone_rwo(cc, pl[:lat], pl[:lon])
				_when error
				_endtry

				.result_rows.add_last(pl)
			_endloop
			recs.close()

			_try
				db_conn.commit()
			_when error
				db_conn.rollback()
			_endtry

			_local n << .result_rows.size
			.items[:count_label].value << write_string("  ", n, " clusters found  ")
			_self.log_success(write_string("Found ", n, " clusters"))

			_self.changed(:cluster_list, :renew)
			_self.manage_actions()

		_when error
			_self.log_error("Search error: " + errCon.report_contents_string)
		_endtry

	_protection
		_if db_conn _isnt _unset
		_then
			_try
				db_conn.rollback()
				db_conn.close()
			_when error
			_endtry
		_endif
	_endprotect
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.reset()
	## Clear results, outage cache, and table

	_self.stop()
	.result_rows.empty()
	.outage_cache.empty()
	.cluster_cache.empty()
	.selected_cluster  << _unset
	.selected_clusters << rope.new()

	_self.changed(:cluster_list, :renew)
	_self.show_map(_false)
	.items[:count_label].value << "  0 clusters found  "
	.items[:highlight_btn].value << _false
	_self.manage_actions()
	_self.clear_log()
	_self.log_info("Reset complete.")
_endmethod
$

##
## Table data selector and selection handler
##

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.cluster_list_data()
	## Data selector: populate table from result_rows

	_try
		.cluster_cache.empty()
		_local row << 0

		_for pl _over .result_rows.fast_elements()
		_loop
			row +<< 1
			_local cc << pl[:cluster_code]

			.items[:table].add_label(row, 1, row.write_string)
			.items[:table].add_label(row, 2, pl[:mp_no].default(""))
			.items[:table].add_label(row, 3, cc)
			.items[:table].add_label(row, 4, pl[:cluster_id_stella])
			.items[:table].add_label(row, 5, pl[:olt_code])
			.items[:table].add_label(row, 6, pl[:fdt_code])
			.items[:table].add_label(row, 7, pl[:olt_hostname])
			.items[:table].add_label(row, 8, pl[:homepass_total])
			# Outage Status column  -  traffic light icon + label
			# In area mode use stella_id as cache key; in cluster_code mode use cluster_code
			_local cache_key << _if .search_mode _is :area
			                    _then >> pl[:cluster_id_stella].default(cc)
			                    _else >> cc
			                    _endif
			_local icon_status
			_local remark_status
			_local cached_result << .outage_cache[cache_key]
			_if cached_result _is _unset
			_then
				icon_status   << {:traffic_light_yellow, :ui_resources}
				remark_status << " Unchecked"
			_elif cached_result[:success] _is _true _andif cached_result[:data].size = 0
			_then
				icon_status   << {:traffic_light_green, :ui_resources}
				remark_status << " Active"
			_elif cached_result[:success] _is _true _andif cached_result[:data].size > 0
			_then
				icon_status   << {:traffic_light_red, :ui_resources}
				remark_status << write_string(" Outage (", cached_result[:data].size, " MP)")
			_else
				icon_status   << {:traffic_light_red, :ui_resources}
				remark_status << " Error"
			_endif
			.items[:table].add_cell(row, 9, {}, {:image, icon_status}, {:label, remark_status})
			# lat/lon not displayed but remain in pl[:lat] / pl[:lon] for map rendering

			.cluster_cache[row] << pl
		_endloop

	_when error
		write("ERROR in cluster_list_data: ", condition.report_contents_string)
	_endtry
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.cluster_selected(table, selection)
	## Handle row selection in cluster table (multi-select).
	## .selected_clusters holds all selected rows.
	## .selected_cluster  holds the single pl only when exactly 1 row is selected.

	.selected_clusters << rope.new()

	_if selection _isnt _unset _andif selection.size > 0
	_then
		_for row _over selection.fast_elements()
		_loop
			# After a column-header sort, `row` is the VISUAL row index.
			# Column 1 (#) holds the original insertion-order number set in
			# cluster_list_data() and travels with the row during sort.
			# Read it back to find the correct cluster_cache entry.
			_local orig_row << row
			_try
				orig_row << table.cell(row, 1).value.as_number()
			_when error
			_endtry
			_local pl << .cluster_cache[orig_row]
			_if pl _isnt _unset _then .selected_clusters.add_last(pl) _endif
		_endloop
	_endif

	.selected_cluster << _if .selected_clusters.size = 1
	                     _then >> .selected_clusters[1]
	                     _else >> _unset
	                     _endif
	_self.manage_actions()

	# Refresh map immediately when show_map is active so displayed clusters track selection
	_if .items[:highlight_btn].value _is _true
	_then
		_self.changed(:show_map, _true)
	_endif
_endmethod
$

##
## Outage check actions
##

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.check_outage_selected()
	## Call NISA API for the currently selected cluster

	_if .selected_cluster _is _unset
	_then
		_self.log_warning("No cluster selected.")
		_return
	_endif

	_local cc << .selected_cluster[:cluster_code]
	_self.log_separator()
	_self.log_info("Checking outage for: " + cc)
	_self.check_one_cluster(.selected_cluster)

	# Refresh the Is Outage? column
	_self.changed(:cluster_list, :renew)
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.check_outage_all()
	## Call NISA API for every cluster in result_rows

	_if .result_rows.empty?
	_then
		_self.log_warning("No clusters in list.")
		_return
	_endif

	_local total << .result_rows.size
	_self.log_separator()
	_self.log_info(write_string("Checking outage for all ", total, " clusters..."))

	_local done << 0
	_for pl _over .result_rows.fast_elements()
	_loop
		_self.check_one_cluster(pl)
		done +<< 1
		_local cc << pl[:cluster_code]
		_self.log_info(write_string("  [", done, "/", total, "] ", cc, " -> ",
			_self.get_outage_label(cc)))
	_endloop

	_self.log_success("Outage check complete for all clusters.")
	_self.changed(:cluster_list, :renew)
	_self.manage_actions()
_endmethod
$

_private _method rwwi_nisa_dialog.check_one_cluster(cluster_pl)
	## Internal: call NISA API using cluster_id_stella already in the result row.
	## Avoids a second PostgreSQL lookup by using the stella ID from the search.
	##
	## Parameters:
	##   cluster_pl - property_list from result_rows (has :cluster_id_stella and :cluster_code)

	_local cluster_code     << cluster_pl[:cluster_code]
	_local cluster_id_stella << cluster_pl[:cluster_id_stella]

	_try _with errCon
		_if cluster_id_stella _is _unset _orif cluster_id_stella = ""
		_then
			_self.log_warning(write_string("  No Stella ID for ", cluster_code, " - skipping"))
			_return
		_endif

		# Call NISA API directly with stella ID (no DB lookup needed)
		_local json_result << nisa_get_massproblem_active_cluster(cluster_id_stella)
		_local result       << _self.parse_massproblem_response_test(json_result)
		.outage_cache[cluster_code] << result

		_local data_count << result[:data].size
		_local status_str << _if data_count > 0
		                     _then >> write_string("OUTAGE (", data_count, " MP)")
		                     _else >> "OK"
		                     _endif
		_self.log_info(write_string("  ", cluster_code, " (", cluster_id_stella, ") -> ", status_str,
			_if _not result[:success]
			_then >> write_string(" [msg: ", result[:msg], "]")
			_else >> ""
			_endif))
	_when error
		_self.log_error(write_string("  Error checking ", cluster_code, ": ",
			errCon.report_contents_string))
		# Store error result so it does not remain :unknown
		_local err_pl << property_list.new_with(
			:success, _false,
			:msg,     errCon.report_contents_string,
			:data,    rope.new())
		.outage_cache[cluster_code] << err_pl
	_endtry
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.parse_massproblem_response(json_string)
	## Parse raw NISA mass problem API response JSON into Magik property_lists.
	## Moved here from global nisa_parse_massproblem_response proc so the dialog
	## is self-contained.
	##
	## Parameters:
	##   json_string - Raw JSON string from nisa_get_massproblem_active_cluster()
	##
	## Returns:
	##   property_list with:
	##     :success - Boolean
	##     :msg     - String message
	##     :data    - Rope of property_lists, each with:
	##                  :mp_no, :event, :area, :category,
	##                  :start_date, :start_time, :estimation,
	##                  :sites - Rope of property_lists with:
	##                           :olt_name, :cluster_name, :frame, :slot, :port

	_local result << property_list.new()
	result[:success] << _false
	result[:msg]     << ""
	result[:data]    << rope.new()

	_if json_string _is _unset _orif json_string.empty?
	_then
		result[:msg] << "No response"
		_return result
	_endif

	_try _with errCon
		_local json_obj << json_parser.parse(json_string)

		result[:success] << json_obj[:success].default(_false)
		result[:msg]     << json_obj[:msg].default("").write_string

		_local json_data << json_obj[:data]
		_if json_data _is _unset _then _return result _endif

		_local data_rope << rope.new()

		_for mp_item _over json_data.fast_elements()
		_loop
			_local mp_pl << property_list.new()
			mp_pl[:mp_no]      << mp_item[:mp_no].default("").write_string
			mp_pl[:event]      << mp_item[:event].default("").write_string
			mp_pl[:area]       << mp_item[:area].default("").write_string
			mp_pl[:category]   << mp_item[:category].default("").write_string
			mp_pl[:start_date] << mp_item[:start_date].default("").write_string
			mp_pl[:start_time] << mp_item[:start_time].default("").write_string
			mp_pl[:estimation] << mp_item[:estimation].default("").write_string

			_local json_sites << mp_item[:sites]
			_local sites_rope << rope.new()
			_if json_sites _isnt _unset
			_then
				_for site_item _over json_sites.fast_elements()
				_loop
					_local site_pl << property_list.new()
					site_pl[:olt_name]     << site_item[:olt_name].default("").write_string
					site_pl[:cluster_name] << site_item[:cluster_name].default("").write_string
					site_pl[:frame]        << site_item[:frame].default("").write_string
					site_pl[:slot]         << site_item[:slot].default("").write_string
					site_pl[:port]         << site_item[:port].default("").write_string
					sites_rope.add_last(site_pl)
				_endloop
			_endif

			mp_pl[:sites] << sites_rope
			data_rope.add_last(mp_pl)
		_endloop

		result[:data] << data_rope

	_when error
		result[:msg] << "Parse error: " + errCon.report_contents_string
		_self.log_error("parse_massproblem_response: " + errCon.report_contents_string)
	_endtry

	>> result
_endmethod
$

_pragma(classify_level=debug, topic={nisa_integration})
_method rwwi_nisa_dialog.parse_massproblem_response_test(json_string)
	## TEST VERSION  -  always injects one dummy mass problem record regardless of
	## whether the actual JSON response contains data.
	## Use this during development/testing when the NISA API returns empty data.

	# Run the real parser first
	_local result << _self.parse_massproblem_response(json_string)

	# If real data came back, return it as-is
	_if result[:success] _is _true _andif result[:data].size > 0
	_then
		>> result
	_endif

	# Inject dummy mass problem so the outage path can be exercised
	_local dummy_site << property_list.new_with(
		:olt_name,     "OLT-TEST-01",
		:cluster_name, "CLUSTER-DUMMY",
		:frame,        "1",
		:slot,         "2",
		:port,         "3")

	_local dummy_mp << property_list.new_with(
		:mp_no,      "MP-DUMMY-0001",
		:event,      "DUMMY FIBRE CUT",
		:area,       "TEST AREA",
		:category,   "FIBRE",
		:start_date, "2026-01-01",
		:start_time, "08:00:00",
		:estimation, "2026-01-01 12:00:00",
		:sites,      rope.new_with(dummy_site))

	result[:success] << _true
	result[:msg]     << "dummy"
	result[:data]    << rope.new_with(dummy_mp)

	>> result
_endmethod
$

##
## Zone RWO lookup
##

_pragma(classify_level=basic, topic={nisa_integration})
_private _method rwwi_nisa_dialog.find_zone_rwo(cluster_code, lat_str, lon_str)
	## Find the best matching ftth!zone record for the given cluster.
	##
	## Priority:
	##   1. Macro Cell (type="Macro Cell") with matching cluster_code  -> return immediately
	##   2. Micro Cell (type="Micro Cell") with matching cluster_code
	##      AND whose area contains the outage coordinate               -> return first match
	##   3. _unset if nothing found or coordinates are missing
	##
	## Parameters:
	##   cluster_code - Cluster code string
	##   lat_str      - Latitude string (WGS84, may be "" or _unset)
	##   lon_str      - Longitude string (WGS84, may be "" or _unset)

	_local zone_col << _self.database.collections[:ftth!zone]
	_if zone_col _is _unset _then _return _unset _endif

	# Step 1: Try Macro Cell first
	_local macro_cell << zone_col.select(
		predicate.eq(:type, "Macro Cell") _and
		predicate.eq(:cluster_code, cluster_code)).an_element()
	_if macro_cell _isnt _unset _then _return macro_cell _endif

	# Step 2: No Macro Cell - fall back to Micro Cell containing the outage coordinate
	_if lat_str _is _unset _orif lat_str = "" _orif
	   lon_str _is _unset _orif lon_str = ""
	_then
		_return _unset
	_endif

	_try
		_dynamic !current_world!             << .database.collections[:sw_gis!world].at(0,0)
		_dynamic !current_coordinate_system! << .database.collections[:sw_gis!world].at(0,0).coordinate_system

		_local local_coord << _self.coord_xform().convert(
			coordinate.new(lon_str.as_number(), lat_str.as_number()))

		_local pt << pseudo_point.new(local_coord)
		pt.world << .database.world

		# Query Micro Cells for this cluster_code that spatially contain the outage point
		_local micro_cell << zone_col.select(
			predicate.eq(:type, "Micro Cell") _and
			predicate.eq(:cluster_code, cluster_code) _and
			predicate.interacts(:location, pt)).an_element()

		_return micro_cell
	_when error
		_return _unset
	_endtry
_endmethod
$

##
## Database / coordinate helpers  -  mirrors rwi_aerial_kmz_object_writer.init() pattern
##

_pragma(classify_level=basic, topic={nisa_integration})
_private _method rwwi_nisa_dialog.init_transform()
	## Initialise database, view, and WGS84 -> local CS transform.
	## Tries :gis key first, then falls back to any open database so
	## this works regardless of the application's session key name.

	.database << gis_program_manager.databases[:gis]

	# Fallback: iterate all open databases until one is found
	_if .database _is _unset
	_then
		_for db _over gis_program_manager.databases.fast_elements()
		_loop
			_if db _isnt _unset
			_then
				.database << db
				_leave
			_endif
		_endloop
	_endif

	.view << gis_program_manager.ace_view

	_if .database _isnt _unset _andif .view _isnt _unset
	_then
		_dynamic !current_world!            << .database.collections[:sw_gis!world].at(0,0)
		_dynamic !current_coordinate_system! << .database.collections[:sw_gis!world].at(0,0).coordinate_system

		cs_wgs84 << .view.collections[:sw_gis!coordinate_system].at(:world_longlat_wgs84_degree)
		cs_local << .database.world.coordinate_system
		.cs_transform << transform.new_converting_cs_to_cs(cs_wgs84, cs_local)
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.database
	## Return the GIS database, initialising on first use.

	_if .database _is _unset _then _self.init_transform() _endif
	>> .database
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.coord_xform()
	## Return the WGS84 -> local CS transform, initialising on first use.

	_if .cs_transform _is _unset _then _self.init_transform() _endif
	>> .cs_transform
_endmethod
$

##
## Map action
##

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.goto_selected()
	## Navigate the map to the currently selected cluster.
	## Converts WGS84 lat/lon to a pseudo_point in local CS here in the dialog,
	## then fires :goto_request with the geom so the plugin only needs goto_bounds.
	write("goto_selected called")
	_if .selected_cluster _is _unset
	_then
		_self.log_warning("No cluster selected.")
		_return
	_endif

	_local pl      << .selected_cluster
	_local lat_str << pl[:lat].default("")
	_local lon_str << pl[:lon].default("")

	_if lat_str = "" _orif lon_str = ""
	_then
		_self.log_warning("Selected cluster has no coordinates.")
		_return
	_endif

	_try _with errCon
		_local xf << _self.coord_xform()
		_dynamic !current_world!             << .database.collections[:sw_gis!world].at(0,0)
		_dynamic !current_coordinate_system! << .database.collections[:sw_gis!world].at(0,0).coordinate_system
		_dynamic !print_float_precision!     << 16
		_local local_coord << xf.convert(
			coordinate.new(lon_str.as_number(), lat_str.as_number()))

		_local pp << pseudo_point.new(local_coord)
		pp.world << _self.database.world

		_self.log_info("Going to cluster: " + pl[:cluster_code])
		_self.changed(:goto_request, pp)

	_when error
		_self.log_error("goto_selected error: " + errCon.report_contents_string)
	_endtry
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.show_map(toggled?)
	## Toggle cluster outage highlights on the map.
	## Works on selected rows only  -  fires :show_map notification consumed by plugin.

	_if toggled? _andif .selected_clusters.empty?
	_then
		_self.log_warning("No clusters selected. Select rows in the table first.")
		.items[:highlight_btn].value << _false
		_return
	_endif
	_self.changed(:show_map, toggled?)
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.records
	## Return a rope of outage-active cluster records for map rendering.
	## Only SELECTED rows with active outage (success=true, data.size > 0) are included.
	## Deduplicates by stella_id (area mode) or cluster_code (cluster_code mode).
	##
	## Each element is a property_list with:
	##   :pseudo_point - pseudo_point in local CS
	##   :cluster_pl   - original cluster property_list
	##   :outage_data  - cached outage result property_list

	_local result        << rope.new()
	_local xf            << _self.coord_xform()
	_local seen_clusters << equality_hash_table.new()

	_for pl _over .selected_clusters.fast_elements()
	_loop
		_local cc        << pl[:cluster_code]
		_local cache_key << _if .search_mode _is :area
		                    _then >> pl[:cluster_id_stella].default(cc)
		                    _else >> cc
		                    _endif
		_local cached << .outage_cache[cache_key]

		_local dedup_key << cache_key
		_if seen_clusters[dedup_key] _isnt _unset _then _continue _endif

		# Only include clusters with a confirmed active outage
		_if cached _is _unset _orif
		    _not (cached[:success] _is _true _andif cached[:data].size > 0)
		_then
			_continue
		_endif

		_local lat_str << pl[:lat].default("")
		_local lon_str << pl[:lon].default("")
		_if lat_str = "" _orif lon_str = "" _then _continue _endif

		_try
			_dynamic !current_world!             << .database.collections[:sw_gis!world].at(0,0)
			_dynamic !current_coordinate_system! << .database.collections[:sw_gis!world].at(0,0).coordinate_system
			_dynamic !print_float_precision!     << 16
			_local local_coord << xf.convert(
				coordinate.new(lon_str.as_number(), lat_str.as_number()))
			_local pp << pseudo_point.new(local_coord)

			result.add_last(property_list.new_with(
				:pseudo_point, pp,
				:cluster_pl,   pl,
				:outage_data,  cached))
			seen_clusters[dedup_key] << _true
		_when error
		_endtry
	_endloop

	>> result
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.all_outage_records
	## Return ALL outage-active cluster records across every result row.
	## Used by blink animations  -  independent of table selection.
	## Same structure as records() but iterates result_rows, not selected_clusters.

	_local result        << rope.new()
	_local xf            << _self.coord_xform()
	_local seen_clusters << equality_hash_table.new()

	_for pl _over .result_rows.fast_elements()
	_loop
		_local cc        << pl[:cluster_code]
		_local cache_key << _if .search_mode _is :area
		                    _then >> pl[:cluster_id_stella].default(cc)
		                    _else >> cc
		                    _endif
		_local cached << .outage_cache[cache_key]

		_local dedup_key << cache_key
		_if seen_clusters[dedup_key] _isnt _unset _then _continue _endif

		_if cached _is _unset _orif
		    _not (cached[:success] _is _true _andif cached[:data].size > 0)
		_then
			_continue
		_endif

		_local lat_str << pl[:lat].default("")
		_local lon_str << pl[:lon].default("")
		_if lat_str = "" _orif lon_str = "" _then _continue _endif

		_try
			_dynamic !current_world!             << .database.collections[:sw_gis!world].at(0,0)
			_dynamic !current_coordinate_system! << .database.collections[:sw_gis!world].at(0,0).coordinate_system
			_dynamic !print_float_precision!     << 16
			_local local_coord << xf.convert(
				coordinate.new(lon_str.as_number(), lat_str.as_number()))
			_local pp << pseudo_point.new(local_coord)

			result.add_last(property_list.new_with(
				:pseudo_point, pp,
				:cluster_pl,   pl,
				:outage_data,  cached))
			seen_clusters[dedup_key] << _true
		_when error
		_endtry
	_endloop

	>> result
_endmethod
$

##
## Outage label / icon helpers
##

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.get_outage_label(cluster_code)
	## Return a display string for the Is Outage? column.
	## :unknown -> "(unchecked)"
	## no data  -> "OK"
	## has data -> "OUTAGE (N MP)"

	_local result << .outage_cache[cluster_code]
	_if result _is _unset
	_then
		_return "(unchecked)"
	_endif

	_local data_count << result[:data].size
	_if data_count > 0
	_then
		_return write_string("OUTAGE (", data_count, " MP)")
	_else
		_return "OK"
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.outage_status_for(cluster_code)
	## Return :outage, :ok, or :unknown for the given cluster_code.
	## Used by the plugin for colour-coded rendering.

	_local result << .outage_cache[cluster_code]
	_if result _is _unset _then _return :unknown _endif
	_if result[:data].size > 0 _then _return :outage _endif
	_return :ok
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.outage_tooltip_for(cluster_code)
	## Build tooltip string from stored NISA API result.
	## Shows cluster header + all active mass problems with their sites.
	## In area mode, sites are filtered to only those matching this cluster's stella ID.
	## In cluster_code mode (sites have no clusterid), all sites are shown.
	##
	## Returns a multi-line string.

	# Find first result row for this cluster (provides DB fields + stella_id)
	_local pl        << _unset
	_local stella_id << _unset
	_for row_pl _over .result_rows.fast_elements()
	_loop
		_if row_pl[:cluster_code] = cluster_code
		_then
			pl        << row_pl
			stella_id << row_pl[:cluster_id_stella]
			_leave
		_endif
	_endloop

	_local lines << rope.new()
	_if pl _isnt _unset
	_then
		lines.add_last(write_string("-- ASTRI INFORMATION --"))
		lines.add_last(write_string("Cluster Code: ", cluster_code))
		lines.add_last(write_string("OLT Code: ", pl[:olt_code]))
		lines.add_last(write_string("FDT Code: ", pl[:fdt_code]))
		lines.add_last(write_string("Homepass: ", pl[:homepass_total]))
	_else
		lines.add_last(write_string("Cluster Code: ", cluster_code))
	_endif

	# In area mode use stella_id as cache key; in cluster_code mode use cluster_code
	_local cache_key << _if .search_mode _is :area _andif stella_id _isnt _unset
	                    _then >> stella_id
	                    _else >> cluster_code
	                    _endif
	_local result << .outage_cache[cache_key]
	_if result _isnt _unset _andif result[:data].size > 0
	_then
		lines.add_last("   ")
		lines.add_last(write_string("--  MASS PROBLEM ACTIVE --"))

		_for mp_pl _over result[:data].fast_elements()
		_loop
			lines.add_last(write_string("MP No: ", mp_pl[:mp_no]))
			lines.add_last(write_string("Event: ", mp_pl[:event]))
			lines.add_last(write_string("Area: ", mp_pl[:area]))
			lines.add_last(write_string("Category: ", mp_pl[:category]))
			lines.add_last(write_string("Start: ", mp_pl[:start_date], " ", mp_pl[:start_time]))
			lines.add_last(write_string("ETA: ", mp_pl[:estimation]))

			# Collect sites: in area mode filter by clusterid = stella_id;
			# in cluster_code mode (site has no clusterid) include all sites
			_local sites          << mp_pl[:sites]
			_local filtered_sites << rope.new()
			_if sites _isnt _unset
			_then
				_for site _over sites.fast_elements()
				_loop
					_local site_cid << site[:clusterid]
					_if stella_id _is _unset _orif
					    site_cid _is _unset _orif site_cid = "" _orif
					    site_cid = stella_id
					_then
						filtered_sites.add_last(site)
					_endif
				_endloop
			_endif

			_if filtered_sites.size > 0
			_then
				# OLT/Cluster/ID are the same for all sites of this cluster in one MP  -  show once
				_local first_site << filtered_sites[1]
				lines.add_last(write_string("---- Sites Information: "))
				lines.add_last(write_string("OLT Name: ", first_site[:olt_name]))
				_local cid_str << first_site[:clusterid].default("")
				_if cid_str <> ""
				_then
					lines.add_last(write_string("Cluster ID: ", cid_str))
				_endif
				lines.add_last(write_string("Cluster Name: ", first_site[:cluster_name]))
				# Per-site: Frame / Slot / Port only
				lines.add_last(write_string("Ports (", filtered_sites.size, "):"))
				_for site _over filtered_sites.fast_elements()
				_loop
					lines.add_last(write_string("> ",
						"  Frame:", site[:frame],
						" Slot:", site[:slot],
						" Port:", site[:port]))
				_endloop
			_endif
		_endloop
	_endif

	# Join with newlines
	_local tooltip << ""
	_for i _over 1.upto(lines.size)
	_loop
		_if i > 1 _then tooltip << tooltip + %newline.write_string _endif
		tooltip << tooltip + lines[i]
	_endloop
	_return tooltip
_endmethod
$

##
## Manage action states
##

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.manage_actions()
	## Enable / disable buttons based on current state.
	## goto_btn: only when exactly 1 row is selected.
	## highlight_btn / start_btn: when at least 1 SELECTED cluster has active outage.

	_local has_results      << _not .result_rows.empty?
	_local single_selected? << .selected_clusters.size = 1

	# has_outage_selected: for Show on Map  -  at least one SELECTED row has active outage
	_local has_outage_selected << _false
	_for pl _over .selected_clusters.fast_elements()
	_loop
		_local mk << _if .search_mode _is :area
		             _then >> pl[:cluster_id_stella].default(pl[:cluster_code])
		             _else >> pl[:cluster_code]
		             _endif
		_local cached << .outage_cache[mk]
		_if cached _isnt _unset _andif
		    cached[:success] _is _true _andif
		    cached[:data].size > 0
		_then
			has_outage_selected << _true
			_leave
		_endif
	_endloop

	# has_outage_any: for Start blink  -  at least one row in the full list has active outage
	_local has_outage_any << _false
	_for pl _over .result_rows.fast_elements()
	_loop
		_local mk << _if .search_mode _is :area
		             _then >> pl[:cluster_id_stella].default(pl[:cluster_code])
		             _else >> pl[:cluster_code]
		             _endif
		_local cached << .outage_cache[mk]
		_if cached _isnt _unset _andif
		    cached[:success] _is _true _andif
		    cached[:data].size > 0
		_then
			has_outage_any << _true
			_leave
		_endif
	_endloop

	# Check All Outages is only relevant in cluster_code mode  -  in area mode the
	# outage cache is already pre-populated from the search API response.
	.items[:run_btn].enabled?       << has_results _andif .search_mode _isnt :area
	.items[:goto_btn].enabled?      << single_selected?
	.items[:highlight_btn].enabled? << has_outage_selected

	.items[:start_btn].enabled? << has_outage_any _andif _not .blink_active
	.items[:stop_btn].enabled?  << .blink_active _is _true
_endmethod
$

##
## Blink animation control
##

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.go()
	## Start blink animation using existing cached outage records.

	_if .result_rows.empty?
	_then
		_self.log_warning("No clusters to animate. Run a search first.")
		_return
	_endif

	.blink_active << _true
	_self.changed(:blink_mode, _true)
	_self.log_info("[Blink] Started.")
	_self.manage_actions()
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.stop()
	## Stop blink animation.

	.blink_active << _false
	_self.changed(:blink_mode, _false)
	_self.log_info("[Blink] Stopped.")
	_self.manage_actions()
_endmethod
$

##
## Logging helpers
##

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.log_info(message)
	## Append an info line to the log window

	_if .items[:log] _isnt _unset
	_then
		_local t << .items[:log].text.default("")
		.items[:log].text << t + message + %newline.write_string
		.items[:log].goto_line_end()
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.log_success(message)
	_self.log_info("[OK] " + message)
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.log_error(message)
	_self.log_info("[ERROR] " + message)
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.log_warning(message)
	_self.log_info("[WARN] " + message)
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.log_separator()
	_self.log_info("-" * 60)
_endmethod
$

_pragma(classify_level=basic, topic={nisa_integration})
_method rwwi_nisa_dialog.clear_log()
	_if .items[:log] _isnt _unset
	_then
		.items[:log].text << ""
	_endif
_endmethod
