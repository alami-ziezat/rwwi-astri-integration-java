			_endif
		
			_if ex_name ="sheath_splice"  _then

				_if  ob.sheath_splice_object_type ="FAT" _then 
				
					geo << ob.location.coord
					a_point << pseudo_point.new( geo )
					a_point.world << v.world
					p_predicate << predicate.interacts(:location, {a_point} )
					p_predicate_type << predicate.eq(:type, "Micro Cell")
					s_pol << pol_col.select( p_predicate) # _and p_predicate_type )
				
					
					
					_if s_pol.size = 0 _then
						p.add(ob)
					_endif
					
				_endif 
				
				count +<< 1
				#_endif 
			_endif
			
		_when error
			_continue
		_endtry
		
	_endloop
	
	>> p

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_stella_integration_dialog.get_data_boundary_fat_not_valid()

	#c_ur1 << ur1.conduits
	#cbl_ur1 << ur1.cables

	v << gis_program_manager.databases[:gis]
	vc << v.collections
	c_ur1 << vc[:ftth!demand_point]
	pol_col << vc[:ftth!zone]
	sc_col << vc[:sheath_splice]
	count << 0

	app << smallworld_product.pni_application() 
	mm << app.plugin(:map_plugin)
		
	s << swg_dsn_admin_engine.get_current_job()

	_if s _is _unset
	_then
		write("No Design")
		_leave 
	_endif
	write("boundd")
	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	#pj << s.inf_project.write_string
	st << s.status.write_string	
	change_set << mit_scheme_record_change_set.new(s)
		
	dm << gis_program_manager.databases[:design_admin]
	val << s.inf_project.write_string
	c << dm.collections[:swg_dsn_project].select(predicate.eq(:name,val))
	cur_rec << c.an_element()
	project_id << cur_rec.id.write_string 
	nama << cur_rec.name.write_string
	owner << s.owner.write_string
	#write(project_id,nama)


	p << rope.new()
	
	_for i _over change_set.fast_elements()
	_loop
		
		#_try _with err
		
			ob << i.current_record
			ex_name <<   ob.source_collection.name.write_string
			#write(ex_name)
			_if ex_name ="Conduit Route Face" _then
				_continue
			_endif
		
			_if ex_name ="ftth!zone"  _then
			
				_if  ob.type ="Micro Cell" _then 
				
					geo << ob.location  #.sectors
					#a_point << pseudo_area.new( geo )
					#a_point.world << v.world
					
					p_predicate << predicate.interacts(:location, (geo)) #{a_point} )
					p_predicate_type << predicate.eq(:sheath_splice_object_type, "FAT")
					s_pol << sc_col.select( p_predicate _and p_predicate_type )
				
					_if s_pol.size = 0 _then
						p.add(ob)
					_elif s_pol.size >1 
					_then
						p.add(ob)
					_endif
					
				_endif 
				
				count +<< 1
				#_endif 
			_endif
			
		#_when error
		#	_continue
		#_endtry
		
	_endloop
	
	>> p

_endmethod
$







_pragma(classify_level=restricted)
_method rwwi_stella_integration_dialog.table_selected_ur1( selection )
	## 
	##

	_global sel
	sel << selection
	#.current_selection_ur1 << selection.get_row_data_from_selection().an_element()	
	#write("cur : ",.current_selection_ur1)
	#i << sel.selected_rows[1]
	

	_if sel.selected_rows[1] = 1 _then
	#	write("Cluster")
		.table_list2.empty()
		.table_list2 << _self.get_data_cell()
	_elif sel.selected_rows[1] = 2 _then
	#	write("Cluster")
		.table_list2.empty()
		.table_list2 << _self.get_data_fdt()	
		
	_elif sel.selected_rows[1] = 3 _then
	#	write("FAT")
		.table_list2.empty()
		.table_list2 << _self.get_data_odp()
	_elif sel.selected_rows[1] = 4 _then
	#	write("Homepass")
		.table_list2.empty()
		.table_list2 << _self.get_data_homepass()
	_elif sel.selected_rows[1] = 5 _then
	#	write("Homepass")
		.table_list2.empty()
		.table_list2 << _self.get_data_fat_not_valid()
	_elif sel.selected_rows[1] = 6 _then
	#	write("Homepass")
		.table_list2.empty()
		.table_list2 << _self.get_data_homepass_not_valid()
	_elif sel.selected_rows[1] = 7 _then
	#	write("Homepass")
		.table_list2.empty()
		.table_list2 << _self.get_data_boundary_fat_not_valid()
	_endif

	.current_selection_ur1 << sel.selected_rows[1]
	write(.current_selection_ur1)

	_self.changed(:table_ur2, :refresh)
_endmethod
$


