#					       :model, _self,
#					       :selector, :print_data|()|,
#					       :tooltip, "Export Detail Object to KML" )
	

		# --- Export BoQ into Excel ---
		#	sw_label_item.new(file_toolbar, "  ")

	.items[:boq_excel_btn] << sw_button_item.new(file_toolbar,
		:label, "Export Data into Excel",
		:model, _self,
		:selector, :generate_boq_excel|()|,
		:tooltip, "Generate Bill of Quantities as Excel file")
	.items[:boq_excel_btn].enabled? << _true


	
	# --- Auto-upload Excel toggle ---
	sw_label_item.new(file_toolbar, "  Auto-upload:  ")
	.items[:auto_upload_excel] << sw_text_item.new(file_toolbar,
		:model, _self,
		:display_length, 5,
		:editable?, _false)
	.items[:auto_upload_excel].text_items << {"Off", "On"}
	.items[:auto_upload_excel].value << "Off"

	# --- Browse Excel + path field ---
	sw_label_item.new(file_toolbar, "  ")

	.items[:browse_excel_btn] << sw_button_item.new(file_toolbar,
		:label, "Browse Excel",
