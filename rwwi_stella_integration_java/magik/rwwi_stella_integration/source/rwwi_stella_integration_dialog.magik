	days_number << d.day_of_month_number
	months_number << d.month_number
	years_number << d.year
	
	_if months_number.write_string.size = 1
	_then 
		mth << "0"+months_number.write_string
	_endif
	
	_if days_number.write_string.size = 1
	_then 
		dys << "0"+days_number.write_string
	_else	
		dys << days_number
	_endif
	
	hari << dys.write_string+"-"+mth.write_string+"-"+years_number.write_string

	# Create directory 
	output_fol_dir << output_dir+"\HPDB astri "+cl_code
	
	# Create directory if it doesn't exist
	_if _not system.file_exists?(output_fol_dir)
	_then
		_try
			system.mkdir(output_fol_dir)
			write("Created BOQ output directory: ", output_fol_dir)
		_when error
			write("WARNING: Could not create sw_kml directory, using temp instead")
			output_fol_dir << system.temp_directory_name
		_endtry
	_endif



	
	fl_ex << "\HPDB astri "+cl_nm+".xlsx"
	ad << output_fol_dir+fl_ex  #"\HPDB astri .xlsx"
	write(ad)
	_if system.file_exists?( ad )
	_then
		system.do_command( write_string( "cmd /c del ", %",ad, %" ) )
	_endif
	
	WorkBook.saveas(ad)	
		
	WorkBook.Release_Object ()
	Excel_Object.Release_Object ()


	_endloop

	system.do_command("taskkill /IM excel.exe /f")
	system.do_command("taskkill /IM et.exe /f") 
	
	system.do_command("explorer.exe " + output_fol_dir)	
_endmethod
$

