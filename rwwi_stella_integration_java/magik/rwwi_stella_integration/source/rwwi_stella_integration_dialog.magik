#					       :image, {:run, :ui_resources},
#					       :model, _self,
#					       :selector, :get_result|()|,
#					       #:enabled?, _false,
#					       :tooltip, "Check " )

#	sw_label_item.new( file_toolbar, "Report" )

#	.items[:rpt_1] << sw_button_item.new( file_toolbar,
#					       :image, {:export_to_excel, :ui_resources},
#					       :model, _self,
#					       :selector, :print_data|()|,
