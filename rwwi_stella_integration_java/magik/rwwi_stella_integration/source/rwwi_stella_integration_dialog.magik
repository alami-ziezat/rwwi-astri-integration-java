_pragma(classify_level=basic, topic={sw2plp,api_client})
_method rwwi_stella_integration_dialog.populate_ur1( a_table )
	## 
	##
		row << 1

		a_table.add_cell( 1, 1, {}, {:label, "Cluster" })
		pl_cell << _self.get_data_cell()
	
		_if pl_cell.size = 0 _then
			jml_cell << 1
		_else
			jml_cell << pl_cell.size
		_endif
#		
#		pl_pole << _self.get_data_fdt()
#		
#		dt_c << jml_cell.write_string+" Cluster  "+ pl_pole.size.write_string+"   FDT" 
		a_table.add_cell( 1, 2, {}, {:label, jml_cell.write_string })

		a_table.add_cell( 2, 1, {}, {:label, "FDT" })
		pl_fdt << _self.get_data_fdt()

		_if pl_fdt _isnt _unset  
		_then
			a_table.add_cell( 2, 2, {}, {:label, pl_fdt.size.write_string })
		_endif
	
		a_table.add_cell( 3, 1, {}, {:label, "FAT" })
		pl_odp << _self.get_data_odp()
	
		_if pl_odp _isnt _unset  
		_then
			a_table.add_cell( 3, 2, {}, {:label, pl_odp.size.write_string })
		_endif
		
		a_table.add_cell( 4, 1, {}, {:label, "Homepass" })
		pl_otb << _self.get_data_homepass()
		_if pl_otb _isnt _unset 
		_then
			a_table.add_cell( 4, 2, {}, {:label, pl_otb.size.write_string })
		_endif

		a_table.add_cell( 5, 1, {}, {:label, "FAT Need To Check" })
		pl_fat << _self.get_data_fat_not_valid()
		_if pl_fat _isnt _unset 
		_then
			a_table.add_cell( 5, 2, {}, {:label, pl_fat.size.write_string })
		_endif

		a_table.add_cell( 6, 1, {}, {:label, "Homepass Need To Check" })
		pl_hp << _self.get_data_homepass_not_valid()
		_if pl_hp _isnt _unset 
		_then
			a_table.add_cell( 6, 2, {}, {:label, pl_hp.size.write_string })
		_endif

		a_table.add_cell( 7, 1, {}, {:label, "Boundary FAT Need To Check" })
		pl_hp << _self.get_data_boundary_fat_not_valid()
		_if pl_hp _isnt _unset 
		_then
			a_table.add_cell( 7, 2, {}, {:label, pl_hp.size.write_string })
		_endif
				
_endmethod
$


