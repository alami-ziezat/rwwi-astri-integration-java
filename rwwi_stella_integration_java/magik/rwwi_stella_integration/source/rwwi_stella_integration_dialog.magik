		{ :grs,              _unset },
		{ :mapman,           _unset },
		{ :ed,               _unset },
		{ :a_uub,               _unset },
		{ :a_sc,               _unset },
		{ :ev,               _unset },
		{ :records,          _unset },
		{ :last_excel_path,  _unset, :writable},
		{ :swl1,          _unset },
		{ :swl2,          _unset },
		{ :swl3,          _unset },
