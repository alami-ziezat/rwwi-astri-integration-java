_pragma(classify_level=restricted)
_method rwwi_stella_integration_dialog.get_data_homepass_fdt(fdt)

	#c_ur1 << ur1.conduits
	#cbl_ur1 << ur1.cables

	v << gis_program_manager.databases[:gis]
	vc << v.collections
	c_ur1 << vc[:ftth!demand_point]
	count << 0

	app << smallworld_product.pni_application() 
	mm << app.plugin(:map_plugin)

	
	p << rope.new()

	hp << _self.get_data_homepass()
	
	_for i _over hp.fast_elements()
	_loop

		_try _with err

			ob << i
			nt << ob.notes
			_if nt _is _unset _orif nt = ""
			_then
				_continue
			_else
				a_nt << nt.split_by("|")
				_if a_nt.size > 0 _then

					fd << a_nt[1].write_string
					fdm << fd.split_by(".")
					_if fdm.size > 2 _then
						fdt_1 << fdm[fdm.size]
						fdt_2 << fdm[fdm.size-1]
						fdt_cd << fdt_2.write_string+"."+fdt_1.write_string
					_else
						fdt_cd << fd
					_endif
					
					d_nt << fdt_cd #+"."+a_nt[a_nt.size].write_string
					#	write(d_nt,"  :  ",fat)
					_if d_nt = fdt _then
						p.add(ob)
						count +<< 1
					_endif
				_endif
				
			_endif 
			
		#	p.add(ob)
		#	count +<< 1
			
		_when error
			_continue
		_endtry
		
	_endloop

	write("hp fdt :",p.size)
#	.swl1 << p
	>> p

_endmethod
$

