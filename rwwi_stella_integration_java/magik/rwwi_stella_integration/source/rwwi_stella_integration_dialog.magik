_pragma(classify_level=restricted)
_method rwwi_stella_integration_dialog.seq_fdt()
	# Create a sequence
	table_list << rope.new()
	
	s << swg_dsn_admin_engine.get_current_job()
	
	_if s _is _unset
	_then
			write("No Design Selected")
			_leave 
	_endif
	
	t << rope.new()
	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	pj << s.inf_project.write_string
	st << s.status.write_string	
	change_set << mit_scheme_record_change_set.new(s)
	
	_for i _over change_set.fast_elements()
	_loop
		
		name <<   i.current_record.source_collection.name
		_if name _is :sheath_splice _then
			_if i.current_record.sheath_splice_object_type="FDT"
			_then
				_if i.current_record.construction_status="In Service"
				_then
					_continue
				_else

					t.add(i.current_record.name)

				_endif

			_endif
			#table_list.add(i.current_record)
		_endif
		
	_endloop

	#my_seq << equality_set.new_from(t) #{"FDT 1 003", "FDT 1 001", "FDT 1 002"})
	my_seq << sorted_collection.new_from(t)
	# Iterate through the sequence
#	_for i _over my_seq.fast_elements()
#	_loop
#		write(i)
#	_endloop

	>> my_seq
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_stella_integration_dialog.seq_fat(fdt)
	# Create a sequence
	table_list << rope.new()
	
	s << swg_dsn_admin_engine.get_current_job()
	
	_if s _is _unset
	_then
			write("No Design Selected")
			_leave 
	_endif
	
	t << rope.new()
	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	pj << s.inf_project.write_string
	st << s.status.write_string	
	change_set << mit_scheme_record_change_set.new(s)
	
	_for i _over change_set.fast_elements()
	_loop
		
		name <<   i.current_record.source_collection.name
		_if name _is :sheath_splice _then
			_if i.current_record.sheath_splice_object_type="FAT" 
			_then
				_if i.current_record.construction_status="In Service"
				_then
					_continue
				_else
					_if i.current_record.ring_name = fdt
					_then 
						t.add(i.current_record.name)
					_endif
				_endif
			_endif
			#table_list.add(i.current_record)
		_endif
	_endloop
	
	my_seq << sorted_collection.new_from(t)
	# Iterate through the sequence
#	_for i _over my_seq.fast_elements()
#	_loop
#		write(i)
#	_endloop

	>> my_seq
_endmethod
$


_global datalake_stella_by_cluster_code <<
_proc(cluster_code)



	_local db_conn << _unset
	_local result   << 0

	_protect
		_try _with errCon
			
			# Step 1: Connect to PostgreSQL
			_local is_connect?
			(is_connect?, db_conn) << user:rwwi_external_ds_manager.open_connection_for("[POSTGRESQL_ASTRI_DB]")
			
			_if _not is_connect?
			_then
			
				_return
			_endif
			write("  Connected to POSTGRESQL_ASTRI_DB")

			# Step 2: Look up cluster_id_stella for the given cluster_code_astri
			_local sql_query << "SELECT olt_code FROM smallworld.dim_cluster_stella_master_smallworld WHERE cluster_code_astri = ? LIMIT 1"
			write("  Querying dim_cluster_stella_master_smallworld...")

			_local recs << db_conn.sql_select(sql_query, cluster_code)
			_local rec  << recs.get()
			recs.close()
		
#			# Clean transaction state after SELECT
#			_try
#				db_conn.commit()
#			_when error
#				db_conn.rollback()
#			_endtry

		
			_if rec _is _unset
			_then
				write("  ERROR: No record found for cluster_code_astri = ", cluster_code)
				#result << "{\"success\":false,\"error\":\"Cluster not found: " + cluster_code + "\"}"
		
				_return result
			_else
			
				_local olt_code << rec.olt_code
				_if olt_code _is _unset 
				_then
					j << ""
				_else
					j << olt_code
				_endif
				
			#	result << j
			_endif


			_local sql_query2 << "SELECT olt_boss_code FROM smallworld.dim_olt_master_smallworld WHERE cluster_code_astri = ? LIMIT 1"
			write("  Querying dim_cluster_stella_master_smallworld...")

			_local recs2 << db_conn.sql_select(sql_query2, j)
			_local rec2  << recs2.get()
			recs2.close()
		
#			# Clean transaction state after SELECT
#			_try
#				db_conn.commit()
#			_when error
#				db_conn.rollback()
#			_endtry

		
			_if rec2 _is _unset
			_then
				write("  ERROR: No record found for cluster_code_astri = ", cluster_code)
				#result << "{\"success\":false,\"error\":\"Cluster not found: " + cluster_code + "\"}"
				_return result
			_else
			
				_local olt_code << rec.olt_boss_code
				_if olt_code _is _unset 
				_then
					j << ""
				_else
					j << olt_code
				_endif
				
				result << j
			_endif


		_when error
			write("  ERROR: ", errCon.report_contents_string)
			#result << "{\"success\":false,\"error\":\"" + errCon.report_contents_string + "\"}"
		_endtry

	_protection
		# Always close the DB connection on exit
		_if db_conn _isnt _unset
		_then
			_try
				db_conn.rollback()
				db_conn.close()
				extdb_java_acp.close_all()
				write("  DB connection closed")
			_when error
				# Ignore cleanup errors
			_endtry
		_endif
	_endprotect

	>> result
_endproc
$

_global datalake_stella_olt_code <<
_proc(olt_code)



	_local db_conn << _unset
	_local result   << 0

	_protect
		_try _with errCon
			
			# Step 1: Connect to PostgreSQL
			_local is_connect?
			(is_connect?, db_conn) << user:rwwi_external_ds_manager.open_connection_for("[POSTGRESQL_ASTRI_DB]")
			
			_if _not is_connect?
			_then
			
				_return
			_endif
			write("  Connected to POSTGRESQL_ASTRI_DB")
			write(olt_code)
			# Step 2: Look up cluster_id_stella for the given cluster_code_astri
			_local sql_query << "SELECT * FROM smallworld.dim_olt_master_smallworld WHERE olt_code = ? LIMIT 1"
			write("  Querying dim_olt_master_smallworld...", sql_query)

			_local recs << db_conn.sql_select(sql_query, olt_code)
			_local rec  << recs.get()
			print(rec)
			recs.close()
		
#			# Clean transaction state after SELECT
#			_try
#				db_conn.commit()
#			_when error
#				db_conn.rollback()
#			_endtry

		
			_if rec _is _unset
			_then
				write("  ERROR: No record found for cluster_code_astri = ", olt_code)
				#result << "{\"success\":false,\"error\":\"Cluster not found: " + cluster_code + "\"}"
				olt_boss_code << ""
				olt_hostname << ""
				
				_return olt_boss_code,olt_hostname
			_else
			
				olt_boss_code << rec.olt_boss_code
				olt_hostname << rec.olt_hostname
#				
#				_if olt_code _is _unset 
#				_then
#					j << ""
#				_else
#					j << olt_code
#				_endif
#				
#				#	result << j
			_endif
			
			
			
		_when error
			write("  ERROR: ", errCon.report_contents_string)
			#result << "{\"success\":false,\"error\":\"" + errCon.report_contents_string + "\"}"
		_endtry
		
	_protection
		# Always close the DB connection on exit
		_if db_conn _isnt _unset
		_then
			_try
				db_conn.rollback()
				db_conn.close()
				extdb_java_acp.close_all()
				write("  DB connection closed")
			_when error
				# Ignore cleanup errors
			_endtry
		_endif
	_endprotect

	>> olt_boss_code,olt_hostname
_endproc
$





_pragma(classify_level=restricted)
_method rwwi_stella_integration_dialog.generate_boq_excel()

	s << swg_dsn_admin_engine.get_current_job()
	nama << s.name.write_string
	y << s.project.job_title
	yy << y.split_by("-")
	nm_cls << yy[2]
	pj << s.inf_project.write_string
	_local area << s.project.project_areas.an_element().area
	geo << area.bounds.centre
	change_set << mit_scheme_record_change_set.new(s)

	v << gis_program_manager.databases[:gis]
	a_view << gis_program_manager.ace_view
	#mapman << .grs.plugin(:maps)
	vc << v.collections
	pol_col << vc[:pol_boundary]
	sc_col << vc[:sheath_splice]
	hp_col << vc[:ftth!demand_point]

	cs1 <<  v.world.coordinate_system 
	cs2 << a_view.collections[:sw_gis!coordinate_system].at(:world_longlat_wgs84_degree)
	t << transform.new_converting_cs_to_cs(cs1,cs2)

	ug << _self.cek_ug()
	ae << _self.cek_ae()

	_if ug _is _true _and ae _is _false 
	_then
		nt << "UG"
	_elif ae _is _true _and ug _is _false
	_then 
		nt << "AE"
	_elif ae _is _true _and ug _is _true
	_then 
		nt << "AE & UG"	
	_endif

	olt_nm << ""
	olt_code << ""
	_for i _over change_set.fast_elements()
	_loop
			
		name <<   i.current_record.source_collection.name
		_if name _is :sheath_with_loc _then
			olt_nm << i.current_record.olt
			_if olt_nm _is _unset
			_then
				olt_nm << ""
			_endif
			
			sf_code << i.current_record.subfeeder_code
			cl_code << i.current_record.cluster_code
			olt_code << i.current_record.olt_code

			_if olt_code _is _unset _orif olt_code ="" _then 
				olt_code << datalake_stella_by_cluster_code(cl_code)
			_endif
			
			write("olt  :",olt_code)
			
			_if olt_code = "" _orif olt_code _is _unset 
			_then
				olt_code << i.current_record.olt_code
			_endif
			_leave
		_endif
		
	_endloop


	_if olt_code _is  _unset _orif olt_code = "" _then

	_else
		write("here")
		(olt_boss_code,olt_hostname) << datalake_stella_olt_code(olt_code)
	_endif

	write(olt_code,olt_boss_code,olt_hostname)

	y_prj << s.project
	jb << y_prj.job_title
	j << jb.split_by("-")
	#	write(j.size)
	_if j.size > 1 
	_then
	
		j_tp << j[1]
		j_cd << j[2].write_string

		_if fd_code = "" _orif fd_code _is _unset
		_then
			fd_code << j_cd
		_endif

		_if sf_code = "" _orif sf_code _is _unset
		_then
			sf_code << j_cd
		_endif
		
		_if cl_code = "" _orif cl_code _is _unset
		_then
			cl_code << j_cd
		_endif
		
	_endif

	e_fdt << _self.seq_fdt()

	c_fdt << 0
	_for fd _over e_fdt.fast_elements()
	_loop

		
		grs << smallworld_product.pni_application() 
	#	grs.show_message("Pastikan semua aplikasi Excel lainnya sudah ditutup!")
		system.do_command("taskkill /IM excel.exe /f")
		system.do_command("taskkill /IM et.exe /f") 
		
		
		_if s _is _unset
		_then
			write("No Design Selected")
			_leave 
		_endif
		
		h_path << system.getenv("pni")
		a_filename << h_path + "\pni_custom\modules\rwwi_stella_integration\resources\template HPDB astri.xlsx"
		
		
		sht << "CLUSTER" #"Template"
		
		Excel_Object << OLE_Client.Create_Object("Excel.Application")
		Excel_Object.Visible << _True
		
		Workbooks << Excel_Object.Workbooks ()
		WorkBook << Workbooks.add(a_filename)
		
		Sheet << Excel_Object.Sheets (sht)
		Sheet1 << Excel_Object.Sheets ("FAT")
		Sheet2 << Excel_Object.Sheets ("HOMEPASS")
		
		a_ff << float_format.new_with_properties(
				:float_format,:fixed,
				:float_decimal_places,3)
		
		start << date_time_now()
		
		!current_dsview! << v
		
		_dynamic !print_float_precision! << 12
		
		_dynamic !current_world! << v.collections[:sw_gis!world].at(0,0)
		_dynamic !current_coordinate_system! << v.collections[:sw_gis!world].at(0,0).coordinate_system
		
		
		count      << 2
		dtn        << date_time_now()
		
		
		cs1 <<  v.world.coordinate_system 
		cs2 << a_view.collections[:sw_gis!coordinate_system].at(:world_longlat_wgs84_degree)
		t << transform.new_converting_cs_to_cs(cs1,cs2)
		
		w_conv << t.convert(geo)
		latitud << w_conv.y.write_string
		longitud << w_conv.x.write_string
		
		e_fdt << _self.get_data_fdt()
		_if e_fdt.size > 0
		_then
			a_fdt << e_fdt.an_element()
			nm_fdt << a_fdt.name
			nm_olt <<a_fdt.olt_code
		_else
			nm_fdt << ""
			nm_olt << ""
		_endif
		
		
		a_point << pseudo_point.new( geo )
		a_point.world << v.world
		p_predicate << predicate.interacts(:boundary, {a_point} )
		p_predicate_town << predicate.eq(:type, "Town")
		s_pol << pol_col.select( p_predicate _and p_predicate_town )
		
		_if s_pol.size > 0 _then
			a_pol << s_pol.an_element()	
			propinsi << a_pol.provinsi
			kabupaten << a_pol.kabupaten
			kecamatan << a_pol.kecamatan
			desa << a_pol.desa	
		_endif
		
		
		#write("count fdt :",e_fdt.size)
		count_fdt << 1
		
		count_fat << 1
		count_dp << 1
		
		

		
		#write(fd)
		fdm << fd.split_by(".")
		_if fdm.size > 2 _then
			fdt_1 << fdm[fdm.size]
			fdt_2 << fdm[fdm.size-1]
			fdt_cd << fdt_2.write_string+"."+fdt_1.write_string
		_else
			fdt_cd << fd
		_endif
		
		count_fdt +<< 1
		c_fdt +<< 1
		Cell_a << Sheet.Range ("A"+count_fdt.write_string)
		Cell_b << Sheet.Range ("B"+count_fdt.write_string)
		Cell_c << Sheet.Range ("C"+count_fdt.write_string)
		Cell_d << Sheet.Range ("D"+count_fdt.write_string)
		Cell_e << Sheet.Range ("E"+count_fdt.write_string)
		Cell_f << Sheet.Range ("F"+count_fdt.write_string)
		Cell_g << Sheet.Range ("G"+count_fdt.write_string)
		Cell_i << Sheet.Range ("I"+count_fdt.write_string)
		Cell_j << Sheet.Range ("J"+count_fdt.write_string)
		Cell_k << Sheet.Range ("K"+count_fdt.write_string)
		Cell_m << Sheet.Range ("M"+count_fdt.write_string)
		Cell_n << Sheet.Range ("N"+count_fdt.write_string)
		Cell_o << Sheet.Range ("O"+count_fdt.write_string)
		Cell_s << Sheet.Range ("S"+count_fdt.write_string)
		Cell_t << Sheet.Range ("T"+count_fdt.write_string)
		Cell_q << Sheet.Range ("Q"+count_fdt.write_string)
		Cell_r << Sheet.Range ("R"+count_fdt.write_string)
		Cell_u << Sheet.Range ("U"+count_fdt.write_string)
		
		cl_nm << nama+" - FDT "+c_fdt.write_string
		cell_a.value << cl_nm.write_string
		cell_a.entirecolumn.autofit
		
		cell_b.value << fdt_cd.write_string
		cell_b.entirecolumn.autofit
		
		cell_c.value << cl_nm.write_string
		cell_c.entirecolumn.autofit

		cell_d.value << propinsi.write_string
