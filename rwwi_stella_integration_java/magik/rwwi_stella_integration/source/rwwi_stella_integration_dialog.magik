_pragma(classify_level=basic, topic={sw2plp,api_client})
_method rwwi_stella_integration_dialog.populate_ur2( a_table )
	## 
	##

	row << 1

	v << gis_program_manager.databases[:gis]
	a_view << gis_program_manager.ace_view
	#mapman << .grs.plugin(:maps)
	vc << v.collections
	!current_dsview! << v

	_dynamic !print_float_precision! << 12

	_dynamic !current_world! << v.collections[:sw_gis!world].at(0,0)
	_dynamic !current_coordinate_system! << v.collections[:sw_gis!world].at(0,0).coordinate_system

	
	count      << 0
	dtn        << date_time_now()


	cs1 <<  v.world.coordinate_system 
	cs2 << a_view.collections[:sw_gis!coordinate_system].at(:world_longlat_wgs84_degree)
	t << transform.new_converting_cs_to_cs(cs1,cs2)

	#print(.table_list2 )

	_if .current_selection_ur1.write_string = "1"
	_then
		
			s << swg_dsn_admin_engine.get_current_job()
			_local area << s.project.project_areas.an_element().area
			geo << area.bounds.centre
			w_conv << t.convert(geo)
			latitud << w_conv.y.write_string
			longitud << w_conv.x.write_string
			a_table.set_row_data( row, s )
			nama << s.name.write_string
			a_table.add_cell( row, 1, {}, {:label, nama })
			a_table.add_cell( row, 2, {}, {:label, latitud })
			a_table.add_cell( row, 3, {}, {:label, longitud })
	_endif
	

	_for a_rec  _over .table_list2.fast_elements()
	_loop
	

		_if a_rec.external_name ="Cell" _then
			a_table.set_row_data( row, a_rec )
			a_table.add_cell( row, 1, {}, {:label, a_rec.name })			
			row +<< 1
	
		_else
	
			_if a_rec.location _isnt _unset _then 
				h << a_rec.location.coord
			
				w_conv << t.convert(h)
				#
				latitud << w_conv.y.write_string
				longitud << w_conv.x.write_string
				
				a_table.set_row_data( row, a_rec )
				a_table.add_cell( row, 1, {}, {:label, a_rec.name })
				a_table.add_cell( row, 2, {}, {:label, latitud })
				a_table.add_cell( row, 3, {}, {:label, longitud })
				#a_table.add_cell( row, 4, {}, {:label, a_rec.id.write_string })
				row +<< 1
				
				#	write("Pole Dont have Location  :",a_rec.telco_pole_tag)
			_endif
		_endif
		
		
		
	_endloop

	write("jj")
_endmethod
$
	

