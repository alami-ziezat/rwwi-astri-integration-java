#% text_encoding = iso8859_1

_package user
$

## ASTRI Design Migrator - Figure Eight Migration
## Contains methods for creating figure eight (slack/coil) from KMZ placemarks
## Two variants:
##   create_figure_eight            - dispatcher, routes to aerial or underground
##   create_figure_eight_aerial     - attaches to pole/OLT (aerial topology)
##   create_figure_eight_underground - attaches to UUB/handhole (underground topology)

_pragma(classify_level=basic, topic={astri_integration})
_private _method astri_design_migrator.create_figure_eight(pm)
	## Dispatcher: create figure_eight for aerial or underground topology
	## Delegates to create_figure_eight_aerial or create_figure_eight_underground
	## based on .topology slot
	##
	## Parameters:
	##   pm - Placemark property_list from KML parser

	_local topology << .topology.default(:aerial)

	_if topology = :underground
	_then
		_return _self.create_figure_eight_underground(pm)
	#_elif topology = :both
	#_then
		# For mixed topology create both
	#	_self.create_figure_eight_aerial(pm)
	#	_return _self.create_figure_eight_underground(pm)
	_else
		_return _self.create_figure_eight_aerial(pm)
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_private _method astri_design_migrator.create_figure_eight_aerial(pm)
	## Create figure_eight (slack/coil) for aerial topology:
	## - Pole/OLT association (search within 700cm or create placeholder)
	## - Aerial route snapping for placeholder poles
	## - Cable connection if available
	_dynamic !current_world! << .database.collections[:sw_gis!world].at(0,0)
	_dynamic !current_coordinate_system! << .database.collections[:sw_gis!world].at(0,0).coordinate_system
	_try _with errCon
		# Step 0: Validate figure_eight
		_local folders << pm[:parent].default("")
		_if _not _self.is_figure_eight?(pm)
		_then
			#write("  WARNING: Skipping - not a figure_eight: ", folders)
			_return
		_endif

		#write("  Processing figure_eight (aerial): ", pm[:name])

		# Step 1: Extract attributes from folders
		_local segment_id << _self.match_segment(folders)

		# Step 2: Parse location
		_local location << _self.parse_point_geometry(pm[:coord])
		_local coord << location.coord

		_local pp << pseudo_point.new(coord)
		pp.world << .database.world

		# Step 3: Find pole/OLT within 700cm or create placeholder
		_local (found, n_obj) << _self.scan_olt(pp, 700)
		_if _not found
		_then
			(found, n_obj) << _self.scan_sheath_splice(pp, 700)
		_endif

		_local sh_loc << _unset

		_if found _is _true
		_then
			# Sheath splice/OLT found - use it as structure
			#sh_loc << n_obj.location.coord
			write("    >> Found FE existing structure within 700cm: ", n_obj)

			# Check if structure already has a figure_eight
			_local existing_fe << _unset
			_try
				_local l_structure << n_obj
				_if eq.source_collection.name _is :sheath_splice
				_then
					l_structure << n_obj.get_structure()
				_endif
				_local equipment_set << l_structure.get_equipment()
				_if equipment_set _isnt _unset
				_then
					_for eq _over equipment_set.fast_elements()
					_loop
						_if eq.source_collection.name _is :figure_eight
						_then
							_local upd_trx << record_transaction.new_update(eq, property_list.new_with(:name, pm[:name]))
							upd_trx.run()
							existing_fe << eq
							_leave
						_endif
					_endloop
				_endif
			_when error
				# Continue if equipment check fails
			_endtry

			_if existing_fe _isnt _unset
			_then
				#write("    >> Structure already has figure_eight, skipping: ", existing_fe.name)
				_return
			_endif
		_else
			# No pole found - create placeholder pole
			#write("    >> Creating placeholder pole for slack")

			# Try to snap to aerial route
			_local (tf, r_pipe, snap_loc) << _self.scan_ar_on_design(pp)

			_if tf _is _true
			_then
				sh_loc << snap_loc
				#write("    >> Pole snapped to aerial route")
			_else
				sh_loc << coord
			_endif

			_local m_line << _self.match_line(folders.lowercase)

			_local l_prop_values_pl << property_list.new_with(
				:location, sh_loc,
				:telco_pole_tag, "Existing Pole Slack",
				:usage, "Telco",
				:material_type, "Steel",
				:extension_arm, _false,
				:power_riser, _false,
				:telco_riser, _false,
				:bond, _false,
				:ground_status, _false,
				:type, "T7",
				:folders, folders,
				:fttx_network_type, _self.get_fttx_network_type(),
				:line_type, m_line,
				:pop, .pop_name,
				:olt, .pop_name,
				:segment, segment_id,
				:uuid, .uuid,
				:construction_status, "In Service",
				:cluster_code, .cluster_code_db,
				:subfeeder_code, .subfeeder_code_db,
				:feeder_code, .feeder_code_db,
				:olt_code, .olt_code
			)

			_local l_rec_trans_pl << record_transaction.new_insert(.pole_col, l_prop_values_pl)
			n_obj << l_rec_trans_pl.run()

			.stats[:existing_poles] +<< 1
			#write("    >> Placeholder pole created (In Service)")
		_endif

		# Step 4: Create figure_eight
		_local infra_type_cap << _if .infra_type = "cluster"
		                         _then >> "Cluster"
		                         _elif .infra_type = "subfeeder"
		                         _then >> "SubFeeder"
		                         _elif .infra_type = "feeder"
		                         _then >> "Feeder"
		                         _else >> ""
		                         _endif
		_local l_prop_values << property_list.new_with(
			:construction_status, .construction_status,
			:type, "Circle",
			:length, 20000,
			:name, pm[:name],
			:folders, folders,
			:fttx_network_type, _self.get_fttx_network_type(),
			:segment, segment_id,
			:pop, .pop_name,
			:olt, .pop_name,
			:uuid, .uuid,
			:ring_name, pm[:ring_name],
			:stf_item_code, "200000185",
			:cluster_code, .cluster_code_db,
			:subfeeder_code, .subfeeder_code_db,
			:feeder_code, .feeder_code_db,
			:olt_code, .olt_code,
			:infra_type, infra_type_cap
		)

		_local l_rec_trans << record_transaction.new_insert(.fe_col, l_prop_values)
		_local l_result << l_rec_trans.run()

		.stats[:figure_eights] +<< 1
		#write("    [OK] Figure eight created: ", pm[:name], " (Type: Circle, Length: 20)")

		# Step 5: Associate to pole structure
		_try
			_if n_obj _isnt _unset
			_then
				l_result.associate_to_structure(n_obj)
				#write("    >> Associated to structure: ", n_obj.telco_pole_tag)
			_endif
		_when error
			# Continue if association fails
		_endtry

		# Step 6: Connect to cable if available
		_try
			_local l_cable << n_obj.cable_records.an_element()
			_if l_cable _isnt _unset
			_then
				l_cable.mcn!connect(l_result)
				#write("    >> Connected to cable")
			_endif
		_when error
			# Continue if cable connection fails
		_endtry

		>> l_result

	_when error
		write("ERROR in create_figure_eight_aerial():", errCon.report_contents_string)
		write("  Placemark name:", pm[:name].default("(unnamed)"))
		write("  Folders:", pm[:parent].default("(none)"))
		write("  Coordinates:", pm[:coord].default("(none)"))
		.stats[:errors] +<< 1
	_endtry
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_private _method astri_design_migrator.create_figure_eight_underground(pm)
	## Create figure_eight (slack/coil) for underground topology:
	## - UUB/handhole association (search within 700cm, prefer connected UUBs)
	## - Placeholder UUB creation when none found nearby
	## - Description stamped with UUB label and ID (ref: fttx_ur_figure_eight_migration)
	## - Cable connection via UUB cable_records if available
	##
	## Parameters:
	##   pm - Placemark property_list from KML parser
	_dynamic !current_world! << .database.collections[:sw_gis!world].at(0,0)
	_dynamic !current_coordinate_system! << .database.collections[:sw_gis!world].at(0,0).coordinate_system
	_try _with errCon
		# Step 0: Validate figure_eight
		_local folders << pm[:parent].default("")
		_if _not _self.is_figure_eight?(pm)
		_then
			#write("  WARNING: Skipping - not a figure_eight: ", folders)
			_return
		_endif

		#write("  Processing figure_eight (underground): ", pm[:name])

		# Step 1: Extract attributes from folders
		_local segment_id << _self.match_segment(folders)
		_local m_line << _self.match_line(folders.lowercase)
		_if m_line _is _unset
		_then
			m_line << _self.match_line(pm[:name])
		_endif

		# Step 2: Parse location
		_local location << _self.parse_point_geometry(pm[:coord])
		_local coord << location.coord

		_local pp << pseudo_point.new(coord)
		pp.world << .database.world

		# Step 3: Scan for UUB within 700cm
		# Prefer UUBs with connected routes (ref: scan_uub_fttx pattern)
		_local n_obj << _unset
		_local found << _false

		_local buff << pp.buffer(700)  # 7m radius in cm
		buff.world << .database.world
		_local pred << predicate.interacts(:location, {buff})
		_local uubs << .uub_col.select(pred)

		_if uubs.size > 0
		_then
			found << _true
			# Prefer UUB with existing connected routes
			_for uu _over uubs.fast_elements()
			_loop
				_if uu.connected_routes().size > 0
				_then
					n_obj << uu
					_leave
				_endif
			_endloop
			# Fall back to any nearby UUB
			_if n_obj _is _unset
			_then
				n_obj << uubs.an_element()
			_endif
			#write("    >> Found existing UUB within 700cm: ", n_obj.label)
		_endif

		_if found _is _true
		_then
			# Check if UUB already has a figure_eight
			_local existing_fe << _unset
			_try
				_local equipment_set << n_obj.get_equipment()
				_if equipment_set _isnt _unset
				_then
					_for eq _over equipment_set.fast_elements()
					_loop
						_if eq.source_collection.name _is :figure_eight
						_then
							existing_fe << eq
							_leave
						_endif
					_endloop
				_endif
			_when error
				# Continue if equipment check fails
			_endtry

			_if existing_fe _isnt _unset
			_then
				#write("    >> UUB already has figure_eight, skipping: ", existing_fe.name)
				_return
			_endif
		_else
			# No UUB found - create placeholder handhole for slack
			#write("    >> Creating placeholder UUB for slack")

			_local uub_props << property_list.new_with(
				:type, "Handhole",
				:label, "HH-Slack",
				:spec_id, "HH Concrete FDT : 80x80x130 cm",
				:construction_status, "In Service",
				:asset_owner, "Owned",
				:location, coord,
				:folders, folders,
				:pop, .pop_name,
				:olt, .pop_name,
				:fttx_network_type, _self.get_fttx_network_type(),
				:line_type, m_line,
				:segment, segment_id,
				:uuid, .uuid,
				:cluster_code, .cluster_code_db,
				:subfeeder_code, .subfeeder_code_db,
				:feeder_code, .feeder_code_db,
				:olt_code, .olt_code,
				:depth, 1.3,
				:width, 0.8
			)
			_local uub_trans << record_transaction.new_insert(.uub_col, uub_props)
			n_obj << uub_trans.run()

			_if .stats[:uubs] _is _unset _then .stats[:uubs] << 0 _endif
			.stats[:uubs] +<< 1
			#write("    >> Placeholder UUB created (In Service)")
		_endif

		# Step 4: Create figure_eight
		# Stamp UUB label + ID in description (ref: fttx_ur_figure_eight_migration)
		_local noted << "UUB Name : " + n_obj.label.default("") +
		                "  UUB ID : " + n_obj.id.write_string

		_local infra_type_cap << _if .infra_type = "cluster"
		                         _then >> "Cluster"
		                         _elif .infra_type = "subfeeder"
		                         _then >> "SubFeeder"
		                         _elif .infra_type = "feeder"
		                         _then >> "Feeder"
		                         _else >> ""
		                         _endif
		_local l_prop_values << property_list.new_with(
			:construction_status, .construction_status,
			:type, "Circle",
			:length, 20000,
			:name, pm[:name],
			:description, noted,
			:folders, folders,
			:fttx_network_type, _self.get_fttx_network_type(),
			:segment, segment_id,
			:pop, .pop_name,
			:olt, .pop_name,
			:uuid, .uuid,
			:stf_item_code, "200000185",
			:cluster_code, .cluster_code_db,
			:subfeeder_code, .subfeeder_code_db,
			:feeder_code, .feeder_code_db,
			:olt_code, .olt_code,
			:infra_type, infra_type_cap
		)

		_local l_rec_trans << record_transaction.new_insert(.fe_col, l_prop_values)
		_local l_result << l_rec_trans.run()

		.stats[:figure_eights] +<< 1
		#write("    [OK] Figure eight created (underground): ", pm[:name], " (Type: Circle, Length: 20)")

		# Step 5: Associate to UUB structure
		_try
			_if n_obj _isnt _unset
			_then
				l_result.associate_to_structure(n_obj)
				#write("    >> Associated to UUB: ", n_obj.label)
			_endif
		_when error
			# Continue if association fails
		_endtry

		# Step 6: Connect to cable via UUB cable_records if available
		# Ref: fttx_ur_figure_eight_migration: pl_sl.cable_records.an_element().mcn!connect(l_result)
		_try
			_local l_cable << n_obj.cable_records.an_element()
			_if l_cable _isnt _unset
			_then
				l_cable.mcn!connect(l_result)
				#write("    >> Connected to cable")
			_endif
		_when error
			# Continue if cable connection fails
		_endtry

		>> l_result

	_when error
		write("ERROR in create_figure_eight_underground():", errCon.report_contents_string)
		write("  Placemark name:", pm[:name].default("(unnamed)"))
		write("  Folders:", pm[:parent].default("(none)"))
		write("  Coordinates:", pm[:coord].default("(none)"))
		.stats[:errors] +<< 1
	_endtry
_endmethod
$
