_pragma(classify_level=basic, topic={astri_integration})
_private _method astri_data_migrator.create_cluster(rec)
	## Create CLUSTER (master_cluster) object in Smallworld
	## Parameters:
	##   rec - PostgreSQL record (from dim_cluster_master_smallworld)
	##
	## Field Mapping (PostgreSQL → Smallworld):
	##   cluster_id → cluster_id and id
	##   cluster_code → cluster_code
	##   cluster_name → cluster_name
	##   subfeeder_code → subfeeder_code
	##   feeder_code → feeder_code
	##   olt_code → olt_code
	##   topology → topology
	##   region → region
	##   vendor_name → vendor_name
	##   vendor_alias → vendor_alias
	##   cluster_hp → cluster_hp
	##   rfs_date → rfs_date
	##   cluster_status → subfeeder_status (set to "NEW")
	##   abd_kmz_uuid → abd_kmz_uuid
	##   apd_kmz_uuid → apd_kmz_uuid
	##   abd_kmz_verified_at → abd_kmz_verified_at
	##   apd_kmz_verified_at → apd_kmz_verified_at
	##   created_timestamp → created_timestamp
	##   updated_timestamp → updated_timestamp
	##   synced_timestamp → synced_timestamp

	# Build property list for new CLUSTER
	_local prop_values << property_list.new_with(
		# Core identification
		:id, rec.cluster_id.default(_unset),
		:cluster_id, rec.cluster_id.default(_unset),
		:cluster_code, rec.cluster_code.default(""),
		:cluster_name, rec.cluster_name.default(""),
		:subfeeder_code, rec.subfeeder_code.default(""),
		:feeder_code, rec.feeder_code.default(""),
		:olt_code, rec.olt_code.default(""),

		# Network details
		:topology, rec.topology.default(""),
		:region, rec.region.default(""),

		# Vendor information
		:vendor_name, rec.vendor_name.default(""),
		:vendor_alias, rec.vendor_alias.default(""),

		# Technical specifications
		:cluster_hp, rec.cluster_hp.default(_unset),
		:subfeeder_capacity, _unset,
		:subfeeder_length, _unset,

		# Status and dates
		:rfs_date, rec.rfs_date.default(_unset),
		:subfeeder_status, "NEW",

		# KMZ UUIDs and verification
		:abd_kmz_uuid, rec.abd_kmz_uuid.default(""),
		:apd_kmz_uuid, rec.apd_kmz_uuid.default(""),
		:abd_kmz_verified_at, rec.abd_kmz_verified_at.default(_unset),
		:apd_kmz_verified_at, rec.apd_kmz_verified_at.default(_unset),

		# Timestamps
		:created_timestamp, rec.created_timestamp.default(_unset),
		:updated_timestamp, rec.updated_timestamp.default(_unset),
		:synced_timestamp, rec.synced_timestamp.default(_unset)
	)

	# Create record transaction
	_local rec_trans << record_transaction.new_insert(.cluster_col, prop_values)
	_local result << rec_trans.run()

	.stats[:created] +<< 1
	write("  [OK] Created CLUSTER: ", rec.cluster_code)
_endmethod
$
#% text_encoding = iso8859_1

_pragma(classify_level=restricted)
_method astri_data_migrator.migrate_feeder_objects()
	## Migrate FEEDER KML objects to Smallworld
	## Status: NULL -> PROCESS -> MIGRATED/ERROR

	_local start_time << date_time.now()
	write("=== FEEDER OBJECT Migration Started ===")

	_local obj_stats << property_list.new_with(:total, 0, :processed, 0, :migrated, 0, :skipped, 0, :errors, 0)

	_try _with cond
		_local master_coll << .database.collections[:master_feeder]
		_if master_coll _is _unset
		_then
			write("ERROR: master_feeder collection not found")
			_return obj_stats
		_endif

		_for rec _over master_coll.fast_elements()
		_loop
			_local feeder_code << rec.feeder_code
			_local kmz_uuid << rec.abd_kmz_uuid
			_local current_status << rec.feeder_status.default("").write_string

			_if feeder_code _is _unset _orif feeder_code = "" _orif kmz_uuid _is _unset _orif kmz_uuid = ""
			_then _continue
			_endif

			obj_stats[:total] +<< 1
			write("")
			write("Processing FEEDER: ", feeder_code, " - Status: ", current_status)

			_if current_status = "MIGRATED"
			_then
				obj_stats[:skipped] +<< 1
				_continue
			_endif

			_if _self.process_feeder_kml_migration(rec, obj_stats)
			_then
				obj_stats[:migrated] +<< 1
			_endif
		_endloop

		write("=== FEEDER OBJECT Migration Complete ===")
	_when error
		write("ERROR: ", cond.report_contents_string)
	_endtry

	>> obj_stats
_endmethod
$

_pragma(classify_level=restricted)
_private _method astri_data_migrator.process_feeder_kml_migration(rec, obj_stats)
	_local feeder_code << rec.feeder_code
	_local kmz_uuid << rec.abd_kmz_uuid

	_try _with cond
		rec.feeder_status << "PROCESS"
		obj_stats[:processed] +<< 1

		_local output_dir << system.getenv("TEMP").default("C:\\temp")
		_local xml_result << astri_download_feeder_kmz(kmz_uuid.write_string, output_dir)

		_if xml_result _is _unset _orif xml_result = ""
		_then
			rec.feeder_status << "ERROR"
			obj_stats[:errors] +<< 1
			_return _false
		_endif

		_local xml_doc << simple_xml.read_element_string(xml_result)
		_local kml_file_path_elem << xml_doc.element_matching_name(:kml_file_path)

		_if kml_file_path_elem _isnt _unset
		_then
			_local kml_file_path << kml_file_path_elem.xml_result
			_local parser << astri_kml_parser.new(kml_file_path)
			_local (placemarks, topology) << parser.parse()

			_local wo << property_list.new_with(:wo_number, feeder_code, :infra_code, feeder_code, :infrastructure_type, "feeder", :kmz_uuid, kmz_uuid)

			_self.migrate_to_sw_alternative(wo, placemarks, "feeder", topology)

			rec.feeder_status << "MIGRATED"
			_return _true
		_else
			rec.feeder_status << "ERROR"
			obj_stats[:errors] +<< 1
			_return _false
		_endif

	_when error
		write("ERROR: ", cond.report_contents_string)
		rec.feeder_status << "ERROR"
		obj_stats[:errors] +<< 1
		_return _false
	_endtry
_endmethod
$

_pragma(classify_level=restricted)
_method astri_data_migrator.migrate_subfeeder_objects()
	## Migrate SUBFEEDER KML objects to Smallworld
	## Status: NULL -> PROCESS -> MIGRATED/ERROR

	_local start_time << date_time.now()
	write("=== SUBFEEDER OBJECT Migration Started ===")

	_local obj_stats << property_list.new_with(:total, 0, :processed, 0, :migrated, 0, :skipped, 0, :errors, 0)

	_try _with cond
		_local master_coll << .database.collections[:master_subfeeder]
		_if master_coll _is _unset
		_then
			write("ERROR: master_subfeeder collection not found")
			_return obj_stats
		_endif

		_for rec _over master_coll.fast_elements()
		_loop
			_local subfeeder_code << rec.subfeeder_code
			_local kmz_uuid << rec.abd_kmz_uuid
			_local current_status << rec.subfeeder_status.default("").write_string

			_if subfeeder_code _is _unset _orif subfeeder_code = "" _orif kmz_uuid _is _unset _orif kmz_uuid = ""
			_then _continue
			_endif

			obj_stats[:total] +<< 1
			write("")
			write("Processing SUBFEEDER: ", subfeeder_code, " - Status: ", current_status)

			_if current_status = "MIGRATED"
			_then
				obj_stats[:skipped] +<< 1
				_continue
			_endif

			_if _self.process_subfeeder_kml_migration(rec, obj_stats)
			_then obj_stats[:migrated] +<< 1
			_endif
		_endloop

		write("=== SUBFEEDER OBJECT Migration Complete ===")
	_when error
		write("ERROR: ", cond.report_contents_string)
	_endtry

	>> obj_stats
_endmethod
$

