_pragma(classify_level=restricted)
_private _method astri_data_migrator.migrate_to_sw_alternative(wo, placemarks, infra_type, _optional kml_topology)
	_local database << gis_program_manager.databases[:gis]
	_local gv << gis_program_manager.cached_dataset(:gis)
	_local alt_name << "|Engineering Design|migration"
	write("migrate_to_sw_alternative")
	gv.go_to_alternative(alt_name)
	gv.switch(:write)

	_local migrator << astri_design_migrator.new(database, wo, "In Service")

	# Resolve topology: prefer wo[:topology] DB field, fallback to KML-detected topology
	_local final_topology << kml_topology
	_local topology_str << wo[:topology].default("")
	_if topology_str _isnt _unset _andif topology_str <> ""
	_then
		_if topology_str = "AE"
		_then
			final_topology << :aerial
		_elif topology_str = "UG"
		_then
			final_topology << :underground
		_elif topology_str = "AE&UG"
		_then
			final_topology << :both
		_endif
	_endif
	_if final_topology _isnt _unset
	_then
		migrator.topology << final_topology
	_endif
	write("  Topology: ", final_topology.default(:unset), " (wo[:topology]: ", topology_str.default("unset"), ", KML detected: ", kml_topology.default(:unset), ")")

	_local stats << migrator.migrate_placemarks(placemarks)

	write("  [MIGRATED] Routes: ", stats[:aerial_routes], ", Poles: ", stats[:new_poles], ", Cable: ", stats[:sheath_length].rounded, "m")
_endmethod
$

## zzzzzzzzzzzzzzzzzzzzzzzzzzzeeeeeee4============================================================
## SCHEDULED MIGRATION — drm_scheduler_logs → SW Design
## Pattern mirrors migrate_<infra_type>_objects / process_<infra_type>_kml_migration
## ============================================================

_pragma(classify_level=basic, topic={astri_integration})
_method astri_data_migrator.migrate_scheduled_objects()
	## Run scheduled migrations for all infra types (cluster, subfeeder, feeder).
	## Reads from smallworld.drm_scheduler_logs WHERE status='scheduled'.
	## Status lifecycle: scheduled -> processing -> migrated / failed
	##
	## CLI usage:
	##   migrator << astri_data_migrator.new(gis_program_manager.databases[:gis])
	##   migrator.migrate_scheduled_objects()

	_local start_time << date_time.now()
	write("=================================================================")
	write("=== SCHEDULED MIGRATION - ALL INFRA TYPES ===")
	write("=================================================================")
	write("")
	write("Start time: ", start_time.write_string)
	write("")

	_local overall_stats << property_list.new_with(
		:cluster_total, 0,   :cluster_migrated, 0,   :cluster_errors, 0,
		:subfeeder_total, 0, :subfeeder_migrated, 0, :subfeeder_errors, 0,
		:feeder_total, 0,    :feeder_migrated, 0,    :feeder_errors, 0)

	# Phase 1: FEEDER
	_try
		write("PHASE 1/3: Starting FEEDER scheduled migration...")
		write("")
		_local s << _self.migrate_feeder_scheduled_objects()
		overall_stats[:feeder_total]    << s[:total]
		overall_stats[:feeder_migrated] << s[:migrated]
		overall_stats[:feeder_errors]   << s[:errors]
		write("PHASE 1/3: FEEDER completed")
		write("")
	_when error
		write("ERROR in PHASE 1/3 (FEEDER): ", condition.report_contents_string)
		write("Continuing with next phase...")
		write("")
	_endtry

	# Phase 2: SUBFEEDER
	_try
		write("PHASE 2/3: Starting SUBFEEDER scheduled migration...")
		write("")
		_local s << _self.migrate_subfeeder_scheduled_objects()
		overall_stats[:subfeeder_total]    << s[:total]
		overall_stats[:subfeeder_migrated] << s[:migrated]
		overall_stats[:subfeeder_errors]   << s[:errors]
		write("PHASE 2/3: SUBFEEDER completed")
		write("")
	_when error
		write("ERROR in PHASE 2/3 (SUBFEEDER): ", condition.report_contents_string)
		write("Continuing with next phase...")
		write("")
	_endtry

	# Phase 3: CLUSTER
	_try
		write("PHASE 3/3: Starting CLUSTER scheduled migration...")
		write("")
		_local s << _self.migrate_cluster_scheduled_objects()
		overall_stats[:cluster_total]    << s[:total]
		overall_stats[:cluster_migrated] << s[:migrated]
		overall_stats[:cluster_errors]   << s[:errors]
		write("PHASE 3/3: CLUSTER completed")
		write("")
	_when error
		write("ERROR in PHASE 3/3 (CLUSTER): ", condition.report_contents_string)
		write("")
	_endtry

	_local end_time << date_time.now()
	_local duration << (end_time - start_time)

	write("=================================================================")
	write("=== SCHEDULED MIGRATION SUMMARY ===")
	write("=================================================================")
	write("")
	write("CLUSTER:")
	write("  Total:    ", overall_stats[:cluster_total])
	write("  Migrated: ", overall_stats[:cluster_migrated])
	write("  Errors:   ", overall_stats[:cluster_errors])
	write("")
	write("SUBFEEDER:")
	write("  Total:    ", overall_stats[:subfeeder_total])
	write("  Migrated: ", overall_stats[:subfeeder_migrated])
	write("  Errors:   ", overall_stats[:subfeeder_errors])
	write("")
	write("FEEDER:")
	write("  Total:    ", overall_stats[:feeder_total])
	write("  Migrated: ", overall_stats[:feeder_migrated])
	write("  Errors:   ", overall_stats[:feeder_errors])
	write("")
	write("GRAND TOTAL:")
	write("  Total:    ", overall_stats[:cluster_total] + overall_stats[:subfeeder_total] + overall_stats[:feeder_total])
	write("  Migrated: ", overall_stats[:cluster_migrated] + overall_stats[:subfeeder_migrated] + overall_stats[:feeder_migrated])
	write("  Errors:   ", overall_stats[:cluster_errors] + overall_stats[:subfeeder_errors] + overall_stats[:feeder_errors])
	write("")
	write("Duration: ", duration.write_string)
	write("=================================================================")

	>> overall_stats
_endmethod
$

_pragma(classify_level=restricted)
_method astri_data_migrator.migrate_cluster_scheduled_objects()
	## Migrate CLUSTER scheduled records from drm_scheduler_logs to SW Design.
	## Status: scheduled -> processing -> migrated/failed

	_local start_time << date_time.now()
	write("=== CLUSTER SCHEDULED Migration Started ===")

	_local obj_stats << property_list.new_with(:total, 0, :processed, 0, :migrated, 0, :skipped, 0, :errors, 0)

	_try _with cond
		_local scheduled << _self.get_scheduled_records("cluster")

		_if scheduled.empty?
		_then
			write("No scheduled CLUSTER records found.")
			>> obj_stats
		_endif

		_for rec _over scheduled.fast_elements()
		_loop
			_local infra_code << rec[:infra_code].default("")
			write("")
			write("Processing CLUSTER: ", infra_code)
			obj_stats[:total] +<< 1

			_if _self.process_cluster_scheduled_migration(rec, obj_stats)
			_then
				obj_stats[:migrated] +<< 1
			_endif
		_endloop

		write("=== CLUSTER SCHEDULED Migration Complete ===")
	_when error
		write("ERROR: ", cond.report_contents_string)
	_endtry

	write("Duration: ", (date_time.now() - start_time).write_string)
	>> obj_stats
_endmethod
$

_pragma(classify_level=restricted)
_private _method astri_data_migrator.process_cluster_scheduled_migration(rec, obj_stats)
	_local infra_code   << rec[:infra_code].default("")
	_local topology_str << rec[:topology].default("")
	_local kmz_uuid     << rec[:uuid].default("")

	_if kmz_uuid _is _unset _orif kmz_uuid = ""
	_then
		write("  ERROR: No uuid for: ", infra_code)
		_self.update_scheduled_status(infra_code, "cluster", "failed")
		obj_stats[:errors] +<< 1
		_return _false
	_endif

	_try _with cond
		_self.update_scheduled_status(infra_code, "cluster", "processing")
		obj_stats[:processed] +<< 1

		_local output_dir << system.getenv("TEMP").default("C:\\temp")
		_local xml_result << astri_download_cluster_kmz(kmz_uuid, output_dir)

		_if xml_result _is _unset _orif xml_result = ""
		_then
			_self.update_scheduled_status(infra_code, "cluster", "failed")
			obj_stats[:errors] +<< 1
			_return _false
		_endif

		_local xml_doc      << simple_xml.read_element_string(xml_result)
		_local kml_path_elem << xml_doc.element_matching_name(:kml_file_path)

		_if kml_path_elem _isnt _unset
		_then
			_local kml_file_path << kml_path_elem.xml_result
			_local parser        << astri_kml_parser.new(kml_file_path)
			_local (placemarks, topology) << parser.parse()

			_local wo << property_list.new_with(
				:wo_number,           infra_code,
				:infra_code,          infra_code,
				:infra_name,          rec[:name].default(infra_code),
				:topology,            topology_str,
				:kmz_uuid,            kmz_uuid,
				:infrastructure_type, "cluster",
				:olt_label,           "",
				:olt_name,            "",
				:area,                "",
				:area_plant_code,     "")

			_self.migrate_to_sw_design(wo, placemarks, "cluster", topology)
			_self.update_scheduled_status(infra_code, "cluster", "migrated")
			_return _true
		_else
			_self.update_scheduled_status(infra_code, "cluster", "failed")
			obj_stats[:errors] +<< 1
			_return _false
		_endif

	_when error
		write("  ERROR: ", cond.report_contents_string)
		_self.update_scheduled_status(infra_code, "cluster", "failed")
		obj_stats[:errors] +<< 1
		_return _false
	_endtry
_endmethod
$

