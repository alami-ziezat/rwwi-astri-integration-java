#% text_encoding = iso8859_1

_package user
$

## ASTRI Design Migrator - Sheath Splice Migration
## Contains methods for creating sheath splices (closures) from KMZ placemarks
## Three variants:
##   create_sheath_splice            - dispatcher, routes to aerial or underground
##   create_sheath_splice_aerial     - attaches to pole (aerial topology)
##   create_sheath_splice_underground - attaches to UUB/handhole (underground topology)

_pragma(classify_level=basic, topic={astri_integration})
_private _method astri_design_migrator.create_sheath_splice(pm)
	## Dispatcher: create sheath splice for aerial or underground topology
	## Delegates to create_sheath_splice_aerial or create_sheath_splice_underground
	## based on .topology slot
	##
	## Parameters:
	##   pm - Placemark property_list from KML parser

	_local topology << .topology.default(:aerial)

	_if topology = :underground
	_then
		_return _self.create_sheath_splice_underground(pm)
	#_elif topology = :both
	#_then
		# For mixed topology create both
	#	_self.create_sheath_splice_aerial(pm)
	#	_return _self.create_sheath_splice_underground(pm)
	_else
		_return _self.create_sheath_splice_aerial(pm)
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_private _method astri_design_migrator.create_sheath_splice_aerial(pm)
	## Create sheath splice (closure) for aerial topology:
	## - Multi-type detection (Join Closure, FDT, FAT)
	## - Core count detection with spec mapping
	## - Pole association (search within 250cm or create placeholder)
	## - Optical splitter creation for FDT and FAT
	## - Figure eight creation for FAT, associated to pole

	_dynamic !current_world! << .database.collections[:sw_gis!world].at(0,0)
	_dynamic !current_coordinate_system! << .database.collections[:sw_gis!world].at(0,0).coordinate_system
	_try _with errCon
		# Step 0: Validate sheath splice
		_local folders << pm[:parent].default("")

		# Step 1: Extract segment_id from folders
		_local segment_id << _self.match_segment(folders)

		# Step 2: Determine closure type
		_local closure_type << _self.match_closure_type(folders, pm[:infrastructure_type].default("cluster"))
		_if closure_type = "FDT"
		_then 
			write("  Processing ", closure_type, " (aerial): ", pm[:name])
		_endif 

		# Step 3: Detect core count and map to spec/STF
		_local core_count << _unset
		_local sp << _unset
		_local st_cd << _unset
		_local c_spl << 0
		_local ot << closure_type

		_if closure_type = "Join Closure"
		_then
			core_count << _self.match_core(pm[:name])
			_if core_count = "24"
			_then
				sp << "Join Closure In-line 24 Core"
				st_cd << "200000180"
			_elif core_count = "36"
			_then
				sp << "Join Closure In-line 36 Core"
				st_cd << "200001049"
			_elif core_count = "48"
			_then
				sp << "Join Closure In-line 48 Core"
				st_cd << "200000164"
			_elif core_count = "72"
			_then
				sp << "Join Closure In-line 72 Core"
				st_cd << "200000159"
			_elif core_count = "96"
			_then
				sp << "Join Closure In-line 96 Core"
				st_cd << "200000176"
			_elif core_count = "144"
			_then
				sp << "Join Closure In-line 144 Core"
				st_cd << "200000158"
			_elif core_count = "288"
			_then
				sp << "Join Closure In-line 288 Core"
				st_cd << "200000156"
			_else
				sp << "Join Closure In-line 48 Core"
				st_cd << "200000164"
			_endif
			c_spl << 0

		_elif closure_type = "FDT"
		_then
			_local core_spec << pm[:name]
			_if pm[:desc] _isnt _unset _andif pm[:desc] <> ""
			_then
				core_spec << pm[:desc]
			_endif
			core_count << _self.match_core(core_spec)

			_if core_count = "48"
			_then
				sp << "48 Core pole mounted FDT"
				st_cd << "200001039"
				c_spl << 6
			_elif core_count = "72"
			_then
				sp << "72 Core pole mounted FDT"
				st_cd << "200001040"
				c_spl << 9
			_elif core_count = "96"
			_then
				sp << "96 Core pole mounted FDT"
				st_cd << "200001041"
				c_spl << 12
			_elif core_count = "144"
			_then
				sp << "144 Core Ground mounted FDT"
				st_cd << "200001042"
				c_spl << 18
			_elif core_count = "288"
			_then
				sp << "288 Core Ground mounted FDT"
				st_cd << "200001043"
				c_spl << 36
			_elif core_count = "576"
			_then
				sp << "576 Core Ground mounted FDT"
				st_cd << "200001044"
				c_spl << 72
			_else
				sp << "48 Core pole mounted FDT"
				st_cd << "200001039"
				c_spl << 6
			_endif

		_elif closure_type = "FAT"
		_then
			sp << "Pole mounted outdoor(16 ports)"
			st_cd << "200001047"
			c_spl << 2
		_endif

		# Step 4: Parse original location and scan for pole
		_local original_location << _self.parse_point_geometry(pm[:coord])
		_local l_location_start << original_location
		#write("    >> Searching for pole within 250cm...")
		_local (k1, pt) << _self.scan_pole_st(l_location_start, 250)
		_local sh_loc << _unset
		_local l_result_pl << _unset

		_if k1 _is _true
		_then
			sh_loc << pt.location.coord
			l_result_pl << pt
			_if closure_type = "FDT"
			_then 
				write("    >> Found existing pole within 250cm")
			_endif 
		_else
			# No pole found - create placeholder
			_if closure_type = "FDT"
			_then 
				write("    >> Creating placeholder pole")
			_endif 
			
			_local (tf, r_pipe, snap_loc) << _self.scan_ar_on_design(original_location)
			_if tf _is _true
			_then
				l_location_start << snap_loc
				(pole_found?, pole_rec) << _self.scan_pole_st(l_location_start, 250)
				_if closure_type = "FDT"
				_then 
					write("    >> Pole snapped to aerial route")
				_endif 
			_endif

			_if pole_found? _is _true
			_then
				sh_loc << pole_rec.location.coord
				l_result_pl << pole_rec
				write("  >> Found pole after snapping to aerial route")
			_else 
			
			_local m_line << _self.match_line(folders)
			_local l_prop_values_pl << property_list.new_with(
				:location, l_location_start,
				:telco_pole_tag, "Pole - " + pm[:name],
				:usage, "Telco",
				:material_type, "Steel",
				:extension_arm, _false,
				:power_riser, _false,
				:telco_riser, _false,
				:bond, _false,
				:ground_status, _false,
				:type, "T7",
				:folders, folders,
				:fttx_network_type, _self.get_fttx_network_type(),
				:line_type, m_line,
				:region, .region,
				:cluster, .cluster,
				:pop, .pop_name,
				:olt, .pop_name,
				:segment, segment_id,
				:uuid, .uuid,
				:construction_status, "In Service",
				:cluster_code, .cluster_code_db,
				:subfeeder_code, .subfeeder_code_db,
				:feeder_code, .feeder_code_db,
				:olt_code, .olt_code
			)
			_local l_rec_trans_pl << record_transaction.new_insert(.pole_col, l_prop_values_pl)
			l_result_pl << l_rec_trans_pl.run()
			sh_loc << l_result_pl.location.coord
			_endif
		_endif

		# Step 5: Get line_type, ring_name, const_status
		_local line_type << _self.match_line(folders)
		_local ring_name << pm[:ring_name]
		_local infra_type_cap << _if .infra_type = "cluster"
		                         _then >> "Cluster"
		                         _elif .infra_type = "subfeeder"
		                         _then >> "SubFeeder"
		                         _elif .infra_type = "feeder"
		                         _then >> "Feeder"
		                         _else >> ""
		                         _endif
		_local splice_name_lc << pm[:name].lowercase
		_local const_status <<
			_if .construction_status = "In Service"
			_then
				>> "In Service"
			_elif splice_name_lc.matches?("new*")
			_then
				>> "Proposed"
			_elif splice_name_lc.matches?("ex*")
			_then
				>> "In Service"
			_else
				>> "Proposed"
			_endif

		# Step 6: Create sheath splice
		#write("    >> Creating sheath splice")
		_local l_prop_values << property_list.new_with(
			:location, sh_loc,
			:asset_owner, "Owned",
			:splice_type, "breaking",
			:splice_method, "Fusion",
			:spec_id, sp,
			:folders, folders,
			:sheath_splice_object_type, ot,
			:fttx_network_type, _self.get_fttx_network_type(),
			:line_type, line_type,
			:ring_name, ring_name,
			:name, pm[:name],
			:segment, segment_id,
			:region, .region,
			:cluster, .cluster,
			:pop, .pop_name,
			:olt, .pop_name,
			:stf_item_code, st_cd,
			:uuid, .uuid,
			:construction_status, const_status,
			:cluster_code, .cluster_code_db,
			:subfeeder_code, .subfeeder_code_db,
			:feeder_code, .feeder_code_db,
			:olt_code, .olt_code,
			:infra_type, infra_type_cap
		)

		_local l_rec_trans << record_transaction.new_insert(.sc_col, l_prop_values)
		_local l_result << l_rec_trans.run()

		_if closure_type = "FDT"
		_then
			.stats[:fdts] +<< 1
			.stats[:sheath_splices] +<< 1
		_elif closure_type = "FAT"
		_then
			.stats[:fats] +<< 1
			.stats[:sheath_splices] +<< 1
		_elif closure_type.index_of_seq("Joint") _isnt _unset _orif
		      closure_type.index_of_seq("Closure") _isnt _unset
		_then
			.stats[:joint_closures] +<< 1 
		_endif
		#write("    [OK] Sheath splice created: ", pm[:name], " (Type: ", closure_type, ", Core: ", core_count.default("N/A"), ")")

		# Step 7: Associate to pole
		_try
			_if l_result_pl _isnt _unset
			_then
				_if l_result_pl.external_name = "Pole"
				_then
					l_result.associate_to_structure(l_result_pl)
					#write("    >> Associated to pole: ", l_result_pl.telco_pole_tag)
				_endif
			_endif
		_when error
			# Continue if association fails
		_endtry

		# Step 8: Connect to cable if available
		_try
			_local l_swl << l_result_pl.cables().an_element()
			_if l_swl _isnt _unset
			_then
				l_result.add_loop_cable(l_swl)
				#write("    >> Connected to cable: ", l_swl.name)
			_endif
		_when error
			# Continue if connection fails
		_endtry

		# Step 9: Create optical splitters (FDT and FAT only)
		_if c_spl > 0
		_then
			_local splitter_spec << _unset
			_if closure_type = "FDT"
			_then
				splitter_spec << "STF Splitter 1:8"
			_elif closure_type = "FAT"
			_then
				splitter_spec << "Splitter 1:8"
			_endif

			_try _with errCon
				_for i _over range(1, c_spl)
				_loop
					_local splitter_name << pm[:name] + "-SP." + i.write_string
					_local vals << property_list.new_with(
						:construction_status, .construction_status,
						:asset_owner, "Owned",
						:name, splitter_name,
						:function, "Splitter",
						:spec_id, splitter_spec,
						:stf_splitter_type, closure_type,
						:stf_item_code, "200001047",
						:sheath_splice, l_result
					)
					_local l_rec_trans_s << record_transaction.new_insert(.os_col, vals)
					_local l_result_s << l_rec_trans_s.run()
					.stats[:optical_splitters] +<< 1
				_endloop
				#write("    [OK] Created ", c_spl, " optical splitters")
			_when error
				write("    WARNING: Error creating optical splitters: ", errCon.report_contents_string)
			_endtry
		_endif

		# Step 10: Create figure_eight for FAT, associated to pole
		_if closure_type = "FAT" _orif closure_type = "FDT"  # Note: original requirement was FAT only, but FDT can also have figure eights in some cases
		_then
			_try _with errCon
				#write("    >> Creating figure_eight for FAT")
				_local l_prop_values_fe << property_list.new_with(
					:construction_status, .construction_status,
					:type, "Circle",
					:length, 20000,
					:name, pm[:name] + " Slack",
					:folders, folders,
					:fttx_network_type, _self.get_fttx_network_type(),
					:segment, segment_id,
					:stf_item_code, "200000185",
					:pop, .pop_name,
					:olt, .pop_name,
					:uuid, .uuid,
					:cluster_code, .cluster_code_db,
					:subfeeder_code, .subfeeder_code_db,
					:feeder_code, .feeder_code_db,
					:olt_code, .olt_code
				)
				_local l_rec_trans_fe << record_transaction.new_insert(.fe_col, l_prop_values_fe)
				_local l_result_fe << l_rec_trans_fe.run()
				.stats[:figure_eights] +<< 1
				#write("    [OK] Figure eight created for FAT: ", pm[:name] + " Slack")

				_try
					_if l_result_pl _isnt _unset
					_then
						l_result_fe.associate_to_structure(l_result_pl)
						#write("    >> Figure eight associated to pole")
					_endif
				_when error
				_endtry

				_try
					_local l_swl_fe << l_result_pl.cable_records.an_element()
					_if l_swl_fe _isnt _unset
					_then
						l_swl_fe.mcn!connect(l_result_fe)
						#write("    >> Figure eight connected to cable: ", l_swl_fe.name)
					_endif
				_when error
				_endtry

			_when error
				write("    WARNING: Error creating figure_eight for FAT: ", errCon.report_contents_string)
			_endtry
		_endif

		>> l_result

	_when error
		write("ERROR in create_sheath_splice_aerial():", errCon.report_contents_string)
		write("  Placemark name:", pm[:name].default("(unnamed)"))
		write("  Folders:", pm[:parent].default("(none)"))
		write("  Coordinates:", pm[:coord].default("(none)"))
		write("  Closure type:", _self.match_closure_type(pm[:parent].default(""), pm[:infrastructure_type].default("cluster")).default("(unknown)"))
		.stats[:errors] +<< 1
	_endtry
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_private _method astri_design_migrator.create_sheath_splice_underground(pm)
	## Create sheath splice (closure) for underground topology:
	## - Multi-type detection (Join Closure, FDT, FAT) - same spec mapping as aerial
	## - UUB/handhole association (search within 1500cm, prefer connected UUBs)
	## - Splice located at UUB position (ref: fttx_ur_closure_migration)
	## - Placeholder UUB creation when none found nearby
	## - Optical splitter creation for FDT and FAT
	## - Figure eight for FAT associated to UUB (not pole)
	##
	## Parameters:
	##   pm - Placemark property_list from KML parser
	_dynamic !current_world! << .database.collections[:sw_gis!world].at(0,0)
	_dynamic !current_coordinate_system! << .database.collections[:sw_gis!world].at(0,0).coordinate_system
	_try _with errCon
		# Step 0: Validate sheath splice
		_local folders << pm[:parent].default("")

		# Step 1: Extract segment_id from folders
		_local segment_id << _self.match_segment(folders)

		# Step 2: Determine closure type
		_local closure_type << _self.match_closure_type(folders, pm[:infrastructure_type].default("cluster"))
		#write("  Processing ", closure_type, " (underground): ", pm[:name])

		# Step 3: Detect core count and map to spec/STF (same as aerial)
		_local core_count << _unset
		_local sp << _unset
		_local st_cd << _unset
		_local c_spl << 0
		_local ot << closure_type

		_if closure_type = "Join Closure"
		_then
			core_count << _self.match_core(pm[:name])
			_if core_count = "24"
			_then
				sp << "Join Closure Dome 24 Core"
				st_cd << "200000180"
			_elif core_count = "36"
			_then
				sp << "Join Closure Dome 36 Core"
				st_cd << "200001049"
			_elif core_count = "48"
			_then
				sp << "Join Closure Dome 48 Core"
				st_cd << "200000164"
			_elif core_count = "72"
			_then
				sp << "Join Closure Dome 72 Core"
				st_cd << "200000159"
			_elif core_count = "96"
			_then
				sp << "Join Closure Dome 96 Core"
				st_cd << "200000176"
			_elif core_count = "144"
			_then
				sp << "Join Closure Dome 144 Core"
				st_cd << "200000158"
			_elif core_count = "288"
			_then
				sp << "Join Closure Dome 288 Core"
				st_cd << "200000156"
			_else
				sp << "Join Closure Dome 48 Core"
				st_cd << "200000164"
			_endif
			c_spl << 0

		_elif closure_type = "FDT"
		_then
			_local core_spec << pm[:name]
			_if pm[:desc] _isnt _unset _andif pm[:desc] <> ""
			_then
				core_spec << pm[:desc]
			_endif
			core_count << _self.match_core(core_spec)

			_if core_count = "48"
			_then
				sp << "48 Core pole mounted FDT"
				st_cd << "200001039"
				c_spl << 6
			_elif core_count = "72"
			_then
				sp << "72 Core pole mounted FDT"
				st_cd << "200001040"
				c_spl << 9
			_elif core_count = "96"
			_then
				sp << "96 Core pole mounted FDT"
				st_cd << "200001041"
				c_spl << 12
			_elif core_count = "144"
			_then
				sp << "144 Core Ground mounted FDT"
				st_cd << "200001042"
				c_spl << 18
			_elif core_count = "288"
			_then
				sp << "288 Core Ground mounted FDT"
				st_cd << "200001043"
				c_spl << 36
			_elif core_count = "576"
			_then
				sp << "576 Core Ground mounted FDT"
				st_cd << "200001044"
				c_spl << 72
			_else
				sp << "48 Core pole mounted FDT"
				st_cd << "200001039"
				c_spl << 6
			_endif

		_elif closure_type = "FAT"
		_then
			sp << "Pedestal mounted (16 ports)"
			st_cd << "100000824"
			c_spl << 2
		_endif

		# Step 4: Parse location
		_local original_location << _self.parse_point_geometry(pm[:coord])
		_local coord << original_location.coord

		_local pp << pseudo_point.new(coord)
		pp.world << .database.world

		# Step 5: Scan for UUB within 200cm (prefer connected UUBs)
		# Ref: fttx_ur_closure_migration uses scan_uub_fttx(c, 1500)
		_local l_result_uub << _unset
		_local found << _false

		_local buff << pp.buffer(200)  # 2m radius in cm
		buff.world << .database.world
		_local pred << predicate.interacts(:location, {buff})
		_local uubs << .uub_col.select(pred)

		_if uubs.size > 0
		_then
			found << _true
			# Prefer UUB with existing connected routes (ref: scan_uub_fttx pattern)
			_for uu _over uubs.fast_elements()
			_loop
				_if uu.connected_routes().size > 0
				_then
					l_result_uub << uu
					_leave
				_endif
			_endloop
			# Fall back to any nearby UUB
			_if l_result_uub _is _unset
			_then
				l_result_uub << uubs.an_element()
			_endif
			#write("    >> Found existing UUB within 200cm: ", l_result_uub.label)
		_else
			# No UUB found - create placeholder handhole
			#write("    >> Creating placeholder UUB for closure")
			_local m_line << _self.match_line(folders)
			_local uub_props << property_list.new_with(
				:type, "Handhole",
				:label, "HH-" + pm[:name],
				:spec_id, "HH Concrete FDT : 80x80x130 cm",
				:construction_status, "In Service",
				:asset_owner, "Owned",
				:location, coord,
				:folders, folders,
				:pop, .pop_name,
				:olt, .pop_name,
				:fttx_network_type, _self.get_fttx_network_type(),
				:line_type, m_line,
				:segment, segment_id,
				:uuid, .uuid,
				:cluster_code, .cluster_code_db,
				:subfeeder_code, .subfeeder_code_db,
				:feeder_code, .feeder_code_db,
				:olt_code, .olt_code,
				:depth, 1.3,
				:width, 0.8
			)
			_local uub_trans << record_transaction.new_insert(.uub_col, uub_props)
			l_result_uub << uub_trans.run()

			_if .stats[:uubs] _is _unset _then .stats[:uubs] << 0 _endif
			.stats[:uubs] +<< 1
			#write("    >> Placeholder UUB created")
		_endif

		# Splice is placed at UUB location (ref: fttx_ur_closure_migration)
		_local sh_loc << l_result_uub.location.coord

		# Step 6: Get line_type, ring_name, const_status
		_local line_type << _self.match_line(folders)
		_local ring_name << pm[:ring_name]
		_local infra_type_cap << _if .infra_type = "cluster"
		                         _then >> "Cluster"
		                         _elif .infra_type = "subfeeder"
		                         _then >> "SubFeeder"
		                         _elif .infra_type = "feeder"
		                         _then >> "Feeder"
		                         _else >> ""
		                         _endif
		_local splice_name_lc << pm[:name].lowercase
		_local const_status <<
			_if .construction_status = "In Service"
			_then
				>> "In Service"
			_elif splice_name_lc.matches?("new*")
			_then
				>> "Proposed"
			_elif splice_name_lc.matches?("ex*")
			_then
				>> "In Service"
			_else
				>> "Proposed"
			_endif

		# Step 7: Create sheath splice at UUB location
		#write("    >> Creating sheath splice at UUB location")
		_local noted << "UUB Name : " + l_result_uub.label.default("") +
		                "  UUB ID : " + l_result_uub.id.write_string

		_local l_prop_values << property_list.new_with(
			:location, sh_loc,
			:asset_owner, "Owned",
			:splice_type, "breaking",
			:splice_method, "Fusion",
			:spec_id, sp,
			:folders, folders,
			:sheath_splice_object_type, ot,
			:fttx_network_type, _self.get_fttx_network_type(),
			:line_type, line_type,
			:ring_name, ring_name,
			:name, pm[:name],
			:segment, segment_id,
			:region, .region,
			:cluster, .cluster,
			:pop, .pop_name,
			:olt, .pop_name,
			:stf_item_code, st_cd,
			:uuid, .uuid,
			:construction_status, const_status,
			:cluster_code, .cluster_code_db,
			:subfeeder_code, .subfeeder_code_db,
			:feeder_code, .feeder_code_db,
			:olt_code, .olt_code,
			:infra_type, infra_type_cap
		)

		_local l_rec_trans << record_transaction.new_insert(.sc_col, l_prop_values)
		_local l_result << l_rec_trans.run()

		_if closure_type = "FDT"
		_then
			.stats[:fdts] +<< 1
			.stats[:sheath_splices] +<< 1
		_elif closure_type = "FAT"
		_then
			.stats[:fats] +<< 1
			.stats[:sheath_splices] +<< 1
		_elif closure_type.index_of_seq("Joint") _isnt _unset _orif
		      closure_type.index_of_seq("Closure") _isnt _unset
		_then
			.stats[:joint_closures] +<< 1
		_endif
		#write("    [OK] Sheath splice created: ", pm[:name], " (Type: ", closure_type, ", Core: ", core_count.default("N/A"), ")")

		# Step 8: Associate to UUB (ref: fttx_ur_closure_migration: associate_to_structure)
		_try
			l_result.associate_to_structure(l_result_uub)
			#write("    >> Associated to UUB: ", l_result_uub.label)
		_when error
			# Continue if association fails
		_endtry

		# Step 9: Connect to cable via UUB cables if available
		_try
			_local l_swl << l_result_uub.cables().an_element()
			_if l_swl _isnt _unset
			_then
				l_result.add_loop_cable(l_swl)
				#write("    >> Connected to cable: ", l_swl.name)
			_endif
		_when error
			# Continue if connection fails
		_endtry

		# Step 10: Create optical splitters (FDT and FAT only)
		_if c_spl > 0
		_then
			_local splitter_spec << _unset
			_if closure_type = "FDT"
			_then
				splitter_spec << "STF Splitter 1:8"
			_elif closure_type = "FAT"
			_then
				splitter_spec << "Splitter 1:8"
			_endif

			_try _with errCon
				_for i _over range(1, c_spl)
				_loop
					_local splitter_name << pm[:name] + "-SP." + i.write_string
					_local vals << property_list.new_with(
						:construction_status, .construction_status,
						:asset_owner, "Owned",
						:name, splitter_name,
						:function, "Splitter",
						:spec_id, splitter_spec,
						:stf_splitter_type, closure_type,
						:stf_item_code, "200001047",
						:sheath_splice, l_result
					)
					_local l_rec_trans_s << record_transaction.new_insert(.os_col, vals)
					_local l_result_s << l_rec_trans_s.run()
					.stats[:optical_splitters] +<< 1
				_endloop
				#write("    [OK] Created ", c_spl, " optical splitters")
			_when error
				write("    WARNING: Error creating optical splitters: ", errCon.report_contents_string)
			_endtry
		_endif

		>> l_result

	_when error
		write("ERROR in create_sheath_splice_underground():", errCon.report_contents_string)
		write("  Placemark name:", pm[:name].default("(unnamed)"))
		write("  Folders:", pm[:parent].default("(none)"))
		write("  Coordinates:", pm[:coord].default("(none)"))
		write("  Closure type:", _self.match_closure_type(pm[:parent].default(""), pm[:infrastructure_type].default("cluster")).default("(unknown)"))
		.stats[:errors] +<< 1
	_endtry
_endmethod
$
