#% text_encoding = iso8859_1

_package user
$

## ASTRI Design Migrator - T-Wey (Point of Interest) Migration
## Creates point_of_interest records from KMZ placemarks detected as t_wey:
##   - Icon filename contains "placemark_square" AND name/parent contains "t-wey"
##
## Location snapping:
##   - Searches for nearest underground_route within 500cm (5m) radius
##   - If found: snaps to the nearest point on that route (segpoint_near)
##   - If not found: uses original KML coordinate with a warning
##
## point_of_interest fields:
##   label             - Placemark name
##   location          - Snapped point geometry (on underground route if possible)
##   topview_boundary  - Not set (no polygon in KML point placemarks)
##   notes             - Join field - not settable via record_transaction
##   folders           - Parent folder path
##   ring_name         - Ring name from placemark
##   pop               - POP/OLT name
##   olt               - OLT name
##   region            - Region
##   cluster           - Cluster
##   line_type         - Matched line type from folders/name
##   segment           - Matched segment from folders
##   fttx_network_type - FTTX network type
##   construction_status - Construction status
##   uuid              - UUID
##   olt_code          - OLT code
##   feeder_code       - Feeder code
##   subfeeder_code    - Subfeeder code
##   cluster_code      - Cluster code
##   infra_type        - Infrastructure type
##   fdt_name          - FDT name (ring name)

_pragma(classify_level=basic, topic={astri_integration})
_private _method astri_design_migrator.create_t_wey(pm)
	## Create point_of_interest record from t_wey placemark.
	## Location is snapped to the nearest underground route when one exists
	## within a 500cm (5m) search radius.
	##
	## Parameters:
	##   pm - Placemark property_list from KML parser

	_dynamic !current_world! << .database.collections[:sw_gis!world].at(0,0)
	_dynamic !current_coordinate_system! << .database.collections[:sw_gis!world].at(0,0).coordinate_system
	write("  Processing T-Wey: ", pm[:name])
	_try _with errCon
		# Step 1: Extract folder and matching info
		_local folders   << _self.truncate_folders(pm[:parent].default(""), 250)
		_local m_line    << _self.match_line(folders)
		_if m_line _is _unset
		_then
			m_line << _self.match_line(pm[:name])
		_endif
		_local segment   << _self.match_segment(folders)
		_local ring_name << pm[:ring_name]
		_local infra_type_cap << _if .infra_type _isnt _unset _andif .infra_type.size > 0
		                         _then >> write_string(.infra_type[1].uppercase, .infra_type.subseq(2))
		                         _else >> ""
		                         _endif
		write("    Matched line: ", m_line, " | segment: ", segment)

		# Step 2: Parse original point geometry from KML coordinates
		_local original_location << _self.parse_point_geometry(pm[:coord])
		_local coord << original_location.as_coord()

		# Step 3: Build search buffer (500cm = 5m radius) around original location
		_local pa << pseudo_point.new(coord)
		pa.world << .database.world

		_local buff << pa.buffer(500)  # 5m radius in cm
		buff.world << .database.world

		# Step 4: Search for nearest underground route within buffer
		_local pred << predicate.interacts(:route, {buff})
		_local ug_routes << .ug_route_col.select(pred)

		_local final_location << _unset
		_if ug_routes.size > 0
		_then
			# Found underground route - snap to nearest point on it
			_local ugr << ug_routes.an_element()
			_local pc << pseudo_chain.new(ugr.route)
			pc.world << .database.world
			_local snapped_coord << pc.segpoint_near(pa)

			_local snapped_point << pseudo_point.new(snapped_coord)
			snapped_point.world << .database.world
			final_location << snapped_point

			write("    >> T-Wey snapped to underground route: ", ugr.name.default("(unnamed)"))
		_else
			# No underground route found within radius - use original location
			final_location << original_location
			write("    >> WARNING: No underground route found within 5m, using original location")
		_endif

		# Step 5: Insert into point_of_interest collection
		# notes is a dd_join_field and cannot be set via record_transaction
		# topview_boundary has no source geometry from a KML point placemark
		_local prop_values << property_list.new_with(
			:label,              pm[:name],
			:location,           final_location,
			:folders,            folders,
			:ring_name,          ring_name,
			:pop,                .pop_name,
			:olt,                .pop_name,
			:region,             .region,
			#:cluster,            .cluster,
			:line_type,          m_line,
			:segment,            segment,
			:fttx_network_type,  _self.get_fttx_network_type(),
			:construction_status, .construction_status,
			:stf_item_code,      "200000992",
			:uuid,               .uuid,
			:olt_code,           .olt_code,
			:feeder_code,        .feeder_code_db,
			:subfeeder_code,     .subfeeder_code_db,
			:cluster_code,       .cluster_code_db,
			:infra_type,         infra_type_cap
			#:fdt_name,           ring_name
		)

		_local rec_trans << record_transaction.new_insert(.poi_col, prop_values)
		rec_trans.run()

		_if .stats[:t_weys] _is _unset
		_then
			.stats[:t_weys] << 0
		_endif
		.stats[:t_weys] +<< 1

		write("    [OK] T-Wey (point_of_interest) created: ", pm[:name])

	_when error
		write("ERROR in create_t_wey(): ", errCon.report_contents_string)
		write("  Placemark name: ", pm[:name].default("(unnamed)"))
		write("  Folders: ", pm[:parent].default("(none)"))
		write("  Coordinates: ", pm[:coord].default("(none)"))
		.stats[:errors] +<< 1
	_endtry
_endmethod
$
