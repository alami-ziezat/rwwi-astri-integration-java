#% text_encoding = iso8859_1

_package user
$

## ASTRI Design Migrator
## Main entry point for migrating parsed KML placemarks to Smallworld design objects
## Creates project and design, orchestrates migration of all object types
##
## Individual migrators are defined in separate files:
## - astri_migrator_utilities.magik - Shared utility methods
## - astri_pole_migrator.magik - Pole creation
## - astri_aerial_route_migrator.magik - Aerial route and cable creation
## - astri_demand_point_migrator.magik - Demand point creation
## - astri_splice_migrator.magik - Sheath splice creation
## - astri_figure_eight_migrator.magik - Figure eight creation
## - astri_olt_migrator.magik - OLT creation
## - astri_riser_migrator.magik - Riser creation
## - astri_access_point_migrator.magik - Access point creation
## - astri_sheath_migrator.magik - Sheath creation
## - astri_micro_cell_migrator.magik - Micro cell creation

remex(:astri_design_migrator)
$

def_slotted_exemplar(:astri_design_migrator,
{
	{:database,        _unset, :writable},   # GIS database
	{:ace_view,        _unset, :writable},   # For coordinate system
	{:transform,       _unset, :writable},   # WGS84 >> local CS transform
	{:uuid,            _unset, :writable},   # KMZ UUID (used for uuid field)

	# Design management
	{:project,         _unset, :writable},   # swg_dsn_project
	{:scheme,          _unset, :writable},   # swg_dsn_scheme (design)
	{:design_manager,  _unset, :writable},   # swg_dsn_design_manager

	# Collection references
	{:ar_col,          _unset, :writable},   # aerial_route
	{:pole_col,        _unset, :writable},   # pole
	{:ug_route_col,    _unset, :writable},   # underground_route (NEW)
	{:uub_col,         _unset, :writable},   # uub (underground utility box/handhole) (NEW)
	{:sheath_col,      _unset, :writable},   # sheath_with_loc
	{:sc_col,          _unset, :writable},   # sheath_splice
	{:fe_col,          _unset, :writable},   # figure_eight
	{:sw_col,          _unset, :writable},   # sling_wire
	{:dp_col,          _unset, :writable},   # ftth!demand_point
	{:os_col,          _unset, :writable},   # optical_splitter
	{:cell_col,        _unset, :writable},   # ftth!zone
	{:cs_col,          _unset, :writable},   # ftth!customer_premise
	{:pol_col,         _unset, :writable},   # pol_boundary
	{:bld_col,         _unset, :writable},   # building
	{:olt_col,         _unset, :writable},   # mit_hub (OLT)
	{:riser_col,       _unset, :writable},   # riser
	{:ap_col,          _unset, :writable},   # access_point
	{:boring_manual_col,  _unset, :writable},  # boring_manual
	{:boring_machine_col, _unset, :writable},  # boring_machine
	{:tali_pancing_col,   _unset, :writable},  # tali_pancing
	{:sub_duct_col,       _unset, :writable},  # mit_conduit (sub duct HDPE 40/34 or 32/28)
	{:ot_col,             _unset, :writable},  # open_trenching (all infra types)
	{:poi_col,            _unset, :writable},   # point_of_interest (t_wey)

	# Migration context
	{:pop_name,             _unset, :writable},   # POP name (from OLT label)
	{:prj_id,               _unset, :writable},   # Project ID (from wo[:uuid])
	{:region,               _unset, :writable},   # Region (from area field)
	{:cluster,              _unset, :writable},   # Infrastructure name (from target infra_name)
	{:infra_type,           _unset, :writable},   # Infrastructure type (cluster/subfeeder/feeder)
	{:construction_status,  _unset, :writable},   # Construction status ("Proposed" or "In Service")
	{:topology,             _unset, :writable},   # Network topology (:aerial, :underground, :both) (NEW)

	# Database infrastructure codes
	{:cluster_code_db,      _unset, :writable},   # Cluster code from database
	{:subfeeder_code_db,    _unset, :writable},   # Subfeeder code from database
	{:feeder_code_db,       _unset, :writable},   # Feeder code from database
	{:olt_code,             _unset, :writable},   # OLT code from database

	# Statistics
	{:stats,           _unset, :writable},   # Migration results

	# Progress reporting
	{:dialog,          _unset, :writable}    # Optional dialog reference for set_progress() calls
})
$

_pragma(classify_level=basic, topic={astri_integration})
_method astri_design_migrator.new(database, wo_data, _optional construction_status)
	## Create new design migrator
	##
	## Parameters:
	##   database - GIS database (e.g., gis_program_manager.databases[:gis])
	##   wo_data - Work order property_list containing:
	##             :uuid - Project ID from work order
	##             :kmz_uuid - KMZ UUID for object tagging
	##             :olt_label - POP name from OLT label
	##             :area - Region from area field
	##             :infra_name - Infrastructure name
	##             :infrastructure_type - Infrastructure type (cluster/subfeeder/feeder)
	##             :cluster_code_db - Cluster code from database
	##             :subfeeder_code_db - Subfeeder code from database
	##             :feeder_code_db - Feeder code from database
	##             :olt_code - OLT code from database
	##   construction_status - Optional construction status ("Proposed" or "In Service", defaults to "Proposed")
	##
	## Returns: New astri_design_migrator instance

	>> _clone.init(database, wo_data, construction_status)
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_private _method astri_design_migrator.init(database, wo_data, _optional construction_status)
	## Initialize migrator
	##
	## Parameters:
	##   database - GIS database
	##   wo_data - Work order property_list
	##   construction_status - Optional construction status

	.database << database

	# Extract work order data from property_list
	.prj_id << wo_data[:uuid].default("")                    # Project ID
	.uuid << wo_data[:kmz_uuid].default("")                  # KMZ UUID for object tagging
	.pop_name << wo_data[:olt_label].default("")             # POP name from OLT label
	.region << wo_data[:area].default("")                    # Region
	.cluster << wo_data[:infra_name].default("")             # Infrastructure name
	.infra_type << wo_data[:infrastructure_type].default("cluster")  # Infrastructure type

	# Extract database infrastructure codes
	.cluster_code_db << wo_data[:cluster_code_db].default("")
	.subfeeder_code_db << wo_data[:subfeeder_code_db].default("")
	.feeder_code_db << wo_data[:feeder_code_db].default("")
	.olt_code << wo_data[:olt_code].default("")

	# Set construction status
	.construction_status << _if construction_status _is _unset _then >> "Proposed" _else >> construction_status _endif
	.ace_view << gis_program_manager.ace_view

	# Get design manager
	.design_manager << swg_dsn_admin_engine
	#gis_program_manager.cached_dataset(:design_admin).actual_dataset

	# Setup coordinate system transformation
	_local cs_local << .database.world.coordinate_system
	_local cs_wgs84 << .ace_view.collections[:sw_gis!coordinate_system].at(:world_longlat_wgs84_degree)
	.transform << transform.new_converting_cs_to_cs(cs_wgs84, cs_local)

	# Setup collection references
	.ar_col << .database.collections[:aerial_route]
	.pole_col << .database.collections[:pole]
	.ug_route_col << .database.collections[:underground_route]  # NEW
	.uub_col << .database.collections[:uub]                     # NEW
	.sheath_col << .database.collections[:sheath_with_loc]
	.sc_col << .database.collections[:sheath_splice]
	.fe_col << .database.collections[:figure_eight]
	.sw_col << .database.collections[:sling_wire]
	.dp_col << .database.collections[:ftth!demand_point]
	.os_col << .database.collections[:optical_splitter]
	.cell_col << .database.collections[:ftth!zone]
	.cs_col << .database.collections[:ftth!customer_premise]
	.pol_col << .database.collections[:pol_boundary]
	.bld_col << .database.collections[:building]
	.olt_col << .database.collections[:mit_hub]
	.riser_col << .database.collections[:riser]
	.ap_col << .database.collections[:access_point]
	.boring_manual_col  << .database.collections[:boring_manual]
	.boring_machine_col << .database.collections[:boring_machine]
	.tali_pancing_col   << .database.collections[:tali_pancing]
	.sub_duct_col       << .database.collections[:mit_conduit]
	.ot_col             << .database.collections[:open_trenching]
	.poi_col            << .database.collections[:point_of_interest]

	# Initialize statistics
	.stats << property_list.new_with(
		:aerial_routes, 0,
		:new_poles, 0,
		:existing_poles, 0,
		:sheath_length, 0.0,
		:sheath_splices, 0,
		:fdts, 0,
		:fats, 0,
		:joint_closures, 0,
		:optical_splitters, 0,
		:figure_eights, 0,
		:sling_wires, 0,
		:demand_points, 0,
		:customer_premises, 0,
		:buildings, 0,
		:micro_cells, 0,
		:olts, 0,
		:risers, 0,
		:access_points, 0,
		:areas_created, 0,
		:boring_manuals, 0,
		:boring_machines, 0,
		:tali_pancings, 0,
		:sub_ducts, 0,
		:open_trenchings, 0,
		:t_weys, 0,
		:t_weys_skipped, 0,
		:underground_routes, 0,
		:placeholder_uubs, 0,
		:errors, 0,
		:skipped, 0
	)

	>> _self
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_method astri_design_migrator.get_fttx_network_type()
	## Remap infrastructure type to FTTX network type
	## Returns display-friendly version of infra_type
	##
	## Mapping:
	##   "cluster" -> "Cluster"
	##   "subfeeder" -> "Sub Feeder"
	##   "feeder" -> "Feeder"
	##
	## Returns:
	##   string - Remapped FTTX network type

	_local type << .infra_type.default("cluster").lowercase

	_if type = "cluster"
	_then
		_return "Cluster"
	_elif type = "subfeeder"
	_then
		_return "Sub Feeder"
	_elif type = "feeder"
	_then
		_return "Feeder"
	_else
		# Default to Cluster if unknown type
		_return "Cluster"
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_private _method astri_design_migrator.is_boundary_area?(pm)
	## Check if placemark is the project boundary area
	## Boundary area has parent = null or empty AND type = "area"
	##
	## Parameters:
	##   pm (property_list) - Placemark datam
	##
	## Returns:
	##   boolean - True if this is the boundary area

	_local parent << pm[:parent].default("").lowercase
	_local type << pm[:type]

	>> type = "area" _andif (parent _is _unset _orif parent = "" _orif parent.index_of_seq("boundary cluster") _isnt _unset)
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_private _method astri_design_migrator.extract_boundary_area(placemarks)
	## Extract boundary area placemark from placemarks
	## The boundary area is an area with parent = null or empty
	## If no boundary area is found, create a convex hull from ALL placemark vertices
	## (including every vertex of line/polygon geometries, not just single points)
	##
	## Parameters:
	##   placemarks (rope) - All placemarks
	##
	## Returns:
	##   property_list - Boundary area placemark (real or synthetic from convex hull)

	_dynamic !print_float_precision! << 16
	write("  Creating convex hull from all placemark vertices (points + lines)...")

	# Collect all vertices from placemarks - both point and line/polygon geometry.
	# KML coordinate format:
	#   Point:   "lon,lat[,alt]"
	#   Line/Polygon: "lon1,lat1[,alt1] lon2,lat2[,alt2] ..."  (space-separated tuples)
	# Strategy: split by space first to get individual tuples, then by comma for lon/lat.
	_local sect << sector.new()
	_local pm_count << 0
	_local vertex_count << 0
	_for pm _over placemarks.fast_elements()
	_loop
		#_if pm[:type] = "area" 
		#_then  
		#	write(pm[:name], " | ", pm[:type], " | ", pm[:network_type].default(""), " | coords: ", pm[:coord].default("(no coords)"))	
		#_endif
		
		_if pm[:coord] _isnt _unset _andif pm[:coord] <> ""
		_then
			_try
				_local coord_string << pm[:coord]
				# Split by space to get individual "lon,lat[,alt]" tuples
				_local coord_pairs << coord_string.split_by(",0 ")
				_local added << 0
				_for coord_pair _over coord_pairs.fast_elements()
				_loop
					# Skip empty parts (caused by multiple consecutive spaces)
					_if coord_pair = "" _orif coord_pair.size < 3 _then _continue _endif
					_local parts << coord_pair.split_by(",")
					_if parts.size >= 2
					_then
						_local lon << parts[1].as_number()
						_local lat << parts[2].as_number()
						_if lon _is _unset _orif lat _is _unset _then _continue _endif
						_local wgs84_coord << coordinate.new(lon, lat)
						_local local_coord << .transform.convert(wgs84_coord)
						_if pm[:name] = "B08" _orif pm[:name] = "B11" 
				_then  
						write("	Converted to local coord: ", local_coord)
						_endif 
						sect.add_last(local_coord)
						added +<< 1
					_endif
				_endloop
				_if added > 0
				_then
					pm_count +<< 1
					vertex_count +<< added
				_endif
			_when error
				# Skip invalid coordinates
				write("  WARNING: Could not parse coordinate for placemark: ", pm[:name].default("(unnamed)"))
			_endtry
		_endif
	_endloop

	write("  Collected ", vertex_count, " vertices from ", pm_count, " placemarks")

	_if sect.size < 3
	_then
		write("  ERROR: Not enough vertices to create convex hull (need at least 3, found ", sect.size, ")")
		_return _unset
	_endif

	# Create convex hull from collected vertices
	_local convex_hull << sector_rope.new_convex_hull(sect)
	_if convex_hull _is _unset
	_then
		write("  WARNING: Convex hull creation failed, suspect line geometry, using buffered points instead")
		l_new_sectors << sect.buffer(400).sectors.an_element()
		_return sector_rope.new_convex_hull(l_new_sectors)
	_endif

	write("  Created convex hull boundary from ", sect.size, " placemark points")
	_return convex_hull.buffer(400).sectors
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_method astri_design_migrator.create_project_and_design(placemarks, wo_number, infra_code, infra_name, _optional infra_type)
	## Create new project and design for migration
	##
	## Parameters:
	##   placemarks (rope) - All placemarks (to extract boundary from)
	##   wo_number (string) - Work order number -> project name
	##   infra_code (string) - Infrastructure code (cluster/subfeeder/feeder) -> project title
	##   infra_name (string) - Infrastructure name -> design name
	##   infra_type (string) - Infrastructure type (optional: "feeder", "subfeeder", "cluster")
	##
	## Returns:
	##   (project, scheme) - Created project and scheme objects

	write("Creating project and design...")

	# Format job_title based on infrastructure type
	# For ALL types: format as "INFRATYPE-code" (e.g., "FEEDER-code", "SUBFEEDER-code", "CLUSTER-code")
	# If infra_type not specified, use infra_code as-is
	_local job_title_value << _if infra_type _isnt _unset _andif infra_type <> ""
	                          _then >> infra_type.uppercase + "-" + infra_code
	                          _else >> infra_code
	                          _endif

	write("  Job title formatted as: ", job_title_value, " (infra_type: ", infra_type.default("(not specified)"), ")")
	_local sch

 	_local prj << .design_manager.find_project_or_scheme(wo_number, :project)
	_if prj _isnt _unset
	_then
		# Check design is exist or not
		write("Project exist...")
		sch << prj.top_schemes.an_element()
	_endif

        # Get all GIS dataset names
	_local dsnames << set.new()
	_for i _over swg_dsn_project.configuration[:initial_dataset_names].default("").split_by(%,).fast_elements()
	_loop
		dsname << i.as_symbol()
		_if gis_program_manager.cached_dataset(dsname) _isnt _unset
		_then
			dsnames.add(dsname)
		_endif
	_endloop

	_if prj _is _unset
	_then
		write("Initiate area project...")
		# Extract boundary area from placemarks
		_local area_sr << _self.extract_boundary_area(placemarks)
		# Ensure it's closed

		_if area_sr.closed? _is _false
		_then
			write("  WARNING: Boundary area not closed, using world bounds")
			area_sr << _unset
		_endif
		write("Creating project...")
		_local prj_attrs << property_list.new_with(
					    :job_title, job_title_value,
					    :job_type, "Physical NI Design Job",
					    :asset_owner, "Owned")

		prj << .design_manager.create_project(
			       wo_number,       # Project name from WO number
			       dsnames,
			       area_sr,
			       prj_attrs
				       )
		write("  Project created: ", wo_number, " (Title: ", job_title_value, ", ID: ", prj.id, ")")
		
	_endif
	_if sch _isnt unset
	_then
		write("Deleting existing scheme..")
		.design_manager.delete_scheme(sch)
	_endif

	#_if sch _is _unset
	#_then
	# Create scheme (design)
	# design_name = infra name
	_local area_sch << prj.project_areas.an_element().area
	_local sch_attrs << property_list.new()
	sch << .design_manager.create_scheme(
		prj,                  # Parent project
		_unset,               # No parent scheme
		infra_name,           # Scheme name from infra name
		dsnames,              # Dataset names
		prj.design_partition, # Design partition
		sch_attrs             # Additional attributes
	)
	write("  Design created: ", infra_name, " (ID: ", sch.id, ")")
	#_endif

	# Activate the design
	.design_manager.activate_design(sch)
	write("  Design activated")

	# Set world AFTER activation - now database view matches the activated design alternative
	# Using .database.world (not .at(0,0)) to get the world for the CURRENT view
	_dynamic !current_world! << .database.world
	_dynamic !current_coordinate_system! << .database.world.coordinate_system
	write("  World set to: ", !current_world!.name)

	# Store references
	.project << prj
	.scheme << sch

	_return prj, sch
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_private _method astri_design_migrator.classify_placemarks(placemarks)
	## Single-pass classification of all placemarks into typed buckets.
	## Eliminates the N x passes scanning by identifying each placemark's
	## type once, then each migration pass iterates only its own bucket.
	##
	## Boundary area placemarks are silently skipped.
	## Classification priority order matches the original pass ordering.
	##
	## Returns: property_list of bucket_key -> rope_of_matching_placemarks

	_local b << property_list.new_with(
		:olt,            rope.new(),
		:route,          rope.new(),
		:boring_manual,  rope.new(),
		:boring_machine, rope.new(),
		:tali_pancing,   rope.new(),
		:open_trenching, rope.new(),
		:sub_duct,       rope.new(),
		:pole,           rope.new(),
		:uub,            rope.new(),
		:splice,         rope.new(),
		:figure_eight,   rope.new(),
		:demand_point,   rope.new(),
		:t_wey,          rope.new(),
		:micro_cell,     rope.new(),
		:riser,          rope.new()
	)

	_for pm _over placemarks.fast_elements()
	_loop
		_if _self.is_boundary_area?(pm) _then _continue _endif

		_if _self.is_olt?(pm)
		_then
			b[:olt].add_last(pm)
		_elif _self.is_route?(pm)
		_then
			b[:route].add_last(pm)
		_elif _self.is_boring_manual?(pm)
		_then
			b[:boring_manual].add_last(pm)
		_elif _self.is_boring_machine?(pm)
		_then
			b[:boring_machine].add_last(pm)
		_elif _self.is_tali_pancing?(pm)
		_then
			b[:tali_pancing].add_last(pm)
		_elif _self.is_open_trenching?(pm)
		_then
			b[:open_trenching].add_last(pm)
		_elif _self.is_sub_duct?(pm)
		_then
			b[:sub_duct].add_last(pm)
		_elif _self.is_pole?(pm)
		_then
			b[:pole].add_last(pm)
		_elif _self.is_uub?(pm)
		_then
			b[:uub].add_last(pm)
		_elif _self.is_splice?(pm)
		_then
			b[:splice].add_last(pm)
		_elif _self.is_figure_eight?(pm)
		_then
			b[:figure_eight].add_last(pm)
		_elif _self.is_demand_point?(pm)
		_then
			b[:demand_point].add_last(pm)
		_elif _self.is_t_wey?(pm)
		_then
			b[:t_wey].add_last(pm)
		_elif _self.is_micro_cell?(pm)
		_then
			b[:micro_cell].add_last(pm)
		_elif _self.is_riser?(pm)
		_then
			b[:riser].add_last(pm)
		_endif
	_endloop

	write("  Classification: ",
		b[:olt].size,           " OLTs | ",
		b[:route].size,         " routes | ",
		b[:boring_manual].size + b[:boring_machine].size +
		b[:tali_pancing].size + b[:open_trenching].size, " boring/trenching | ",
		b[:sub_duct].size,      " sub-ducts | ",
		b[:pole].size,          " poles | ",
		b[:uub].size,           " UUBs | ",
		b[:splice].size,        " splices | ",
		b[:figure_eight].size,  " fig-eights | ",
		b[:demand_point].size,  " demand-pts | ",
		b[:t_wey].size,         " t-weys | ",
		b[:micro_cell].size,    " cells | ",
		b[:riser].size,         " risers")

	>> b
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_private _method astri_design_migrator.notify_progress(status_msg, _optional done_msg)
	## Call dialog.set_progress() if a dialog is set, to update the footer and log.
	##
	## Parameters:
	##   status_msg (string) - Text to show in the dialog progress footer (current step)
	##   done_msg   (string) - Optional text to log as completed step in text window
	_if .dialog _isnt _unset
	_then
		.dialog.set_progress(status_msg, done_msg)
	_endif
_endmethod
$

_method astri_design_migrator.migrate_placemarks(placemarks)
	## Migrate placemarks to design objects.
	## NOTE: For new projects, design must be activated before calling this
	##       method (call create_project_and_design() first).
	## NOTE: For existing alternatives (construction_status="In Service"),
	##       no design activation needed.
	## NOTE: Boundary area (parent=null/empty) is automatically excluded.
	##
	## Placemarks are classified in a single pass, then each migration pass
	## iterates only its own bucket — avoiding repeated full-list scans.
	##
	## Parameters:
	##   placemarks (rope) - Rope of property_lists from astri_kml_parser
	##
	## Returns:
	##   property_list - Migration statistics
	write("Starting design migration of ", placemarks.size, " placemarks... [", .construction_status, "]")

	_if .scheme _is _unset _andif .construction_status = "Proposed"
	_then
		condition.raise(:error, :string, "Design not activated. Call create_project_and_design() first.")
	_endif

	# Single pre-classification pass — each pm is typed exactly once
	write("  Pre-classifying placemarks...")
	_self.notify_progress("Pre-classifying " + placemarks.size.write_string + " placemarks, please wait...")
	_local b        << _self.classify_placemarks(placemarks)
	_local topology << .topology.default(:aerial)

	# Pass 1: OLTs (needed for cable snapping in subsequent passes)
	write("  Pass 1: Creating OLTs (", b[:olt].size, ")...")
	_self.notify_progress(
		"Processing " + b[:olt].size.write_string + " OLTs, please wait...",
		"Pre-classification done: " + placemarks.size.write_string + " placemarks classified")
	_for pm _over b[:olt].fast_elements() _loop	_self.create_olt(pm)	_endloop

	# Pass 2: Cables / routes (topology-based)
	write("  Pass 2: Creating cables and routes (", b[:route].size, ", topology: ", topology, ")...")
	_self.notify_progress(
		"Processing " + b[:route].size.write_string + " cables/routes (" + topology.write_string + "), please wait...",
		"Done: " + b[:olt].size.write_string + " OLTs processed")
	_for pm _over b[:route].fast_elements()
	_loop
		_if topology = :aerial #_orif topology = :both
		_then
			_self.create_aerial_route(pm)
		_endif
		_if topology = :underground #_orif topology = :both
		_then
			_self.create_underground_route(pm)
		_endif
	_endloop

	# Pass 3: Structures — poles and/or UUBs (topology-based)
	write("  Pass 3: Creating structures (", b[:pole].size, " poles, ", b[:uub].size, " UUBs, topology: ", topology, ")...")
	_self.notify_progress(
		"Processing " + b[:pole].size.write_string + " poles / " + b[:uub].size.write_string + " UUBs, please wait...",
		"Done: " + b[:route].size.write_string + " cables/routes processed")
	_if topology = :aerial _orif topology = :both
	_then
		_local pole_trans << rope.new()
		_for pm _over b[:pole].fast_elements() _loop _self.create_pole(pm, pole_trans) _endloop
		_if _not pole_trans.empty?
		_then
			dt << dataset_transaction.new(pole_trans, "Insert Poles")
			dt.run()
			write("  [OK] Poles inserted: ", pole_trans.size)
		_endif
	_endif
	_if topology = :underground _orif topology = :both
	_then
		_local uub_trans << rope.new()
		_for pm _over b[:uub].fast_elements() _loop _self.create_uub(pm, uub_trans) _endloop
		_if _not uub_trans.empty?
		_then
			dt << dataset_transaction.new(uub_trans, "Insert UUBs")
			dt.run()
			write("  [OK] UUBs inserted: ", uub_trans.size)
		_endif
	_endif

	# Pass 4: Splices, figure-eights, demand points, t-weys
	write("  Pass 4: Creating splices, figure-eights, demand points and t-weys...")
	_self.notify_progress(
		"Processing " + b[:splice].size.write_string + " splices / " + b[:figure_eight].size.write_string + " slack hangers, please wait...",
		"Done: " + b[:pole].size.write_string + " poles / " + b[:uub].size.write_string + " UUBs processed")
	_for pm _over b[:splice].fast_elements()       _loop _self.create_sheath_splice(pm) _endloop
	_for pm _over b[:figure_eight].fast_elements() _loop _self.create_figure_eight(pm)  _endloop

	# Pass 4.5: Sub-ducts (after all routes are created — sub-ducts snap to routes)
	write("  Pass 4.5: Creating sub-ducts (", b[:sub_duct].size, ")...")
	_self.notify_progress(
		"Processing " + b[:sub_duct].size.write_string + " sub-ducts, please wait...",
		"Done: " + b[:splice].size.write_string + " splices / " + b[:figure_eight].size.write_string + " slack hangers processed")
	_for pm _over b[:sub_duct].fast_elements() _loop _self.create_sub_duct(pm) _endloop

	# Pass 5: Objects with dataset transactions approach
	write("  Pass 5: Creating boring routes and tali pancing (",
		b[:boring_manual].size + b[:boring_machine].size +
		b[:tali_pancing].size + b[:open_trenching].size, ")...")
	_self.notify_progress(
		"Processing " + (b[:boring_manual].size + b[:boring_machine].size + b[:tali_pancing].size + b[:open_trenching].size).write_string + " boring/tali pancing/trenching objects, please wait...",
		"Done: " + b[:sub_duct].size.write_string + " sub-ducts processed")

	_local dt_trans << rope.new()	
	_local bman_trans << rope.new()
	_for pm _over b[:boring_manual].fast_elements()  _loop _self.create_boring_manual(pm, bman_trans)  _endloop
	_if _not bman_trans.empty?
	_then
		#dt << dataset_transaction.new(bm_trans, "Insert Boring Manual")
		#dt.run()
		dt_trans.add_all_last(bman_trans)
		write("  [OK] Boring Manual created: ", bman_trans.size)
	_endif

	_local bmach_trans << rope.new()
	_for pm _over b[:boring_machine].fast_elements() _loop _self.create_boring_machine(pm, bmach_trans) _endloop
	_if _not bmach_trans.empty?
	_then
		#dt << dataset_transaction.new(bmach_trans, "Insert Boring Machine")
		#dt.run()
		dt_trans.add_all_last(bmach_trans)
		write("  [OK] Boring Machine created: ", bmach_trans.size)
	_endif

	_local tp_trans << rope.new()
	_for pm _over b[:tali_pancing].fast_elements() _loop _self.create_tali_pancing(pm, tp_trans) _endloop
	_if _not tp_trans.empty?
	_then
		#dt << dataset_transaction.new(tp_trans, "Insert Tali Pancing")
		#dt.run()
		dt_trans.add_all_last(tp_trans)
		write("  [OK] Tali Pancing created: ", tp_trans.size)
	_endif

	_local ot_trans << rope.new()
	_for pm _over b[:open_trenching].fast_elements() _loop _self.create_open_trenching(pm, ot_trans) _endloop
	_if _not ot_trans.empty?
	_then
		#dt << dataset_transaction.new(ot_trans, "Insert Open Trenching")
		#dt.run()
		dt_trans.add_all_last(ot_trans)
		write("  [OK] Open Trenching created: ", ot_trans.size)
	_endif	
	
	_local pass5_total << b[:boring_manual].size + b[:boring_machine].size + b[:tali_pancing].size + b[:open_trenching].size
	write("  Pass 6: Creating demand point (",b[:demand_point].size, ")...")
	_self.notify_progress(
		"Processing " + b[:demand_point].size.write_string + " demand points (homepass), please wait...",
		"Done: " + pass5_total.write_string + " boring/tali pancing/trenching objects processed")
	_local dp_trans << rope.new()
	_for pm _over b[:demand_point].fast_elements() _loop _self.create_demand_point(pm, dp_trans) _endloop
	_if _not dp_trans.empty?
	_then
		dt << dataset_transaction.new(dp_trans, "Insert Demand Points")
		dt.run()
		#dt_trans.add_all_last(dp_trans)
		write("  [OK] Demand point created: ", dp_trans.size)
	_endif

	write("  Pass 7: Creating point of interest (t-wey) (",b[:t_wey].size, ")...")
	_self.notify_progress(
		"Processing " + b[:t_wey].size.write_string + " T-Wey (POI) objects, please wait...",
		"Done: " + b[:demand_point].size.write_string + " demand points processed")
	_for pm _over b[:t_wey].fast_elements() _loop _self.create_t_wey(pm) _endloop

	write("  Pass 8: Creating micro/macro cells (", b[:micro_cell].size, ")...")
	_self.notify_progress(
		"Processing " + b[:micro_cell].size.write_string + " boundary FAT (micro/macro cells), please wait...",
		"Done: " + b[:t_wey].size.write_string + " T-Wey (POI) objects processed")
	_local cell_trans << rope.new()
	_for pm _over b[:micro_cell].fast_elements() _loop _self.create_micro_cell(pm, cell_trans) _endloop
	_if _not cell_trans.empty?
	_then
		#dt << dataset_transaction.new(cell_trans, "Insert Cells")
		#dt.run()
		dt_trans.add_all_last(cell_trans)
		write("  [OK] Macro cell created: ", cell_trans.size)
	_endif

	# Insert all transactions for Pass 5 and 5.5 together (cells, sub-ducts, demand points, t-weys) to ensure they are all available before Pass 6 riser creation
	_global dtrx
	dtrx << dt_trans
	_if _not dt_trans.empty?
	_then
		dt << dataset_transaction.new(dt_trans, "Insert all transactions for Pass 5 and 5.5")
		dt.run()
		write("  [OK] All Pass 5 and 5.5 objects inserted: ", dt_trans.size)
	_endif

	# Pass 9: Risers
	write("  Pass 9: Creating risers (", b[:riser].size, ")...")
	_self.notify_progress(
		"Processing " + b[:riser].size.write_string + " risers, please wait...",
		"Done: " + b[:micro_cell].size.write_string + " boundary FAT objects processed")
	_for pm _over b[:riser].fast_elements() _loop _self.create_riser(pm) _endloop

	# Update FDT :tp field with total demand points (cluster infrastructure only)
	_if .infra_type = "cluster"
	_then
		write("  Pass 10: Updating FDT :tp field...")
		_self.notify_progress(
			"Updating FDT demand point totals, please wait...",
			"Done: " + b[:riser].size.write_string + " risers processed")
		_self.update_fdt_tp_field()
		_self.notify_progress(
			"Migration complete!",
			"Done: FDT demand point totals updated")
	_else
		_self.notify_progress(
			"Migration complete!",
			"Done: " + b[:riser].size.write_string + " risers processed")
	_endif

	_self.print_statistics()
	>> .stats
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_method astri_design_migrator.print_statistics()
	## Print migration statistics

	write("")
	write("=" * 60)
	write("Design Migration Statistics")
	write("=" * 60)
	write("Aerial Routes:      ", .stats[:aerial_routes])
	write("New Poles:          ", .stats[:new_poles])
	write("Existing Poles:     ", .stats[:existing_poles])
	write("Sheath Length (m):  ", .stats[:sheath_length].rounded)
	write("Sheath Splices:     ", .stats[:sheath_splices])
	write("  - FDT:            ", .stats[:fdts])
	write("  - FAT:            ", .stats[:fats])
	write("  - JOINT CLOSURE:  ", .stats[:joint_closures])
	write("Optical Splitters:  ", .stats[:optical_splitters])
	write("Figure Eights:      ", .stats[:figure_eights])
	write("Sling Wires:        ", .stats[:sling_wires])
	write("Demand Points:      ", .stats[:demand_points])
	write("Customer Premises:  ", .stats[:customer_premises])
	write("Buildings:          ", .stats[:buildings])
	write("Micro Cells:        ", .stats[:micro_cells])
	write("OLTs:               ", .stats[:olts])
	write("Risers:             ", .stats[:risers])
	write("Access Points:      ", .stats[:access_points])
	write("Other Areas:        ", .stats[:areas_created])
	write("Underground Routes: ", .stats[:underground_routes])
	write("Placeholder UUBs:   ", .stats[:placeholder_uubs])
	write("Boring Manual:      ", .stats[:boring_manuals])
	write("Boring Machine:     ", .stats[:boring_machines])
	write("Tali Pancing:       ", .stats[:tali_pancings])
	write("Sub Duct:           ", .stats[:sub_ducts])
	write("Open Trenching:     ", .stats[:open_trenchings])
	write("T-Wey (POI):        ", .stats[:t_weys])
	write("  - Skipped (dup):  ", .stats[:t_weys_skipped])
	write("Errors:             ", .stats[:errors])
	write("Skipped:            ", .stats[:skipped])
	write("")
	_local total_created << .stats[:aerial_routes] + .stats[:new_poles] + .stats[:existing_poles] +
	                         .stats[:sheath_splices] + .stats[:optical_splitters] +
	                         .stats[:figure_eights] + .stats[:sling_wires] +
	                         .stats[:demand_points] + .stats[:customer_premises] +
	                         .stats[:buildings] + .stats[:micro_cells] + .stats[:olts] +
	                         .stats[:risers] + .stats[:access_points] + .stats[:areas_created] +
	                         .stats[:boring_manuals] + .stats[:boring_machines] + .stats[:tali_pancings] +
	                         .stats[:sub_ducts] + .stats[:open_trenchings] + .stats[:t_weys] + .stats[:underground_routes]
	write("Total objects:      ", total_created)
	write("=" * 60)
_endmethod
$
