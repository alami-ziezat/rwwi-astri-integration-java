#% text_encoding = iso8859_1

_package user
$

## ASTRI Design Migrator - Boring Manual, Boring Machine, Tali Pancing Migration
## Contains methods for creating boring_manual, boring_machine, and tali_pancing
## records from KMZ placemarks.
##
## Detection is based on network_type set by astri_kml_parser:
##   :boring_manual  - parent folder contains "boring manual" + line geometry
##   :boring_machine - parent folder contains "boring machine" + line geometry
##   :tali_pancing   - parent folder contains "tali pancing"  + line geometry

_pragma(classify_level=basic, topic={astri_integration})
_private _method astri_design_migrator.create_boring_manual(pm, p_trans)
	## Create boring_manual record from placemark
	##
	## Parameters:
	##   pm - Placemark property_list from KML parser
	#write("Processing boring manual: ", pm[:name])
	_dynamic !current_world! << .database.collections[:sw_gis!world].at(0,0)
	_dynamic !current_coordinate_system! << .database.collections[:sw_gis!world].at(0,0).coordinate_system
	_try _with errCon
		_local folders  << pm[:parent].default("")
		_local route    << _self.parse_line_geometry(pm[:coord])
		_local pc << pseudo_chain.new(route)
		pc.world << .database.world
		_local m_line   << _self.match_line(folders)
		_if m_line _is _unset
		_then
			m_line << _self.match_line(pm[:name])
		_endif
		_local segment   << _self.match_segment(folders)
		_local ring_name << pm[:ring_name]
		_local infra_type_cap << _if .infra_type = "cluster"
		                         _then >> "Cluster"
		                         _elif .infra_type = "subfeeder"
		                         _then >> "SubFeeder"
		                         _elif .infra_type = "feeder"
		                         _then >> "Feeder"
		                         _else >> ""
		                         _endif
		#write(" Processed folders: ", folders, " | matched line: ", m_line, " | segment: ", segment)
		_local prop_values << property_list.new_with(
			:name,               pm[:name],
			:folders,            folders,
			:route,              pc,
			:ring_name,          ring_name,
			:pop,                .pop_name,
			:olt,                .pop_name,
			:region,             .region,
			:cluster,            .cluster,
			:line_type,          m_line,
			:segment,            segment,
			:fttx_network_type,  _self.get_fttx_network_type(),
			:construction_status, .construction_status,
			:stf_item_code,      "500002117",
			:uuid,               .uuid,
			:olt_code,           .olt_code,
			:feeder_code,        .feeder_code_db,
			:subfeeder_code,     .subfeeder_code_db,
			:cluster_code,       .cluster_code_db,
			:fdt_name,           ring_name,
			:infra_type,         infra_type_cap
		)

		_local rec_trans << record_transaction.new_insert(.boring_manual_col, prop_values)
		p_trans.add_last(rec_trans)

		_if .stats[:boring_manuals] _is _unset
		_then
			.stats[:boring_manuals] << 0
		_endif
		.stats[:boring_manuals] +<< 1
		#write("  Created boring_manual record for: ", pm[:name])
	_when error
		write("ERROR in create_boring_manual(): ", errCon.report_contents_string)
		write("  Placemark name: ", pm[:name].default("(unnamed)"))
		write("  Folders: ", pm[:parent].default("(none)"))
		.stats[:errors] +<< 1
	_endtry
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_private _method astri_design_migrator.create_boring_machine(pm, p_trans)
	## Create boring_machine record_transaction and append to p_trans.
	##
	## Parameters:
	##   pm      - Placemark property_list from KML parser
	##   p_trans - Rope collecting record_transactions for batch dataset_transaction
	_dynamic !current_world! << .database.collections[:sw_gis!world].at(0,0)
	_dynamic !current_coordinate_system! << .database.collections[:sw_gis!world].at(0,0).coordinate_system
	_try _with errCon
		_local folders  << pm[:parent].default("")
		_local route    << _self.parse_line_geometry(pm[:coord])
		_local pc << pseudo_chain.new(route)
		pc.world << .database.world
		_local m_line   << _self.match_line(folders)
		_if m_line _is _unset
		_then
			m_line << _self.match_line(pm[:name])
		_endif
		_local segment   << _self.match_segment(folders)
		_local ring_name << pm[:ring_name]
		_local infra_type_cap << _if .infra_type = "cluster"
		                         _then >> "Cluster"
		                         _elif .infra_type = "subfeeder"
		                         _then >> "SubFeeder"
		                         _elif .infra_type = "feeder"
		                         _then >> "Feeder"
		                         _else >> ""
		                         _endif

		_local prop_values << property_list.new_with(
			:name,               pm[:name],
			:folders,            folders,
			:route,              pc,
			:ring_name,          ring_name,
			:pop,                .pop_name,
			:olt,                .pop_name,
			:region,             .region,
			:cluster,            .cluster,
			:line_type,          m_line,
			:segment,            segment,
			:fttx_network_type,  _self.get_fttx_network_type(),
			:construction_status, .construction_status,
			:stf_item_code,      "500000980",
			:uuid,               .uuid,
			:olt_code,           .olt_code,
			:feeder_code,        .feeder_code_db,
			:subfeeder_code,     .subfeeder_code_db,
			:cluster_code,       .cluster_code_db,
			:fdt_name,           ring_name,
			:infra_type,         infra_type_cap
		)

		_local rec_trans << record_transaction.new_insert(.boring_machine_col, prop_values)
		p_trans.add_last(rec_trans)

		_if .stats[:boring_machines] _is _unset _then .stats[:boring_machines] << 0 _endif
		.stats[:boring_machines] +<< 1

	_when error
		write("ERROR in create_boring_machine(): ", errCon.report_contents_string)
		write("  Placemark name: ", pm[:name].default("(unnamed)"))
		write("  Folders: ", pm[:parent].default("(none)"))
		.stats[:errors] +<< 1
	_endtry
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
