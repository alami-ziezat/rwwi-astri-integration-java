#% text_encoding = iso8859_1

_package user
$

## ASTRI Design Migrator - Micro Cell Migration
## Contains methods for creating micro cells and macro cells from KMZ placemarks

_pragma(classify_level=basic, topic={astri_integration})
 _private _method astri_design_migrator.create_micro_cell(pm, p_trans)
	## Create micro cell or macro cell from area placemark
	## - Areas WITHOUT folders = Macro Cell (boundary areas)
	## - Areas WITH folders + LINE + boundary patterns = Micro Cell
	## - Other areas = Skipped

	_dynamic !current_world! << .database.collections[:sw_gis!world].at(0,0)
	_dynamic !current_coordinate_system! << .database.collections[:sw_gis!world].at(0,0).coordinate_system
	_try _with errCon
		# Step 0: Parse folder hierarchy
		_local folders << pm[:parent].default("")
		_local fol << _unset
		_local fsize << 0
		_local fparent << 0

		_if folders _isnt _unset _andif folders <> ""
		_then
			fol << folders.split_by("|")
			fsize << fol.size
			_if fsize > 1
			_then
				fparent << fsize - 1
			_else
				fparent << fsize
			_endif
		_endif

		# Extract segment_id from folders
		_local segment_id << _self.match_segment(folders)
		# Truncate folders if needed
		_local ff << _unset

		_if folders.size > 100
		_then
			ff << folders.slice(1, 120)  # Truncate to 120 chars
			#write("    >> Folders truncated to 120 chars")
		_else
			ff << folders
		_endif

		# Extract ring_name from folders (FDT/Closure name)
		_local ring_name << pm[:ring_name]

		# Extract line_type from folders (used by both macro and micro cell)
		_local line_type << _self.match_line(folders)
		_if line_type _is _unset
		_then
			line_type << _self.match_line(pm[:name])
		_endif

		# Capitalize infra_type for field value (e.g. "cluster" -> "Cluster")
		_local infra_type_cap << _if .infra_type = "cluster"
		                         _then >> "Cluster"
		                         _elif .infra_type = "subfeeder"
		                         _then >> "SubFeeder"
		                         _elif .infra_type = "feeder"
		                         _then >> "Feeder"
		                         _else >> ""
		                         _endif

		# Step 1: Check if this is a MACRO CELL (boundary area without folders)
		_if folders _is _unset _orif folders = "" _orif folders.lowercase.index_of_seq("boundary cluster") _isnt _unset
		_then
			# Parse area geometry (use precomputed_area if provided, e.g. from all-placemark hull fallback)
			_local area << _if pm[:precomputed_area] _isnt _unset
			               _then >> pm[:precomputed_area]
			               _else >> _self.parse_area_geometry(pm[:coord])
			               _endif

			# Create Macro Cell
			_local prop_values << property_list.new_with(
				:identification, pm[:name],
				:type, "Macro Cell",
				:status, "Active",
				:location, area,
				:segment, segment_id,
				:folders, ff,
				:fttx_network_type, _self.get_fttx_network_type(),
				:pop, .pop_name,
				:olt, .pop_name,
				:region, .region,
				:cluster, .cluster,
				:line_type, line_type,
				:deployment_technology, "System Default",
				:note, ring_name.default("") + "|" + folders,
				:uuid, .uuid,
				:olt_code, .olt_code,
				:feeder_code, .feeder_code_db,
				:subfeeder_code, .subfeeder_code_db,
				:cluster_code, .cluster_code_db
			)

			_local rec_trans << record_transaction.new_insert(.cell_col, prop_values)
			p_trans.add_last(rec_trans)

			.stats[:micro_cells] +<< 1
			_return 
		_endif

		# Step 2: Check for LINE pattern (required for Micro Cell)
		_local has_line << _false

		_if fol[fsize].matches?("LINE A*") _orif fol[fparent].matches?("LINE A*") _orif
		   fol[fsize].matches?("LINE B*") _orif fol[fparent].matches?("LINE B*") _orif
		   fol[fsize].matches?("LINE C*") _orif fol[fparent].matches?("LINE C*") _orif 
		   fol[fsize].matches?("LINE D*") _orif fol[fparent].matches?("LINE D*")
		_then
			has_line << _true
		_else
			#write("  WARNING: Skipping - no LINE pattern: ", folders)
			_return
		_endif

		# Step 4: Valid Micro Cell - proceed with creation
		# Parse area geometry
		_local area << _self.parse_area_geometry(pm[:coord])

		# Step 5: Find splitter inside cell
		_local s_id << _self.splitter_inside_cell(area)
		_local nm << _unset

		_if s_id _is _unset
		_then
			nm << fol[fsize]  # Use folder name as fallback
		_else
			nm << s_id        # Use splitter name
			#write("    >> Found splitter: ", s_id)
		_endif

		# Step 6: Create Micro Cell
		_local prop_values << property_list.new_with(
			:identification, pm[:name],
			:type, "Micro Cell",
			:status, "Active",
			:location, area,
			:folders, ff,
			:segment, segment_id,
			:fttx_network_type, _self.get_fttx_network_type(),
			:pop, .pop_name,
			:olt, .pop_name,
			:region, .region,
			:cluster, .cluster,
			:line_type, line_type,
			:splitter_id, s_id,
			:deployment_technology, "System Default",
			:note, ring_name.default("") + "|" + folders,
			:uuid, .uuid,
			:olt_code, .olt_code,
			:feeder_code, .feeder_code_db,
			:subfeeder_code, .subfeeder_code_db,
			:cluster_code, .cluster_code_db,
			:infra_type, infra_type_cap
		)

		_local rec_trans << record_transaction.new_insert(.cell_col, prop_values)
		p_trans.add_last(rec_trans)

		.stats[:micro_cells] +<< 1
	_when error
		write("ERROR in create_micro_cell():", errCon.report_contents_string)
		write("  Placemark name:", pm[:name].default("(unnamed)"))
		write("  Folders:", pm[:parent].default("(none)"))
		write("  Coordinates:", pm[:coord].default("(none)"))
		.stats[:errors] +<< 1
	_endtry
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_private _method astri_design_migrator.create_area_based_object(pm)
	## Create area-based object from placemark WITH parent folder
	## This is a catchall for other area types

	_dynamic !current_world! << .database.collections[:sw_gis!world].at(0,0)
	_dynamic !current_coordinate_system! << .database.collections[:sw_gis!world].at(0,0).coordinate_system
	_try _with errCon
		_local parent << pm[:parent].default("")

		# Safety check: Only process areas WITH parent folders
		_if parent = "" _orif parent _is _unset
		_then
			_return  # Skip boundary areas
		_endif

		# Parse area geometry
		_local area << _self.parse_area_geometry(pm[:coord])

		#write("  >> Other area object: ", pm[:name], " (folder: ", parent, ")")

		.stats[:areas_created] +<< 1

	_when error
		write("ERROR in create_area_based_object():", errCon.report_contents_string)
		write("  Placemark name:", pm[:name].default("(unnamed)"))
		write("  Folders:", pm[:parent].default("(none)"))
		write("  Coordinates:", pm[:coord].default("(none)"))
		.stats[:errors] +<< 1
	_endtry
_endmethod
$
