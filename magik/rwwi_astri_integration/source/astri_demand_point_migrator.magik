#% text_encoding = iso8859_1

_package user
$

## ASTRI Design Migrator - Demand Point Migration
## Contains methods for creating demand points from KMZ placemarks

_private _method astri_design_migrator.create_demand_point(pm, p_trans)
	## Create demand point (home pass) from placemark with advanced mode:
	## - Multi-level folder validation
	## - Annotation creation
	## - Micro cell detection for splitter_id
	## - Optical splitter lookup for splice coordinates
	## - Boundary intersection for administrative data
	## - Customer premise creation with full attributes
	## - Optional building creation for GEDUNG type

	_dynamic !current_world! << .database.collections[:sw_gis!world].at(0,0)
	_dynamic !current_coordinate_system! << .database.collections[:sw_gis!world].at(0,0).coordinate_system
	_try _with errCon
		# Step 0: Validate demand point folder pattern
		_local folders << pm[:parent].default("")
		_if _not _self.is_demand_point?(pm)
		_then
			write("  WARNING: Skipping - not a demand point: ", folders)
			_return
		_endif

		# Step 1: Extract segment_id from folders
		_local segment_id << _self.match_segment(folders)

		# Step 2: Truncate folders to 100 characters
		_local ff << _self.truncate_folders(folders, 100)

		# Step 3: Parse geometry
		_local location << _self.parse_point_geometry(pm[:coord])

		# Step 3.5: Extract line_type
		_local m_line << _self.match_line(folders)

		# Step 3.6: Extract ring_name from folders (FDT/Closure name)
		_local ring_name << pm[:ring_name]
		_local infra_type_cap << _if .infra_type = "cluster"
		                         _then >> "Cluster"
		                         _elif .infra_type = "subfeeder"
		                         _then >> "SubFeeder"
		                         _elif .infra_type = "feeder"
		                         _then >> "Feeder"
		                         _else >> ""
		                         _endif

		# Step 3.7: Truncate identification to fit field length (max 32 chars)
		_local identification << pm[:name].default("")
		_if identification.size > 32
		_then
			identification << identification.slice(1, 32)
		_endif

		_local geom_text << pseudo_text.new_for_world(location, .database.world, property_list.new_with(:string, identification, :orientation, 0))
		# Step 4: Create demand point
		_local prop_values << property_list.new_with(
			:identification, identification,
			:name, pm[:name],
			:status, "Active",
			:mdu?, _false,
			:type, "Type 1",
			:segment, segment_id,
			:fttx_network_type, _self.get_fttx_network_type(),
			:folders, ff,
			:pop, .pop_name,
			:olt, .pop_name,
			:line_type, m_line,
			:notes, ring_name.default("") + "|" + folders,
			:location, location,
			:annotation, geom_text,
			:uuid, .uuid,
			:olt_code, .olt_code,
			:feeder_code, .feeder_code_db,
			:subfeeder_code, .subfeeder_code_db,
			:cluster_code, .cluster_code_db,
			:infra_type, infra_type_cap
		)

		_local rec_trans << record_transaction.new_insert(.dp_col, prop_values)
		p_trans.add_last(rec_trans)
		#_local l_result << rec_trans.run()

		.stats[:demand_points] +<< 1
		#write("  [OK] Demand point created: ", pm[:name])

		#>> l_result

	_when error
		write("ERROR in create_demand_point():", errCon.report_contents_string)
		write("  Placemark name:", pm[:name].default("(unnamed)"))
		write("  Folders:", pm[:parent].default("(none)"))
		write("  Coordinates:", pm[:coord].default("(none)"))
		.stats[:errors] +<< 1
	_endtry
_endmethod
$

_private _method astri_design_migrator.update_fdt_tp_field()
	## Update :tp field of FDT (sheath_splice) with total demand points
	##
	## This method:
	## - Queries sheath_splice by cluster_code_db AND sheath_splice_object_type contains "FDT"
	## - Updates :tp field with total demand point count from .stats[:demand_points]

	_dynamic !current_world! << .database.collections[:sw_gis!world].at(0,0)
	_dynamic !current_coordinate_system! << .database.collections[:sw_gis!world].at(0,0).coordinate_system
	_local total_dp << .stats[:demand_points]

	_if total_dp = 0
	_then
		write("  No demand points to update FDT :tp field")
		_return
	_endif

	_if .cluster_code_db _is _unset _orif .cluster_code_db = ""
	_then
		write("  WARNING: No cluster_code_db available, skipping FDT :tp update")
		_return
	_endif

	write("  Updating FDT :tp field with total demand points: ", total_dp)

	_local updated_count << 0
	_local not_found_count << 0

	_try _with err
		# Query sheath_splice by cluster_code AND sheath_splice_object_type contains "FDT"
		_local pred_cluster << predicate.eq(:cluster_code, .cluster_code_db)
		_local pred_type << predicate.contains(:sheath_splice_object_type, "FDT", _true)
		_local pred << pred_cluster.and(pred_type)

		_local fdts << .sc_col.select(pred)

		_if fdts.empty?
		_then
			write("    WARNING: No FDT found for cluster_code: ", .cluster_code_db)
			not_found_count << 1
		_else
			# Update :tp field for all matching FDTs
			_for fdt _over fdts.fast_elements()
			_loop
				_try _with cond
					_local old_tp << fdt.tp.default(0)
					_local update_props << property_list.new_with(:tp, total_dp.write_string)
					_local update_trans << record_transaction.new_update(fdt, update_props)
					update_trans.run()

					updated_count +<< 1
					write("    [OK] Updated FDT ", fdt.name.default("(unnamed)"),
					      " cluster: ", .cluster_code_db,
					      " :tp ", old_tp, " -> ", total_dp)
				_when error
					write("    ERROR updating FDT: ", cond.report_contents_string)
				_endtry
			_endloop
		_endif

	_when error
		write("    ERROR querying FDT for cluster ", .cluster_code_db, ": ", err.report_contents_string)
	_endtry

	write("  FDT :tp field update complete:")
	write("    - Updated: ", updated_count)
	write("    - Not found: ", not_found_count)

_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
