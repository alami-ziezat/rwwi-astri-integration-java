_pragma(classify_level=basic, topic={fms}, usage={subclassable})
_method rwwi_fms_dialog.init(owner)
	_super.init()
	appl << smallworld_product.pni_application()
	.app << appl
	.gv << gis_program_manager.cached_dataset(:gis)
	.map_p << .app.plugin(:map_plugin)
	.lo_manager <<  mit_low_level_nf_manager.new(:signal_level_nf_manager,.app)
	.v << gis_program_manager.cached_dataset(:gis)
	.owner << owner
	.grs << .owner.framework
	#.engine << rwi_fms_engine.new(appl)
	.items << property_list.new()
	#.interval << an_interval.default(30)
	.update_status << hash_table.new()
	.info_box << rwi_fms_info_box.new(_self)
	.mv << .map_p.current_map_view
	.an << map_animator.new(.mv)
	.list << rope.new()
	_self.add_dependent(.owner)
        >> _self
_endmethod
$

_pragma(classify_level=basic, topic={fms}, usage={subclassable})
_method rwwi_fms_dialog.new(_optional owner) #, _optional an_interval)
	## 
	##
	
	>> _clone.init(owner)
_endmethod
$

_pragma(classify_level=basic, topic={fms}, usage={subclassable})
_method rwwi_fms_dialog.activate_in(a_frame)
	## 
	##

	_self.title << "FMS"
	# format button
	# set button width to standard minimum button width
	a_frame.resizable? << _true
	a_frame.maximizable? << _true 
	
	# RC MAIN
	# create outer rowcol, 5 rows and 1 columns, 
	# use top_level style
	
	rc << rowcol.new(a_frame, 2, 1, :pixel,
			 :style, :top_level, :default_row_alignment, :centre)


	

	# GROUP BOX 1  
	# create grupbox nested 2 row 2 col
	group_box2 << group_box.new( rc, "DATA FMS", :row, 1, :col, 1 )
	gb_rc2 << rowcol.new( group_box2, 5, 1, :pixel, 
			      :style, :group_box)
	
	.items[:tree_item] << tree_item.new(gb_rc2,
					    :model,	_self,
					    :allow_filtering?,	_false,
					    :aspect,	:|tab_list|,
					    :col,	1,
					    :col_alignment,	:fill,
					    :column_alignments,	{:left,:right,:center},
					    :column_headings,        {"CircuitID", "Distance", "CableID", "Alseverity","Latitude ","Longitude"},
					    :column_heading_ids,     {:ciscuitid, :dist, :cableid, :alseverity, :lat, :long},
					    :column_headings_styled_strings, {{:bold, "CircuitID"}, {:bold, "Distance"}, {:bold, "CableID"}, {:bold, "Alseverity"}, {:bold, "Latitude"}, {:bold, "Longitude"}},
					    :column_widths,	{125,125,180,100,150,150},
					    :double_click_notifier,	:|tab_list_double_clicked()|,
						:grid_lines?,	_true,
						:stripes?,	_true,
					    :height,	240,
					    :mode,	:one,
					    :row,2,
					    :row_alignment,	:fill,
					    :select_notifier,	:|list_selected()|,
					    :width,	770 )
	# BUTTON



	button_rc << rowcol.new(rc, 1, _unset, :pixel, :row, 2, :col, 1,
				:style, :button_box, :col_alignment, :right )

	ti << .items[:ti] << toggle_item.new(button_rc,"Activate FMS ", :model, _self ,
					       :change_selector, :activate_fms|()| ,
					       :value, _false   )

	.items[:bt_03] << button_item.new_safe( button_rc, "Refresh", _self, :|refresh()|, :min_width, 100 )
	.items[:bt_04] << button_item.new_safe( button_rc, "Print Work Order", _self, :|do_snap()|, :min_width, 100 )
	.items[:bt_05] << button_item.new_safe( button_rc, "Email", _self, :|do_snap()|, :min_width, 100 )
	.items[:bt_05].enabled? << _false 

	label_item.new(button_rc,"        Interval   :  ")

	
	
	.items[:text_choice_item_01] << text_choice_item.new(button_rc,"",
			:model,   _self,
			:col,	1,
			:col_alignment,	:centre,
			:row,	1,
			:row_alignment,	:top,
			:items,	{{00,"1/4"},{0,"1/2"},{1,"1"},{2,"2"},{3,"5"}} )

	label_item.new(button_rc," minute ")

	.items[:bt_01] << button_item.new_safe(button_rc, "Run", _self, :|go()|, :property_aspect, :current_label,:col,1,:row,1)
	.items[:bt_02] << button_item.new_safe(button_rc, "Stop", _self, :|stop()|, :property_aspect, :current_label)


	# STATUS BAR
	my_pane_map << property_list.new_with(
			       :status_info, property_list.new_with(
						     :width, 590, :style, :innie ))
	.items[:status_bar] << status_bar.new(a_frame , my_pane_map)
	_return _self


_endmethod
$

_pragma(classify_level=basic, topic={tree_item})
_method rwwi_fms_dialog.activate_fms(enabled?)

	d << .app.plugin(:rwi_fms_plugin)
	_if enabled?
	_then
		write("true ")
		.items[:bt_01].enabled? << _false
		.items[:bt_02].enabled? << _false 
		d.activate_fms(enabled?)
		.map_p.current_map_view.render()
	_else
		write("false")
		.items[:bt_01].enabled? << _true
		.items[:bt_02].enabled? << _true
		d.activate_fms(enabled?)
		.map_p.current_map_view.render()
	_endif
	
_endmethod
$

_pragma(classify_level=basic, topic={tree_item})
_method rwwi_fms_dialog.tab_list

		>> .list

_endmethod
$

_method rwwi_fms_dialog.go()

   ## Begin the update alert

	_if .items[:ti].value _is _true
	_then 
		.items[:ti].value << _false 
		.items[:ti].enabled? << _false
	_else
		.items[:ti].enabled? << _false
	_endif

	
	.items[:bt_01].enabled? << _false

	_if .items[:text_choice_item_01].value = 00 _then 
		.interval << 15
	_elif .items[:text_choice_item_01].value = 0 _then 
		.interval << 30
	_elif .items[:text_choice_item_01].value = 1 _then
		.interval << 60
	_elif .items[:text_choice_item_01].value = 2 _then
		.interval << 120
	_elif .items[:text_choice_item_01].value = 3 _then
		.interval << 60*5
	_endif
	
	write(.Interval)
   _if .timer _is _unset _then
      the_proc << _proc(alert)
			  alert.check_for_update()
                  _endproc
      .timer << timed_event.new(.interval,the_proc,_self)
   _endif

   _if .timer.return_status() _is :running _then
      _return
   _endif

   .timer.go()

_endmethod
$

_method rwwi_fms_dialog.stop()

   ## Stop the update alert
	.items[:ti].enabled? << _true
	.items[:bt_01].enabled? <<  _true 
	.an.stop()
   _if .timer _is _unset _then
      _return
   _endif

   	_self.clear_trace()
	#	.current_doc.render()
	_self.disconnect_all()

   _if .timer.return_status() _is :stopped _then
      _return
   _endif

   .timer.stop()

_endmethod
$

_method rwwi_fms_dialog.check_for_update()

#	_for r _over .an.fast_elements()
#	_loop
