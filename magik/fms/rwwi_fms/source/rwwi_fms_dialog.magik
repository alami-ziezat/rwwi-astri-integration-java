_pragma(classify_level=basic, topic={fms}, usage={subclassable})
_method rwwi_fms_dialog.sheath(ob,reqid)
	write("sheath")
	
#	_dynamic !print_float_precision! << 16
	v << gis_program_manager.cached_dataset(:gis)
	tb << v.collection(:sheath_with_loc)
	_local table_names << { "fms_cable_route:fms_cable_route", "fms_structure_point:fms_structure_point"}
	#c_user << _self.mysql_connect()
	(cek?, a_view, cn) << _unset #connect_mysql()

	 _if cek?
	 _then
		 _for tab_name _over table_names.fast_elements()
		 _loop
			 _try _with ErrAddTables
					
				 cn.open_collection(tab_name.as_symbol(), a_view)
			 _when error		
			 _endtry
		 _endloop
	 _else
		 extdb_java_acp.close_all()
		 _return write("gagal")

	 _endif

	fms_structure_point << a_view.collections["fms_structure_point".as_symbol() ]
	fms_cable_route << a_view.collections["fms_cable_route".as_symbol() ]
	i << ob
	
	struktur << i.structures
	_for st _over struktur.fast_elements()
	_loop

		#write(st.source.name.write_string)
		_if st.source.name.write_string = "pole"
		_then
			l1  << st.get_equipment().an_element() #.name
		
			_if l1 _is _unset
			_then
				l1 << "POLE"
			_else
				loc_nm1  << l1.name
				_if loc_nm1 _is _unset
				_then
					l1 << "POLE"
				_else
					l1  << l1.name
			_endif 	
		_endif
		lo << st.location
		w_conv << _self.convert_coord(lo.coord)
		px << w_conv.x.write_string
		py << w_conv.y.write_string
		swobject << "Pole"
		
		_elif st.source.name.write_string = "mit_building_structure"
		_then
			s1 << st.building
			l1  << s1.name #+"|"+get_room.identifier
			lo << s1.location
			w_conv << _self.convert_coord(lo.coord)
			px << w_conv.x.write_string
			py << w_conv.y.write_string
			swobject << "Building"
			
		_elif st.source.name.write_string = "access_point"
		_then
			l1  << st.get_equipment().an_element()
			lo << st.location
			w_conv << _self.convert_coord(lo.coord)
			px << w_conv.x.write_string
			py << w_conv.y.write_string
			swobject << "Access Point"

		_elif st.source.name.write_string = "mit_terminal_enclosure"
		_then
			l1  << st.name #+"|"+get_room.identifier
			lo << st.location
			w_conv << _self.convert_coord(lo.coord)
			px << w_conv.x.write_string
			py << w_conv.y.write_string
			swobject << "odc"
			
		_elif st.source.name.write_string = "uub"
		_then
			l1  << st.label #+"|"+get_room.identifier
			_if l1 _is _unset
			_then
				l1 << st.type
			_endif 
			lo << st.location
			w_conv << _self.convert_coord(lo.coord)
			px << w_conv.x.write_string
			py << w_conv.y.write_string
			swobject << st.type

		_elif st.source.name.write_string = "building"
		_then
			l1  << st.name #+"|"+get_room.identifier
			lo << st.location
			w_conv << _self.convert_coord(lo.coord)
			px << w_conv.x.write_string
			py << w_conv.y.write_string
			swobject << "Building"

		_else
			_continue 
		_endif

		temp << _unset
		temp << fms_structure_point.new_template_record()

			temp.structureid << l1
			temp.reqid << reqid
			temp.cableid << i.name
			temp.long << px
			temp.lat << py
			temp.swobject << swobject
							
			fms_structure_point.insert(temp )
			a_view.commit()

	_endloop
	
	sec << i.route_sectors()
	h << 0

	_for sec_i _over sec.fast_elements()
	_loop
		
		h +<< 1
		_dynamic !print_float_precision! << 16
		p << sec_i.sectors.an_element()
		w_conv << _self.convert_coord(p.coords.an_element())
				px << w_conv.x.write_string
				py << w_conv.y.write_string

				temp << _unset
				temp << fms_cable_route.new_template_record()

					temp.cableid << i.name
					temp.reqid << reqid
					temp.sequence << h.write_string
					temp.long << px
					temp.lat << py
					#temp.closest_odp << b
							
					fms_cable_route.insert(temp )
					a_view.commit()

		_if sec_i = sec.last
		_then
			h +<< 1
			w_conv << _self.convert_coord(p.coords[2])
				px << w_conv.x.write_string
				py << w_conv.y.write_string

					temp << _unset
					temp << fms_cable_route.new_template_record()

					temp.cableid << i.name
					temp.reqid << reqid
					temp.sequence << h.write_string
					temp.long << px
					temp.lat << py
				
							
					fms_cable_route.insert(temp )
					a_view.commit()

					
		_endif
	_endloop

	cn.close()
_endmethod 

_pragma(classify_level=basic, topic={fms}, usage={subclassable})
_method rwwi_fms_dialog.convert_coord(p_coord)
	
#	gv<< gis_program_manager.databases[:gis]
#	cs1 <<gv.collections[:sw_gis!coordinate_system].at(:world_longlat_wgs84_degree)
#	cs2 <<gv.collections[:sw_gis!coordinate_system].at(:world_miller_wgs84_cm)
#	write(p_coord.y, "  in : ",p_coord.x)
	gv<< gis_program_manager.databases[:gis]
	v << gis_program_manager.databases[:gis]
	a_view << gis_program_manager.ace_view
	#cs1 <<gv.collections[:sw_gis!coordinate_system].at(:world_longlat_wgs84_degree)
	#cs2 <<gv.collections[:sw_gis!coordinate_system].at(:world_miller_wgs84_cm)

	cs1 <<  v.world.coordinate_system 
	cs2 << a_view.collections[:sw_gis!coordinate_system].at(:world_longlat_wgs84_degree)
	t << transform.new_converting_cs_to_cs(cs1,cs2)
#	write(t)
	t_coord << t.convert(p_coord)
#	write("here")
	>> t_coord
_endmethod 
$

_pragma(classify_level=basic, topic={fms}, usage={subclassable})
_method rwwi_fms_dialog.convert_coord2(p_coord)
	
#	gv<< gis_program_manager.databases[:gis]
#	cs1 <<gv.collections[:sw_gis!coordinate_system].at(:world_longlat_wgs84_degree)
#	cs2 <<gv.collections[:sw_gis!coordinate_system].at(:world_miller_wgs84_cm)
#	write(p_coord.y, "  in : ",p_coord.x)
	gv<< gis_program_manager.databases[:gis]
	v << gis_program_manager.databases[:gis]
	a_view << gis_program_manager.ace_view
	#cs1 <<gv.collections[:sw_gis!coordinate_system].at(:world_longlat_wgs84_degree)
	#cs2 <<gv.collections[:sw_gis!coordinate_system].at(:world_miller_wgs84_cm)

	cs1 <<  v.world.coordinate_system 
	cs2 << a_view.collections[:sw_gis!coordinate_system].at(:world_longlat_wgs84_degree)
	t << transform.new_converting_cs_to_cs(cs2,cs1)
#	write(t)
	t_coord << t.convert(p_coord)
#	write("here")
	>> t_coord
_endmethod 
$


_pragma(classify_level=basic, topic={fms}, usage={subclassable})
_method rwwi_fms_dialog.connect_to_fms()
	## 
	##
	fms_tables << rope.new_with(:|input_parse2:input_parse2|,
				    :|fms_point:fms_point|,
				    :|fms_cable_route:fms_cable_route|,
				    :|fms_structure_point:fms_structure_point|)
	(cek?, c_user) << get_user_connection(:mysql_rest, :rest)
	c_user.per_table_connection_parameters <<
	hash_table.new_with(:input_parse2, hash_table.new_with(:no_primary_key_validation, _true),
			     :fms_point, hash_table.new_with(:no_primary_key_validation, _true),

			     :fms_cable_route, hash_table.new_with(:no_primary_key_validation, _true),
			     :fms_structure_point, hash_table.new_with(:no_primary_key_validation, _true)
		   )
	_if cek?
	_then
		_for table _over fms_tables.fast_elements()
		_loop
			_try _with ErrAddTables
				c_user.open_collection(table, .gv)
			_when Error
				condition.raise(:user_error, :string, ErrAddTables)
			_endtry
		_endloop
	_else
		extdb_java_acp.close_all()
	_endif 
_endmethod
$

_pragma(classify_level=basic, topic={fms}, usage={subclassable})
_method rwwi_fms_dialog.disconnect_all()
	## 
	## 
	extdb_java_acp.close_all()
_endmethod
$

_pragma(classify_level=restricted, topic={default_class})
_method rwwi_fms_dialog.int!tab_list


	_dynamic !print_float_precision! << 16
	_local mulai << date_time.now()
	#_self.connect_to_fms()
	#show(.gv,"<====>",.c_window)
	_constant severity << "Critical"
	
	ip2 << .gv.collections[:input_parse2]
	fms_p << .gv.collections[:fms_point]
	m_shelf << .gv.collections[:mit_shelf]
	ip2_critical << ip2.select(predicate.eq(:alseverity, severity))
	
	geom_fault << equality_geometry_set.new()
	obj_fault << equality_geometry_set.new()

	regpel << hash_table.new()

	_for i_ip2 _over ip2_critical.fast_elements()
	_loop
		show("INPUT PARSE")
		_local l_cid << i_ip2.circuitid.delimited_by(%.,%")
		obj_cir << m_shelf.select(predicate.eq(:ne_name,l_cid[1]))
		_if obj_cir.empty?
		_then
			_continue 
		_endif
		l_port << obj_cir.an_element().all_rme_port_components().select(
										predicate.using(_proc (s)
													_import l_cid
													_return s.description = l_cid[2]
												_endproc)).an_element()
		l_dist << i_ip2.dist.write_string
		(points,last_link, results)<< _self.get_fault_by_range(l_port,l_dist)
	
		geom_fault.add_all(points)
	#	print(points[1])
		pa  << pseudo_point.new(points[1])	
		pa.world << .gv.world

		w_conv << _self.convert_coord(pa.coord)
		px << w_conv.x.write_string
		py << w_conv.y.write_string
			write(px,"  :   ",py)
		#.info_box.paint(enabled?, .c_window, points[1] , l_dist, i_ip2.reqid, last_link)

		regpel[i_ip2.circuitid.as_symbol()] << hash_table.new_with(
							       :circuitid, i_ip2.circuitid,
							       :dist, i_ip2.dist,
							       :cableid, i_ip2.cableid,
							       :alseverity, i_ip2.alseverity,
							       :lat, py,
							       :long, px,
							       :rec, i_ip2
					    )

	
	_endloop
	
	_for key, val _over regpel.fast_keys_and_elements() 
	_loop

		vals << {}.new(6)
		vals[1] << val[:circuitid]
		vals[2] << val[:dist]
		vals[3] << val[:cableid]
		vals[4] << val[:alseverity]
		vals[5] << val[:lat]
		vals[6] << val[:long]
		ds << display_tree.new(key,vals)
		ds.styled_string << {:value,1,:tab,:value,2,:tab,:value,3,:tab,:value,4,:tab,:value,5,:tab,:value,6}
		.list.add_last(ds)
		
	_endloop

	
_endmethod
$


_pragma(classify_level=restricted, topic={default_class})
_method rwwi_fms_dialog.tab_list_double_clicked(selection)
	##
	##

	px << selection.value[6].as_number()
	py << selection.value[5].as_number()
	a_loc << coordinate.new(px,py)
	w_conv << _self.convert_coord2(a_loc.coord)
	pa  << pseudo_point.new(w_conv)	
	pa.world << .gv.world

	bb << bounding_box.new_enclosing(pa.bounds, 800)
	.map_p.goto(bb) #pa.bounds)

	_local l_point_style << line_style.new_with_properties(:foreground_colour,colour.new_with_properties(:red,0,:green,1,:blue,0),
							       :width,8)
	a_window     << .map_p.current_map_view.window
	a_point_geom  << pa
	pa.style_info << l_point_style
	.map_p.draw_geometry(pa)
	
_endmethod
$

_pragma(classify_level=restricted, topic={default_class})
_method rwwi_fms_dialog.list_selected(selection)
	##
	##
	_if (sel << selection.an_element()) _isnt _unset 
	_then
		.sel_record << sel
		.items[:status_bar].set_pane_text(:status_info, "".concatenation("Circuit ",sel.value[1]," selected: Double click the selected item to goto its vault area"))
	_else
		.sel_record << sel
		.items[:status_bar].set_pane_text(:status_info, "")
	_endif

	
_endmethod
$


_pragma(classify_level=restricted, topic={default_class})
_method rwwi_fms_dialog.refresh()
	## 
	##
	.items[:status_bar].set_pane_text(:status_info, "Collecting FMS data from external database (Mysql)...")
	.list.empty()
	_self.connect_to_fms()
	_self.int!tab_list
	_self.clear_trace()
	_self.changed(:tab_list, :refresh)
	.items[:status_bar].set_pane_text(:status_info, "Done")
_endmethod
$

_method rwwi_fms_dialog.wm_close()
	## 
	##
	_self.disconnect_all()
	_super.wm_close()
_endmethod
$

_pragma(classify_level=restricted, topic={default_class})
_method rwwi_fms_dialog.do_snap()

	_if (sel << .sel_record) _isnt _unset
	_then
		cr << sel.value[1]
		cu << sel.value[2]
		cw << sel.value[3]
		cx << sel.value[4]
	_endif
	
	#.map_p.goto(bb)

	#gv << .acurrent_map_view
	#gv << .map_p.map_view
	gv << .map_p.current_map_view
	gv.snapshot_w(gv)
	
	#.map_p.snapshot(.map_p.world_bounds)

	
	
	_local wd
	wd << ole_client.create_object("Word.Basic")
	wd.AppShow()
	a_path << system.working_directory + "\wo_report.docx"
	write("path-",a_path)
	wd.FileOpen(a_path)

    	wd.EditFind("AREA")
	wd.EditPaste(gv)


	
	newline<<character.newline.write_string
	tab<<character.tab.write_string

	# add the problem record
	wd.EditFind("device_info")
	o << internal_text_output_stream.new()
	o.write(newline)
	o.write( "                 WORK ORDER")
	o.write(newline)
	o.write(newline)
	o.write(newline)
	o.write( "Work Order Nomor :   CENT112233344")
	o.write(newline)
	o.write( "Petugas              :   Cent")
	o.write( newline)
	o.write( "Tanggal              :   ",date_time.now()) # 24/09/99 12:00)
	o.write(newline)
	o.write( "Circuit ID           :   ",cr)
	o.write(newline)
	o.write( "Distance             :   ",cu)
	o.write(newline)
	o.write( "Cable ID             :   ",cw)
	o.write(newline)
	o.write( "Alseverity           :   ",cx)
	#o.write(newline)
	#o.write( "Petugas              :   Cent")
	#wd.EditPaste(str)
	wd.insert(o.string)

	wd.release_object()

_endmethod
$

_pragma(classify_level=basic)
_method map_view.snapshot_w()
	##	
	## Places a snapshot of the map_view on the Windows clipboard
	##

	_if  .window _isnt _unset _andif
	     .window.realised?
	_then
		.window.copy_to_clipboard()
	#	_self.show_alert( _self.message( :snapshot_done ) )
	_endif 
	
_endmethod
$
