_pragma(classify_level=basic, topic={fms}, usage={subclassable})
_method rwwi_fms_dialog.do_process_fms(enabled?)
	## 
	##

	_self.run_engine( _thisthread.background_priority, :|int!do_process_fms()|,enabled?)
	write("ok")

_endmethod
$


_pragma(classify_level=basic, topic={fms}, usage={subclassable})
_method rwwi_fms_dialog.int!do_process_fms(enabled?)
	## 
	##

	.an.stop()
	_self.disconnect_all()
	_self.connect_to_fms()
	
	.an << map_animator.new(.mv)
	#.an.stop()
	.an.run()
	

	#.map_p.current_map_view.render()
	_dynamic !print_float_precision! << 16
	_local mulai << date_time.now()
	#_self.connect_to_fms()
	#show(.gv,"<====>",.c_window)
	_constant severity << "Critical"
	
	ip2 << .gv.collections[:input_parse2]
	fms_p << .gv.collections[:fms_point]
	m_shelf << .gv.collections[:mit_shelf]
	ip2_critical << ip2.select(predicate.eq(:alseverity, severity))
	
	geom_fault << equality_geometry_set.new()
	obj_fault << equality_geometry_set.new()

	_for i_ip2 _over ip2_critical.fast_elements()
	_loop
		show("INPUT PARSE")
		_local l_cid << i_ip2.circuitid.delimited_by(%.,%")
		obj_cir << m_shelf.select(predicate.eq(:ne_name,l_cid[1]))
		_if obj_cir.empty?
		_then
			_continue 
		_endif
		l_port << obj_cir.an_element().all_rme_port_components().select(
										predicate.using(_proc (s)
													_import l_cid
													_return s.description = l_cid[2]
												_endproc)).an_element()
		l_dist << i_ip2.dist.write_string
		(points,last_link, results)<< _self.get_fault_by_range(l_port,l_dist)
		a << map_blink_animation.new(.mv,points[1])
		.an.add(a)
		geom_fault.add_all(points)
		#.info_box.paint(enabled?, .c_window, points[1] , l_dist, i_ip2.reqid, last_link)
		
	_endloop

	#	write ("E", " ... HOLA ")

#	_endloop
_endmethod
$

_pragma(classify_level=advanced, topic={fms}, usage={subclassable})
_method rwwi_fms_dialog.get_fault_by_range(port, distance)
	## 
	## 
	_dynamic !current_world! << .gv.world
	
	range << unit_value.new(distance.as_number(),:m)
	#core << sheath_with_loc.get_all_in_fiber_pins()[port]
	start_node << rope.new_with(port)#core)
	params << property_list.new()
	params[:cost_message] << :|fiber_length()|
	params[:pseudo_link_message] <<	:|mit!split_link()|
	params[:want_end_pseudos?] << _true
	params[:max_cost] <<  stop_cost << range
	(results, results_set) << .lo_manager.otdr_trace(start_node, stop_cost, _scatter params)
	points << rope.new()
	_for l_link _over results.fast_elements()
	_loop
		_if (l_node<<l_link.out_node).class_name _is :pseudo_node
		_then
			l_point << pseudo_point.new_for_world(l_node.coord,!current_world!)
			points.add(l_point)
			last_link << l_link
		_endif
	_endloop
	_return points, last_link, results #, results_set#l_point
_endmethod
$


_pragma(classify_level=advanced, topic={fms}, usage={subclassable})
_method rwwi_fms_dialog.last_equipment(link)
	## 
	## 
	_if (in_node << link.in_node).class_name _is :mit_pseudo_fiber_loc_pin
	_then
		gdc << in_node.sheath_pin.sheath_with_loc.get_downstream_connector()
		_return _self.closest_equipment(gdc)
	_endif
_endmethod
$


