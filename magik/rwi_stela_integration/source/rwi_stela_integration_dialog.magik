_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.new(_optional owner, framework)
	## 
	## 
	>> _clone.init(owner, framework)
_endmethod
$

_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.init(owner, framework)
	## 
	##
	_super.init()

	.ev << gis_program_manager.cached_dataset(:gis)
	.owner << owner
	.grs << framework

	.grs << smallworld_product.pni_application()
	.mapman << .grs.plugin(:map_plugin)
	.ed << .grs.plugin(:editor_manager)
	.items << hash_table.new()
	.current_selection_ur1 << _unset
	.current_selection_ur2 << _unset
	.swl1 << _unset
	.swl2 << _unset
	.swl3 << _unset 
	# Data holder
	.table_list << rope.new()
	.table_list2 << rope.new()
	.records << rope.new()
	.a_uub << _unset 
	.a_sc << _unset
	.a_hp << _unset
	.engine << ""
	.pending_auto_upload? << _false

	# Add dependent dialog to plugin
	_self.add_dependent(.owner)
        >> _self
_endmethod
$

_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.activate_in( parent )
	## 
	##
	parent.title << "Stella Integration"

	mb << menubar.new( parent )

	m << _unset

	# Create the first pulldown menu and its button items
	p << pulldown_menu.new()
	#button_item.new( p, "Load KML...", _self , :get_kml|()| )
	button_item.new( p, "Clear",  _self , :clear|()| )
	button_item.new( p, "Refresh", _self , :refresh|()| )
	# Create the "File" button in the menubar
	menu_button_item.new( mb, "File", p )

	
	# top_outer stacks 4 rows: first_con (toolbar), second_con (tables),
	# third_con (upload toolbar), status_bar. row_resize_values only takes
	# effect on a fixed-size grid, so n_rows must be declared explicitly (4)
	# instead of _unset — same as rwwi_nisa_dialog/rwwi_astri_workorder_dialog,
	# which both pass an explicit row count alongside row_resize_values. Only
	# the tables row (index 1) should stretch when the dialog is resized; the
	# toolbars and status bar stay fixed-height.
	top_outer << sw_container.new( parent, 4, 1,
				       :outer_spacing, 5,
				       :row_spacing, 5,
				       :row_resize_values, {0,1,0,0},
				       :width, 1400,
				       :height, 440 )

	first_con << sw_border_container.new( top_outer, _unset, 1,
					      :label, "",
					      :row_resize_values,{0,1})
	_self.build_toolbar( first_con )
	# :col_resize_values makes the two table columns stretch to fill second_con
	# instead of shrinking to their minimum width and leaving empty space after
	# each table. Dropped the old :width,600 cap so this row fills the dialog
	# the same as first_con/third_con. Do NOT set :row_resize_values here —
	# with only one row it fights the tables' own :min_height and stops
	# second_con growing to fill the leftover vertical space in top_outer.
	second_con << sw_border_container.new( top_outer, 1, 2,
					      :label, "",
					      :col_resize_values,{1,1})

	_self.build_table_ur1( second_con )
	_self.build_table_ur2( second_con )

#	thirt_con << sw_border_container.new( top_outer, _unset, 1,
#					      :label, "",
#					   #   :width, 30,
#					      :row_resize_values,{0})
#	_self.build_label_result2( thirt_con )

	# Upload toolbar needs its own full-width row — it was previously sharing
	# second_con with the two tables, which clipped the Export/Auto-upload/
	# Doc Type/Browse/Upload controls into an overflowing "..." toolbar.
	third_con << sw_border_container.new( top_outer, _unset, 1,
					      :label, "",
					      :row_resize_values,{0,1})
	_self.build_toolbar_second( third_con )

	my_pane_map << property_list.new_with(
			       :status_info, property_list.new_with(
						     :width, 590, :style, :innie ))
	.items[:status_bar] << status_bar.new(top_outer , my_pane_map)
_endmethod
$

_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.build_toolbar( parent )
	## 
	##
	toolbar << sw_container.new( parent, 1, _unset,
				     :col_spacing, 15  
				)
	file_toolbar << sw_toolbar_container.new( toolbar, _false,
						  :background_type, :button_group,
						  :button_group_height, sw_item.default_item_height )

#	sw_label_item.new( file_toolbar, "source : ")
#	
