			#	write(a_dp)
				cell_g.value << "General Retail" #pj.write_string
				cell_g.entirecolumn.autofit
				cell_i.value << cl_code.write_string
				cell_i.entirecolumn.autofit
			#	write(a_dp)
				cell_j.value << cl_nm.write_string #nama.write_string
				cell_j.entirecolumn.autofit
			#	write("2")
