					       :model, _self,
					       :selector, :clear|()|,
					       :tooltip, "Clear" )
	
	.items[:refresh] << sw_button_item.new( file_toolbar,
					       :image, {:refresh, :ui_resources},
					       :model, _self,
					       :selector, :refresh|()|,
					       :tooltip, "Refresh" )


