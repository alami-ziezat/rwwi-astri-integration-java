			#	_else
			
			

			#	_endif
			
				
				
		_endloop



			
			
			

			



	_endloop
		
		



		
		
#	_endloop
	

	

	#	_endif
	# Get user home directory
	_local home_dir << system.getenv("USERPROFILE")  # Windows
	_if home_dir _is _unset _orif home_dir = ""
	_then
		# Fallback to TEMP if USERPROFILE not available
		home_dir << system.temp_directory_name
	_endif
	
	# Create sw_kml subdirectory path
	_local output_dir << system.pathname_from_components("sw_stella", home_dir)
	
	# Create directory if it doesn't exist
	_if _not system.file_exists?(output_dir)
	_then
		_try
			system.mkdir(output_dir)
			write("Created BOQ output directory: ", output_dir)
		_when error
			write("WARNING: Could not create sw_kml directory, using temp instead")
			output_dir << system.temp_directory_name
		_endtry
	_endif
	
	#ex << Excel_Object.save_file( output_dir,"test.xls")
	#ex << Excel_Object.save_as( "test.xlsx")
	
	d << date_now()
	days_number << d.day_of_month_number
	months_number << d.month_number
	years_number << d.year
	
	_if months_number.write_string.size = 1
	_then 
		mth << "0"+months_number.write_string
	_endif
	
	_if days_number.write_string.size = 1
	_then 
		dys << "0"+days_number.write_string
	_else	
		dys << days_number
	_endif
	
	hari << dys.write_string+"-"+mth.write_string+"-"+years_number.write_string
	fl_ex << "\HPDB astri "+cl_code+".xlsx"
	ad << output_dir+fl_ex  #"\HPDB astri .xlsx"
	write(ad)
	_if system.file_exists?( ad )
	_then
		system.do_command( write_string( "cmd /c del ", %",ad, %" ) )
	_endif
	
	WorkBook.saveas(ad)	
		
	WorkBook.Release_Object ()
	Excel_Object.Release_Object ()
		
_endmethod




_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.table_selected_ur2( selection )
	## 
	##
	v << gis_program_manager.databases[:gis]
	
	ed << .grs.plugin(:editor_manager)

	_global sel
	sel << selection
	.current_selection_ur2 << selection.get_row_data_from_selection().an_element()
	_if .current_selection_ur2.external_name ="Fibre Figure Eight" _then 
		p << .current_selection_ur2.get_structure()
		ef << ed.display_object_in_embedded_editor(.current_selection_ur2)
		#.mapman.goto(p)
		.grs.databus.make_data_available(:goto_request,{p, :highlight?, _true})
	_elif .current_selection_ur2.external_name ="Sheath (LOC)" _then

		ef << ed.display_object_in_embedded_editor(.current_selection_ur2)
		#ef.select_spatial_context_and_goto()
		#.current_selection_ur2.goto_border #mit!goto_bounds(v.world)
		#.current_selection_ur2.get_geometry_set_for_highlight(v.world)
		#ef.goto_in_current_world()
		#ef.select_in_map()
		#ef.highlight_rwo()
		#write("goto..")
		#.mapman.goto(.current_selection_ur2)

		#ef.select_spatial_context_and_goto()
		ef.goto_in_current_world()
		#ef.select_in_map()
		ef.highlight_rwo()
	_else
		ef << ed.display_object_in_embedded_editor(.current_selection_ur2)
		#.mapman.goto(.current_selection_ur2)
		ef.goto_in_current_world()
		#ef.select_in_map()
		ef.highlight_rwo()
		#.app.databus.make_data_available(:goto_request,{.current_selection_ur2, :highlight?, _true})
	_endif
	
	#print(.current_selection_ur2 )
_endmethod
$


