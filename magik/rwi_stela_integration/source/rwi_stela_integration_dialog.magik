				cell_k.entirecolumn.autofit


				cell_u.value << a_dp.name.write_string
				cell_u.entirecolumn.autofit
				
				cell_ac.value << olt_code.write_string
				cell_ac.entirecolumn.autofit
			#	write("3")
				cell_ad.value << olt_nm.write_string
