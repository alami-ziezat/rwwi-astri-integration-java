_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.table_selected_ur1( selection )
	## 
	##

	_global sel
	sel << selection
	#.current_selection_ur1 << selection.get_row_data_from_selection().an_element()	
	#write("cur : ",.current_selection_ur1)
	#i << sel.selected_rows[1]
	

	_if sel.selected_rows[1] = 1 _then
	#	write("Cluster")
		.table_list2.empty()
		.table_list2 << _self.get_data_cell()
	_elif sel.selected_rows[1] = 2 _then
	#	write("FAT")
		.table_list2.empty()
		.table_list2 << _self.get_data_odp()
	_elif sel.selected_rows[1] = 3 _then
	#	write("Homepass")
		.table_list2.empty()
		.table_list2 << _self.get_data_homepass()
	_elif sel.selected_rows[1] = 4 _then
	#	write("Homepass")
		.table_list2.empty()
		.table_list2 << _self.get_data_fat_not_valid()
	_elif sel.selected_rows[1] = 5 _then
	#	write("Homepass")
		.table_list2.empty()
		.table_list2 << _self.get_data_homepass_not_valid()
	_elif sel.selected_rows[1] = 6 _then
	#	write("Homepass")
		.table_list2.empty()
		.table_list2 << _self.get_data_boundary_fat_not_valid()
	_endif

	.current_selection_ur1 << sel.selected_rows[1]
	write(.current_selection_ur1)

	# Keep the upload Doc Type dropdown in sync with the summary row that has a
	# matching Excel export template (rows 1/2/3 only - see generate_boq_excel()).
	_if .items[:upload_doc_type] _isnt _unset
	_then
		_if .current_selection_ur1 = 1 _then .items[:upload_doc_type].value << "Cluster"  _endif
		_if .current_selection_ur1 = 2 _then .items[:upload_doc_type].value << "FAT"      _endif
		_if .current_selection_ur1 = 3 _then .items[:upload_doc_type].value << "Homepass" _endif
	_endif

	_self.changed(:table_ur2, :refresh)
_endmethod
$


_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.cek_ug()
	s << swg_dsn_admin_engine.get_current_job()
	
	_if s _is _unset
	_then
			write("No Design Selected")
			_leave 
	_endif
	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	pj << s.inf_project.write_string
	st << s.status.write_string	
	change_set << mit_scheme_record_change_set.new(s)
	e << _false
	_for i _over change_set.fast_elements()
	_loop
		
		name <<   i.current_record.source_collection.name
		_if name _is :uub _then
			#table_list.add(i.current_record)
			e << _true 
			_leave
		_endif
		
	_endloop
	
	>> e
	
_endmethod
$

#line
_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.cek_ae()

	s << swg_dsn_admin_engine.get_current_job()
	
	_if s _is _unset
	_then
			write("No Design Selected")
			_leave 
	_endif
	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	pj << s.inf_project.write_string
	st << s.status.write_string	
	change_set << mit_scheme_record_change_set.new(s)
	e << _false
	_for i _over change_set.fast_elements()
	_loop
		
		name <<   i.current_record.source_collection.name
		_if name _is :pole _then
			#table_list.add(i.current_record)
			e << _true 
			_leave
		_endif
		
	_endloop
	
	>> e
	
_endmethod
$

_global datalake_stella_by_cluster_code <<
_proc(cluster_code)

	write("  Input cluster_code: ", cluster_code)

	_local db_conn << _unset
	_local result   << 0

	_protect
		_try _with errCon
			
			# Step 1: Connect to PostgreSQL
			_local is_connect?
			(is_connect?, db_conn) << user:rwwi_external_ds_manager.open_connection_for("[POSTGRESQL_ASTRI_DB]")
			
			_if _not is_connect?
			_then
				write("  ERROR: Failed to connect to POSTGRESQL_ASTRI_DB")
				#result << "{\"success\":false,\"error\":\"Failed to connect to PostgreSQL\"}"
				_return
			_endif
			write("  Connected to POSTGRESQL_ASTRI_DB")

			# Step 2: Look up cluster_id_stella for the given cluster_code_astri
			_local sql_query << "SELECT olt_code FROM smallworld.dim_cluster_stella_master_smallworld WHERE cluster_code_astri = ? LIMIT 1"
			write("  Querying dim_cluster_stella_master_smallworld...")

			_local recs << db_conn.sql_select(sql_query, cluster_code)
			_local rec  << recs.get()
			recs.close()
			write("ssd")
#			# Clean transaction state after SELECT
#			_try
#				db_conn.commit()
#			_when error
#				db_conn.rollback()
#			_endtry

			write("sd  :  ",rec)
			_if rec _is _unset
			_then
				write("  ERROR: No record found for cluster_code_astri = ", cluster_code)
				#result << "{\"success\":false,\"error\":\"Cluster not found: " + cluster_code + "\"}"
				_return result
			_else
				write(rec)
				_local olt_code << rec.olt_code
				_if olt_code _is _unset 
				_then
					j << ""
				_else
					j << olt_code
				_endif
				
				result << j
			_endif

write("result  :",result)
		_when error
			write("  ERROR: ", errCon.report_contents_string)
			#result << "{\"success\":false,\"error\":\"" + errCon.report_contents_string + "\"}"
		_endtry

	_protection
		# Always close the DB connection on exit
		_if db_conn _isnt _unset
		_then
			_try
				db_conn.rollback()
				db_conn.close()
				extdb_java_acp.close_all()
				write("  DB connection closed")
			_when error
				# Ignore cleanup errors
			_endtry
		_endif
	_endprotect

	>> result
_endproc
$

_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.generate_boq_excel()

	s << swg_dsn_admin_engine.get_current_job()
	nama << s.name.write_string
	y << s.project.job_title
	yy << y.split_by("-")
	nm_cls << yy[2]
	pj << s.inf_project.write_string
	_local area << s.project.project_areas.an_element().area
	geo << area.bounds.centre
	change_set << mit_scheme_record_change_set.new(s)


	ug << _self.cek_ug()
	ae << _self.cek_ae()

	_if ug _is _true _and ae _is _false 
	_then
		nt << "UG"
	_elif ae _is _true _and ug _is _false
	_then 
		nt << "AE"
	_elif ae _is _true _and ug _is _true
	_then 
		nt << "AE & UG"	
	_endif

	olt_nm << ""
	#clr_nm << ""
	_for i _over change_set.fast_elements()
	_loop
			
		name <<   i.current_record.source_collection.name
		_if name _is :sheath_with_loc _then
			olt_nm << i.current_record.olt
			_if olt_nm _is _unset
			_then
				olt_nm << ""
			_endif
			
			sf_code << i.current_record.subfeeder_code
			cl_code << i.current_record.cluster_code
			olt_code << ""
			write("b4 : ",cl_code)
			olt_code << datalake_stella_by_cluster_code(cl_code)
			write("gfd  :",olt_code)
			_if olt_code = "" _orif olt_code _is _unset 
			_then
				olt_code << i.current_record.olt_code
			_endif

			write("next")
			_leave
		_endif
		
	_endloop



	_if .current_selection_ur1 = 1
	_then


		a_filename << "C:\SW5\PNI_FTTH536\pni_custom\modules\rwi_stela_integration\resources\cluster-template (4).xlsx"
		#system.getenv("TEMPLATE_BOQ_CLUSTER_AEUG")
		sht << "Template"
		
		Excel_Object << OLE_Client.Create_Object("Excel.Application")
		Excel_Object.Visible << _True
		write(a_filename,"  :  ",sht)
		Workbooks << Excel_Object.Workbooks ()
		WorkBook << Workbooks.add(a_filename)
		
		Sheet << Excel_Object.Sheets (sht)
		#Sheet1 << Excel_Object.Sheets ("Sheet1")
		
		
		a_ff << float_format.new_with_properties(
				:float_format,:fixed,
				:float_decimal_places,3)
		
		start << date_time_now()
		
		v << gis_program_manager.databases[:gis]
		a_view << gis_program_manager.ace_view
		#mapman << .grs.plugin(:maps)
		vc << v.collections
		pol_col << vc[:pol_boundary]
		!current_dsview! << v
		
		_dynamic !print_float_precision! << 12
		
		_dynamic !current_world! << v.collections[:sw_gis!world].at(0,0)
		_dynamic !current_coordinate_system! << v.collections[:sw_gis!world].at(0,0).coordinate_system
		
		
		count      << 2
		dtn        << date_time_now()
		
		
		cs1 <<  v.world.coordinate_system 
		cs2 << a_view.collections[:sw_gis!coordinate_system].at(:world_longlat_wgs84_degree)
		t << transform.new_converting_cs_to_cs(cs1,cs2)

		w_conv << t.convert(geo)
		latitud << w_conv.y.write_string
		longitud << w_conv.x.write_string
	
		
		#	a_table.add_cell( row, 1, {}, {:label, nama })
		#	a_table.add_cell( row, 2, {}, {:label, latitud })
		#	a_table.add_cell( row, 3, {}, {:label, longitud })

		e_fdt << _self.get_data_fdt()
		_if e_fdt.size > 0
		_then
			a_fdt << e_fdt.an_element()
			nm_fdt << a_fdt.name
			nm_olt <<a_fdt.olt_code
		_else
			nm_fdt << ""
			nm_olt << ""
		_endif

		
	
		a_point << pseudo_point.new( geo )
		a_point.world << v.world
		p_predicate << predicate.interacts(:boundary, {a_point} )
		p_predicate_town << predicate.eq(:type, "Town")
		s_pol << pol_col.select( p_predicate _and p_predicate_town )
		
		_if s_pol.size > 0 _then
			a_pol << s_pol.an_element()	
			propinsi << a_pol.provinsi
			kabupaten << a_pol.kabupaten
			kecamatan << a_pol.kecamatan
			desa << a_pol.desa	
		_endif
		
		Cell_a << Sheet.Range ("A"+count.write_string)
		Cell_b << Sheet.Range ("B"+count.write_string)
		Cell_c << Sheet.Range ("C"+count.write_string)
		Cell_f << Sheet.Range ("F"+count.write_string)
		Cell_g << Sheet.Range ("G"+count.write_string)
		Cell_i << Sheet.Range ("I"+count.write_string)
		Cell_m << Sheet.Range ("M"+count.write_string)
		Cell_n << Sheet.Range ("N"+count.write_string)
		Cell_s << Sheet.Range ("S"+count.write_string)
		Cell_t << Sheet.Range ("T"+count.write_string)
		Cell_q << Sheet.Range ("Q"+count.write_string)
		Cell_u << Sheet.Range ("U"+count.write_string)


		cell_a.value << nama.write_string
		cell_a.entirecolumn.autofit
		cell_b.value << nm_fdt.write_string
		cell_b.entirecolumn.autofit
		cell_c.value << nama.write_string
		cell_c.entirecolumn.autofit
		cell_f.value << kabupaten.write_string
		cell_f.entirecolumn.autofit
		cell_g.value << propinsi.write_string
		cell_g.entirecolumn.autofit
		cell_i.value << propinsi.write_string
		cell_i.entirecolumn.autofit
		cell_m.value << desa.write_string
		cell_m.entirecolumn.autofit
		cell_n.value << nm_olt.write_string
		cell_n.entirecolumn.autofit
		cell_s.value << latitud.write_string
		cell_s.entirecolumn.autofit
		cell_t.value << longitud.write_string
		cell_t.entirecolumn.autofit
		cell_q.value << pj.write_string
		cell_q.entirecolumn.autofit
		cell_u.value << nm_cls.write_string
		cell_u.entirecolumn.autofit
		



		
	_elif .current_selection_ur1 = 2
	_then
		a_filename << "C:\SW5\PNI_FTTH536\pni_custom\modules\rwi_stela_integration\resources\fat-template (9).xlsx"
		#system.getenv("TEMPLATE_BOQ_CLUSTER_AEUG")
