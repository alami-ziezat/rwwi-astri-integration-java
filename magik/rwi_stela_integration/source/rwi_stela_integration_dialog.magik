_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.build_toolbar_second( parent )
	## 
	##
	toolbar << sw_container.new( parent, 1, _unset,
				     :col_spacing, 20  
				)
	file_toolbar << sw_toolbar_container.new( toolbar, _false,
						  :background_type, :button_group,
						  #:col_alignment, :fill,
						  :button_group_height, sw_item.default_item_height )

#	.items[:run_check] << sw_button_item.new( file_toolbar,
#					       :image, {:run, :ui_resources},
#					       :model, _self,
#					       :selector, :get_result|()|,
#					       #:enabled?, _false,
#					       :tooltip, "Check " )

#	sw_label_item.new( file_toolbar, "Report" )

#	.items[:rpt_1] << sw_button_item.new( file_toolbar,
#					       :image, {:export_to_excel, :ui_resources},
#					       :model, _self,
#					       :selector, :print_data|()|,
#					       :tooltip, "Export Detail Object to Excel" )
#
#	.items[:rpt_2] << sw_button_item.new( file_toolbar,
#					       :image, {:google_maps_22x22, :ui_resources},
#					       :model, _self,
#					       :selector, :print_data|()|,
#					       :tooltip, "Export Detail Object to KML" )
	

		# --- Export BoQ into Excel ---
		#	sw_label_item.new(file_toolbar, "  ")

	.items[:boq_excel_btn] << sw_button_item.new(file_toolbar,
		:label, "Export Data into Excel",
		:model, _self,
		:selector, :generate_boq_excel|()|,
		:tooltip, "Generate Bill of Quantities as Excel file")
	.items[:boq_excel_btn].enabled? << _true

	# --- Auto-upload Excel toggle ---
	sw_label_item.new(file_toolbar, "  Auto-upload:  ")
	.items[:auto_upload_excel] << sw_text_item.new(file_toolbar,
		:model, _self,
		:display_length, 5,
		:editable?, _false)
	.items[:auto_upload_excel].text_items << {"Off", "On"}
	.items[:auto_upload_excel].value << "Off"

	# --- Document type selector (defaults to selected summary row, overridable) ---
	sw_label_item.new(file_toolbar, "  Doc Type:  ")
	.items[:upload_doc_type] << sw_text_item.new(file_toolbar,
		:model, _self,
		:display_length, 10,
		:editable?, _false)
	.items[:upload_doc_type].text_items << {"Cluster", "FAT", "Homepass"}
	.items[:upload_doc_type].value << "Homepass"

	# --- Browse Excel + path field ---
	sw_label_item.new(file_toolbar, "  ")

	.items[:browse_excel_btn] << sw_button_item.new(file_toolbar,
		:label, "Browse Excel",
		:model, _self,
		:selector, :browse_excel|()|,
		:tooltip, "Select a local Excel file for upload")

	.items[:local_excel_path] << sw_text_item.new(file_toolbar,
		:model, _self,
		:display_length, 35,
		:editable?, _true)
	.items[:local_excel_path].value << ""

	# --- Upload Excel ---
	.items[:upload_excel_btn] << sw_button_item.new(file_toolbar,
		:label, "Upload Excel",
		:model, _self,
		:selector, :upload_excel|()|,
		:tooltip, "Upload selected Excel file to ASTRI Document API")
	.items[:upload_excel_btn].enabled? << _false

_endmethod
