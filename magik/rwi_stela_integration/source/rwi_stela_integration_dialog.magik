			_if count > 4
			_then
				_leave
			_endif
	_endloop
	#	_endif
	# Get user home directory
	_local home_dir << system.getenv("USERPROFILE")  # Windows
	_if home_dir _is _unset _orif home_dir = ""
	_then
		# Fallback to TEMP if USERPROFILE not available
		home_dir << system.temp_directory_name
	_endif
	
	# Create sw_kml subdirectory path
	_local output_dir << system.pathname_from_components("sw_stella", home_dir)
	
	# Create directory if it doesn't exist
	_if _not system.file_exists?(output_dir)
	_then
		_try
			system.mkdir(output_dir)
			write("Created BOQ output directory: ", output_dir)
		_when error
			write("WARNING: Could not create sw_kml directory, using temp instead")
			output_dir << system.temp_directory_name
		_endtry
	_endif
	
	#ex << Excel_Object.save_file( output_dir,"test.xls")
	#ex << Excel_Object.save_as( "test.xlsx")
	
	d << date_now()
	days_number << d.day_of_month_number
	months_number << d.month_number
	years_number << d.year
	
	_if months_number.write_string.size = 1
	_then 
		mth << "0"+months_number.write_string
	_endif
	
	_if days_number.write_string.size = 1
	_then 
		dys << "0"+days_number.write_string
	_else	
		dys << days_number
	_endif
	
	hari << dys.write_string+"-"+mth.write_string+"-"+years_number.write_string
	fl_ex << "\HPDB astri "+cl_code+".xlsx"
	ad << output_dir+fl_ex  #"\HPDB astri .xlsx"
	write(ad)
	_if system.file_exists?( ad )
	_then
		system.do_command( write_string( "cmd /c del ", %",ad, %" ) )
	_endif
	
	WorkBook.saveas(ad)	
		
	WorkBook.Release_Object ()
	Excel_Object.Release_Object ()
		
_endmethod
$


_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.generate_boq_excel()

	s << swg_dsn_admin_engine.get_current_job()
	nama << s.name.write_string
	y << s.project.job_title
	yy << y.split_by("-")
	nm_cls << yy[2]
	pj << s.inf_project.write_string
	_local area << s.project.project_areas.an_element().area
	geo << area.bounds.centre
	change_set << mit_scheme_record_change_set.new(s)

	v << gis_program_manager.databases[:gis]
	a_view << gis_program_manager.ace_view
	#mapman << .grs.plugin(:maps)
	vc << v.collections
	pol_col << vc[:pol_boundary]
	sc_col << vc[:sheath_splice]

	cs1 <<  v.world.coordinate_system 
	cs2 << a_view.collections[:sw_gis!coordinate_system].at(:world_longlat_wgs84_degree)
	t << transform.new_converting_cs_to_cs(cs1,cs2)

	ug << _self.cek_ug()
	ae << _self.cek_ae()

	_if ug _is _true _and ae _is _false 
	_then
		nt << "UG"
	_elif ae _is _true _and ug _is _false
	_then 
		nt << "AE"
	_elif ae _is _true _and ug _is _true
	_then 
		nt << "AE & UG"	
	_endif

	olt_nm << ""
	#clr_nm << ""
	_for i _over change_set.fast_elements()
	_loop
			
		name <<   i.current_record.source_collection.name
		_if name _is :sheath_with_loc _then
			olt_nm << i.current_record.olt
			_if olt_nm _is _unset
			_then
				olt_nm << ""
			_endif
			
			sf_code << i.current_record.subfeeder_code
			cl_code << i.current_record.cluster_code
			olt_code << ""
		
			olt_code << datalake_stella_by_cluster_code(cl_code)
		
			_if olt_code = "" _orif olt_code _is _unset 
			_then
				olt_code << i.current_record.olt_code
			_endif

		
			_leave
		_endif
		
	_endloop

	y_prj << s.project
	jb << y_prj.job_title
	j << jb.split_by("-")
	#	write(j.size)
	_if j.size > 1 
	_then
	
		j_tp << j[1]
		j_cd << j[2].write_string

		_if fd_code = "" _orif fd_code _is _unset
		_then
			fd_code << j_cd
		_endif

		_if sf_code = "" _orif sf_code _is _unset
		_then
			sf_code << j_cd
		_endif
		
		_if cl_code = "" _orif cl_code _is _unset
		_then
			cl_code << j_cd
		_endif
		
	_endif

	grs << smallworld_product.pni_application() 
	grs.show_message("Pastikan semua aplikasi Excel lainnya sudah ditutup!")
	system.do_command("taskkill /IM excel.exe /f")
	system.do_command("taskkill /IM et.exe /f") 


	_if s _is _unset
	_then
		write("No Design Selected")
		_leave 
	_endif

	h_path << system.getenv("pni")
	a_filename << h_path + "\pni_custom\modules\rwi_stela_integration\resources\template HPDB astri.xlsx"


	sht << "CLUSTER" #"Template"
	
	Excel_Object << OLE_Client.Create_Object("Excel.Application")
	Excel_Object.Visible << _True
	
	Workbooks << Excel_Object.Workbooks ()
	WorkBook << Workbooks.add(a_filename)
	
	Sheet << Excel_Object.Sheets (sht)
	Sheet1 << Excel_Object.Sheets ("FAT")
	Sheet2 << Excel_Object.Sheets ("HOMEPASS")
	
	a_ff << float_format.new_with_properties(
			:float_format,:fixed,
			:float_decimal_places,3)
	
	start << date_time_now()

	!current_dsview! << v
	
	_dynamic !print_float_precision! << 12
	
	_dynamic !current_world! << v.collections[:sw_gis!world].at(0,0)
	_dynamic !current_coordinate_system! << v.collections[:sw_gis!world].at(0,0).coordinate_system
	
	
	count      << 2
	dtn        << date_time_now()
	
	
	cs1 <<  v.world.coordinate_system 
	cs2 << a_view.collections[:sw_gis!coordinate_system].at(:world_longlat_wgs84_degree)
	t << transform.new_converting_cs_to_cs(cs1,cs2)
	
	w_conv << t.convert(geo)
	latitud << w_conv.y.write_string
	longitud << w_conv.x.write_string
		
	e_fdt << _self.get_data_fdt()
	_if e_fdt.size > 0
	_then
		a_fdt << e_fdt.an_element()
		nm_fdt << a_fdt.name
		nm_olt <<a_fdt.olt_code
	_else
		nm_fdt << ""
		nm_olt << ""
	_endif
		

	a_point << pseudo_point.new( geo )
	a_point.world << v.world
	p_predicate << predicate.interacts(:boundary, {a_point} )
	p_predicate_town << predicate.eq(:type, "Town")
	s_pol << pol_col.select( p_predicate _and p_predicate_town )
	
	_if s_pol.size > 0 _then
		a_pol << s_pol.an_element()	
		propinsi << a_pol.provinsi
		kabupaten << a_pol.kabupaten
		kecamatan << a_pol.kecamatan
		desa << a_pol.desa	
	_endif

	e_fdt << _self.seq_fdt()
	#write("count fdt :",e_fdt.size)
	count_fdt << 1
	c_fdt << 0
	count_fat << 1
	count_dp << 1
	_for fd _over e_fdt.fast_elements()
	_loop 
		#write(fd)
		count_fdt +<< 1
		c_fdt +<< 1
		Cell_a << Sheet.Range ("A"+count_fdt.write_string)
		Cell_b << Sheet.Range ("B"+count_fdt.write_string)
		Cell_c << Sheet.Range ("C"+count_fdt.write_string)
		Cell_d << Sheet.Range ("D"+count_fdt.write_string)
		Cell_f << Sheet.Range ("F"+count_fdt.write_string)
		Cell_g << Sheet.Range ("G"+count_fdt.write_string)
		Cell_i << Sheet.Range ("I"+count_fdt.write_string)
		Cell_m << Sheet.Range ("M"+count_fdt.write_string)
		Cell_n << Sheet.Range ("N"+count_fdt.write_string)
		Cell_s << Sheet.Range ("S"+count_fdt.write_string)
		Cell_t << Sheet.Range ("T"+count_fdt.write_string)
		Cell_q << Sheet.Range ("Q"+count_fdt.write_string)
		Cell_u << Sheet.Range ("U"+count_fdt.write_string)
		
		cl_nm << nama+" - FDT "+c_fdt.write_string
		cell_a.value << cl_nm.write_string
		cell_a.entirecolumn.autofit
		
		cell_b.value << fd.write_string
		cell_b.entirecolumn.autofit
		
		cell_c.value << cl_nm.write_string
		cell_c.entirecolumn.autofit

		cell_d.value << propinsi.write_string
		cell_d.entirecolumn.autofit
		
		cell_f.value << kabupaten.write_string
		cell_f.entirecolumn.autofit
		
		cell_g.value << propinsi.write_string
		cell_g.entirecolumn.autofit
		
		cell_i.value << propinsi.write_string
		cell_i.entirecolumn.autofit
		
		cell_m.value << desa.write_string
		cell_m.entirecolumn.autofit
		cell_n.value << nm_olt.write_string
		cell_n.entirecolumn.autofit
		cell_s.value << latitud.write_string
		cell_s.entirecolumn.autofit
		cell_t.value << longitud.write_string
		cell_t.entirecolumn.autofit
		cell_q.value << pj.write_string
		cell_q.entirecolumn.autofit
		cell_u.value << nm_cls.write_string
		cell_u.entirecolumn.autofit

		#loop fat
		e_fat << _self.seq_fat(fd)
		#write("count fdt :",e_fdt.size)
		
		c_fat << 0
		_for fa _over e_fat.fast_elements()
		_loop
		
			p_predicate_fat << predicate.eq(:name, fa )
			sc_pol << sc_col.select( p_predicate_fat)
			_if sc_col.size > 0 _then
				a_rec_fat << sc_pol.an_element()
			_else
				_continue
			_endif
			
			count_fat  +<< 1
			
			a_point_fat << a_rec_fat.location
			p_predicate << predicate.interacts(:boundary, {a_point_fat} )
			p_predicate_town << predicate.eq(:type, "Town")
			s_pol << pol_col.select( p_predicate _and p_predicate_town )
		
			_if s_pol.size > 0 _then
				a_pol << s_pol.an_element()	
				propinsi << a_pol.provinsi
					kabupaten << a_pol.kabupaten
					kecamatan << a_pol.kecamatan
					desa << a_pol.desa
					
			_endif
			
			
			h << a_rec_fat.location.coord
			w_conv << t.convert(h)
			
			latitud << w_conv.y
			longitud << w_conv.x
			
			Cell_a1 << Sheet1.Range ("A"+count_fat.write_string)
			Cell_b1 << Sheet1.Range ("B"+count_fat.write_string)
			Cell_c1 << Sheet1.Range ("C"+count_fat.write_string)
			Cell_d1 << Sheet1.Range ("D"+count_fat.write_string)
			Cell_e1 << Sheet1.Range ("E"+count_fat.write_string)
			Cell_f1 << Sheet1.Range ("F"+count_fat.write_string)
			Cell_g1 << Sheet1.Range ("G"+count_fat.write_string)
			
			_if kabupaten _isnt _unset _then
				cell_a1.value << kabupaten.uppercase.write_string
				cell_a1.entirecolumn.autofit
			_else
					
				cell_a1.value << a_rec_fat.name.write_string
				cell_a1.entirecolumn.autofit
			_endif
			
				
			cell_b1.value << cl_nm.write_string #a_rec_fat.cluster.write_string
			cell_b1.entirecolumn.autofit
			
			f_nm << a_rec_fat.name.split_by(".")
			_if f_nm.size > 0 _then
				cell_c1.value << f_nm[f_nm.size].write_string
				cell_c1.entirecolumn.autofit
			_else 
				cell_c1.value << a_rec_fat.name.write_string
				cell_c1.entirecolumn.autofit
			_endif
			
			
			cell_d1.value << a_rec_fat.ring_name.write_string
			cell_d1.entirecolumn.autofit
			cell_e1.value << "16"#a_rec.ring_name.write_string
			cell_e1.entirecolumn.autofit
			cell_f1.value << latitud # a_ff.format(latitud).write_string
			cell_f1.entirecolumn.autofit
			cell_f1.numberformat << "general"
			cell_g1.value << longitud #a_ff.format(longitud).write_string
			cell_g1.entirecolumn.autofit
			cell_g1.numberformat << "general"
			
			
		#	_else 
		#		write("Data Dont have Location  :") #,a_rec.telco_pole_tag)
	#		_endif
			
	#	_endif
#		_if count > 40
#		_then
#			_leave
#		_endif

			#loop demand point
			
			dbc << _self.get_data_homepass_fat_comment(fa)

			_if dbc.size = 0 _then
				dbc << _self.get_data_homepass_fat_cell(fa)
			_endif
			
		
		#	write("df :",dbc.size) 
		#	_if dpc.size >= dbf.size _then

			_for a_dp _over dbc.fast_elements()
			_loop
				count_dp +<< 1
		#		write(a_dp)
				h << a_dp.location.coord
				w_conv << t.convert(h)
				
				latitud << w_conv.y
				longitud << w_conv.x
				
				Cell_a << Sheet2.Range ("A"+count_dp.write_string)
				Cell_b << Sheet2.Range ("B"+count_dp.write_string)
				Cell_c << Sheet2.Range ("C"+count_dp.write_string)
				Cell_d << Sheet2.Range ("D"+count_dp.write_string)
				Cell_e << Sheet2.Range ("E"+count_dp.write_string)
				Cell_f << Sheet2.Range ("F"+count_dp.write_string)
				Cell_g << Sheet2.Range ("G"+count_dp.write_string)
				Cell_h << Sheet2.Range ("H"+count_dp.write_string)
				Cell_i << Sheet2.Range ("I"+count_dp.write_string)
				Cell_j << Sheet2.Range ("J"+count_dp.write_string)
				Cell_k << Sheet2.Range ("K"+count_dp.write_string)
				Cell_l << Sheet2.Range ("L"+count_dp.write_string)
				Cell_m << Sheet2.Range ("M"+count_dp.write_string)
				Cell_n << Sheet2.Range ("N"+count_dp.write_string)
				Cell_o << Sheet2.Range ("O"+count_dp.write_string)
				Cell_p << Sheet2.Range ("P"+count_dp.write_string)
				Cell_q << Sheet2.Range ("Q"+count_dp.write_string)
				Cell_r << Sheet2.Range ("R"+count_dp.write_string)
				Cell_s << Sheet2.Range ("S"+count_dp.write_string)
				Cell_t << Sheet2.Range ("T"+count_dp.write_string)
				Cell_u << Sheet2.Range ("U"+count_dp.write_string)
				Cell_v << Sheet2.Range ("V"+count_dp.write_string)
				Cell_w << Sheet2.Range ("W"+count_dp.write_string)
				Cell_x << Sheet2.Range ("X"+count_dp.write_string)
				Cell_y << Sheet2.Range ("Y"+count_dp.write_string)
				Cell_z << Sheet2.Range ("Z"+count_dp.write_string)
				Cell_aa << Sheet2.Range ("AA"+count_dp.write_string)
				Cell_ab << Sheet2.Range ("AB"+count_dp.write_string)
				Cell_ac << Sheet2.Range ("AC"+count_dp.write_string)
				Cell_ad << Sheet2.Range ("AD"+count_dp.write_string)
				Cell_ae << Sheet2.Range ("AE"+count_dp.write_string)
				Cell_af << Sheet2.Range ("AF"+count_dp.write_string)
				Cell_ag << Sheet2.Range ("AG"+count_dp.write_string)
				Cell_ah << Sheet2.Range ("AH"+count_dp.write_string)
				Cell_ai << Sheet2.Range ("AI"+count_dp.write_string)
				Cell_aj << Sheet2.Range ("AJ"+count_dp.write_string)
				Cell_ak << Sheet2.Range ("AK"+count_dp.write_string)
				Cell_al << Sheet2.Range ("AL"+count_dp.write_string)
				Cell_am << Sheet2.Range ("AM"+count_dp.write_string)
				Cell_an << Sheet2.Range ("AN"+count_dp.write_string)
				Cell_ao << Sheet2.Range ("AO"+count_dp.write_string)
				Cell_ap << Sheet2.Range ("AP"+count_dp.write_string)
				Cell_aq << Sheet2.Range ("AQ"+count_dp.write_string)
				Cell_ar << Sheet2.Range ("AR"+count_dp.write_string)
