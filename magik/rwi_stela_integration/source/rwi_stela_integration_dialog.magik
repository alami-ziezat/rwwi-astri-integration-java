_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.get_data_homepass_fat_comment(fat)

	#c_ur1 << ur1.conduits
	#cbl_ur1 << ur1.cables

	v << gis_program_manager.databases[:gis]
	vc << v.collections
	c_ur1 << vc[:ftth!demand_point]
	count << 0

	app << smallworld_product.pni_application() 
	mm << app.plugin(:map_plugin)
		
	s << swg_dsn_admin_engine.get_current_job()

	_if s _is _unset
	_then
		write("No Design")
		_leave 
	_endif

	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	#pj << s.inf_project.write_string
	st << s.status.write_string	
	change_set << mit_scheme_record_change_set.new(s)
		
	dm << gis_program_manager.databases[:design_admin]
	val << s.inf_project.write_string
	c << dm.collections[:swg_dsn_project].select(predicate.eq(:name,val))
	cur_rec << c.an_element()
	project_id << cur_rec.id.write_string 
	nama << cur_rec.name.write_string
	owner << s.owner.write_string
	#write(project_id,nama)


	p << rope.new()
	write(fat)
	_for i _over change_set.fast_elements()
	_loop
	#	write("start")
		_try _with err
		
		ob << i.current_record

		ex_name <<   ob.source_collection.name.write_string
		
		
		_if ex_name ="Conduit Route Face" _then
			_continue
		_endif
		
		_if ex_name ="ftth!demand_point"  _then
			nt << ob.notes
			_if nt _is _unset _orif nt = ""
			_then
				_continue
			_else
				a_nt << nt.split_by("|")
			#	write(a_nt.size)
				_if a_nt.size > 0 _then
					d_nt << a_nt[1].write_string+"."+a_nt[a_nt.size].write_string
				#	write(d_nt,"  :  ",fat)
					_if d_nt = fat _then
						write(ob.name)
						p.add(ob)
						count +<< 1
					_endif
				_endif
				
			_endif 
		_endif
		
		_when error
			_continue
		_endtry

	_endloop
	
	>> p

_endmethod
