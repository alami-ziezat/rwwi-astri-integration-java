_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.get_data_cell()

	#c_ur1 << ur1.conduits
	#cbl_ur1 << ur1.cables

	v << gis_program_manager.databases[:gis]
	vc << v.collections
	c_ur1 << vc[:ftth!zone]
	count << 0



	app << smallworld_product.pni_application() 
	mm << app.plugin(:map_plugin)
		
	s << swg_dsn_admin_engine.get_current_job()

	_if s _is _unset
	_then
		write("No Design")
		_leave 
	_endif

	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	#pj << s.inf_project.write_string
	st << s.status.write_string	
	change_set << mit_scheme_record_change_set.new(s)
		
	dm << gis_program_manager.databases[:design_admin]
	val << s.inf_project.write_string
	c << dm.collections[:swg_dsn_project].select(predicate.eq(:name,val))
	cur_rec << c.an_element()
	project_id << cur_rec.id.write_string 
	nama << cur_rec.name.write_string
	owner << s.owner.write_string
	#write(project_id,nama)
	_local area << s.project.project_areas.an_element().area

	p << rope.new()
	
	_for i _over change_set.fast_elements()
	_loop
		_try _with err
		ob << i.current_record
	
		_if ob.external_name ="Cell"  _then
			_if ob.type ="Macro Cell" _then 
				#write(ob)
				p.add(ob)
				count +<< 1
			_endif
			

		_endif

		_when error
			_continue
		_endtry
		#.table_list.add_last(data_pole_ur1)
	_endloop
#.table_list.add_last(
#print(p)
	

	>> p

_endmethod
$


_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.get_data_micro_cell(dp)

	#c_ur1 << ur1.conduits
	#cbl_ur1 << ur1.cables

	v << gis_program_manager.databases[:gis]
	vc << v.collections
	pol_col << vc[:ftth!zone]
	sc_col << vc[:sheath_splice]
	count << 0

	app << smallworld_product.pni_application() 
	mm << app.plugin(:map_plugin)
		

	write(dp.id)
	geo << dp.location.coord
	a_point << pseudo_point.new( geo )
	a_point.world << v.world
	p_predicate << predicate.interacts(:location, {a_point} )
	p_predicate_type << predicate.eq(:type, "Micro Cell")
	s_pol << pol_col.select( p_predicate _and p_predicate_type )
	write(s_pol.size)
	_if s_pol.size > 0 _then
		a_pol << s_pol.an_element()
		p_area << a_pol.location
		s_predicate << predicate.interacts(:location, p_area)
		s_predicate_fat << predicate.eq(:sheath_splice_object_type, "FAT")
		sc_pol << sc_col.Select(s_predicate _and s_predicate_fat)
	#	write("jumlah fat : ",sc_pol.size)
		_if sc_pol.size > 0
		_then
			fat << sc_pol.an_element()
		_else
			fat << _self.get_fat_cell(a_pol)
		_endif
		
	_endif
	

	>> a_pol,fat

_endmethod
$




