_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.get_fat_cell(cell)

	#write("hereODP")
	#c_ur1 << ur1.conduits
	#cbl_ur1 << ur1.cables

	#v << gis_program_manager.databases[:gis]
	#vc << v.collections
	#c_ur1 << .sc_col #vc[:pole]
	count << 0

	v << gis_program_manager.databases[:gis]
	vc << v.collections
	pol_col << vc[:ftth!zone]
	sc_col << vc[:sheath_splice]
	count << 0

	app << smallworld_product.pni_application() 
	mm << app.plugin(:map_plugin)
	t0 << system.time_now()
	count << 0
	_dynamic !current_world! << v.collections[:sw_gis!world].at(0,0)
	_dynamic !current_coordinate_system! << v.collections[:sw_gis!world].at(0,0).coordinate_system
		
	s << swg_dsn_admin_engine.get_current_job()

	_if s _is _unset
	_then
		write("No Design")
		_leave 
	_endif

	area << cell.location
	geo << area.bounds.centre
	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	#pj << s.inf_project.write_string
	st << s.status.write_string	
	change_set << mit_scheme_record_change_set.new(s)
		
	dm << gis_program_manager.databases[:design_admin]
	val << s.inf_project.write_string
	c << dm.collections[:swg_dsn_project].select(predicate.eq(:name,val))
	cur_rec << c.an_element()
	project_id << cur_rec.id.write_string 
	nama << cur_rec.name.write_string
	owner << s.owner.write_string
	#write(project_id,nama)

	p << rope.new()
	
	_for i _over change_set.fast_elements()
	_loop
		_try _with err
			
			ob << i.current_record
	
			_if ob.external_name ="Sheath Splice"  _then
				_if  ob.sheath_splice_object_type ="FAT" _then 
					
					geo << ob.location.coord
					a_point << pseudo_point.new( geo )
					a_point.world << v.world
					p_predicate << predicate.interacts(:location, {a_point} )
					p_predicate_type << predicate.eq(:type, "Micro Cell")
					s_pol << pol_col.select( p_predicate _and p_predicate_type )
					
					_if s_pol.size = 0
					_then
						p.add(ob)
						count +<< 1
					_endif
					
				_endif
				
			_endif
		_when error
			_continue
		_endtry

	_endloop


	_if p.size > 0 
	_then
		_for pp _over p.fast_elements()
		_loop
			
			c << pp.location
			pa << pseudo_point.new(c)
			pa.world << v.world
			
			a_buffe << pa.buffer(1000)
			a_buffe.world << !current_world!
		
			pred << predicate.interacts(:location , {a_buffe})
			pred_nm << predicate.eq(:id , cell.id)
			g << pol_col.select(pred _and pred_nm)
		
			_if g.size > 0
			_then
				j << pp
				_return  j
				_leave
			_endif

		_endloop
		#p << p.an_element()
	_elif p.size = 1 
	_then
		j << p #.an_element()
	_endif

	>> j

_endmethod
$


_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.scan_fat( c , buf_ti )
	## 
	##

	#write("here scan pole")
	v_gis << gis_program_manager.databases[:gis]
	pole_col << v_gis.collections[:pole]

	t0 << system.time_now()
	count << 0
	_dynamic !current_world! << v_gis.collections[:sw_gis!world].at(0,0)
	_dynamic !current_coordinate_system! << v_gis.collections[:sw_gis!world].at(0,0).coordinate_system

	#buf_ti << 20000
	
	
	pa << pseudo_point.new(c)
	pa.world << v_gis.world

	a_buffe << pa.buffer(buf_ti)
	a_buffe.world << !current_world!
	
	pred << predicate.interacts(:location , {a_buffe})
	g << pole_col.select(pred)

	#write(g.size)
	_if g.size > 0 _then
		h << _true
		_if g.size = 1 _then
			pl << g.an_element()
			y << pl.connected_routes()
			_if y.size > 0 _then
				a_pl << pl
			_endif
		_elif g.size > 1 _then
			_for gg _over g.fast_elements()
			_loop
			#	write(gg)
				y << gg.connected_routes()
				_if y.size > 0 _then
					a_pl << gg
				_endif	
			_endloop
			
		_endif

		_if a_pl _is _unset _then
			h << _false
		_endif
		
		
	_else
		h << _false
		a_pl << _unset 
	_endif
	#write(c," pole ", h)
	#write(pl)
	>> h,a_pl

_endmethod
$


