					cell_ai.entirecolumn.autofit
					cell_ai.numberformat << "general"
					cell_an.value << nt.write_string
					cell_an.entirecolumn.autofit
					
				_else 
					write("Data Dont have Location  :") #,a_rec.telco_pole_tag)
				_endif
				
			_endif
			_if count > 40
			_then
				_leave
			_endif
		_endloop
	_endif
	
		
	WorkBook.Release_Object ()
	Excel_Object.Release_Object ()

	# Auto-upload: generate_boq_excel() leaves the workbook open/unsaved (OLE
	# automation, no SaveAs), so we can't upload immediately - guide the user
	# through the remaining manual save + pick-the-file step instead.
	_if .items[:auto_upload_excel] _isnt _unset _andif .items[:auto_upload_excel].value = "On"
	_then
		_self.prompt_and_upload_after_export()
	_endif

_endmethod
$

_pragma(classify_level=basic, topic={sw2plp,api_client})
_method rwi_stela_integration_dialog.browse_excel()
	## Open a file dialog to select a local Excel file for upload to ASTRI.

	_local fd << file_dialog.new(_self, :ok_browse_excel|()|)
	fd.filter << {"Excel files (*.xlsx)", "*.xlsx"}

	_local current_path << .items[:local_excel_path].value.default("")
	_if current_path <> ""
	_then
		fd.directory << current_path
	_else
		fd.directory << system.getenv("TEMP").default("C:\")
	_endif

	fd.activate()
_endmethod
$

_pragma(classify_level=basic, topic={sw2plp,api_client})
_method rwi_stela_integration_dialog.ok_browse_excel(path)
	## Callback from file_dialog — store selected Excel path and enable Upload.
	## If this browse was triggered by the auto-upload guided flow, chain
	## straight into upload_excel() once a file has been picked.

	.items[:local_excel_path].value << path
	.items[:upload_excel_btn].enabled? << _true

	_if .pending_auto_upload?
	_then
		.pending_auto_upload? << _false
		_self.upload_excel()
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={sw2plp,api_client})
_method rwi_stela_integration_dialog.prompt_and_upload_after_export()
	## Auto-upload is On, but generate_boq_excel() leaves the workbook open and
	## unsaved (OLE Excel automation - no SaveAs call), unlike the workorder
	## dialog's create_boq(), which returns an already-saved path. Guide the user
	## through the remaining manual step instead of trying to detect Excel
	## save/close.

	.owner.show_alert("Save the Excel file in Excel, then click OK to select it for upload.")
	.pending_auto_upload? << _true
	_self.browse_excel()
_endmethod
$

_pragma(classify_level=restricted)
_private _method rwi_stela_integration_dialog.get_current_cluster_code()
	## Resolve the cluster code for the current design job from its project's
	## job_title, which follows the format "infra_type-infra_code" (e.g.
	## "cluster-KDR000292") — the last "-"-separated part is the code. This
	## avoids scanning the design's change set at all (mit_scheme_record_change_set
	## scans have been unreliable here — see prior revisions of this method),
	## and works regardless of what record types the job actually contains.

	_local s << swg_dsn_admin_engine.get_current_job()
	_if s _is _unset
	_then
		_return _unset
	_endif

	_try _with err
		_local job_title << s.project.job_title
		write("get_current_cluster_code: job_title = ", job_title)
		_if job_title _is _unset
		_then
			_return _unset
		_endif

		_local parts << job_title.write_string.split_by("-")

		_return parts[parts.size]
	_when error
		write("get_current_cluster_code: could not parse job_title - ", err.report_contents_string)
	_endtry

	_return _unset
_endmethod
$

_pragma(classify_level=basic, topic={sw2plp,api_client})
_method rwi_stela_integration_dialog.upload_excel()
	## Upload the browsed Excel file (Cluster/FAT/Homepass — per the Doc Type
	## dropdown) to the ASTRI "... Database Stella" document API.

	_local path << .items[:local_excel_path].value.default("")
	_if path = ""
	_then
		.owner.show_alert("Select an Excel file to upload first (Browse Excel).")
		_return
	_endif

	_local cluster_code << _self.get_current_cluster_code()
	_if cluster_code _is _unset _orif cluster_code = ""
	_then
		.owner.show_alert("Could not resolve a cluster code for the current design job.")
		_return
	_endif

	_local doc_type << .items[:upload_doc_type].value.default("Homepass")

	_local path_parts << path.split_by("\")
	_local file_name << path_parts[path_parts.size]

	write("Uploading ", doc_type, " document to ASTRI: ", path, " (cluster ", cluster_code, ")")

	_try _with errCond
		_local xml_result << astri_upload_stella_document(path, cluster_code, doc_type, file_name)

		_if xml_result _is _unset _orif xml_result = ""
		_then
			.owner.show_alert("Upload failed: no response from server")
			_return
		_endif

		_local xml_doc      << simple_xml.read_element_string(xml_result)
		_local success_elem << xml_doc.element_matching_name(:success)
		_local success      << success_elem _isnt _unset _andif
		                       success_elem.xml_result = "true"

		_if success
		_then
			write("Upload successful: ", doc_type, " - ", file_name)
			.owner.show_alert(write_string(doc_type, " document uploaded successfully.", newline_char,
				"File: ", file_name))
		_else
			_local err_elem << xml_doc.element_matching_name(:error)
			_local err_msg  << _if err_elem _isnt _unset
			                   _then >> err_elem.xml_result
			                   _else >> "Unknown error"
			                   _endif
			write("Upload failed: ", err_msg)
			.owner.show_alert(write_string("Upload failed:", newline_char, err_msg))
		_endif

	_when error
		write("Upload error: ", errCond.report_contents_string)
		.owner.show_alert(write_string("Upload error:", newline_char,
			errCond.report_contents_string))
	_endtry
_endmethod
$

_pragma(classify_level=restricted)
_method rwi_stela_integration_dialog.table_selected_ur2( selection )
	## 
	##
	v << gis_program_manager.databases[:gis]
	
	ed << .grs.plugin(:editor_manager)

	_global sel
	sel << selection
	.current_selection_ur2 << selection.get_row_data_from_selection().an_element()
	_if .current_selection_ur2.external_name ="Fibre Figure Eight" _then 
		p << .current_selection_ur2.get_structure()
		ef << ed.display_object_in_embedded_editor(.current_selection_ur2)
		#.mapman.goto(p)
		.grs.databus.make_data_available(:goto_request,{p, :highlight?, _true})
	_elif .current_selection_ur2.external_name ="Sheath (LOC)" _then

		ef << ed.display_object_in_embedded_editor(.current_selection_ur2)
		#ef.select_spatial_context_and_goto()
		#.current_selection_ur2.goto_border #mit!goto_bounds(v.world)
		#.current_selection_ur2.get_geometry_set_for_highlight(v.world)
		#ef.goto_in_current_world()
		#ef.select_in_map()
		#ef.highlight_rwo()
		#write("goto..")
		#.mapman.goto(.current_selection_ur2)

		#ef.select_spatial_context_and_goto()
		ef.goto_in_current_world()
		#ef.select_in_map()
		ef.highlight_rwo()
	_else
		ef << ed.display_object_in_embedded_editor(.current_selection_ur2)
		#.mapman.goto(.current_selection_ur2)
		ef.goto_in_current_world()
		#ef.select_in_map()
		ef.highlight_rwo()
		#.app.databus.make_data_available(:goto_request,{.current_selection_ur2, :highlight?, _true})
	_endif
	
	#print(.current_selection_ur2 )
_endmethod
$


