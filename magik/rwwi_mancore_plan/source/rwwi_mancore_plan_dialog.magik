_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.update_booking_button_states()
	##
	## Update booking button states based on table selections and status
	##
	## BOOKED: Requires matching counts AND all records IDLE (not TAKEN)
	## RELEASE: Enable if ANY records selected (no IDLE check)
	## ACTIVE: Enable if ALL records are BOOKED (transport_remarks = "BOOKED")
	##

	# Get current status
	_local status << .items[:status_field].value.default("BOOKED")

	_local enable_feeder? << _false
	_local enable_subfeeder? << _false

	_if status = "BOOKED"
	_then
		# BOOKED mode: Must match counts AND all records must be IDLE
		_if .feeder_count > 0 _andif .subfeeder_count > 0 _andif
		    .feeder_count = .subfeeder_count
		_then
			# Check if all records in both tables are IDLE
			_local feeder_idle? << _self.check_all_records_idle(.feeder_table_selection)
			_local subfeeder_idle? << _self.check_all_records_idle(.subfeeder_table_selection)

			_if feeder_idle? _andif subfeeder_idle?
			_then
				enable_feeder? << _true
				write("Booking Feeder ENABLED (BOOKED) - Table 1: ", .feeder_count, ", Table 2: ", .subfeeder_count, " (all IDLE)")
			_else
				write("Booking Feeder DISABLED (BOOKED) - Some records are not IDLE")
				write("  Table 1 all IDLE: ", feeder_idle?, ", Table 2 all IDLE: ", subfeeder_idle?)
			_endif
		_else
			write("Booking Feeder DISABLED (BOOKED) - Counts don't match or zero")
			write("  Table 1: ", .feeder_count, ", Table 2: ", .subfeeder_count)
		_endif

		_if .subfeeder_count > 0 _andif .fdt_count > 0 _andif
		    .subfeeder_count >= .fdt_count
		_then
			# Check if all records in both tables are IDLE
			_local subfeeder_idle? << _self.check_all_records_idle(.subfeeder_table_selection)
			_local fdt_idle? << _self.check_all_records_idle(.fdt_table_selection)

			_if subfeeder_idle? _andif fdt_idle?
			_then
				enable_subfeeder? << _true
				write("Booking Subfeeder ENABLED (BOOKED) - Table 2: ", .subfeeder_count, ", Table 3: ", .fdt_count, " (all IDLE)")
			_else
				write("Booking Subfeeder DISABLED (BOOKED) - Some records are not IDLE")
				write("  Table 2 all IDLE: ", subfeeder_idle?, ", Table 3 all IDLE: ", fdt_idle?)
			_endif
		_else
			write("Booking Subfeeder DISABLED (BOOKED)")
			write("  Table 2: ", .subfeeder_count, ", Table 3: ", .fdt_count)
		_endif

	_elif status = "RELEASE"
	_then
		# RELEASE mode: Enable if ANY records selected
		_if .feeder_count > 0
		_then
			enable_feeder? << _true
			write("Booking Feeder ENABLED (RELEASE) - Table 1: ", .feeder_count, " records selected")
		_else
			write("Booking Feeder DISABLED (RELEASE) - No records selected")
		_endif

		_if .subfeeder_count > 0
		_then
			enable_subfeeder? << _true
			write("Booking Subfeeder ENABLED (RELEASE) - Table 2: ", .subfeeder_count, " records selected")
		_else
			write("Booking Subfeeder DISABLED (RELEASE) - No records selected")
		_endif

	_elif status = "ACTIVE"
	_then
		# ACTIVE mode: Enable only if ALL selected records are already BOOKED
		_if .feeder_count > 0
		_then
			# Check if all feeder records are BOOKED
			_local all_booked? << _self.check_all_records_booked(.feeder_table_selection)
			_if all_booked?
			_then
				enable_feeder? << _true
				write("Booking Feeder ENABLED (ACTIVE) - Table 1: ", .feeder_count, " records selected and all BOOKED")
			_else
				write("Booking Feeder DISABLED (ACTIVE) - Some records are not BOOKED")
			_endif
		_else
			write("Booking Feeder DISABLED (ACTIVE) - No records selected")
		_endif

		_if .subfeeder_count > 0
		_then
			# Check if all subfeeder records are BOOKED
			_local all_booked? << _self.check_all_records_booked(.subfeeder_table_selection)
			_if all_booked?
			_then
				enable_subfeeder? << _true
				write("Booking Subfeeder ENABLED (ACTIVE) - Table 2: ", .subfeeder_count, " records selected and all BOOKED")
			_else
				write("Booking Subfeeder DISABLED (ACTIVE) - Some records are not BOOKED")
			_endif
		_else
			write("Booking Subfeeder DISABLED (ACTIVE) - No records selected")
		_endif
	_endif

	.items[:booking_feeder].enabled? << enable_feeder?
	.items[:booking_subfeeder].enabled? << enable_subfeeder?

_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.check_all_records_booked(selection)
	##
	## Check if all records in selection have transport_remarks = "BOOKED"
	## Parameters:
	##   selection - Table selection object
	## Returns:
	##   true if all records are BOOKED, false otherwise
	##

	_if selection _is _unset
	_then
		_return _false
	_endif

	_local records << selection.get_row_data_from_selection()

	_if records.empty?
	_then
		_return _false
	_endif

	# Check each record
	_for rec _over records.fast_elements()
	_loop
		_local remarks << rec[:transport_remarks].default("")
		_if remarks <> "BOOKED"
		_then
			# Found a record that's not BOOKED
			_return _false
		_endif
	_endloop

	# All records are BOOKED
	_return _true

_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.check_all_records_idle(selection)
	##
	## Check if all records in selection are IDLE (transport_status != "TAKEN")
	## This ensures records haven't been booked or activated yet
	## Parameters:
	##   selection - Table selection object
	## Returns:
	##   true if all records are IDLE, false otherwise
	##

	_if selection _is _unset
	_then
		_return _false
	_endif

	_local records << selection.get_row_data_from_selection()

	_if records.empty?
	_then
		_return _false
	_endif

	# Check each record
	_for rec _over records.fast_elements()
	_loop
		_local t_status << rec[:transport_status].default("")
		_if t_status = "TAKEN"
		_then
			# Found a record that's already TAKEN (BOOKED or ACTIVE)
			write("  Found non-IDLE record - transport_status: ", t_status,
			     ", remarks: ", rec[:transport_remarks].default(""))
			_return _false
		_endif
	_endloop

	# All records are IDLE
	_return _true

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.table_selected_ur2( selection )
	##
	## Handle selection in FDT table
	## Store selection and count records
