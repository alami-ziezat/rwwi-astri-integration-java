_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.new(_optional owner, framework)
	## 
	## 
	>> _clone.init(owner, framework)
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.init(owner, framework)
	## 
	##
	_super.init()

	.ev << gis_program_manager.cached_dataset(:gis)
	.owner << owner
	.grs << framework

	.grs << smallworld_product.pni_application()
	.mapman << .grs.plugin(:map_plugin)
	.ed << .grs.plugin(:editor_manager)
	.items << hash_table.new()
	.current_selection_ur1 << _unset
	.current_selection_ur2 << _unset
	.swl1 << _unset
	.swl2 << _unset
	.swl3 << _unset 
	# Data holder
	.table_list << rope.new()
	.table_list2 << rope.new()
	.records << rope.new()
	.a_sc << _unset 
	.engine << ""

	# Add dependent dialog to plugin
	_self.add_dependent(.owner)
        >> _self
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.activate_in( parent )
	## 
	##
	parent.title << "FTTx Mancore Plan"

	mb << menubar.new( parent )

	m << _unset

	# Create the first pulldown menu and its button items
	p << pulldown_menu.new()
	#button_item.new( p, "Load KML...", _self , :get_kml|()| )
	button_item.new( p, "Clear",  _self , :clear|()| )
	button_item.new( p, "Refresh", _self , :refresh|()| )
	# Create the "File" button in the menubar
	menu_button_item.new( mb, "File", p )

	
	top_outer << sw_container.new( parent, _unset, 1,
				       :outer_spacing, 4,
				       :row_spacing, 4,
				       :row_resize_values, {0,1},
				       :width, 700,
				       :height, 800 )

	first_con << sw_border_container.new( top_outer, _unset, 1,
					      :label, "",
					      :row_resize_values,{0,1})
	
	_self.build_toolbar( first_con )

	thirt_con << sw_border_container.new( top_outer, _unset, 1,
					      :label, "",
					      :width, 30,
					      :row_resize_values,{0})
	
	_self.build_toolbar_second( thirt_con )
	_self.build_label_result2( thirt_con )
	
	second_con << sw_border_container.new( top_outer, _unset, 2,
					      :label, "",
					      :width, 500,
					      :row_resize_values,{0})

	#_self.build_toolbar_exec( second_con )
	_self.build_table_ur1( second_con )
	_self.build_table_ur2( second_con )
	
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.build_toolbar( parent )
	## 
	##
	toolbar << sw_container.new( parent, 1, _unset,
				     :col_spacing, 15  
				)
	file_toolbar << sw_toolbar_container.new( toolbar, _false,
						  :background_type, :button_group,
						  :button_group_height, sw_item.default_item_height )

	sw_label_item.new( file_toolbar, "Infrastructure:")
	
	.items[:infra] << sw_text_item.new( file_toolbar, :model, _self,
					       :editable?, _false,
					       :text_items, {{:feeder,"Feeder"},
							     {:subfeeder,"SubFeeder"},
							     {:cluster,"Cluster"}
					       }
					   )


	sw_label_item.new( file_toolbar, "Source:")
	
	.items[:kmlsource] << sw_text_item.new( file_toolbar, :model, _self,
					       :editable?, _false,
					       :text_items, { {:selected,"Selected Object"},
							       {:cable,"Cable"},
							       {:trail,"Trail"},
							       {:olt,"OLT"},
							       {:closure,"CLosure"},
							       {:fdt,"FDT"},
							       {:fat,"FAT"},
							       {:cable,"Cable"},
							       {:kml,"KML"}
					       }
					   )



	.items[:add_ur1] << sw_button_item.new( file_toolbar,
					       :image, {:find, :ui_resources},
					       :model, _self,
					       :selector, :get_cable|()|,
					       :tooltip, "Cari Closure Terdekat" )


	sw_label_item.new( file_toolbar, "    Cluster " )
	
	.items[:nm] << sw_text_item.new( file_toolbar,
					 :editable?, _true,
					 :enabled?, _false,
					 :display_length, 25)



_endmethod
$

