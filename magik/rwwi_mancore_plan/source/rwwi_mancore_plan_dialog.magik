_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.get_rwo()
	## Get RWO from selected object and store in .selected_rwo slot

	r << _self.selected_str()

	_if r _isnt _unset _andif (r.external_name ="Aerial Route" _orif r.external_name = "Underground Route")
	_then
		rr << r.cables()
		_if rr.size  = 1 _then
			cab << rr.an_element()

			# Store selected RWO in slot
			.selected_rwo << cab

			# Set limit field to fiber_count (default value)
			_local fiber_count << cab.fiber_count.default(100)
			.items[:limit_field].value << fiber_count.write_string

			.items[:log].text <<""
			.items[:log].append("DATA CABLE SELECTED")
			.items[:log].append(newline_char)
			.items[:log].append("===================")
			.items[:log].append(newline_char)
			.items[:log].append(newline_char)
			.items[:log].append("Name         : "+ cab.name)
			.items[:log].append(newline_char)
			.items[:log].append("Spec         : "+ cab.spec_id)
			.items[:log].append(newline_char)
			.items[:log].append("OLT          : "+ cab.olt)
			.items[:log].append(newline_char)
			.items[:log].append("Cluster Code : "+ cab.cluster_code.default(""))
			.items[:log].append(newline_char)
			.items[:log].append("Feeder       : "+ cab.feeder_code.default(""))
			.items[:log].append(newline_char)
			.items[:log].append("SubFeeder    : "+ cab.subfeeder_code.default(""))
			.items[:log].append(newline_char)
			.items[:log].append(newline_char)

			# Determine network type based on populated code fields
			_local network_type << ""
			_local subfeeder_code << cab.subfeeder_code.default("")
			_local feeder_code << cab.feeder_code.default("")
			_local cluster_code << cab.cluster_code.default("")

			_if subfeeder_code <> "" _andif subfeeder_code _isnt _unset
			_then
				network_type << "subfeeder"
			_elif feeder_code <> "" _andif feeder_code _isnt _unset
			_then
				network_type << "feeder"
			_elif cluster_code <> "" _andif cluster_code _isnt _unset
			_then
				network_type << "cluster"
			_endif

			# Also check sheath_network_type as fallback
			_if network_type = ""
			_then
				network_type << cab.sheath_network_type.default("").lowercase
			_endif

			.items[:log].append("Network Type : "+ network_type)
			.items[:log].append(newline_char)
			.items[:log].append(newline_char)

			.items[:log].append("DATA Astri")
			.items[:log].append(newline_char)
			.items[:log].append("===========")

			# Populate subfeeder field with priority: cable subfeeder_code → design job_title
			_local populated_subfeeder << ""

			# Priority 1: Check cable's subfeeder_code
			_if subfeeder_code <> "" _andif subfeeder_code _isnt _unset
			_then
				populated_subfeeder << subfeeder_code
				.items[:subfeeder_field].value << populated_subfeeder
				write("Populated subfeeder field from cable subfeeder_code: ", populated_subfeeder)
			_else
				# Priority 2: Try to get from design job_title
				_local design << _unset
				_local project_subfeeder_code << ""
				_try
					design << swg_dsn_admin_engine.get_current_job()
					_if design _isnt _unset
					_then
						project_subfeeder_code << design.project.perform(:job_title).default("")
						_if project_subfeeder_code <> "" _andif project_subfeeder_code _isnt _unset
						_then
							populated_subfeeder << project_subfeeder_code
							.items[:subfeeder_field].value << populated_subfeeder
							write("Populated subfeeder field from project job_title: ", populated_subfeeder)
						_endif
					_endif
				_when error
					# Design doesn't exist or error - that's OK, user can manually enter subfeeder
					write("No active design - subfeeder field can be manually entered")
				_endtry
			_endif

			# Populate feeder field with cable's feeder_code (if available)
			_if feeder_code <> "" _andif feeder_code _isnt _unset
			_then
				.items[:feeder_field].value << feeder_code
				write("Populated feeder field from cable feeder_code: ", feeder_code)
			_else
				# Clear feeder field if no feeder_code
				.items[:feeder_field].value << ""
				write("Feeder field cleared (no feeder_code in cable)")
			_endif

			# Enable get_mancore button for all network types (feeder, subfeeder, cluster)
			_if network_type = "feeder" _orif network_type = "subfeeder" _orif network_type = "cluster"
			_then
				.items[:get_mancore].enabled? << _true
				write("    >> Get Mancore button ENABLED for network type: ", network_type)
			_else
				.items[:get_mancore].enabled? << _false
				write("    >> Get Mancore button DISABLED (unknown network type: '", network_type, "')")
			_endif

			# Clear all tables when new cable is selected
			.feeder_table_list.empty()
			.table_list.empty()
			.table_list2.empty()

			# Reset counts
			.feeder_count << 0
			.subfeeder_count << 0
			.fdt_count << 0

			_self.changed(:feeder_connection_table, :refresh)
			_self.changed(:device_connection_table, :refresh)
			_self.changed(:table_ur2, :refresh)
			.items[:feeder_table].refresh()
			.items[:table].refresh()
			.items[:table2].refresh()
		_else
			cab << _unset
			.selected_rwo << _unset
			# No cable selected - disable button
			.items[:get_mancore].enabled? << _false
		_endif
	_else
		_self.show_message("Pilih Kabel")
		.selected_rwo << _unset
		# No valid selection - disable button
		.items[:get_mancore].enabled? << _false
	_endif

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.clear()
#	##
#	##

	.current_selection_ur1 << _unset
	.current_selection_ur2 << _unset
	.swl1 << _unset
	.swl2 << _unset
	.swl3 << _unset


	.feeder_table_list.empty()
	.table_list.empty()
	.table_list2.empty()
	.items[:feeder_table].refresh()
	.items[:table].refresh()
	.items[:table2].refresh()
#
#
	.items[:feeder_table].clear_selection()
	.items[:table].clear_selection()
	_self.changed(:feeder_connection_table, :refresh)
	_self.changed(:device_connection_table, :refresh)
	_self.changed(:table_ur2, :refresh)

	.items[:log].text << ""

	# Reset homepass field
	.items[:homepass_field].value << "0"

	# Reset subfeeder field
	.items[:subfeeder_field].value << ""

	# Reset feeder field
	.items[:feeder_field].value << ""

	# Reset counts
	.feeder_count << 0
	.subfeeder_count << 0
	.fdt_count << 0

	# Disable buttons when cleared
	.items[:get_mancore].enabled? << _false
	.items[:booking_feeder].enabled? << _false
	.items[:booking_subfeeder].enabled? << _false

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.clear_selections()
	##
	## Clear all table selections without clearing table data
	##

	write("Clearing all table selections...")

	# Clear selection references
	.feeder_table_selection << _unset
	.subfeeder_table_selection << _unset
	.fdt_table_selection << _unset

	# Clear table selections in UI
	.items[:feeder_table].clear_selection()
	.items[:table].clear_selection()
	.items[:table2].clear_selection()

	# Reset counts
	.feeder_count << 0
	.subfeeder_count << 0
	.fdt_count << 0

	# Disable booking buttons
	.items[:booking_feeder].enabled? << _false
	.items[:booking_subfeeder].enabled? << _false

	write("All table selections cleared")

_endmethod
$

_method rwwi_mancore_plan_dialog.selected_str()

	#setvars()
	#grs << smallworld_product.pni_application()

	grs << smallworld_product.application(:pni)
	#mapman << grs.plugin(:maps)
	mapman << grs.plugin(:map_plugin)

	sel << mapman.current_map.current_selection

	_if sel.size > 0
	_then
		_return sel.an_element().rwo
		#_self.show_message("Pilih Kabel")
	#_else
	#	an_rwo << sel.an_element().rwo
	_endif
	#	>> an_rwo
_endmethod
