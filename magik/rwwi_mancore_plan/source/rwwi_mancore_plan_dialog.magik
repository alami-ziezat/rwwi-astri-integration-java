_pragma(classify_level=basic, topic={sw2plp,api_client})
_method rwwi_mancore_plan_dialog.build_feeder_table( parent )
	##
	## Build feeder connectivity table
	##
	.items[:feeder_table] << a_table << sw_table.new( parent,
				 :model, _self,
				 :label, "Feeder Connectivity",
				 :aspect, :feeder_connection_table,
				 :data_selector, :populate_feeder_connection_table|()|,
				 :selection_notifier, :feeder_connection_table_selected|()|,
				 :double_click_notifier,:|open_editor_feeder()|,
				 :row_lines?, _true,
				 :selection_type, :row, # :row or :cell
				 :selection_mode, :many, # :many or :one
				 :col_alignment, :fill,
				 :row_alignment, :fill,
				 :min_height, 250,
				 :enable_horizontal_scrollbar?, _true)
	a_table.n_cols << 13
	a_table.set_column_labels({"Source Type",
				   "Source Code",
				   "Transport Code",
				   "Tube Count",
				   "Core Count",
				   "Tube No",
				   "Core No",
				   "SW Core",
				   "Status",
				   "Dest Code",
				   "Dest Tube No",
				   "Dest Core No",
				   "Dest Name"
				  })

	a_table.col_resize_values << {0.8,1.0,1.0,0.6,0.6,0.6,0.6,0.6,0.6,0.8,0.6,0.6,3}

	# The table can be filtered, sorted and columns can be
	# reordered and hidden
	a_table.enable_filter? << _true
	a_table.enable_sort? << _true
	a_table.enable_manage_columns? << _true

	a_table.set_column_sort_procedure(1, a_table.strings_with_numbers_sort_proc)
	a_table.set_column_sort_procedure(2, a_table.strings_with_numbers_sort_proc)
	a_table.set_column_sort_procedure(3, a_table.strings_with_numbers_sort_proc)
	a_table.set_column_sort_procedure(4, a_table.strings_with_numbers_sort_proc)
	a_table.set_column_sort_procedure(5, a_table.strings_with_numbers_sort_proc)
	a_table.set_column_sort_procedure(6, a_table.strings_with_numbers_sort_proc)
	a_table.set_column_sort_procedure(7, a_table.strings_with_numbers_sort_proc)

_endmethod
$

