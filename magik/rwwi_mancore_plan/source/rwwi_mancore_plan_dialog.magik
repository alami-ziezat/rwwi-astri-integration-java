_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.new(_optional owner, framework)
	## 
	## 
	>> _clone.init(owner, framework)
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.init(owner, framework)
	##
	## Initialize dialog - using SW_SWIFT components
	##

	.owner << owner
	.grs << framework

	.ev << gis_program_manager.cached_dataset(:gis)
	.mapman << .grs.plugin(:map_plugin)
	.ed << .grs.plugin(:editor_manager)
	.items << property_list.new()
	.current_selection_ur1 << _unset
	.current_selection_ur2 << _unset
	.swl1 << _unset
	.swl2 << _unset
	.swl3 << _unset
	.selected_rwo << _unset
	# Data holder
	.table_list << rope.new()
	.table_list2 << rope.new()
	.records << rope.new()
	.a_sc << _unset
	.engine << rwwi_mancore_plan_engine.new(_self, framework)

	# Add dependent dialog to plugin
	_self.add_dependent(.owner)
	>> _super.init()
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.activate_in( parent )
	## 
	##
	parent.title << "FTTx Mancore Plan"

	#mb << menubar.new( parent )

	#m << _unset

	# Create the first pulldown menu and its button items
	#p << pulldown_menu.new()
	#button_item.new( p, "Load KML...", _self , :get_kml|()| )
	#button_item.new( p, "Clear",  _self , :clear|()| )
	#button_item.new( p, "Refresh", _self , :refresh|()| )
	# Create the "File" button in the menubar
	#menu_button_item.new( mb, "File", p )

	# Create top-level sw_canvas_container (required for SWIFT)
	.items[:top] << top_c << sw_canvas_container.new(
		parent, 4, 1,
		:width, 900,
		:height, 600,
		:outer_spacing, 5,
		:row_spacing, 5,
		:identifier, :top_container,
		:model, _self)

	# Create outer container with flexible row sizing
	# 4 rows: Toolbar (fixed), Table1 (flexible), Table2 (flexible), Log (flexible)
	.items[:outer] << outer << sw_container.new(top_c, 4, 1,
		:row_resize_values, {0, 1, 1, 1})  # Toolbar fixed, Tables flexible, Log flexible

	# Build toolbar
	_self.build_toolbar( outer )

	# Build tables
	_self.build_device_connection_table( outer )
	_self.build_table_ur2( outer )

	# Build log window
	_self.build_log( outer )

	# Return the top-level container (required)
	_return top_c
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.build_toolbar( parent )
	##
	## Build main toolbar with source selector and action buttons
	##
	toolbar << sw_container.new( parent, 1, _unset,
				     :col_spacing, 15
				)
	file_toolbar << sw_toolbar_container.new( toolbar, _false,
						  :background_type, :button_group,
						  :button_group_height, sw_item.default_item_height )

	sw_label_item.new( file_toolbar, "Source:")

	.items[:kmlsource] << sw_text_item.new( file_toolbar, :model, _self,
					       :editable?, _false,
					       :value, :cable,
					       :text_items, {{:olt, "OLT"},
							     {:cable, "Cable"}
					       }
					   )

	.items[:get_rwo] << sw_button_item.new( file_toolbar,
					       :image, {:find, :ui_resources},
					       :model, _self,
					       :selector, :get_rwo|()|,
					       :tooltip, "Get Selected Object" )

	sw_label_item.new( file_toolbar, "Limit:" )

	.items[:limit_field] << sw_text_item.new( file_toolbar,
						  :display_length, 10,
						  :model, _self,
						  :value, "100",
						  :tooltip, "Limit for device connection query (default: fiber count)" )

	sw_label_item.new( file_toolbar, "  " )

	.items[:check_upstream] << sw_button_item.new( file_toolbar,
					       :image, {:back, :ui_resources},
					       :model, _self,
					       :selector, :check_upstream|()|,
					       :tooltip, "Check Upstream Device Connection" )
	.items[:check_upstream].enabled? << _false

	.items[:check_current] << sw_button_item.new( file_toolbar,
					       :image, {:forward, :ui_resources},
					       :model, _self,
					       :selector, :check_current|()|,
					       :tooltip, "Check Current Device Connection" )
	.items[:check_current].enabled? << _false

	.items[:clear] << sw_button_item.new( file_toolbar,
					       :image, {:clear, :ui_resources},
					       :model, _self,
					       :selector, :clear|()|,
					       :tooltip, "Clear" )

	.items[:assign_fiber] << sw_button_item.new( file_toolbar,
					       :image, {:export_settings, :ui_resources},
					       :model, _self,
					       :selector, :assign_fiber|()|,
					       :tooltip, "Assign Fiber" )
	.items[:assign_fiber].enabled? << _false

_endmethod
$

