_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.query_and_populate_tables(infra_type, infra_code, level_label)
	## Common method to query API and database, then populate both tables
	## Parameters:
	##   infra_type   - "feeder" or "subfeeder"
	##   infra_code   - feeder_code or subfeeder_code
	##   level_label  - "Upstream" or "Current Level" for log display

	_local cab << .selected_rwo
	_local subfeeder_code << cab.subfeeder_code.default("")

	# Get limit value from text field
	_local limit_str << .items[:limit_field].value.default("100")
	_local limit << limit_str.as_number().default(100)

	# Call engine to get device connections
	.items[:log].append(newline_char)
	.items[:log].append("Calling Device Connection API (" + level_label + ")...")
	.items[:log].append(newline_char)
	.items[:log].append("  Infrastructure Type: " + infra_type)
	.items[:log].append(newline_char)
	.items[:log].append("  Infrastructure Code: " + infra_code)
	.items[:log].append(newline_char)
	.items[:log].append("  Limit: " + limit.write_string)
	.items[:log].append(newline_char)
	.items[:log].append(newline_char)

	_local result << .engine.get_device_connections(infra_type, infra_code, limit, 0)

	# Check for errors from engine
	_if result[:error_message] _isnt _unset
	_then
		.items[:log].append("ERROR: " + result[:error_message])
		.items[:log].append(newline_char)
		_self.show_message("Error calling device connection API:" + newline_char +
				   result[:error_message])
		_return
	_endif

	# Display DATA Astri section with parsed results
	_if result[:success] _is _true
	_then
		.items[:log].append("DATA Astri (" + level_label + ")")
		.items[:log].append(newline_char)
		.items[:log].append("===========")
		.items[:log].append(newline_char)
		.items[:log].append("Fiber Count Query   : " + result[:count].write_string)
		.items[:log].append(newline_char)
		.items[:log].append("Total Fiber Count   : " + result[:count_all].write_string)
		.items[:log].append(newline_char)
		.items[:log].append("Taken               : " + result[:taken_count].write_string)
		.items[:log].append(newline_char)
		.items[:log].append("Idle (Not Taken)    : " + result[:idle_count].write_string)
		.items[:log].append(newline_char)
		.items[:log].append(newline_char)

		# Query and display homepass information
		_local homepass << .engine.get_homepass(infra_type, infra_code)
		.items[:log].append("Homepass (Demand Points)")
		.items[:log].append(newline_char)
		.items[:log].append("=======================")
		.items[:log].append(newline_char)
		.items[:log].append("Total Homepass      : " + homepass.size.write_string)
		.items[:log].append(newline_char)
		.items[:log].append(newline_char)

		# Store infra_type and populate table1 with device connection data
		.current_infra_type << result[:infra_type].as_symbol()
		.table_list.empty()

		_if result[:data] _isnt _unset
		_then
			_for conn _over result[:data].fast_elements()
			_loop
				.table_list.add(conn)
			_endloop
		_endif

		# Refresh table1
		_self.changed(:device_connection_table, :refresh)
		.items[:table].refresh()

	_else
		.items[:log].append(newline_char)
		.items[:log].append("API returned success: false")
		.items[:log].append(newline_char)
	_endif

	# Get destination code (subfeeder_code or project title from active design)
	_local destination_code << subfeeder_code
	_if destination_code = "" _orif destination_code _is _unset
	_then
		# Use project title from active design
		_local design << swg_dsn_admin_engine.get_current_job()
		_if design _isnt _unset
		_then
			destination_code << design.project.perform(:job_title).default("")
			write("  Using project title from active design: ", destination_code)
		_endif
	_endif

	_if destination_code = "" _orif destination_code _is _unset
	_then
		write("  WARNING: Cannot determine destination code for optical splitters")
		_return
	_endif

	# Query sheath_splice by subfeeder_code to get optical splitters
	.items[:log].append("Querying Optical Splitters...")
	.items[:log].append(newline_char)
	.items[:log].append("  Subfeeder Code: " + subfeeder_code)
	.items[:log].append(newline_char)
	.items[:log].append("  Destination Code: " + destination_code)
	.items[:log].append(newline_char)
	.items[:log].append(newline_char)

	_try _with err
		_local sc_col << .ev.collections[:sheath_splice]
		_if sc_col _is _unset
		_then
			_self.show_message("Collection sheath_splice not found")
			_return
		_endif

		# Query with two predicates: subfeeder_code AND sheath_splice_object_type = "FDT"
		_local pred1 << predicate.eq(:subfeeder_code, subfeeder_code)
		_local pred2 << predicate.eq(:sheath_splice_object_type, "FDT")
		_local pred << pred1.and(pred2)
		_local sheath_splices << sc_col.select(pred)

		write("  Found ", sheath_splices.size, " sheath_splice records with subfeeder_code: ", subfeeder_code)

		# Clear table2 and populate with optical splitters
		.table_list2.empty()
		_local splitter_count << 0

		_for ss _over sheath_splices.fast_elements()
		_loop
			# Get optical splitters from sheath_splice
			_local splitters << ss.optical_splitters
			_if splitters _isnt _unset
			_then
				_for splitter _over splitters.fast_elements()
				_loop
					_local splitter_name << splitter.name.default("")
					_local construction_status << splitter.construction_status.default("")

					# Extract core number from splitter name (last part after -)
					# Example: "FAT-SP.1" -> extract "1"
					_local dest_core_number << ""
					_local parts << splitter_name.split_by(%-)
					_if parts.size > 0
					_then
						_local last_part << parts.last.default("")
						# Extract number from "SP.x" format
						_if last_part.index_of_seq("SP.") _isnt _unset
						_then
							_local dot_parts << last_part.split_by(%.)
							_if dot_parts.size >= 2
							_then
								dest_core_number << dot_parts[2].default("")
							_endif
						_endif
					_endif

					# Create property list for table2
					_local splitter_data << property_list.new_with(
						:destination_code, destination_code,
						:splitter_name, splitter_name,
						:dest_tube_number, "1",
						:dest_core_number, dest_core_number,
						:status, construction_status,
						:splitter_object, splitter)

					.table_list2.add(splitter_data)
					splitter_count +<< 1
				_endloop
			_endif
		_endloop

		.items[:log].append("Optical Splitters Found")
		.items[:log].append(newline_char)
		.items[:log].append("=======================")
		.items[:log].append(newline_char)
		.items[:log].append("Total Splitters     : " + splitter_count.write_string)
		.items[:log].append(newline_char)

		# Refresh table2
		_self.changed(:table_ur2, :refresh)
		.items[:table2].refresh()

	_when error
		.items[:log].append("ERROR: " + err.report_contents_string)
		.items[:log].append(newline_char)
		_self.show_message("Error querying optical splitters:" + newline_char +
				   err.report_contents_string)
		write("ERROR querying optical splitters: ", err.report_contents_string)
	_endtry

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.display_rwo_info()
	## Display selected RWO info in the log
	## Called when check buttons are pressed to preserve RWO info after log reset

	_if .selected_rwo _is _unset _then _return _endif

	_local cab << .selected_rwo
	_local network_type << cab.sheath_network_type.default("").lowercase

	.items[:log].append("Selected Cable Information")
	.items[:log].append(newline_char)
	.items[:log].append("==========================")
	.items[:log].append(newline_char)
	.items[:log].append("Cable Name   : " + cab.name.default(""))
	.items[:log].append(newline_char)
	.items[:log].append("OLT Code     : " + cab.olt_code.default(""))
	.items[:log].append(newline_char)
	.items[:log].append("Cluster Code : " + cab.cluster_code.default(""))
	.items[:log].append(newline_char)
	.items[:log].append("Feeder       : " + cab.feeder_code.default(""))
	.items[:log].append(newline_char)
	.items[:log].append("SubFeeder    : " + cab.subfeeder_code.default(""))
	.items[:log].append(newline_char)
	.items[:log].append("Network Type : " + network_type)
	.items[:log].append(newline_char)
	.items[:log].append(newline_char)

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.check_upstream()
	## Check upstream device connections and optical splitters
	## Uses sheath_network_type to determine infrastructure level:
	##   - subfeeder network → query by feeder
	##   - cluster network → query by subfeeder

	# Reset log and display RWO info
	.items[:log].text << ""
	_self.display_rwo_info()

	# Ensure design is active
	_try
		_local design << swg_dsn_admin_engine.get_current_job()
		_if design _is _unset
		_then
			_self.show_message("No active design. Please activate a design first.")
			_return
		_endif
		_local project_name << design.project.perform(:job_title).default("")
		write("Active design: ", project_name)
	_when error
		_self.show_message("Cannot get active design. Please activate a design first.")
		_return
	_endtry

	_if .selected_rwo _is _unset
	_then
		_self.show_message("Please select a cable first using the Get RWO button")
		_return
	_endif

	_local cab << .selected_rwo
	_local network_type << cab.sheath_network_type.default("").lowercase
	_local feeder_code << cab.feeder_code.default("")
	_local subfeeder_code << cab.subfeeder_code.default("")

	write("Checking upstream (network type: ", network_type, ")...")

	_local infra_type << _unset
	_local infra_code << _unset

	# Determine infrastructure based on sheath_network_type
	_if network_type = "subfeeder"
	_then
		# Subfeeder network → query by feeder (upstream)
		infra_type << "feeder"
		infra_code << feeder_code
		write("  Network type: subfeeder → Using FEEDER (upstream): ", infra_code)
	_elif network_type = "cluster"
	_then
		# Cluster network → query by subfeeder (upstream)
		infra_type << "subfeeder"
		infra_code << subfeeder_code
		write("  Network type: cluster → Using SUBFEEDER (upstream): ", infra_code)
	_else
		_self.show_message("Invalid network type for upstream query: " + network_type + newline_char +
				   "Expected: 'subfeeder' or 'cluster'")
		_return
	_endif

	_if infra_code = "" _orif infra_code _is _unset
	_then
		_self.show_message("Missing infrastructure code for upstream query")
		_return
	_endif

	# Call common method to query and populate both tables
	_self.query_and_populate_tables(infra_type, infra_code, "Upstream")

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.check_current()
	## Check current device connections and optical splitters
	## Uses sheath_network_type to determine infrastructure level:
	##   - feeder network → query by feeder
	##   - subfeeder network → query by subfeeder

	# Reset log and display RWO info
	.items[:log].text << ""
	_self.display_rwo_info()

	# Ensure design is active
	_try
		_local design << swg_dsn_admin_engine.get_current_job()
		_if design _is _unset
