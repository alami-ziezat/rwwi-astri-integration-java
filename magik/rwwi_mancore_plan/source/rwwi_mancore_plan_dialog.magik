		{ :mapman,           _unset },
		{ :ed,               _unset },
		{ :a_sc,               _unset },
		{ :ev,               _unset },
		{ :records,          _unset },
		{ :swl1,          _unset },
		{ :swl2,          _unset },
		{ :swl3,          _unset },
		{ :selected_rwo,     _unset },
		{ :current_infra_type, _unset },
