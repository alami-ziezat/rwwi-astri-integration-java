					_endif

					# Create property list for table2
					_local splitter_data << property_list.new_with(
						:destination_code, destination_code,
						:splitter_name, splitter_name,
						:dest_tube_number, "1",
						:dest_core_number, dest_core_number,
						:status, construction_status,
