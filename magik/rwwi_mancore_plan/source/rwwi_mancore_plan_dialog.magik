_pragma(classify_level=basic, topic={sw2plp,api_client})
_method rwwi_mancore_plan_dialog.build_device_connection_table( parent )
	##
	## Build table to display device connection data from ASTRI API
	##
	.items[:table] << a_table << sw_table.new( parent,
				 :model, _self,
				 :label, "Source - Astri Cable Connectivity",
				 :aspect, :device_connection_table,
				 :data_selector, :populate_device_connection_table|()|,
				 #:text_style , .styles[:true_style],
				 :selection_notifier, :device_connection_table_selected|()|,
				 :double_click_notifier,:|open_editor_ur1()|,
				 :row_lines?, _true,
				 #:enabled?,  _false ,
				 :selection_type, :row, # :row or :cell
				 :selection_mode, :many, # :many or :one
				 :col_alignment, :fill,
				 :row_alignment, :fill,
				 :min_height, 250,
				 :enable_horizontal_scrollbar?, _true)
	a_table.n_cols << 10
	a_table.set_column_labels({"Source Type",
				   "Source Code",
				   "Transport Code",
				   "Tube Count",
				   "Core Count",
				   "Tube Number",
				   "Core Number",
				   "Status",
				   "Destination Code",
				   "Destination Name"
				  })

	a_table.col_resize_values << {0.8,1.0,1.0,0.6,0.6,0.6,0.6,0.6,0.8,3}

	# The table can be filtered, sorted and columns can be
	# reordered and hidden
	a_table.enable_filter? << _true
	a_table.enable_sort? << _true
	a_table.enable_manage_columns? << _true

	a_table.set_column_sort_procedure(1, a_table.strings_with_numbers_sort_proc)
	a_table.set_column_sort_procedure(2, a_table.strings_with_numbers_sort_proc)
	a_table.set_column_sort_procedure(3, a_table.strings_with_numbers_sort_proc)
	a_table.set_column_sort_procedure(4, a_table.strings_with_numbers_sort_proc)
	a_table.set_column_sort_procedure(5, a_table.strings_with_numbers_sort_proc)
	a_table.set_column_sort_procedure(6, a_table.strings_with_numbers_sort_proc)
	a_table.set_column_sort_procedure(7, a_table.strings_with_numbers_sort_proc)

_endmethod
$

_pragma(classify_level=basic, topic={sw2plp,api_client})
_method rwwi_mancore_plan_dialog.build_table_ur2( parent )
	## 
	##
	.items[:table2] << a_table2 << sw_table.new( parent,
				 :model, _self,
				 :label, "Target - FDT Splice Connectifity",
				 :aspect, :table_ur2,
				 :data_selector, :populate_ur2|()|,
				 :selection_notifier, :table_selected_ur2|()|,
				 :double_click_notifier,:|open_editor_ur2()|,
				 :row_lines?, _true,
				 :selection_type, :row, # :row or :cell
				 :selection_mode, :many, # :many or :one
				 :col_alignment, :fill,
				 :row_alignment, :fill,
				 :min_height, 250 )
	a_table2.n_cols << 5
	a_table2.set_column_labels({"Destination Code",
				    "Splitter Name",
				    "Dest. Tube Number",
				    "Dest. Core Number",
				    "Status"
				  })
	a_table2.col_resize_values << {1.0, 1.5, 0.8, 0.8, 0.6}
	# The table can be filtered, sorted and columns can be
	# reordered and hidden
	a_table2.enable_filter? << _true
	a_table2.enable_sort? << _true
	a_table2.enable_manage_columns? << _true

	a_table2.set_column_sort_procedure(3, a_table2.strings_with_numbers_sort_proc)
	a_table2.set_column_sort_procedure(4, a_table2.strings_with_numbers_sort_proc)

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.get_rwo()
	## Get RWO from selected object and store in .selected_rwo slot

	r << _self.selected_str()

	_if r _isnt _unset _andif (r.external_name ="Aerial Route" _orif r.external_name = "Underground Route")
	_then
		rr << r.cables()
		_if rr.size  = 1 _then
			cab << rr.an_element()

			# Store selected RWO in slot
			.selected_rwo << cab

			# Set limit field to fiber_count (default value)
			_local fiber_count << cab.fiber_count.default(100)
			.items[:limit_field].value << fiber_count.write_string

			.items[:log].text <<""
			.items[:log].append("DATA CABLE SELECTED")
			.items[:log].append(newline_char)
			.items[:log].append("===================")
			.items[:log].append(newline_char)
			.items[:log].append(newline_char)
			.items[:log].append("Name         : "+ cab.name)
			.items[:log].append(newline_char)
			.items[:log].append("Spec         : "+ cab.spec_id)
			.items[:log].append(newline_char)
			.items[:log].append("OLT          : "+ cab.olt)
			.items[:log].append(newline_char)
			.items[:log].append("Cluster Code : "+ cab.cluster_code.default(""))
			.items[:log].append(newline_char)
			.items[:log].append("Feeder       : "+ cab.feeder_code.default(""))
			.items[:log].append(newline_char)
			.items[:log].append("SubFeeder    : "+ cab.subfeeder_code.default(""))
			.items[:log].append(newline_char)
			.items[:log].append(newline_char)

			# Get sheath_network_type to determine button states
			_local network_type << cab.sheath_network_type.default("").lowercase
			.items[:log].append("Network Type : "+ network_type)
			.items[:log].append(newline_char)
			.items[:log].append(newline_char)

			.items[:log].append("DATA Astri")
			.items[:log].append(newline_char)
			.items[:log].append("===========")

			# Enable/Disable buttons based on sheath_network_type
			# check_upstream: disable for feeder, enable for subfeeder and cluster
			# check_current: disable for cluster, enable for feeder and subfeeder
			_if network_type = "feeder"
			_then
				.items[:check_upstream].enabled? << _false
				.items[:check_current].enabled? << _true
				write("    >> Check Upstream button DISABLED (feeder level)")
				write("    >> Check Current button ENABLED")
			_elif network_type = "subfeeder"
			_then
				.items[:check_upstream].enabled? << _true
				.items[:check_current].enabled? << _true
				write("    >> Check Upstream button ENABLED")
				write("    >> Check Current button ENABLED")
			_elif network_type = "cluster"
			_then
				.items[:check_upstream].enabled? << _true
				.items[:check_current].enabled? << _false
				write("    >> Check Upstream button ENABLED")
				write("    >> Check Current button DISABLED (cluster level)")
			_else
				.items[:check_upstream].enabled? << _false
				.items[:check_current].enabled? << _false
				write("    >> Both buttons DISABLED (unknown network type)")
			_endif

			# Clear both tables when new cable is selected
			.table_list.empty()
			.table_list2.empty()
			_self.changed(:device_connection_table, :refresh)
			_self.changed(:table_ur2, :refresh)
			.items[:table].refresh()
			.items[:table2].refresh()
		_else
			cab << _unset
			.selected_rwo << _unset
			# No cable selected - disable buttons
			.items[:check_upstream].enabled? << _false
			.items[:check_current].enabled? << _false
		_endif
	_else
		_self.show_message("Pilih Kabel")
		.selected_rwo << _unset
		# No valid selection - disable buttons
		.items[:check_upstream].enabled? << _false
		.items[:check_current].enabled? << _false
	_endif

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.clear()
#	## 
#	##

	.current_selection_ur1 << _unset
	.current_selection_ur2 << _unset
	.swl1 << _unset
	.swl2 << _unset
	.swl3 << _unset


	.table_list.empty()
	.table_list2.empty()
	.items[:table].refresh()
	.items[:table2].refresh()
#
#
	.items[:table].clear_selection()
	_self.changed(:device_connection_table, :refresh)
	_self.changed(:table_ur2, :refresh)

	.items[:log].text << ""

	# Disable buttons when cleared
	.items[:check_upstream].enabled? << _false
	.items[:check_current].enabled? << _false
	.items[:assign_fiber].enabled? << _false

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.assign_fiber()
	##
	## Assign fiber to selected device connections
	## Calls ASTRI add device connection API
	##

	write("============================================")
	write("TESTING ADD DEVICE CONNECTION API")
	write("============================================")

	# Get current design for work_order_number
	_local design << _unset
	_local work_order << "TEST-WO-001"
	_try
		design << swg_dsn_admin_engine.get_current_job()
		_if design _isnt _unset
		_then
			work_order << design.project.perform(:job_title).default("TEST-WO-001")
		_endif
	_when error
		# Use default
	_endtry

	# Create dummy connection data with all 35 fields
	_local connection_data << property_list.new_with(
		:work_order_number, work_order,
		:source_device_name, "OLT-TEST-01",
		:source_device_hardware_type, "OLT",
		:source_device_port_name, "Port-1/1/1",
		:source_device_port_type, "GPON",
		:source_device_remarks, "Test source device",
		:source_device_capacity, "16",
		:source_device_capacity_measurement, "Gbps",
		:transport_name, "CAB-TEST-001",
		:transport_hardware_type, "Fiber Cable",
		:transport_capacity, "144",
		:transport_capacity_measurement, "Cores",
		:destination_device_name, "FDT-TEST-05",
		:destination_device_hardware_type, "FDT",
		:destination_device_port_name, "Port-1",
		:destination_device_port_type, "SC/APC",
		:destination_device_remarks, "Test destination device",
		:destination_device_capacity, "8",
		:destination_device_capacity_measurement, "Ports",
		:source_type, "feeder",
		:source_code, "FDR-001",
		:source_tube_number, "1",
		:source_core_number, "2",
		:transport_code, "CAB-TEST-001",
		:transport_tube_number, "3",
		:transport_core_number, "4",
		:transport_status, "AVAILABLE",
		:transport_remarks, "Test transport",
		:closure_code, "CLS-TEST-001",
		:destination_type, "subfeeder",
		:destination_code, "SFD-001",
		:destination_tube_number, "5",
		:destination_core_number, "6",
		:verified_by_username, "test_user",
		:verified_at, date_time.now().write_string
	)

	write("Calling add_device_connection with dummy data...")

	# Call engine method
	_local result << .engine.add_device_connection(connection_data)

	write("============================================")
	write("API CALL COMPLETED")
	write("============================================")
	write("Success: ", result[:success])
	write("Data: ", result[:data])
	write("Error: ", result[:error_message])

	# Show result to user
	_if result[:success] = _true
	_then
		_local msg << "Device connection added successfully!" + newline_char
		_if result[:data] _isnt _unset _andif result[:data].size > 0
		_then
			_local id << result[:data][1][:id]
			msg +<< "ID: " + id.write_string
		_endif
		_self.show_message(msg)
	_else
		_local err_msg << "Failed to add device connection" + newline_char
		_if result[:error_message] _isnt _unset
		_then
			err_msg +<< "Error: " + result[:error_message]
		_endif
		_self.show_message(err_msg)
	_endif

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.populate_device_connection_table( a_table )
	##
	## Populate table with device connection data from API response

	_local row << 1

	# Sort data by Tube Number, then by Core Number
	_local sorted_data << .table_list.as_sorted_collection(
		_proc(a, b)
			_local tube_a << a[:transport_tube_number].default(0)
			_local tube_b << b[:transport_tube_number].default(0)
			_local core_a << a[:transport_core_number].default(0)
			_local core_b << b[:transport_core_number].default(0)

			_if tube_a <> tube_b
			_then
				_return tube_a < tube_b
			_else
				_return core_a < core_b
			_endif
		_endproc)

	_for a_rec _over sorted_data.fast_elements()
	_loop
		a_table.set_row_data( row, a_rec )

		# Column 1: Source Type - depends on infra_type
		_local source_type
		_if .current_infra_type _is :feeder
		_then
			source_type << "OLT"
		_else
			# subfeeder
			source_type << "FEEDER"
		_endif
		a_table.add_cell(row, 1, {}, {:label, source_type})

		# Column 2: Source Code - depends on infra_type
		_local source_code
		_if .current_infra_type _is :feeder
		_then
			source_code << a_rec[:source_olt_device_code]
		_else
			# subfeeder
			source_code << a_rec[:source_feeder_code]
		_endif
		a_table.add_cell(row, 2, {}, {:label, source_code.default("").write_string})

		# Column 3: Transport Code - depends on infra_type
		_local transport_code
		_if .current_infra_type _is :feeder
		_then
			transport_code << a_rec[:transport_feeder_code]
		_else
			# subfeeder
			transport_code << a_rec[:transport_subfeeder_code]
		_endif
		a_table.add_cell(row, 3, {}, {:label, transport_code.default("").write_string})

		# Column 4: Tube Count - depends on infra_type
		_local tube_count
		_if .current_infra_type _is :feeder
		_then
			tube_count << a_rec[:transport_feeder_tube_count]
		_else
			tube_count << a_rec[:transport_subfeeder_tube_count]
		_endif
		a_table.add_cell(row, 4, {}, {:label, tube_count.default("").write_string, :row_alignment, :centre})

		# Column 5: Core Count - depends on infra_type
		_local core_count
		_if .current_infra_type _is :feeder
		_then
			core_count << a_rec[:transport_feeder_core_count]
		_else
			core_count << a_rec[:transport_subfeeder_core_count]
		_endif
		a_table.add_cell(row, 5, {}, {:label, core_count.default("").write_string, :row_alignment, :centre})

		# Column 6: Tube Number
		a_table.add_cell(row, 6, {}, {:label, a_rec[:transport_tube_number].default("").write_string, :row_alignment, :centre})

		# Column 7: Core Number
		a_table.add_cell(row, 7, {}, {:label, a_rec[:transport_core_number].default("").write_string, :row_alignment, :centre})

		# Column 8: Status - show TAKEN or IDLE
		_local icon_status
		_if a_rec[:transport_status] = "TAKEN"
		_then
			icon_status << {:traffic_light_red, :ui_resources}
		_else
			icon_status << {:traffic_light_green, :ui_resources}
		_endif
		a_table.add_cell(row, 8, {}, {:image, icon_status })

		# Column 9: Destination Code - depends on infra_type
		_local dest_code << a_rec[:destination_cluster_code]
		a_table.add_cell(row, 9, {}, {:label, dest_code.default("").write_string })

		# Column 10: Destination Name - depends on infra_type
		_local dest_name << a_rec[:destination_cluster_name]
		a_table.add_cell(row, 10, {}, {:label, dest_name.default("").write_string })

		row +<< 1
	_endloop

	a_table.apply_sorting(_true )

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.populate_ur2( a_table )
	##
	## Populate table2 with optical splitter data
	## Displays: Destination Code, Splitter Name, Dest. Tube Number, Dest. Core Number, Status

	_local row << 1

	# Sort data by splitter name
	_local sorted_data << .table_list2.as_sorted_collection(
		_proc(a, b)
			_local name_a << a[:splitter_name].default("")
			_local name_b << b[:splitter_name].default("")
			_return name_a < name_b
		_endproc)

	_for a_rec _over sorted_data.fast_elements()
	_loop
		a_table.set_row_data( row, a_rec )

		# Column 1: Destination Code
		a_table.add_cell(row, 1, {}, {:label, a_rec[:destination_code].default("").write_string})

		# Column 2: Splitter Name
		a_table.add_cell(row, 2, {}, {:label, a_rec[:splitter_name].default("").write_string})

		# Column 3: Dest. Tube Number (always 1)
		a_table.add_cell(row, 3, {}, {:label, a_rec[:dest_tube_number].default("1").write_string, :row_alignment, :centre})

		# Column 4: Dest. Core Number (extracted from splitter name)
		a_table.add_cell(row, 4, {}, {:label, a_rec[:dest_core_number].default("").write_string, :row_alignment, :centre})

		# Column 5: Status (construction_status)
		_local status << a_rec[:status].default("")
		_local icon_status
		_if status = "In Service" _orif status = "IN SERVICE"
		_then
			icon_status << {:traffic_light_green, :ui_resources}
		_elif status = "Proposed" _orif status = "PROPOSED"
		_then
			icon_status << {:traffic_light_yellow, :ui_resources}
		_else
			icon_status << {:traffic_light_red, :ui_resources}
		_endif
		a_table.add_cell(row, 5, {}, {:image, icon_status})

		row +<< 1
	_endloop

	a_table.apply_sorting(_true)
_endmethod
$


_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.device_connection_table_selected( selection )
	##
	## Handle selection in device connection table
	## Enable assign_fiber button only if selected records are not TAKEN
	##
	_global sel
	sel << selection
	.current_selection_ur1 << selection.get_row_data_from_selection().an_element()

	# Enable assign_fiber button only if selected records are not TAKEN
	_local selected_records << selection.get_row_data_from_selection()
	_local all_non_taken? << _true

	_if selected_records.empty?
	_then
		.items[:assign_fiber].enabled? << _false
	_else
		_for rec _over selected_records.fast_elements()
		_loop
			_if rec[:transport_status] = "TAKEN"
			_then
				all_non_taken? << _false
				_leave
			_endif
		_endloop

		.items[:assign_fiber].enabled? << all_non_taken?
	_endif

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.table_selected_ur2( selection )
	## 
	##
	_global sel
	sel << selection
	.current_selection_ur2 << selection.get_row_data_from_selection().an_element()
	
_endmethod
