_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.new(_optional owner, framework)
	## 
	## 
	>> _clone.init(owner, framework)
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.init(owner, framework)
	##
	## Initialize dialog - using SW_SWIFT components
	##

	.owner << owner
	.grs << framework

	.ev << gis_program_manager.cached_dataset(:gis)
	.mapman << .grs.plugin(:map_plugin)
	.ed << .grs.plugin(:editor_manager)
	.items << property_list.new()
	.current_selection_ur1 << _unset
	.current_selection_ur2 << _unset
	.swl1 << _unset
	.swl2 << _unset
	.swl3 << _unset
	.selected_rwo << _unset
	.feeder_count << 0
	.subfeeder_count << 0
	.fdt_count << 0
	# Data holder
	.feeder_table_list << rope.new()
	.table_list << rope.new()
	.table_list2 << rope.new()
	.records << rope.new()
	.a_sc << _unset
	.engine << rwwi_mancore_plan_engine.new(_self, framework)

	# Add dependent dialog to plugin
	_self.add_dependent(.owner)
	>> _super.init()
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.activate_in( parent )
	## 
	##
	parent.title << "FTTx Mancore Plan"

	#mb << menubar.new( parent )

	#m << _unset

	# Create the first pulldown menu and its button items
	#p << pulldown_menu.new()
	#button_item.new( p, "Load KML...", _self , :get_kml|()| )
	#button_item.new( p, "Clear",  _self , :clear|()| )
	#button_item.new( p, "Refresh", _self , :refresh|()| )
	# Create the "File" button in the menubar
	#menu_button_item.new( mb, "File", p )

	# Create top-level sw_canvas_container (required for SWIFT)
	.items[:top] << top_c << sw_canvas_container.new(
		parent, 4, 1,
		:width, 900,
		:height, 600,
		:outer_spacing, 5,
		:row_spacing, 5,
		:identifier, :top_container,
		:model, _self)

	# Create outer container with flexible row sizing
	# 5 rows: Toolbar (fixed), Feeder Table (flexible), Subfeeder Table (flexible), FDT Table (flexible), Log (flexible)
	.items[:outer] << outer << sw_container.new(top_c, 5, 1,
		:row_resize_values, {0, 1, 1, 1, 1})  # Toolbar fixed, 3 Tables flexible, Log flexible

	# Build toolbar
	_self.build_toolbar( outer )

	# Build tables (in order: Feeder, Subfeeder, FDT)
	_self.build_feeder_table( outer )
	_self.build_device_connection_table( outer )
	_self.build_table_ur2( outer )

	# Build log window
	_self.build_log( outer )

	# Return the top-level container (required)
	_return top_c
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.build_toolbar( parent )
	##
	## Build main toolbar with source selector and action buttons
	##
	toolbar << sw_container.new( parent, 1, _unset,
				     :col_spacing, 15
				)
	file_toolbar << sw_toolbar_container.new( toolbar, _false,
						  :background_type, :button_group,
						  :button_group_height, sw_item.default_item_height )

	sw_label_item.new( file_toolbar, "Source:")

	.items[:kmlsource] << sw_text_item.new( file_toolbar, :model, _self,
					       :editable?, _false,
					       :value, :cable,
					       :text_items, {{:olt, "OLT"},
							     {:cable, "Cable"}
					       }
					   )

	.items[:get_rwo] << sw_button_item.new( file_toolbar,
					       :image, {:find, :ui_resources},
					       :model, _self,
					       :selector, :get_rwo|()|,
					       :tooltip, "Get Selected Object" )

	sw_label_item.new( file_toolbar, "Limit:" )

	.items[:limit_field] << sw_text_item.new( file_toolbar,
						  :display_length, 10,
						  :model, _self,
						  :value, "100",
						  :tooltip, "Limit for device connection query (default: fiber count)" )


	.items[:get_mancore] << sw_button_item.new( file_toolbar,
					       :image, {:run, :ui_resources},
					       :model, _self,
					       :selector, :get_mancore|()|,
					       :tooltip, "Get Mancore Plan" )
	.items[:get_mancore].enabled? << _false

	.items[:clear] << sw_button_item.new( file_toolbar,
					       :image, {:clear, :ui_resources},
					       :model, _self,
					       :selector, :clear|()|,
					       :tooltip, "Clear" )

	.items[:clear_selections] << sw_button_item.new( file_toolbar,
					       :image, {:refresh, :ui_resources},
					       :model, _self,
					       :selector, :clear_selections|()|,
					       :tooltip, "Clear All Table Selections" )


	sw_label_item.new( file_toolbar, "Homepass:" )

	.items[:homepass_field] << sw_text_item.new( file_toolbar,
						  :display_length, 10,
						  :model, _self,
						  :value, "0",
						  :change_selector, :homepass_changed|()|,
						  :tooltip, "Total homepass (demand points) count - editable" )


	sw_label_item.new( file_toolbar, "Status:" )

	.items[:status_field] << sw_text_item.new( file_toolbar,
						   :model, _self,
						   :display_length, 10,
						   :editable?, _false,
						   :change_selector, :status_changed|()|,
						   :tooltip, "Booking status - RELEASE sets destination to null" )
	.items[:status_field].text_items << {"RELEASE", "BOOKED", "ACTIVE"}
	.items[:status_field].value << "BOOKED"


	.items[:booking_feeder] << sw_button_item.new( file_toolbar,
					       :image, {:back, :ui_resources},
					       :model, _self,
					       :selector, :booking_feeder|()|,
					       :tooltip, "Booking Feeder" )
	.items[:booking_feeder].enabled? << _false

	.items[:booking_subfeeder] << sw_button_item.new( file_toolbar,
					       :image, {:forward, :ui_resources},
					       :model, _self,
					       :selector, :booking_subfeeder|()|,
					       :tooltip, "Booking Subfeeder" )
	.items[:booking_subfeeder].enabled? << _false

_endmethod
$

