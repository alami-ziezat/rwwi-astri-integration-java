_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.clear()
#	## 
#	##

	.current_selection_ur1 << _unset
	.current_selection_ur2 << _unset
	.swl1 << _unset
	.swl2 << _unset
	.swl3 << _unset


	.table_list.empty()
	.table_list2.empty()
	.items[:table].refresh()
	.items[:table2].refresh()
#
#
	.items[:table].clear_selection()
	_self.changed(:table_ur1, :refresh)
	_self.changed(:table_ur2, :refresh)

	.items[:result2].text << ""

_endmethod
$



_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.populate_ur1( a_table )
	## 
	##

	row << 1
	rd << {:traffic_light_red, :ui_resources}
	gr << {:traffic_light_grey, :ui_resources}
	gn << {:traffic_light_green, :ui_resources}
	tk << {:tick, :ui_resources}
	
	_for a_rec  _over .table_list.fast_elements()
	_loop
		a_table.set_row_data( row, a_rec )
		a_table.add_cell(row, 1, {}, {:label, a_rec.fiber_number.as_number() })
		a_table.add_cell( row, 2, {}, {:label, a_rec.owner })
		a_table.add_cell( row, 3, {}, {:label, "" })
		a_table.add_cell( row, 4, {}, {:label, a_rec.priority })
		a_table.add_cell( row, 5, {}, {:label, a_rec.sheath_with_loc.name })
		
		_if a_rec.owner = "Kosong" _orif a_rec.owner = "Idle" _orif a_rec.owner = "Port Kosong" _orif a_rec.owner _is _unset _orif a_rec.owner = ""
		_then 
			a_table.add_cell( row, 6, {}, {:image, rd })
		_else
			a_table.add_cell( row, 6, {}, {:image, gn })	
		_endif
		
		row +<< 1
	_endloop

	a_table.apply_sorting(_true )

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.populate_ur2( a_table )
	## 
	##

	row << 1
	rd << {:traffic_light_red, :ui_resources}
	gr << {:traffic_light_grey, :ui_resources}
	gn << {:traffic_light_green, :ui_resources}
	tk << {:tick, :ui_resources}
	_for a_rec  _over .table_list2.fast_elements()
	_loop
		a_table.set_row_data( row, a_rec )
		a_table.add_cell(row, 1, {}, {:label, a_rec.fiber_number.as_number(),:row_alignment, :centre})
		a_table.add_cell( row, 2, {}, {:label, a_rec.owner })
		a_table.add_cell( row, 3, {}, {:label, "" })
		a_table.add_cell( row, 4, {}, {:label, a_rec.priority })
		a_table.add_cell( row, 5, {}, {:label, a_rec.sheath_with_loc.name })
		_if a_rec.owner = "Kosong" _orif a_rec.owner = "Idle" _orif a_rec.owner = "Port Kosong" _orif a_rec.owner _is _unset _orif a_rec.owner = ""
		_then 
			a_table.add_cell( row, 6, {}, {:image, rd })
		_else
			a_table.add_cell( row, 6, {}, {:image, gn })	
		_endif
		
		row +<< 1
	_endloop

	a_table.apply_sorting(_true )
_endmethod
$


_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.table_selected_ur1( selection )
#	## 
#	##
	_global sel
	sel << selection
	.current_selection_ur1 << selection.get_row_data_from_selection().an_element()

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.table_selected_ur2( selection )
	## 
	##
	_global sel
	sel << selection
	.current_selection_ur2 << selection.get_row_data_from_selection().an_element()
	
_endmethod
