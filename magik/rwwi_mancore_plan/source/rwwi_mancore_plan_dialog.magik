_pragma(classify_level=basic, topic={sw2plp,api_client})
_method rwwi_mancore_plan_dialog.build_table_ur1( parent )
	## 
	##
	.items[:table] << a_table << sw_table.new( parent,
				 :model, _self,
				 :label, "Cable Connectifity",
				 :aspect, :table_ur1,
				 :data_selector, :populate_ur1|()|,
				 #:text_style , .styles[:true_style],
				 :selection_notifier, :table_selected_ur1|()|,
				 :double_click_notifier,:|open_editor_ur1()|,
				 :row_lines?, _true,
				 #:enabled?,  _false ,
				 :selection_type, :row, # :row or :cell
				 :selection_mode, :one, # :many or :one
				 :min_height, 350 )
	a_table.n_cols << 6
	a_table.set_column_labels({"Fiber",
				   "Name",
				   " ",
				   "Priority",
				   "Cable",
				   "Status"
				  })
 
	a_table.col_resize_values << {0.5,1,0.1,0.3,1,0.3}
	
	# The table can be filtered, sorted and columns can be
	# reordered and hidden
	a_table.enable_filter? << _true
	a_table.enable_sort? << _true
	a_table.enable_manage_columns? << _true

	a_table.set_column_sort_procedure(1, a_table.strings_with_numbers_sort_proc)

_endmethod
$

_pragma(classify_level=basic, topic={sw2plp,api_client})
_method rwwi_mancore_plan_dialog.build_table_ur2( parent )
	## 
	##
	.items[:table2] << a_table2 << sw_table.new( parent,
				 :model, _self,
				 :label, "New Cable Connectifity",
				 :aspect, :table_ur2,
				 :data_selector, :populate_ur2|()|,
				 :selection_notifier, :table_selected_ur2|()|,
				 :double_click_notifier,:|open_editor_ur2()|,
				 :row_lines?, _true,
				 :selection_type, :row, # :row or :cell
				 :selection_mode, :one, # :many or :one
				 :min_height, 350 )
	a_table2.n_cols << 4
	a_table2.set_column_labels({"Fiber",
				    "Name",
				    " ",
				    "Priority",
				    "Cable",
				    "Status"
				  })
	a_table2.col_resize_values << {0.5,1,0.1,0.3,1,0.3}
	# The table can be filtered, sorted and columns can be
	# reordered and hidden
	a_table2.enable_filter? << _true
	a_table2.enable_sort? << _true
	a_table2.enable_manage_columns? << _true

	a_table2.set_column_sort_procedure(1, a_table2.strings_with_numbers_sort_proc)
	
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.get_cable()

	r << _self.selected_str()
	write("obj :",r)
	
	_if r.external_name ="Aerial Route" _orif r.external_name = "Underground Route"
	_then
		rr << r.cables()
		_if rr.size  = 1 _then
			cab << rr.an_element()
			.items[:result2].text <<""
			.items[:result2].append("DATA CABLE SELECTED")
			.items[:result2].append(newline_char)
			.items[:result2].append("===================")
			.items[:result2].append(newline_char)
			.items[:result2].append(newline_char)
			.items[:result2].append("Name    : "+ cab.name)
			.items[:result2].append(newline_char)
			.items[:result2].append("Spec    : "+ cab.spec_id)
			.items[:result2].append(newline_char)
			.items[:result2].append("OLT    : "+ cab.olt)
			.items[:result2].append(newline_char)
			.items[:result2].append("Feeder    : "+ cab.feeder_code.default(""))
			.items[:result2].append(newline_char)
			.items[:result2].append("SubFeeder    : "+ cab.subfeeder_code.default(""))
			.items[:result2].append(newline_char)
			.items[:result2].append(newline_char)
			
			.items[:result2].append("DATA Astri")
			.items[:result2].append(newline_char)
			.items[:result2].append("===========")
		_else
			cab << _unset 
		_endif


	

	_else
		_self.show_message("Pilih Kabel")	
	_endif
	
_endmethod
$

