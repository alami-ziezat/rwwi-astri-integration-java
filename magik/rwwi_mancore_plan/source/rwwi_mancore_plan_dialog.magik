_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.get_rwo()
	## Get RWO from selected object and store in .selected_rwo slot

	r << _self.selected_str()

	_if r _isnt _unset _andif (r.external_name ="Aerial Route" _orif r.external_name = "Underground Route")
	_then
		rr << r.cables()
		_if rr.size  = 1 _then
			cab << rr.an_element()

			# Store selected RWO in slot
			.selected_rwo << cab

			# Set limit field to fiber_count (default value)
			_local fiber_count << cab.fiber_count.default(100)
			.items[:limit_field].value << fiber_count.write_string

			.items[:log].text <<""
			.items[:log].append("DATA CABLE SELECTED")
			.items[:log].append(newline_char)
			.items[:log].append("===================")
			.items[:log].append(newline_char)
			.items[:log].append(newline_char)
			.items[:log].append("Name         : "+ cab.name)
			.items[:log].append(newline_char)
			.items[:log].append("Spec         : "+ cab.spec_id)
			.items[:log].append(newline_char)
			.items[:log].append("OLT          : "+ cab.olt)
			.items[:log].append(newline_char)
			.items[:log].append("Cluster Code : "+ cab.cluster_code.default(""))
			.items[:log].append(newline_char)
			.items[:log].append("Feeder       : "+ cab.feeder_code.default(""))
			.items[:log].append(newline_char)
			.items[:log].append("SubFeeder    : "+ cab.subfeeder_code.default(""))
			.items[:log].append(newline_char)
			.items[:log].append(newline_char)

			# Determine network type based on populated code fields
			_local network_type << ""
			_local subfeeder_code << cab.subfeeder_code.default("")
			_local feeder_code << cab.feeder_code.default("")
			_local cluster_code << cab.cluster_code.default("")

			_if subfeeder_code <> "" _andif subfeeder_code _isnt _unset
			_then
				network_type << "subfeeder"
			_elif feeder_code <> "" _andif feeder_code _isnt _unset
			_then
				network_type << "feeder"
			_elif cluster_code <> "" _andif cluster_code _isnt _unset
			_then
				network_type << "cluster"
			_endif

			# Also check sheath_network_type as fallback
			_if network_type = ""
			_then
				network_type << cab.sheath_network_type.default("").lowercase
			_endif

			.items[:log].append("Network Type : "+ network_type)
			.items[:log].append(newline_char)
			.items[:log].append(newline_char)

			.items[:log].append("DATA Astri")
			.items[:log].append(newline_char)
			.items[:log].append("===========")

			# Enable get_mancore button for all network types (feeder, subfeeder, cluster)
			_if network_type = "feeder" _orif network_type = "subfeeder" _orif network_type = "cluster"
			_then
				.items[:get_mancore].enabled? << _true
				write("    >> Get Mancore button ENABLED for network type: ", network_type)
			_else
				.items[:get_mancore].enabled? << _false
				write("    >> Get Mancore button DISABLED (unknown network type: '", network_type, "')")
			_endif

			# Clear all tables when new cable is selected
			.feeder_table_list.empty()
			.table_list.empty()
			.table_list2.empty()

			# Reset counts
			.feeder_count << 0
			.subfeeder_count << 0
			.fdt_count << 0

			_self.changed(:feeder_connection_table, :refresh)
			_self.changed(:device_connection_table, :refresh)
			_self.changed(:table_ur2, :refresh)
			.items[:feeder_table].refresh()
			.items[:table].refresh()
			.items[:table2].refresh()
		_else
			cab << _unset
			.selected_rwo << _unset
			# No cable selected - disable button
			.items[:get_mancore].enabled? << _false
		_endif
	_else
		_self.show_message("Pilih Kabel")
		.selected_rwo << _unset
		# No valid selection - disable button
		.items[:get_mancore].enabled? << _false
	_endif

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.clear()
#	## 
#	##

	.current_selection_ur1 << _unset
	.current_selection_ur2 << _unset
	.swl1 << _unset
	.swl2 << _unset
	.swl3 << _unset


	.feeder_table_list.empty()
	.table_list.empty()
	.table_list2.empty()
	.items[:feeder_table].refresh()
	.items[:table].refresh()
	.items[:table2].refresh()
#
#
	.items[:feeder_table].clear_selection()
	.items[:table].clear_selection()
	_self.changed(:feeder_connection_table, :refresh)
	_self.changed(:device_connection_table, :refresh)
	_self.changed(:table_ur2, :refresh)

	.items[:log].text << ""

	# Reset homepass field
	.items[:homepass_field].value << "0"

	# Reset counts
	.feeder_count << 0
	.subfeeder_count << 0
	.fdt_count << 0

	# Disable buttons when cleared
	.items[:get_mancore].enabled? << _false
	.items[:booking_feeder].enabled? << _false
	.items[:booking_subfeeder].enabled? << _false

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.clear_selections()
	##
	## Clear all table selections without clearing table data
	##

	write("Clearing all table selections...")

	# Clear selection references
	.feeder_table_selection << _unset
	.subfeeder_table_selection << _unset
	.fdt_table_selection << _unset

	# Clear table selections in UI
	.items[:feeder_table].clear_selection()
	.items[:table].clear_selection()
	.items[:table2].clear_selection()

	# Reset counts
	.feeder_count << 0
	.subfeeder_count << 0
	.fdt_count << 0

	# Disable booking buttons
	.items[:booking_feeder].enabled? << _false
	.items[:booking_subfeeder].enabled? << _false

	write("All table selections cleared")

_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.get_homepass_and_cores()
	##
	## Calculate homepass and cores to book from homepass field
	##
	## Returns:
	##   homepass_str    - String value from field
	##   homepass_count  - Numeric value
	##   cores_to_book   - Calculated cores (homepass/64 rounded)
	##

	_local homepass_str << .items[:homepass_field].value.default("0")
	_local homepass_count << homepass_str.as_number().default(0)
	_local cores_to_book << (homepass_count.as_float / 64).rounded

	>> homepass_str, homepass_count, cores_to_book
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.homepass_changed()
	##
	## Called when homepass field is manually updated
	## Recalculates and logs the total cores to book
	##

	_local (homepass_str, homepass_count, cores_to_book) << _self.get_homepass_and_cores()

	write("Homepass field updated: ", homepass_count)
	write("Total Cores to Book: ", cores_to_book)

	# Append to log
	.items[:log].append(newline_char)
	.items[:log].append("** Homepass Updated **")
	.items[:log].append(newline_char)
	.items[:log].append("Total Homepass      : " + homepass_count.write_string)
	.items[:log].append(newline_char)
	.items[:log].append("Total Cores to Book : " + cores_to_book.write_string)
	.items[:log].append(newline_char)
	.items[:log].append(newline_char)

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.status_changed()
	##
	## Called when status dropdown is changed
	## Updates button states based on new status
	##

	_local status << .items[:status_field].value.default("BOOKED")
	write("Status changed to: ", status)

	# Update button states based on new status and current selections
	_self.update_booking_button_states()

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.booking_feeder()
	##
	## Booking Feeder - Book device connections between Table 1 (Feeder) and Table 2 (Subfeeder)
	##

	write("============================================")
	write("BOOKING FEEDER")
	write("============================================")

	# Get current design for work_order_number
	_local design << _unset
	_local work_order << ""
	_try
		design << swg_dsn_admin_engine.get_current_job()
		_if design _is _unset
		_then
			_self.show_message("No active design. Please activate a design first.")
			_return
		_endif
		work_order << design.project.perform(:name).default("")
		_if work_order = "" _orif work_order _is _unset
		_then
			_self.show_message("Cannot get project name from active design.")
			_return
		_endif
		write("Work Order (project.name): ", work_order)
	_when error
		_self.show_message("Cannot get active design. Please activate a design first.")
		_return
	_endtry

	# Get selections from slots
	_local feeder_selection << .feeder_table_selection
	_local subfeeder_selection << .subfeeder_table_selection

	# Get all records from feeder table (regardless of status)
	_local feeder_records << _self.get_records_from_selection(feeder_selection)

	# Get all records from subfeeder table (regardless of status)
	_local subfeeder_records << _self.get_records_from_selection(subfeeder_selection)

	write("Table 1 (Feeder): ", feeder_records.size, " records")
	write("Table 2 (Subfeeder): ", subfeeder_records.size, " records")

	# Get status
	_local status << .items[:status_field].value.default("BOOKED")
	write("Status: ", status)

	# Validate against homepass (only for BOOKED status)
	_if status = "BOOKED"
	_then
		_local (homepass_str, homepass_count, cores_to_book) << _self.get_homepass_and_cores()

		write("Total Homepass: ", homepass_count)
		write("Total Cores to Book: ", cores_to_book)

		_if feeder_records.size > cores_to_book
		_then
			_local msg << write_string("Booking validation failed!", newline_char, newline_char,
						   "Records to book: ", feeder_records.size, newline_char,
						   "Maximum allowed (based on homepass): ", cores_to_book, newline_char, newline_char,
						   "Total Homepass: ", homepass_count, newline_char,
						   "This exceeds the homepass limit.")
			_self.show_message(msg)
			write("ERROR: Booking exceeds homepass limit")
			_return
		_endif
	_endif

	# Execute booking
	_self.execute_booking_feeder(work_order, feeder_records, subfeeder_records)

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.booking_subfeeder()
	##
	## Booking Subfeeder - Book device connections between Table 2 (Subfeeder) and Table 3 (FDT)
	##

	write("============================================")
	write("BOOKING SUBFEEDER")
	write("============================================")

	# Get current design for work_order_number
	_local design << _unset
	_local work_order << ""
	_try
		design << swg_dsn_admin_engine.get_current_job()
		_if design _is _unset
		_then
			_self.show_message("No active design. Please activate a design first.")
			_return
		_endif
		work_order << design.project.perform(:name).default("")
		_if work_order = "" _orif work_order _is _unset
		_then
			_self.show_message("Cannot get project name from active design.")
			_return
		_endif
		write("Work Order (project.name): ", work_order)
	_when error
		_self.show_message("Cannot get active design. Please activate a design first.")
		_return
	_endtry

	# Get selections from slots
	_local subfeeder_selection << .subfeeder_table_selection
	_local fdt_selection << .fdt_table_selection

	# Get all records from subfeeder table (regardless of status)
	_local subfeeder_records << _self.get_records_from_selection(subfeeder_selection)

	# Get all records from FDT table
	_local fdt_records << _self.get_records_from_selection(fdt_selection)

	write("Table 2 (Subfeeder): ", subfeeder_records.size, " records")
	write("Table 3 (FDT): ", fdt_records.size, " records")

	# Get status
	_local status << .items[:status_field].value.default("BOOKED")
	write("Status: ", status)

	# Validate against homepass (only for BOOKED status)
	_if status = "BOOKED"
	_then
		_local (homepass_str, homepass_count, cores_to_book) << _self.get_homepass_and_cores()

		write("Total Homepass: ", homepass_count)
		write("Total Cores to Book: ", cores_to_book)

		_if subfeeder_records.size > cores_to_book
		_then
			_local msg << write_string("Booking validation failed!", newline_char, newline_char,
						   "Records to book: ", subfeeder_records.size, newline_char,
						   "Maximum allowed (based on homepass): ", cores_to_book, newline_char, newline_char,
						   "Total Homepass: ", homepass_count, newline_char,
						   "This exceeds the homepass limit.")
			_self.show_message(msg)
			write("ERROR: Booking exceeds homepass limit")
			_return
		_endif
	_endif

	# Execute booking
	_self.execute_booking_subfeeder(work_order, subfeeder_records, fdt_records)

_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.get_idle_records_from_selection(selection)
	## Extract IDLE records from table selection
	## Parameters:
	##   selection - Table selection object
	## Returns:
	##   rope of IDLE records (status != "TAKEN")

	_local idle_records << rope.new()

	_if selection _is _unset
	_then
		_return idle_records
	_endif

	_local records << selection.get_row_data_from_selection()
	_for rec _over records.fast_elements()
	_loop
		_if rec[:transport_status] <> "TAKEN"
		_then
			idle_records.add(rec)
		_endif
	_endloop

	>> idle_records
_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.get_records_from_selection(selection)
	## Extract all records from table selection (no filtering)
	## Parameters:
	##   selection - Table selection object
	## Returns:
	##   rope of records

	_local records << rope.new()

	_if selection _is _unset
	_then
		_return records
	_endif

	_local selected << selection.get_row_data_from_selection()
	_for rec _over selected.fast_elements()
	_loop
		records.add(rec)
	_endloop

	>> records
_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.execute_booking_feeder(work_order, feeder_records, subfeeder_records)
	## Execute booking feeder - pair Table 1 (IDLE) with Table 2 (any status)
	## Parameters:
	##   work_order - Work order number
	##   feeder_records - Records from Table 1 (must be IDLE)
	##   subfeeder_records - Records from Table 2 (can be IDLE or TAKEN)

	write("============================================")
	write("EXECUTING BOOKING FEEDER")
	write("============================================")

	# Validate counts match
	_if feeder_records.size <> subfeeder_records.size
	_then
		_local msg << write_string("Selected records count mismatch!", newline_char,
					   "Table 1 (Feeder): ", feeder_records.size, newline_char,
					   "Table 2 (Subfeeder): ", subfeeder_records.size, newline_char,
					   "Please select the same number of records in both tables.")
		_self.show_message(msg)
		_return
	_endif

	write("Pairing ", feeder_records.size, " records for booking feeder...")

	# Process each pair
	_local success_count << 0
	_local error_count << 0
	_local errors << rope.new()

	_for i _over 1.upto(feeder_records.size)
	_loop
		_local feeder_rec << feeder_records[i]
		_local subfeeder_rec << subfeeder_records[i]

		write("Pair ", i, ":")
		write("  Table 1: Tube ", feeder_rec[:transport_tube_number], " Core ", feeder_rec[:transport_core_number])
		write("  Table 2: Tube ", subfeeder_rec[:transport_tube_number], " Core ", subfeeder_rec[:transport_core_number])

		# Build connection data
		_local connection_data << _self.build_booking_feeder_data(
			work_order, feeder_rec, subfeeder_rec)
		
		# Call API
		_local result << .engine.add_device_connection(connection_data)

		_if result[:success] = _true
		_then
			success_count +<< 1
			write("  → SUCCESS: Booking created")
		_else
			error_count +<< 1
			_local err_msg << result[:error_message].default("Unknown error")
			errors.add(write_string("Pair ", i, ": ", err_msg))
			write("  → ERROR: ", err_msg)
		_endif
	_endloop

	write("============================================")
	write("BOOKING FEEDER COMPLETED")
	write("============================================")
	write("Success: ", success_count)
	write("Errors: ", error_count)

	# Show result to user
	_local msg << write_string("Booking Feeder Completed", newline_char,
				   "Success: ", success_count, newline_char,
				   "Errors: ", error_count)

	_if error_count > 0
	_then
		msg +<< newline_char + newline_char + "Errors:" + newline_char
		_for err _over errors.fast_elements()
		_loop
			msg +<< err + newline_char
		_endloop
	_endif

	_self.show_message(msg)

	# Refresh tables after booking
	_if success_count > 0
	_then
		write("Refreshing tables after successful bookings...")
		_self.refresh_data_after_booking()
	_endif

_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.execute_booking_subfeeder(work_order, subfeeder_records, fdt_records)
	## Execute booking subfeeder - pair Table 2 (any status) with Table 3
	## Parameters:
	##   work_order - Work order number
	##   subfeeder_records - Records from Table 2 (can be IDLE or TAKEN)
	##   fdt_records - Records from Table 3

	write("============================================")
	write("EXECUTING BOOKING SUBFEEDER")
	write("============================================")

	write("Table 2 (Subfeeder): ", subfeeder_records.size, " records")
	write("Table 3 (FDT): ", fdt_records.size, " records")

	_if fdt_records.size > subfeeder_records.size
	_then
		write("WARNING: Table 3 has more records than Table 2. Only first ", subfeeder_records.size, " FDT records will be used.")
	_elif fdt_records.size < subfeeder_records.size
	_then
		write("NOTE: Table 3 has fewer records. Remaining Table 2 records will have empty destination fields.")
	_endif

	write("Processing ", subfeeder_records.size, " records for booking subfeeder...")

	# Process each pair
	_local success_count << 0
	_local error_count << 0
	_local errors << rope.new()

	_for i _over 1.upto(subfeeder_records.size)
	_loop
		_local subfeeder_rec << subfeeder_records[i]
		_local fdt_rec << _unset

		# Get matching FDT record if available
		_if i <= fdt_records.size
		_then
			fdt_rec << fdt_records[i]
		_endif

		write("Pair ", i, ":")
		write("  Table 2: Tube ", subfeeder_rec[:transport_tube_number], " Core ", subfeeder_rec[:transport_core_number])
		_if fdt_rec _isnt _unset
		_then
			write("  Table 3: ", fdt_rec[:splitter_name].default(""), " - Dest Core ", fdt_rec[:dest_core_number].default(""))
		_else
			write("  Table 3: (no pair - destination will be empty)")
		_endif

		# Build connection data
		_local connection_data << _self.build_booking_subfeeder_data(
			work_order, subfeeder_rec, fdt_rec)

		# Call API
		_local result << .engine.add_device_connection(connection_data)

		_if result[:success] = _true
		_then
			success_count +<< 1
			write("  → SUCCESS: Booking created")
		_else
			error_count +<< 1
			_local err_msg << result[:error_message].default("Unknown error")
			errors.add(write_string("Pair ", i, ": ", err_msg))
			write("  → ERROR: ", err_msg)
		_endif
	_endloop

	write("============================================")
	write("BOOKING SUBFEEDER COMPLETED")
	write("============================================")
	write("Success: ", success_count)
	write("Errors: ", error_count)

	# Show result to user
	_local msg << write_string("Booking Subfeeder Completed", newline_char,
				   "Success: ", success_count, newline_char,
				   "Errors: ", error_count)

	_if error_count > 0
	_then
		msg +<< newline_char + newline_char + "Errors:" + newline_char
		_for err _over errors.fast_elements()
		_loop
			msg +<< err + newline_char
		_endloop
	_endif

	_self.show_message(msg)

	# Refresh tables after booking
	_if success_count > 0
	_then
		write("Refreshing tables after successful bookings...")
		_self.refresh_data_after_booking()
	_endif

_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.refresh_data_after_booking()
	##
	## Refresh table data after successful booking by re-querying BOTH
	## feeder and subfeeder device connection APIs
	## Gets codes from table records instead of selected RWO
	## This ensures all affected tables show the latest status
	##

	write("Refreshing data from both APIs...")

	# Get feeder_code from feeder table records (Table 1)
	_local feeder_code << _unset
	_if .feeder_table_list _isnt _unset _andif _not .feeder_table_list.empty?
	_then
		_local first_feeder_rec << .feeder_table_list.an_element()
		feeder_code << first_feeder_rec[:transport_feeder_code].default("")
		_if feeder_code = "" _orif feeder_code _is _unset
		_then
			# Try source_feeder_code as fallback
			feeder_code << first_feeder_rec[:source_feeder_code].default("")
		_endif
	_endif

	# Get subfeeder_code from subfeeder table records (Table 2)
	_local subfeeder_code << _unset
	_if .table_list _isnt _unset _andif _not .table_list.empty?
	_then
		_local first_subfeeder_rec << .table_list.an_element()
		subfeeder_code << first_subfeeder_rec[:transport_subfeeder_code].default("")
		_if subfeeder_code = "" _orif subfeeder_code _is _unset
		_then
			# Try source_subfeeder_code as fallback
			subfeeder_code << first_subfeeder_rec[:source_subfeeder_code].default("")
		_endif
	_endif

	write("  Feeder Code (from table): ", feeder_code)
	write("  Subfeeder Code (from table): ", subfeeder_code)

	# Refresh feeder table if feeder_code is available
	_if feeder_code _isnt _unset _andif feeder_code <> ""
	_then
		write("  Refreshing Feeder table...")
		_self.query_and_populate_feeder_table(feeder_code)
	_else
		write("  Skipping Feeder refresh - no feeder code in table")
	_endif

	# Refresh subfeeder table if subfeeder_code is available
	_if subfeeder_code _isnt _unset _andif subfeeder_code <> ""
	_then
		write("  Refreshing Subfeeder table...")
		_self.query_and_populate_subfeeder_table(subfeeder_code)
	_else
		write("  Skipping Subfeeder refresh - no subfeeder code in table")
	_endif

	write("Data refresh completed")

	# Clear all table selections and reset buttons after refresh
	_self.clear_selections()

_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.get_default_device_connection_fields()
	## Returns property_list with all null/empty device and transport metadata fields
	## These fields are common to all booking operations
	## Returns:
	##   property_list with null/empty default fields

	>> property_list.new_with(
		:source_tube_number, _unset,
		:source_core_number, _unset,
		:source_device_name, _unset,
		:source_device_hardware_type, _unset,
		:source_device_port_name, _unset,
		:source_device_port_type, _unset,
		:source_device_remarks, _unset,
		:source_device_capacity, _unset,
		:source_device_capacity_measurement, _unset,
		:transport_name, _unset,
		:transport_hardware_type, _unset,
		:transport_capacity, _unset,
		:transport_capacity_measurement, _unset,
		:destination_device_name, _unset,
		:destination_device_hardware_type, _unset,
		:destination_device_port_name, _unset,
		:destination_device_port_type, _unset,
		:destination_device_remarks, _unset,
		:destination_device_capacity, _unset,
		:destination_device_capacity_measurement, _unset,
		:destination_status, _unset,
		:destination_remarks, _unset,
		:verified_by_username, _unset,
		:verified_at, _unset
	)
_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.build_booking_feeder_data(work_order, feeder_rec, subfeeder_rec)
	## Build device connection data for booking feeder
	## Maps data from table 1 (feeder) and table 2 (subfeeder) to API format
	## Parameters:
	##   work_order - Work order number from project.name
	##   feeder_rec - Selected record from table 1 (Feeder Connectivity)
	##   subfeeder_rec - Selected record from table 2 (Subfeeder Connectivity)
	## Returns:
	##   property_list with device connection data

	# Get source data from table 1
	_local source_type << "OLT"
	_local source_code << feeder_rec[:source_olt_device_code].default("")

	# Get transport code from table 1
	_local transport_code << feeder_rec[:transport_feeder_code].default("")

	# Get status from dropdown
	_local status << .items[:status_field].value.default("BOOKED")

	# Determine transport_status based on selected status
	# RELEASE → transport_status = "RELEASE"
	# BOOKED → transport_status = "TAKEN"
	# ACTIVE → transport_status = "TAKEN"
	_local transport_status
	_if status = "RELEASE"
	_then
		transport_status << "RELEASE"
	_else
		# For both BOOKED and ACTIVE, set to TAKEN
		transport_status << "TAKEN"
	_endif

	write("Setting transport_status to: ", transport_status, " (status=", status, ")")

	# Determine destination fields based on status
	_local dest_type, dest_code, dest_tube, dest_core
	_if status = "RELEASE"
	_then
		# For RELEASE, set destination fields to null
		dest_type << _unset
		dest_code << _unset
		dest_tube << _unset
		dest_core << _unset
	_elif status = "ACTIVE"
	_then
		# For ACTIVE, use destination data from same table (table 1 - feeder)
		dest_type << "SUBFEEDER"
		dest_code << feeder_rec[:destination_code].default("")
		dest_tube << feeder_rec[:destination_tube_number].default("")
		dest_core << feeder_rec[:destination_core_number].default("")
	_else
		# For BOOKED, use destination data from table 2 (subfeeder)
		dest_type << "SUBFEEDER"
		dest_code << subfeeder_rec[:transport_subfeeder_code].default("")
		dest_tube << subfeeder_rec[:transport_tube_number].default("")
		dest_core << subfeeder_rec[:transport_core_number].default("")
	_endif

	# Build connection data with specific fields
	_local connection_data << property_list.new_with(
		:work_order_number, work_order,
		:source_type, source_type,
		:source_code, source_code,
		:transport_tube_number, feeder_rec[:transport_tube_number].default(""),
		:transport_core_number, feeder_rec[:transport_core_number].default(""),
		:transport_code, transport_code,
		:transport_status, transport_status,
		:transport_remarks, status,
		:destination_type, dest_type,
		:destination_code, dest_code,
		:destination_tube_number, dest_tube,
		:destination_core_number, dest_core
	)

	# Add default null/empty fields
	connection_data.add_all(_self.get_default_device_connection_fields())

	>> connection_data
_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.build_booking_subfeeder_data(work_order, subfeeder_rec, fdt_rec)
	## Build device connection data for booking subfeeder
	## Maps data from table 2 (subfeeder) and table 3 (FDT) to API format
	## Parameters:
	##   work_order - Work order number from project.name
	##   subfeeder_rec - Selected record from table 2 (Subfeeder Connectivity)
	##   fdt_rec - Selected record from table 3 (FDT Splice)
	## Returns:
	##   property_list with device connection data

	# Get source data from table 2
	_local source_type << "FEEDER"
	_local source_code << subfeeder_rec[:source_feeder_code].default("")

	# Get transport code from table 2
	_local transport_code << subfeeder_rec[:transport_subfeeder_code].default("")

	# Get status from dropdown
	_local status << .items[:status_field].value.default("BOOKED")

	# Determine transport_status based on selected status
	# RELEASE → transport_status = "RELEASE"
	# BOOKED → transport_status = "TAKEN"
	# ACTIVE → transport_status = "TAKEN"
	_local transport_status
	_if status = "RELEASE"
	_then
		transport_status << "RELEASE"
	_else
		# For both BOOKED and ACTIVE, set to TAKEN
		transport_status << "TAKEN"
	_endif

	write("Setting transport_status to: ", transport_status, " (status=", status, ")")

	# Determine destination fields based on status
	_local dest_type, dest_code, dest_tube, dest_core
	_if status = "RELEASE"
	_then
		# For RELEASE, set destination fields to null
		dest_type << _unset
		dest_code << _unset
		dest_tube << _unset
		dest_core << _unset
	_elif status = "ACTIVE"
	_then
		# For ACTIVE, use destination data from same table (table 2 - subfeeder)
		dest_type << "CLUSTER"
		dest_code << subfeeder_rec[:destination_cluster_code].default("")
		dest_tube << subfeeder_rec[:destination_tube_number].default("")
		dest_core << subfeeder_rec[:destination_core_number].default("")
	_else
		# For BOOKED, use destination data from table 3 (FDT)
		dest_type << "CLUSTER"
		_if fdt_rec _isnt _unset
		_then
			dest_code << fdt_rec[:destination_code].default("")
			dest_tube << fdt_rec[:dest_tube_number].default("")
			dest_core << fdt_rec[:dest_core_number].default("")
		_else
			dest_code << ""
			dest_tube << ""
			dest_core << ""
		_endif
	_endif

	# Build connection data with specific fields
	_local connection_data << property_list.new_with(
		:work_order_number, work_order,
		:source_type, source_type,
		:source_code, source_code,
		:transport_tube_number, subfeeder_rec[:transport_tube_number].default(""),
		:transport_core_number, subfeeder_rec[:transport_core_number].default(""),
		:transport_code, transport_code,
		:transport_status, transport_status,
		:transport_remarks, status,
		:destination_type, dest_type,
		:destination_code, dest_code,
		:destination_tube_number, dest_tube,
		:destination_core_number, dest_core
	)

	# Add default null/empty fields
	connection_data.add_all(_self.get_default_device_connection_fields())

	>> connection_data
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.populate_feeder_connection_table( a_table )
	##
	## Populate feeder table with device connection data from API response

	_local row << 1

	# Sort data by Tube Number, then by Core Number
	_local sorted_data << .feeder_table_list.as_sorted_collection(
		_proc(a, b)
			_local tube_a << a[:transport_tube_number].default(0)
			_local tube_b << b[:transport_tube_number].default(0)
			_local core_a << a[:transport_core_number].default(0)
			_local core_b << b[:transport_core_number].default(0)

			_if tube_a <> tube_b
			_then
				_return tube_a < tube_b
			_else
				_return core_a < core_b
			_endif
		_endproc)

	_for a_rec _over sorted_data.fast_elements()
	_loop
		a_table.set_row_data( row, a_rec )

		# Column 1: Source Type - depends on infra_type
		_local source_type
		_if .current_infra_type _is :feeder
		_then
			source_type << "OLT"
		_else
			# subfeeder
			source_type << "FEEDER"
		_endif
		a_table.add_cell(row, 1, {}, {:label, source_type})

		# Column 2: Source Code - depends on infra_type
		_local source_code
		_if .current_infra_type _is :feeder
		_then
			source_code << a_rec[:source_olt_device_code]
		_else
			# subfeeder
			source_code << a_rec[:source_feeder_code]
		_endif
		a_table.add_cell(row, 2, {}, {:label, source_code.default("").write_string})

		# Column 3: Transport Code - depends on infra_type
		_local transport_code
		_if .current_infra_type _is :feeder
		_then
			transport_code << a_rec[:transport_feeder_code]
		_else
			# subfeeder
			transport_code << a_rec[:transport_subfeeder_code]
		_endif
		a_table.add_cell(row, 3, {}, {:label, transport_code.default("").write_string})

		# Column 4: Tube Count - depends on infra_type
		_local tube_count
		_if .current_infra_type _is :feeder
		_then
			tube_count << a_rec[:transport_feeder_tube_count]
		_else
			tube_count << a_rec[:transport_subfeeder_tube_count]
		_endif
		a_table.add_cell(row, 4, {}, {:label, tube_count.default("").write_string, :row_alignment, :centre})

		# Column 5: Core Count - depends on infra_type
		_local core_count
		_if .current_infra_type _is :feeder
		_then
			core_count << a_rec[:transport_feeder_core_count]
		_else
			core_count << a_rec[:transport_subfeeder_core_count]
		_endif
		a_table.add_cell(row, 5, {}, {:label, core_count.default("").write_string, :row_alignment, :centre})

		# Column 6: Tube Number
		_local tube_num << a_rec[:transport_tube_number].default(0)
		a_table.add_cell(row, 6, {}, {:label, tube_num.write_string, :row_alignment, :centre})

		# Column 7: Core Number
		_local core_num << a_rec[:transport_core_number].default(0)
		a_table.add_cell(row, 7, {}, {:label, core_num.write_string, :row_alignment, :centre})

		# Column 8: SW Core - absolute core number in cable
		_local sw_core << (tube_num - 1) * 12 + core_num
		a_table.add_cell(row, 8, {}, {:label, sw_core.write_string, :row_alignment, :centre})

		# Column 9: Status - based on transport_status and transport_remarks
		_local icon_status
		_local t_status << a_rec[:transport_status].default("")
		_local t_remarks << a_rec[:transport_remarks].default("")

		_if t_status = "" _orif t_status _is _unset _orif t_status = "RELEASE"
		_then
			# NULL/BLANK or RELEASE -> RED
			icon_status << {:traffic_light_red, :ui_resources}
		_elif t_status = "TAKEN" _andif t_remarks = "BOOKED"
		_then
			# TAKEN & BOOKED -> YELLOW
			icon_status << {:traffic_light_yellow, :ui_resources}
		_elif t_status = "TAKEN" _andif (t_remarks = "" _orif t_remarks = "ACTIVE" _orif t_remarks _is _unset)
		_then
			# TAKEN & (NULL or BLANK or ACTIVE) -> GREEN
			icon_status << {:traffic_light_green, :ui_resources}
		_else
			# Default -> RED for safety
			icon_status << {:traffic_light_red, :ui_resources}
		_endif
		a_table.add_cell(row, 9, {}, {:image, icon_status })

		# Column 10: Destination Code
		_local dest_code << a_rec[:destination_cluster_code]
		a_table.add_cell(row, 10, {}, {:label, dest_code.default("").write_string })

		# Column 11: Destination Tube Number
		_local dest_tube << a_rec[:destination_tube_number]
		a_table.add_cell(row, 11, {}, {:label, dest_tube.default("").write_string, :row_alignment, :centre })

		# Column 12: Destination Core Number
		_local dest_core << a_rec[:destination_core_number]
		a_table.add_cell(row, 12, {}, {:label, dest_core.default("").write_string, :row_alignment, :centre })

		# Column 13: Destination Name
		_local dest_name << a_rec[:destination_cluster_name]
		a_table.add_cell(row, 13, {}, {:label, dest_name.default("").write_string })

		row +<< 1
	_endloop

	a_table.apply_sorting(_true )

_endmethod
$

