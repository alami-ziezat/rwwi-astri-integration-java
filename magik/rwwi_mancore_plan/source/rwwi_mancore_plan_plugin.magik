_package sw
$

remex(:rwwi_mancore_plan_plugin)
$

_pragma(classify_level=restricted)
def_slotted_exemplar(:rwwi_mancore_plan_plugin,
	##
	##
	{
		{:dialog, _unset }
	},
	:plugin)
$

_pragma(classify_level=advanced)
rwwi_mancore_plan_plugin.define_shared_constant(:databus_producer_data_types,
				      {
					      :goto_request,
					      :geometry_to_draw,
					      :post_render_sets
				      },
				      :private
	       )
$

_pragma(classify_level=advanced)
rwwi_mancore_plan_plugin.define_shared_constant(:post_render_sets,
				      equality_geometry_set.new(),
				      :private
	       )
$



_pragma(classify_level=restricted)
_method rwwi_mancore_plan_plugin.init_actions()
	## 
	##
	
	_self.add_action( sw_action.new( :activate_mancore_plan,
					 :caption,         "Mancore Plan Manager...",
					 :engine, _self,
					 :image, {:associate, :mit_base_gui},
					 :action_message, :|activate_mancore_plan()|,
					 :help_id, 5030 ) )
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_plugin.activate_mancore_plan()
	## 
	## Activate

	write("Activating ASTRI ManCore Manager...")

	name << :mancore_plan_manager
	.dialog << _self.get_dialog( name )
	_if .dialog _is _unset 
	_then
		.dialog << rwwi_mancore_plan_dialog.new(_self, _self.application)
		_self.cache_dialog( name, .dialog )
	_endif

	
	_if .dialog.active?.not
	_then
		.dialog.activate()
	_else
		write("Dialog already active")
	_endif
	>> .dialog
_endmethod
$

