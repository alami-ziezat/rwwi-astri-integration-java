_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.get_homepass_and_cores()
	##
	## Calculate homepass and cores to book from homepass field
	##
	## Returns:
	##   homepass_str    - String value from field
	##   homepass_count  - Numeric value
	##   cores_to_book   - Calculated cores (homepass/64 rounded UP)
	##
	## Note: Uses ceiling to round up (e.g., 8.1 → 9, not 8)
	##

	_local homepass_str << .items[:homepass_field].value.default("0")
	_local homepass_count << homepass_str.as_number().default(0)
	_local cores_to_book << (homepass_count.as_float / 64).ceiling

	write("Parsed Homepass: ", homepass_count, " cores to book ", cores_to_book)

	>> homepass_str, homepass_count, cores_to_book
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.homepass_changed()
	##
	## Called when homepass field is manually updated
	## Recalculates and logs the total cores to book
	##

	_local (homepass_str, homepass_count, cores_to_book) << _self.get_homepass_and_cores()

	write("Homepass field updated: ", homepass_count)
	write("Total Cores to Book: ", cores_to_book)

	# Append to log
	.items[:log].append(newline_char)
	.items[:log].append("** Homepass Updated **")
	.items[:log].append(newline_char)
	.items[:log].append("Total Homepass      : " + homepass_count.write_string)
	.items[:log].append(newline_char)
	.items[:log].append("Total Cores to Book : " + cores_to_book.write_string)
	.items[:log].append(newline_char)
	.items[:log].append(newline_char)

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.status_changed()
	##
	## Called when status dropdown is changed
	## Updates button states based on new status
	##

	_local status << .items[:status_field].value.default("BOOKED")
	write("Status changed to: ", status)

	# Update button states based on new status and current selections
	_self.update_booking_button_states()

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.booking_feeder()
	##
	## Booking Feeder - Book device connections between Table 1 (Feeder) and Table 2 (Subfeeder)
	##

	write("============================================")
	write("BOOKING FEEDER")
	write("============================================")

	# Get current design for work_order_number
	_local design << _unset
	_local work_order << ""
	_try
		design << swg_dsn_admin_engine.get_current_job()
		_if design _is _unset
		_then
			_self.show_message("No active design. Please activate a design first.")
			_return
		_endif
		work_order << design.project.perform(:name).default("")
		_if work_order = "" _orif work_order _is _unset
		_then
			_self.show_message("Cannot get project name from active design.")
			_return
		_endif
		write("Work Order (project.name): ", work_order)
	_when error
		_self.show_message("Cannot get active design. Please activate a design first.")
		_return
	_endtry

	# Get selections from slots
	_local feeder_selection << .feeder_table_selection
	_local subfeeder_selection << .subfeeder_table_selection

	# Get status
	_local status << .items[:status_field].value.default("BOOKED")
	write("Status: ", status)

	# Get records based on status
	_local feeder_records
	_local subfeeder_records

	_if status = "BOOKED"
	_then
		# For BOOKED status: Filter out TAKEN->ACTIVE records, allow TAKEN->BOOKED and RELEASE
		feeder_records << _self.get_bookable_records_from_selection(feeder_selection)
		subfeeder_records << _self.get_bookable_records_from_selection(subfeeder_selection)
		write("Using bookable records filter (excludes TAKEN->ACTIVE)")
	_else
		# For RELEASE/ACTIVE status: Get all selected records
		feeder_records << _self.get_records_from_selection(feeder_selection)
		subfeeder_records << _self.get_records_from_selection(subfeeder_selection)
		write("Using all selected records")
	_endif

	write("Table 1 (Feeder): ", feeder_records.size, " records")
	write("Table 2 (Subfeeder): ", subfeeder_records.size, " records")

	# Validate against homepass (only for BOOKED status)
	_if status = "BOOKED"
	_then
		_local (homepass_str, homepass_count, cores_to_book) << _self.get_homepass_and_cores()

		write("Total Homepass: ", homepass_count)
		write("Total Cores to Book: ", cores_to_book)

		_if feeder_records.size > cores_to_book
		_then
			_local msg << write_string("Booking validation failed!", newline_char, newline_char,
						   "Records to book: ", feeder_records.size, newline_char,
						   "Maximum allowed (based on homepass): ", cores_to_book, newline_char, newline_char,
						   "Total Homepass: ", homepass_count, newline_char,
						   "This exceeds the homepass limit.")
			_self.show_message(msg)
			write("ERROR: Booking exceeds homepass limit")
			_return
		_endif
	_endif

	# Execute booking
	_self.execute_booking_feeder(work_order, feeder_records, subfeeder_records, status)

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.booking_subfeeder()
	##
	## Booking Subfeeder - Book device connections between Table 2 (Subfeeder) and Table 3 (FDT)
	##

	write("============================================")
	write("BOOKING SUBFEEDER")
	write("============================================")

	# Get current design for work_order_number
	_local design << _unset
	_local work_order << ""
	_try
		design << swg_dsn_admin_engine.get_current_job()
		_if design _is _unset
		_then
			_self.show_message("No active design. Please activate a design first.")
			_return
		_endif
		work_order << design.project.perform(:name).default("")
		_if work_order = "" _orif work_order _is _unset
		_then
			_self.show_message("Cannot get project name from active design.")
			_return
		_endif
		write("Work Order (project.name): ", work_order)
	_when error
		_self.show_message("Cannot get active design. Please activate a design first.")
		_return
	_endtry

	# Get selections from slots
	_local subfeeder_selection << .subfeeder_table_selection
	_local fdt_selection << .fdt_table_selection

	# Get all records from subfeeder table (regardless of status)
	_local subfeeder_records << _self.get_records_from_selection(subfeeder_selection)

	# Get all records from FDT table
	_local fdt_records << _self.get_records_from_selection(fdt_selection)

	write("Table 2 (Subfeeder): ", subfeeder_records.size, " records")
	write("Table 3 (FDT): ", fdt_records.size, " records")

	# Get status
	_local status << .items[:status_field].value.default("BOOKED")
	write("Status: ", status)

	# Validate against homepass (only for BOOKED status)
	_if status = "BOOKED"
	_then
		_local (homepass_str, homepass_count, cores_to_book) << _self.get_homepass_and_cores()

		write("Total Homepass: ", homepass_count)
		write("Total Cores to Book: ", cores_to_book)

		_if subfeeder_records.size > cores_to_book
		_then
			_local msg << write_string("Booking validation failed!", newline_char, newline_char,
						   "Records to book: ", subfeeder_records.size, newline_char,
						   "Maximum allowed (based on homepass): ", cores_to_book, newline_char, newline_char,
						   "Total Homepass: ", homepass_count, newline_char,
						   "This exceeds the homepass limit.")
			_self.show_message(msg)
			write("ERROR: Booking exceeds homepass limit")
			_return
		_endif
	_endif

	# Execute booking
	_self.execute_booking_subfeeder(work_order, subfeeder_records, fdt_records, status)

_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.get_idle_records_from_selection(selection)
	## Extract IDLE records from table selection
	## Parameters:
	##   selection - Table selection object
	## Returns:
	##   rope of IDLE records (status != "TAKEN")

	_local idle_records << rope.new()

	_if selection _is _unset
	_then
		_return idle_records
	_endif

	_local records << selection.get_row_data_from_selection()
	_for rec _over records.fast_elements()
	_loop
		_if rec[:transport_status] <> "TAKEN"
		_then
			idle_records.add(rec)
		_endif
	_endloop

	>> idle_records
_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.get_bookable_records_from_selection(selection)
	## Extract records that can be booked for BOOKED status
	## Parameters:
	##   selection - Table selection object
	## Returns:
	##   rope of records that can be booked:
	##     - IDLE records (transport_status != "TAKEN")
	##     - TAKEN -> BOOKED records (can re-book)
	##     - TAKEN -> RELEASE records
	##   Excludes:
	##     - TAKEN records with unset/empty/ACTIVE remarks (cannot book over active connections)

	_local bookable_records << rope.new()

	_if selection _is _unset
	_then
		_return bookable_records
	_endif

	_local records << selection.get_row_data_from_selection()
	_for rec _over records.fast_elements()
	_loop
		_local t_status << rec[:transport_status].default("")
		_local t_remarks << rec[:transport_remarks].default("")

		# Allow IDLE records (not TAKEN)
		_if t_status <> "TAKEN"
		_then
			bookable_records.add(rec)
			_continue
		_endif

		# Block TAKEN with unset/empty/ACTIVE remarks (cannot book over active connections)
		_if t_status = "TAKEN" _andif (t_remarks = "" _orif t_remarks = "ACTIVE")
		_then
			# Skip this record - cannot book over ACTIVE/unset/empty
			write("  Skipping TAKEN with unset/empty/ACTIVE: Tube ", rec[:transport_tube_number], " Core ", rec[:transport_core_number])
			_continue
		_endif

		# Allow TAKEN with other remarks (e.g., BOOKED - can re-book)
		bookable_records.add(rec)
	_endloop

	>> bookable_records
_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.get_records_from_selection(selection)
	## Extract all records from table selection (no filtering)
	## Parameters:
	##   selection - Table selection object
	## Returns:
	##   rope of records

	_local records << rope.new()

	_if selection _is _unset
	_then
		_return records
	_endif

	_local selected << selection.get_row_data_from_selection()
	_for rec _over selected.fast_elements()
	_loop
		records.add(rec)
	_endloop

	>> records
_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.execute_booking_feeder(work_order, feeder_records, subfeeder_records, status)
	## Execute booking feeder
	## Parameters:
	##   work_order - Work order number
	##   feeder_records - Records from Table 1 (Feeder)
	##   subfeeder_records - Records from Table 2 (Subfeeder) - only used for BOOKED
	##   status - Status from dropdown (BOOKED/RELEASE/ACTIVE)
	##
	## Behavior:
	##   BOOKED: Process pairs (Table 1 paired with Table 2)
	##   RELEASE/ACTIVE: Process all Table 1 records independently (no pairing)

	write("============================================")
	write("EXECUTING BOOKING FEEDER")
	write("============================================")

	# Process each record
	_local success_count << 0
	_local error_count << 0
	_local errors << rope.new()

	_if status = "BOOKED"
	_then
		# BOOKED: Validate pair counts and process pairs
		_if feeder_records.size <> subfeeder_records.size
		_then
			_local msg << write_string("Selected records count mismatch!", newline_char,
						   "Table 1 (Feeder): ", feeder_records.size, newline_char,
						   "Table 2 (Subfeeder): ", subfeeder_records.size, newline_char,
						   "Please select the same number of records in both tables.")
			_self.show_message(msg)
			_return
		_endif

		write("Processing ", feeder_records.size, " pairs for BOOKED status...")

		_for i _over 1.upto(feeder_records.size)
		_loop
			_local feeder_rec << feeder_records[i]
			_local subfeeder_rec << subfeeder_records[i]

			write("Pair ", i, ":")
			write("  Table 1: Tube ", feeder_rec[:transport_tube_number], " Core ", feeder_rec[:transport_core_number])
			write("  Table 2: Tube ", subfeeder_rec[:transport_tube_number], " Core ", subfeeder_rec[:transport_core_number])

			# Build connection data
			_local connection_data << _self.build_booking_feeder_data(
				work_order, feeder_rec, subfeeder_rec)

			# Call API
			_local result << .engine.add_device_connection(connection_data)

			_if result[:success] = _true
			_then
				success_count +<< 1
				write("  >> SUCCESS: Booking created")
			_else
				error_count +<< 1
				_local err_msg << result[:error_message].default("Unknown error")
				errors.add(write_string("Pair ", i, ": ", err_msg))
				write("  >> ERROR: ", err_msg)
			_endif
		_endloop

	_else
		# RELEASE/ACTIVE: Process all feeder records independently (no pairing)
		write("Processing ", feeder_records.size, " records for ", status, " status (no pairing required)...")

		_local code_to_core_count << hash_table.new()  # Track destination codes and sum core counts (no duplicates)

		_for i _over 1.upto(feeder_records.size)
		_loop
			_local feeder_rec << feeder_records[i]

			write("Record ", i, ":")
			write("  Table 1: Tube ", feeder_rec[:transport_tube_number], " Core ", feeder_rec[:transport_core_number])

			# Build connection data (subfeeder_rec = _unset for RELEASE/ACTIVE)
			_local connection_data << _self.build_booking_feeder_data(
				work_order, feeder_rec, _unset)

			# Call API
			_local result << .engine.add_device_connection(connection_data)

			_if result[:success] = _true
			_then
				success_count +<< 1
				write("  >> SUCCESS: Booking created")

				# For ACTIVE/RELEASE status: Track destination codes with source feeder code, tube, and core
				_if status = "ACTIVE" _orif status = "RELEASE"
				_then
					_local dest_subfeeder_code << feeder_rec[:destination_subfeeder_code].default(feeder_rec[:destination_code])
					_local feeder_core_count << feeder_rec[:transport_feeder_core_count].default(100)
					_local source_feeder_code << feeder_rec[:transport_feeder_code].default("")
					_local source_tube << feeder_rec[:transport_tube_number].default("")
					_local source_core << feeder_rec[:transport_core_number].default("")
					_local dest_tube_number << feeder_rec[:destination_tube_number].default("")
					_local dest_core_number << feeder_rec[:destination_core_number].default("")
					_if dest_subfeeder_code <> "" _andif dest_subfeeder_code _isnt _unset _andif
					    source_feeder_code <> "" _andif source_feeder_code _isnt _unset
					_then
						# Convert to symbol for hash table key
						_local code_symbol << dest_subfeeder_code.as_symbol()

						# Track destination code with source feeder code, tube, core, and core count
						_if _not code_to_core_count.includes_key?(code_symbol)
						_then
							code_to_core_count[code_symbol] << property_list.new_with(
								:core_count, feeder_core_count,
								:source_feeder_code, source_feeder_code,
								:source_tube, source_tube,
								:source_core, source_core,
								:destination_tube_number, dest_tube_number,
								:destination_core_number, dest_core_number)
							write("  >> Tracking destination subfeeder: ", dest_subfeeder_code, " (", feeder_core_count, " cores, source: ", source_feeder_code, ", tube: ", dest_tube_number, ", core: ", dest_core_number, ")")
						_else
							write("  >> Destination subfeeder already tracked: ", dest_subfeeder_code, " (skipping duplicate)")
						_endif
					_endif
				_endif
			_else
				error_count +<< 1
				_local err_msg << result[:error_message].default("Unknown error")
				errors.add(write_string("Record ", i, ": ", err_msg))
				write("  >> ERROR: ", err_msg)
			_endif
		_endloop

		# For ACTIVE status: Automatically activate subfeeders booked to these feeders
		_if status = "ACTIVE" _andif _not code_to_core_count.empty?
		_then
			write("============================================")
			write("AUTO-ACTIVATING DESTINATION SUBFEEDERS")
			write("============================================")
			write("Found ", code_to_core_count.size, " unique destination subfeeder code(s)")

			_self.activate_destination_subfeeders(work_order, code_to_core_count, success_count, error_count, errors)
		_endif

		# For RELEASE status: Automatically revert subfeeders back to BOOKED
		_if status = "RELEASE" _andif _not code_to_core_count.empty?
		_then
			write("============================================")
			write("AUTO-REVERTING DESTINATION SUBFEEDERS TO BOOKED")
			write("============================================")
			write("Found ", code_to_core_count.size, " unique destination subfeeder code(s)")

			_self.release_destination_subfeeders(work_order, code_to_core_count, success_count, error_count, errors)
		_endif
	_endif

	write("============================================")
	write("BOOKING FEEDER COMPLETED")
	write("============================================")
	write("Success: ", success_count)
	write("Errors: ", error_count)

	# Show result to user with status-specific message
	_local action_text << _if status = "BOOKED"
	                      _then >> "Booked"
	                      _elif status = "RELEASE"
	                      _then >> "Released"
	                      _elif status = "ACTIVE"
	                      _then >> "Activated"
	                      _else >> "Processed"
	                      _endif

	_local msg << write_string("Run Feeder Completed - Status: ", action_text, newline_char,
				   "Success: ", success_count, newline_char,
				   "Errors: ", error_count)

	_if error_count > 0
	_then
		msg +<< newline_char + newline_char + "Errors:" + newline_char
		_for err _over errors.fast_elements()
		_loop
			msg +<< err + newline_char
		_endloop
	_endif

	_self.show_message(msg)

	# Refresh tables after booking
	_if success_count > 0
	_then
		write("Refreshing tables after successful bookings...")
		_self.refresh_data_after_booking()
	_endif

_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.execute_booking_subfeeder(work_order, subfeeder_records, fdt_records, status)
	## Execute booking subfeeder
	## Parameters:
	##   work_order - Work order number
	##   subfeeder_records - Records from Table 2 (Subfeeder)
	##   fdt_records - Records from Table 3 (FDT) - only used for BOOKED
	##   status - Status from dropdown (BOOKED/RELEASE/ACTIVE)
	##
	## Behavior:
	##   BOOKED: Process pairs (Table 2 paired with Table 3)
	##   RELEASE/ACTIVE: Process all Table 2 records independently (no pairing)

	write("============================================")
	write("EXECUTING BOOKING SUBFEEDER")
	write("============================================")

	write("Table 2 (Subfeeder): ", subfeeder_records.size, " records")

	# Process each record
	_local success_count << 0
	_local error_count << 0
	_local errors << rope.new()

	_if status = "BOOKED"
	_then
		# BOOKED: Process pairs with FDT records
		write("Table 3 (FDT): ", fdt_records.size, " records")

		_if fdt_records.size > subfeeder_records.size
		_then
			write("WARNING: Table 3 has more records than Table 2. Only first ", subfeeder_records.size, " FDT records will be used.")
		_elif fdt_records.size < subfeeder_records.size
		_then
			write("NOTE: Table 3 has fewer records. Remaining Table 2 records will have empty destination fields.")
		_endif

		write("Processing ", subfeeder_records.size, " records for BOOKED status...")

		_for i _over 1.upto(subfeeder_records.size)
		_loop
			_local subfeeder_rec << subfeeder_records[i]
			_local fdt_rec << _unset

			# Get matching FDT record if available
			_if i <= fdt_records.size
			_then
				fdt_rec << fdt_records[i]
			_endif

			write("Pair ", i, ":")
			write("  Table 2: Tube ", subfeeder_rec[:transport_tube_number], " Core ", subfeeder_rec[:transport_core_number])
			_if fdt_rec _isnt _unset
			_then
				write("  Table 3: ", fdt_rec[:splitter_name].default(""), " - Dest Core ", fdt_rec[:dest_core_number].default(""))
			_else
				write("  Table 3: (no pair - destination will be empty)")
			_endif

			# Build connection data
			_local connection_data << _self.build_booking_subfeeder_data(
				work_order, subfeeder_rec, fdt_rec)

			# Call API
			_local result << .engine.add_device_connection(connection_data)

			_if result[:success] = _true
			_then
				success_count +<< 1
				write("  >> SUCCESS: Booking created")
			_else
				error_count +<< 1
				_local err_msg << result[:error_message].default("Unknown error")
				errors.add(write_string("Pair ", i, ": ", err_msg))
				write("  >> ERROR: ", err_msg)
			_endif
		_endloop

	_else
		# RELEASE/ACTIVE: Process all subfeeder records independently (no pairing)
		write("Processing ", subfeeder_records.size, " records for ", status, " status (no pairing required)...")

		_for i _over 1.upto(subfeeder_records.size)
		_loop
			_local subfeeder_rec << subfeeder_records[i]

			write("Record ", i, ":")
			write("  Table 2: Tube ", subfeeder_rec[:transport_tube_number], " Core ", subfeeder_rec[:transport_core_number])

			# Build connection data (fdt_rec = _unset for RELEASE/ACTIVE)
			_local connection_data << _self.build_booking_subfeeder_data(
				work_order, subfeeder_rec, _unset)

			# Call API
			_local result << .engine.add_device_connection(connection_data)

			_if result[:success] = _true
			_then
				success_count +<< 1
				write("  >> SUCCESS: Booking created")
			_else
				error_count +<< 1
				_local err_msg << result[:error_message].default("Unknown error")
				errors.add(write_string("Record ", i, ": ", err_msg))
				write("  >> ERROR: ", err_msg)
			_endif
		_endloop
	_endif

	write("============================================")
	write("BOOKING SUBFEEDER COMPLETED")
	write("============================================")
	write("Success: ", success_count)
	write("Errors: ", error_count)

	# Show result to user with status-specific message
	_local action_text << _if status = "BOOKED"
	                      _then >> "Booked"
	                      _elif status = "RELEASE"
	                      _then >> "Released"
	                      _elif status = "ACTIVE"
	                      _then >> "Activated"
	                      _else >> "Processed"
	                      _endif

	_local msg << write_string("Run Subfeeder Completed - Status: ", action_text, newline_char,
				   "Success: ", success_count, newline_char,
				   "Errors: ", error_count)

	_if error_count > 0
	_then
		msg +<< newline_char + newline_char + "Errors:" + newline_char
		_for err _over errors.fast_elements()
		_loop
			msg +<< err + newline_char
		_endloop
	_endif

	_self.show_message(msg)

	# Refresh tables after booking
	_if success_count > 0
	_then
		write("Refreshing tables after successful bookings...")
		_self.refresh_data_after_booking()
	_endif

_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.refresh_data_after_booking()
	## Refresh data after successful booking operations
	## Re-queries ALL tables (feeder, subfeeder, FDT) to show updated status

	write("============================================")
	write("REFRESHING DATA AFTER BOOKING")
	write("============================================")

	# Check if we have stored codes from get_mancore()
	_if .current_feeder_code _is _unset _andif .current_subfeeder_code _is _unset
	_then
		write("Cannot refresh - no infrastructure codes stored")
		write("Please run 'Get Mancore' first before booking")
		_return
	_endif

	# Re-query all three tables with stored codes
	_if .current_feeder_code _isnt _unset
	_then
		write("Re-querying feeder table (code: ", .current_feeder_code, ")...")
		_self.query_and_populate_feeder_table(.current_feeder_code)
	_endif

	_if .current_subfeeder_code _isnt _unset
	_then
		write("Re-querying subfeeder table (code: ", .current_subfeeder_code, ")...")
		_self.query_and_populate_subfeeder_table(.current_subfeeder_code)

		write("Re-querying FDT/optical splitters table (code: ", .current_subfeeder_code, ")...")
		_self.query_and_populate_optical_splitters(.current_subfeeder_code)
	_endif

	write("Data refresh completed - all tables updated")

_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.get_default_device_connection_fields()
	## Returns property_list with all null/empty device and transport metadata fields
	## These fields are common to all booking operations
	## Returns:
	##   property_list with null/empty default fields

	>> property_list.new_with(
		:source_tube_number, _unset,
		:source_core_number, _unset,
		:source_device_name, _unset,
		:source_device_hardware_type, _unset,
		:source_device_port_name, _unset,
		:source_device_port_type, _unset,
		:source_device_remarks, _unset,
		:source_device_capacity, _unset,
		:source_device_capacity_measurement, _unset,
		:transport_name, _unset,
		:transport_hardware_type, _unset,
		:transport_capacity, _unset,
		:transport_capacity_measurement, _unset,
		:destination_device_name, _unset,
		:destination_device_hardware_type, _unset,
		:destination_device_port_name, _unset,
		:destination_device_port_type, _unset,
		:destination_device_remarks, _unset,
		:destination_device_capacity, _unset,
		:destination_device_capacity_measurement, _unset,
		:destination_status, _unset,
		:destination_remarks, _unset,
		:verified_by_username, _unset,
		:verified_at, _unset
	)
_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.build_booking_feeder_data(work_order, feeder_rec, subfeeder_rec)
	## Build device connection data for booking feeder
	## Maps data from table 1 (feeder) and table 2 (subfeeder) to API format
	## Parameters:
	##   work_order - Work order number from project.name
	##   feeder_rec - Selected record from table 1 (Feeder Connectivity)
	##   subfeeder_rec - Selected record from table 2 (Subfeeder Connectivity)
	## Returns:
	##   property_list with device connection data

	# Get source data from table 1
	_local source_type << "OLT"
	_local source_code << feeder_rec[:source_olt_device_code].default("")

	# Get transport code from table 1
	_local transport_code << feeder_rec[:transport_feeder_code].default("")

	# Get status from dropdown
	_local status << .items[:status_field].value.default("BOOKED")

	# Determine transport_status based on selected status
	# RELEASE → transport_status = "RELEASE"
	# BOOKED → transport_status = "TAKEN"
	# ACTIVE → transport_status = "TAKEN"
	_local transport_status
	_if status = "RELEASE"
	_then
		transport_status << "RELEASE"
	_else
		# For both BOOKED and ACTIVE, set to TAKEN
		transport_status << "TAKEN"
	_endif

	write("Setting transport_status to: ", transport_status, " (status=", status, ")")

	# Determine destination fields based on status
	_local dest_type, dest_code, dest_tube, dest_core
	_if status = "RELEASE"
	_then
		# For RELEASE, set destination fields to null
		dest_type << _unset
		dest_code << _unset
		dest_tube << _unset
		dest_core << _unset
	_elif status = "ACTIVE"
	_then
		# For ACTIVE, use destination data from same table (table 1 - feeder)
		dest_type << "SUBFEEDER"
		dest_code << feeder_rec[:destination_subfeeder_code].default(feeder_rec[:destination_code])
		dest_tube << feeder_rec[:destination_tube_number].default("")
		dest_core << feeder_rec[:destination_core_number].default("")
	_else
		# For BOOKED, use destination data from table 2 (subfeeder)
		dest_type << "SUBFEEDER"
		dest_code << subfeeder_rec[:transport_subfeeder_code].default("")
		dest_tube << subfeeder_rec[:transport_tube_number].default("")
		dest_core << subfeeder_rec[:transport_core_number].default("")
	_endif

	# Build connection data with specific fields
	_local connection_data << property_list.new_with(
		:work_order_number, work_order,
		:source_type, source_type,
		:source_code, source_code,
		:transport_tube_number, feeder_rec[:transport_tube_number].default(""),
		:transport_core_number, feeder_rec[:transport_core_number].default(""),
		:transport_code, transport_code,
		:transport_status, transport_status,
		:transport_remarks, status,
		:destination_type, dest_type,
		:destination_code, dest_code,
		:destination_tube_number, dest_tube,
		:destination_core_number, dest_core
	)

	# Add default null/empty fields
	connection_data.add_all(_self.get_default_device_connection_fields())

	>> connection_data
_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.build_booking_subfeeder_data(work_order, subfeeder_rec, fdt_rec)
	## Build device connection data for booking subfeeder
	## Maps data from table 2 (subfeeder) and table 3 (FDT) to API format
	## Parameters:
	##   work_order - Work order number from project.name
	##   subfeeder_rec - Selected record from table 2 (Subfeeder Connectivity)
	##   fdt_rec - Selected record from table 3 (FDT Splice)
	## Returns:
	##   property_list with device connection data

	# Get source data from table 2
	_local source_type << "FEEDER"
	_local source_code << subfeeder_rec[:source_feeder_code].default("")

	# Get transport code from table 2
	_local transport_code << subfeeder_rec[:transport_subfeeder_code].default("")

	# Get status from dropdown
	_local status << .items[:status_field].value.default("BOOKED")

	# Determine transport_status based on selected status
	# RELEASE → transport_status = "RELEASE"
	# BOOKED → transport_status = "TAKEN"
	# ACTIVE → transport_status = "TAKEN"
	_local transport_status
	_if status = "RELEASE"
	_then
		transport_status << "RELEASE"
	_else
		# For both BOOKED and ACTIVE, set to TAKEN
		transport_status << "TAKEN"
	_endif

	write("Setting transport_status to: ", transport_status, " (status=", status, ")")

	# Get destination fields based on status
	_local dest_type, dest_code, dest_tube, dest_core
	_if status = "RELEASE"
	_then
		# For RELEASE, set destination fields to null
		dest_type << _unset
		dest_code << _unset
		dest_tube << _unset
		dest_core << _unset
	_elif status = "ACTIVE"
	_then
		# For ACTIVE, use destination data from same table (table 2 - subfeeder)
		dest_type << "CLUSTER"
		dest_code << subfeeder_rec[:destination_cluster_code].default("")
		dest_tube << subfeeder_rec[:destination_tube_number].default("")
		dest_core << subfeeder_rec[:destination_core_number].default("")
	_else
		# For BOOKED, use destination data from table 3 (FDT)
		dest_type << "CLUSTER"
		_if fdt_rec _isnt _unset
		_then
			dest_code << fdt_rec[:destination_code].default("")
			dest_tube << fdt_rec[:dest_tube_number].default("")
			dest_core << fdt_rec[:dest_core_number].default("")
		_else
			dest_code << ""
			dest_tube << ""
			dest_core << ""
		_endif
	_endif

	# Build connection data with specific fields
	_local connection_data << property_list.new_with(
		:work_order_number, work_order,
		:source_type, source_type,
		:source_code, source_code,
		:transport_tube_number, subfeeder_rec[:transport_tube_number].default(""),
		:transport_core_number, subfeeder_rec[:transport_core_number].default(""),
		:transport_code, transport_code,
		:transport_status, transport_status,
		:transport_remarks, status,
		:destination_type, dest_type,
		:destination_code, dest_code,
		:destination_tube_number, dest_tube,
		:destination_core_number, dest_core
	)

	# Add default null/empty fields
	connection_data.add_all(_self.get_default_device_connection_fields())

	>> connection_data
_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.activate_destination_subfeeders(work_order, code_to_core_count, success_count, error_count, errors)
	##
	## Automatically activate destination subfeeders when feeder is activated
	## Parameters:
	##   work_order - Work order number
	##   code_to_core_count - hash_table mapping destination_subfeeder_code (symbol) to property_list with:
	##                        :core_count - number of cores to query
	##                        :source_feeder_code - single source feeder code
	##                        :destination_tube_number - destination tube number from feeder
	##                        :destination_core_number - destination core number from feeder
	##   success_count - Reference to success counter (updated by reference)
	##   error_count - Reference to error counter (updated by reference)
	##   errors - rope of error messages (updated by reference)
	##
	## Filtering criteria for subfeeders:
	##   - source_type = "FEEDER"
	##   - source_code = source_feeder_code
	##   - transport_status = "TAKEN"
	##   - transport_remarks = "BOOKED"
	##   - transport_tube_number = destination_tube_number (from feeder)
	##   - transport_core_number = destination_core_number (from feeder)
	##

	_local subfeeder_success << 0
	_local subfeeder_error << 0

	# Query and activate subfeeders for each unique destination code
	_for dest_code_symbol, info _over code_to_core_count.fast_keys_and_elements()
	_loop
		# Convert symbol back to string for querying
		_local dest_code << dest_code_symbol.write_string
		_local total_cores << info[:core_count]
		_local source_feeder_code << info[:source_feeder_code]
		_local source_tube << info[:source_tube]
		_local source_core << info[:source_core]
		_local dest_tube_number << info[:destination_tube_number]
		_local dest_core_number << info[:destination_core_number]

		write("Querying subfeeders for code: ", dest_code, " (limit: ", total_cores, " cores, source: ", source_feeder_code, ", tube: ", dest_tube_number, ", core: ", dest_core_number, ")")

		# Query device connections using the correct method signature
		_local query_result << .engine.get_device_connections("subfeeder", dest_code, total_cores, 0)

		_if query_result[:success] _isnt _true
		_then
			_local err_msg << write_string("Failed to query subfeeders for ", dest_code, ": ",
						       query_result[:error_message].default("Unknown error"))
			write("  >> ERROR: ", err_msg)
			errors.add(err_msg)
			subfeeder_error +<< 1
			_continue
		_endif

		_local subfeeder_records << query_result[:data]
		write("  Found ", subfeeder_records.size, " subfeeder record(s) - filtering by criteria...")

		# Filter records to match criteria:
		# - source_code = source_feeder_code
		# - transport_status = "TAKEN"
		# - transport_remarks = "BOOKED"
		# - transport_tube_number = destination_tube_number (from feeder)
		# - transport_core_number = destination_core_number (from feeder)
		write("  Filtering criteria:  source_code=", source_feeder_code,
		      ", transport_status=TAKEN, transport_remarks=BOOKED, transport_tube_number=", dest_tube_number,
		      ", transport_core_number=", dest_core_number)
		_local filtered_records << rope.new()
		_for rec _over subfeeder_records.fast_elements()
		_loop
			_local src_code << rec[:source_feeder_code].default("")
			_local t_status << rec[:transport_status].default("")
			_local t_remarks << rec[:transport_remarks].default("")
			_local t_tube << rec[:transport_tube_number].default("")
			_local t_core << rec[:transport_core_number].default("")

			_if src_code = source_feeder_code _andif
			    t_status = "TAKEN" _andif
			    t_remarks = "BOOKED" _andif
			    t_tube = dest_tube_number _andif
			    t_core = dest_core_number
			_then
				filtered_records.add(rec)
			_endif
		_endloop

		write("  Filtered to ", filtered_records.size, " matching subfeeder(s)")

		# Activate each matching subfeeder
		_for subfeeder_rec _over filtered_records.fast_elements()
		_loop
			write("  Activating: Tube ", subfeeder_rec[:transport_tube_number], " Core ", subfeeder_rec[:transport_core_number])

			# Build activation data
			_local activation_data << property_list.new_with(
				:work_order_number, work_order,
				:source_type, "FEEDER",
				:source_code, subfeeder_rec[:source_feeder_code].default(""),
				:source_tube_number, source_tube,
				:source_core_number, source_core,
				:transport_tube_number, subfeeder_rec[:transport_tube_number].default(""),
				:transport_core_number, subfeeder_rec[:transport_core_number].default(""),
				:transport_code, subfeeder_rec[:transport_subfeeder_code].default(""),
				:transport_status, "TAKEN",
				:transport_remarks, "ACTIVE",
				:destination_type, "CLUSTER",
				:destination_code, subfeeder_rec[:destination_cluster_code].default(""),
				:destination_tube_number, subfeeder_rec[:destination_tube_number].default(""),
				:destination_core_number, subfeeder_rec[:destination_core_number].default("")
			)

			# Add default fields
			activation_data.add_all(_self.get_default_device_connection_fields())

			# Call API to activate
			_local result << .engine.add_device_connection(activation_data)

			_if result[:success] = _true
			_then
				subfeeder_success +<< 1
				write("    >> SUCCESS: Subfeeder activated")
			_else
				subfeeder_error +<< 1
				_local err_msg << write_string("Subfeeder activation failed (", dest_code, " Tube ",
							       subfeeder_rec[:transport_tube_number], " Core ",
							       subfeeder_rec[:transport_core_number], "): ",
							       result[:error_message].default("Unknown error"))
				errors.add(err_msg)
				write("    >> ERROR: ", result[:error_message].default("Unknown error"))
			_endif
		_endloop
	_endloop

	write("============================================")
	write("AUTO-ACTIVATION COMPLETED")
	write("============================================")
	write("Subfeeders Activated: ", subfeeder_success)
	write("Subfeeders Failed: ", subfeeder_error)

	# Update overall counters (pass by reference not supported, so we log it separately)
	# The counts will be shown in the final message

_endmethod
$

_pragma(classify_level=restricted)
_private _method rwwi_mancore_plan_dialog.release_destination_subfeeders(work_order, code_to_core_count, success_count, error_count, errors)
	##
	## Automatically revert destination subfeeders to BOOKED when feeder is released
	## Parameters:
	##   work_order - Work order number
	##   code_to_core_count - hash_table mapping destination_subfeeder_code (symbol) to property_list with:
	##                        :core_count - number of cores to query
	##                        :source_feeder_code - single source feeder code
	##                        :destination_tube_number - destination tube number from feeder
	##                        :destination_core_number - destination core number from feeder
	##   success_count - Reference to success counter (updated by reference)
	##   error_count - Reference to error counter (updated by reference)
	##   errors - rope of error messages (updated by reference)
	##
	## Filtering criteria for subfeeders:
	##   - source_type = "FEEDER"
	##   - source_code = source_feeder_code
	##   - transport_status = "TAKEN"
	##   - transport_remarks = "ACTIVE"
	##   - transport_tube_number = destination_tube_number (from feeder)
	##   - transport_core_number = destination_core_number (from feeder)
	##

	_local subfeeder_success << 0
	_local subfeeder_error << 0

	# Query and revert subfeeders for each unique destination code
	_for dest_code_symbol, info _over code_to_core_count.fast_keys_and_elements()
	_loop
		# Convert symbol back to string for querying
		_local dest_code << dest_code_symbol.write_string
		_local total_cores << info[:core_count]
		_local source_feeder_code << info[:source_feeder_code]
		_local source_tube << info[:source_tube]
		_local source_core << info[:source_core]
		_local dest_tube_number << info[:destination_tube_number]
		_local dest_core_number << info[:destination_core_number]

		write("Querying ACTIVE subfeeders for code: ", dest_code, " (limit: ", total_cores, " cores, source: ", source_feeder_code, ", tube: ", dest_tube_number, ", core: ", dest_core_number, ")")

		# Query device connections using the correct method signature
		_local query_result << .engine.get_device_connections("subfeeder", dest_code, total_cores, 0)

		_if query_result[:success] _isnt _true
		_then
			_local err_msg << write_string("Failed to query subfeeders for ", dest_code, ": ",
						       query_result[:error_message].default("Unknown error"))
			write("  >> ERROR: ", err_msg)
			errors.add(err_msg)
			subfeeder_error +<< 1
			_continue
		_endif

		_local subfeeder_records << query_result[:data]
		write("  Found ", subfeeder_records.size, " subfeeder record(s) - filtering by criteria...")

		# Filter records to match criteria:
		# - source_type = "FEEDER"
		# - source_code = source_feeder_code
		# - transport_status = "TAKEN"
		# - transport_remarks = "ACTIVE" (we want to revert ACTIVE back to BOOKED)
		# - transport_tube_number = destination_tube_number (from feeder)
		# - transport_core_number = destination_core_number (from feeder)
		_local filtered_records << rope.new()
		_for rec _over subfeeder_records.fast_elements()
		_loop
			_local src_code << rec[:source_feeder_code].default("")
			_local t_status << rec[:transport_status].default("")
			_local t_remarks << rec[:transport_remarks].default("")
			_local t_tube << rec[:transport_tube_number].default("")
			_local t_core << rec[:transport_core_number].default("")

			_if src_code = source_feeder_code _andif
			    t_status = "TAKEN" _andif
			    t_remarks = "ACTIVE" _andif
			    t_tube = dest_tube_number _andif
			    t_core = dest_core_number
			_then
				filtered_records.add(rec)
			_endif
		_endloop

		write("  Filtered to ", filtered_records.size, " matching ACTIVE subfeeder(s)")

		# Revert each matching subfeeder back to BOOKED
		_for subfeeder_rec _over filtered_records.fast_elements()
		_loop
			write("  Reverting to BOOKED: Tube ", subfeeder_rec[:transport_tube_number], " Core ", subfeeder_rec[:transport_core_number])

			# Build revert data - keep TAKEN status but change remarks to BOOKED
			_local revert_data << property_list.new_with(
				:work_order_number, work_order,
				:source_type, "FEEDER",
				:source_code, subfeeder_rec[:source_feeder_code].default(""),
				:source_tube_number, source_tube,
				:source_core_number, source_core,
				:transport_tube_number, subfeeder_rec[:transport_tube_number].default(""),
				:transport_core_number, subfeeder_rec[:transport_core_number].default(""),
				:transport_code, subfeeder_rec[:transport_subfeeder_code].default(""),
				:transport_status, "TAKEN",
				:transport_remarks, "BOOKED",
				:destination_type, "CLUSTER",
				:destination_code, subfeeder_rec[:destination_cluster_code].default(""),
				:destination_tube_number, subfeeder_rec[:destination_tube_number].default(""),
				:destination_core_number, subfeeder_rec[:destination_core_number].default("")
			)

			# Add default fields
			revert_data.add_all(_self.get_default_device_connection_fields())

			# Call API to revert to BOOKED
			_local result << .engine.add_device_connection(revert_data)

			_if result[:success] = _true
			_then
				subfeeder_success +<< 1
				write("    >> SUCCESS: Subfeeder reverted to BOOKED")
			_else
				subfeeder_error +<< 1
				_local err_msg << write_string("Subfeeder revert failed (", dest_code, " Tube ",
							       subfeeder_rec[:transport_tube_number], " Core ",
							       subfeeder_rec[:transport_core_number], "): ",
							       result[:error_message].default("Unknown error"))
				errors.add(err_msg)
				write("    >> ERROR: ", result[:error_message].default("Unknown error"))
			_endif
		_endloop
	_endloop

	write("============================================")
	write("AUTO-REVERT TO BOOKED COMPLETED")
	write("============================================")
	write("Subfeeders Reverted: ", subfeeder_success)
	write("Subfeeders Failed: ", subfeeder_error)

_endmethod
$
