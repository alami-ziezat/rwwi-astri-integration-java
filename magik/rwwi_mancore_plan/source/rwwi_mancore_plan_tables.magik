_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.populate_feeder_connection_table( a_table )
	##
	## Populate feeder table with device connection data from API response

	_local row << 1

	# Sort data by Tube Number, then by Core Number
	_local sorted_data << .feeder_table_list.as_sorted_collection(
		_proc(a, b)
			_local tube_a << a[:transport_tube_number].default(0)
			_local tube_b << b[:transport_tube_number].default(0)
			_local core_a << a[:transport_core_number].default(0)
			_local core_b << b[:transport_core_number].default(0)

			_if tube_a <> tube_b
			_then
				_return tube_a < tube_b
			_else
				_return core_a < core_b
			_endif
		_endproc)

	_for a_rec _over sorted_data.fast_elements()
	_loop
		a_table.set_row_data( row, a_rec )

		# Column 1: Source Type - depends on infra_type
		_local source_type
		_if .current_infra_type _is :feeder
		_then
			source_type << "OLT"
		_else
			# subfeeder
			source_type << "FEEDER"
		_endif
		a_table.add_cell(row, 1, {}, {:label, source_type})

		# Column 2: Source Code - depends on infra_type
		_local source_code
		_if .current_infra_type _is :feeder
		_then
			source_code << a_rec[:source_olt_device_code]
		_else
			# subfeeder
			source_code << a_rec[:source_feeder_code]
		_endif
		a_table.add_cell(row, 2, {}, {:label, source_code.default("").write_string})

		# Column 3: Transport Code - depends on infra_type
		_local transport_code
		_if .current_infra_type _is :feeder
		_then
			transport_code << a_rec[:transport_feeder_code]
		_else
			# subfeeder
			transport_code << a_rec[:transport_subfeeder_code]
		_endif
		a_table.add_cell(row, 3, {}, {:label, transport_code.default("").write_string})

		# Column 4: Tube Count - depends on infra_type
		_local tube_count
		_if .current_infra_type _is :feeder
		_then
			tube_count << a_rec[:transport_feeder_tube_count]
		_else
			tube_count << a_rec[:transport_subfeeder_tube_count]
		_endif
		a_table.add_cell(row, 4, {}, {:label, tube_count.default("").write_string, :row_alignment, :centre})

		# Column 5: Core Count - depends on infra_type
		_local core_count
		_if .current_infra_type _is :feeder
		_then
			core_count << a_rec[:transport_feeder_core_count]
		_else
			core_count << a_rec[:transport_subfeeder_core_count]
		_endif
		a_table.add_cell(row, 5, {}, {:label, core_count.default("").write_string, :row_alignment, :centre})

		# Column 6: Tube Number
		_local tube_num << a_rec[:transport_tube_number].default(0)
		a_table.add_cell(row, 6, {}, {:label, tube_num.write_string, :row_alignment, :centre})

		# Column 7: Core Number
		_local core_num << a_rec[:transport_core_number].default(0)
		a_table.add_cell(row, 7, {}, {:label, core_num.write_string, :row_alignment, :centre})

		# Column 8: SW Core - absolute core number in cable
		_local sw_core << (tube_num - 1) * 12 + core_num
		a_table.add_cell(row, 8, {}, {:label, sw_core.write_string, :row_alignment, :centre})

		# Column 9: Status - show TAKEN or IDLE
		_local icon_status
		_if a_rec[:transport_status] = "TAKEN"
		_then
			icon_status << {:traffic_light_red, :ui_resources}
		_else
			icon_status << {:traffic_light_green, :ui_resources}
		_endif
		a_table.add_cell(row, 9, {}, {:image, icon_status })

		# Column 10: Destination Code
		_local dest_code << a_rec[:destination_cluster_code]
		a_table.add_cell(row, 10, {}, {:label, dest_code.default("").write_string })

		# Column 11: Destination Tube Number
		_local dest_tube << a_rec[:destination_tube_number]
		a_table.add_cell(row, 11, {}, {:label, dest_tube.default("").write_string, :row_alignment, :centre })

		# Column 12: Destination Core Number
		_local dest_core << a_rec[:destination_core_number]
		a_table.add_cell(row, 12, {}, {:label, dest_core.default("").write_string, :row_alignment, :centre })

		# Column 13: Destination Name
		_local dest_name << a_rec[:destination_cluster_name]
		a_table.add_cell(row, 13, {}, {:label, dest_name.default("").write_string })

		row +<< 1
	_endloop

	a_table.apply_sorting(_true )

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.feeder_connection_table_selected( selection )
	##
	## Handle feeder table selection
	## Store selection and count all records
	##

	# Store selection for use in booking operations
	.feeder_table_selection << selection

	_local selected_records << selection.get_row_data_from_selection()

	# Count all records in feeder table (regardless of status)
	.feeder_count << selected_records.size

	write("Feeder table: ", .feeder_count, " records selected")

	# Update booking button states
	_self.update_booking_button_states()

_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_dialog.open_editor_feeder()
	##
