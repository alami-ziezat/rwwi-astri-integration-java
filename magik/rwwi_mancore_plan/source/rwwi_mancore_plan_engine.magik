_pragma(classify_level=restricted)
_method rwwi_mancore_plan_engine.new(_optional owner, framework)
	## 
	## 
	_return _clone.init(owner, framework)
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_engine.init( owner , framework )
	## 
	## 

	.grs << framework
	.ev << gis_program_manager.cached_dataset(:gis)
	.owner << owner
	.mapman << .grs.plugin(:map_plugin)
	.ed << .grs.plugin(:editor_manager)

	# Holder for widgets
	#	.items << hash_table.new()
	.current_selection_ur1 << _unset
	.current_selection_ur2 << _unset
	
	# Data holder
	#.table_list << rope.new()
	#.table_list2 << rope.new()
	#.records << rope.new()
	
	# Add dependent dialog to plugin
	_self.add_dependent(.owner)

	_return _self
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_engine.get_device_connections(infra_type, infra_code, limit, offset)
	## Call ASTRI Device Connection API to retrieve device connections
	## based on infrastructure type and code, then parse the response.
	##
	## Parameters:
	##   infra_type  - "feeder" or "subfeeder" (string)
	##   infra_code  - infrastructure code (string)
	##   limit       - maximum number of records to fetch (integer)
	##   offset      - starting offset for pagination (integer)
	##
	## Returns:
	##   property_list with keys:
	##     :success        - boolean (true/false)
	##     :count          - number of records in response
	##     :count_all      - total number of available records
	##     :taken_count    - number of TAKEN connections
	##     :idle_count     - number of idle (not TAKEN) connections
	##     :data           - array of device connection records (for table display)
	##     :infra_type     - infrastructure type used ("feeder" or "subfeeder")
	##     :error_message  - error message if parsing fails
	##
	## Example:
	##   result << _self.get_device_connections("subfeeder", "PLB005917", 100, 0)

	_local result << property_list.new()

	_try _with err
		# Call Java procedure to get JSON response
		_local json_result << astri_get_device_connections(infra_type.write_string, infra_code.write_string, limit, offset)

		# Parse JSON response
		_local json_obj << json_parser.parse(json_result)
		_local success << json_obj[:success]
		_local count << json_obj[:count]
		_local count_all << json_obj[:count_all]

		result[:success] << success
		result[:count] << count
		result[:count_all] << count_all
		result[:infra_type] << infra_type

		_if success _is _true
		_then
			# Count TAKEN and idle connections
			_local data << json_obj[:data]
			_local taken_count << 0
			_local idle_count << 0

			_if data _isnt _unset
			_then
				_for conn _over data.fast_elements()
				_loop
					_local status << conn[:transport_status]
					_if status = "TAKEN"
					_then
						taken_count +<< 1
					_else
						# Not TAKEN = idle (includes AVAILABLE and RESERVED)
						idle_count +<< 1
					_endif
				_endloop
			_endif

			result[:taken_count] << taken_count
			result[:idle_count] << idle_count
			result[:data] << data
			result[:error_message] << _unset
		_else
			# API returned success: false
			result[:taken_count] << 0
			result[:idle_count] << 0
			result[:data] << rope.new()
			result[:error_message] << "API returned success: false"
		_endif

	_when error
		# Handle parsing or API call errors
		result[:success] << _false
		result[:count] << 0
		result[:count_all] << 0
		result[:taken_count] << 0
		result[:idle_count] << 0
		result[:data] << rope.new()
		result[:infra_type] << infra_type
		result[:error_message] << err.report_contents_string
		write("ERROR in get_device_connections(): ", err.report_contents_string)
	_endtry

	_return result
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_engine.get_homepass(infra_type, infra_code)
	## Query demand points (homepass) based on infrastructure type and code
	##
	## Parameters:
	##   infra_type  - "subfeeder" or "feeder" (string)
	##   infra_code  - infrastructure code (string)
	##
	## Returns:
	##   rope - Collection of demand point records

	_local homepass_collection << rope.new()

	_try _with err
		_local dp_col << .ev.collections[:ftth!demand_point]
		_if dp_col _is _unset
		_then
			write("  WARNING: ftth!demand_point collection not found")
			_return homepass_collection
		_endif

		_local pred << _unset
		_if infra_type = "subfeeder"
		_then
			# Query by subfeeder_code
			pred << predicate.eq(:subfeeder_code, infra_code)
		_elif infra_type = "feeder"
		_then
			# Query by feeder_code
			pred << predicate.eq(:feeder_code, infra_code)
		_else
			write("  WARNING: Unknown infra_type: ", infra_type)
			_return homepass_collection
		_endif

		_local homepass << dp_col.select(pred)
		_for hp _over homepass.fast_elements()
		_loop
			homepass_collection.add(hp)
		_endloop

		write("  Found ", homepass_collection.size, " homepass for ", infra_type, ": ", infra_code)

	_when error
		write("ERROR in get_homepass(): ", err.report_contents_string)
	_endtry

	_return homepass_collection
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_engine.add_device_connection(connection_data)
	## Add device connection to ASTRI API
	##
	## Parameters:
	##   connection_data - property_list containing connection fields
	##
	## Returns:
	##   property_list with:
	##     :success - true/false
	##     :data - array of IDs [{:id => internalId}]
	##     :error_message - error message if failed

	_local result << property_list.new()

	_try _with err
		# Build JSON request body from property_list
		_local json_builder << internal_text_output_stream.new()
		json_builder.write("{")

		# Define all 35 fields
		_local fields << {
			:work_order_number,
			:source_device_name,
			:source_device_hardware_type,
			:source_device_port_name,
			:source_device_port_type,
			:source_device_remarks,
			:source_device_capacity,
			:source_device_capacity_measurement,
			:transport_name,
			:transport_hardware_type,
			:transport_capacity,
			:transport_capacity_measurement,
			:destination_device_name,
			:destination_device_hardware_type,
			:destination_device_port_name,
			:destination_device_port_type,
			:destination_device_remarks,
			:destination_device_capacity,
			:destination_device_capacity_measurement,
			:source_type,
			:source_code,
			:source_tube_number,
			:source_core_number,
			:transport_code,
			:transport_tube_number,
			:transport_core_number,
			:transport_status,
			:transport_remarks,
			:closure_code,
			:destination_type,
			:destination_code,
			:destination_tube_number,
			:destination_core_number,
			:verified_by_username,
			:verified_at
		}

		_local first? << _true
		_for field _over fields.fast_elements()
		_loop
			_local value << connection_data[field]
			_if value _isnt _unset _andif value <> ""
			_then
				_if _not first?
				_then
					json_builder.write(",")
				_endif
				# Write field as JSON: "field_name":"value"
				json_builder.write(%", field.write_string.convert_to_non_escape_string(), %")
				json_builder.write(":")
				json_builder.write(%", _self.escape_json_string(value.write_string), %")
				first? << _false
			_endif
		_endloop

		json_builder.write("}")
		_local json_request << json_builder.string

		write("Calling ASTRI add device connection API...")
		write("Request JSON: ", json_request)

		# Call Java proc
		_local json_response << astri_add_device_connection(json_request)
		write("Response JSON: ", json_response)

		# Parse JSON response
		_local parser << json_parser.new()
		_local response << parser.parse(json_response)

		result[:success] << response[:success]
		result[:data] << response[:data]
		result[:error_message] << response[:error]

	_when error
		result[:success] << _false
		result[:data] << rope.new()
		result[:error_message] << err.report_contents_string
		write("ERROR in add_device_connection(): ", err.report_contents_string)
	_endtry

	_return result
_endmethod
$

_pragma(classify_level=restricted)
_method rwwi_mancore_plan_engine.escape_json_string(str)
	## Escape special characters for JSON string
	##
	## Parameters:
	##   str - string to escape
	##
	## Returns:
	##   escaped string

	_if str _is _unset _then _return "" _endif

	_local result << str.copy()

	# Escape backslash first (must be done before other escapes)
	result << result.substitute_string(%\, write_string(%\, %\))

	# Escape quote character
	result << result.substitute_string(%", write_string(%\, %"))

	# Escape newline
	result << result.substitute_string(newline_char, write_string(%\, %n))

	# Escape tab
	result << result.substitute_string(character.tab, write_string(%\, %t))

	_return result
_endmethod
$
