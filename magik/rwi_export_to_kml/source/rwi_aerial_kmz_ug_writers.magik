#% text_encoding = iso8859_1
_package user
$

## AERIAL KMZ - UNDERGROUND FEEDER WRITERS
## Methods on rwi_export_to_aerial_kmz for underground (UG) feeder topology.
## Used when .topology = "UG" or "AE&UG".

_pragma(classify_level=basic, topic={rwi_export})
_private _method rwi_export_to_aerial_kmz.write_feeder_ug_folder(p_stream, p_folder_def, p_area, p_indent)
	## Write a single folder for underground feeder
	## Mirrors write_feeder_folder() but routes to UG content writer
	##
	## Parameters:
	##   p_stream - Output stream
	##   p_folder_def - Folder definition property_list
	##   p_area - Design boundary area
	##   p_indent - Indentation level

	indent << "".fill_up_with(% , p_indent)
	folder_name << p_folder_def[:name]

	p_stream.write(indent, "<Folder>", newline_char)
	p_stream.write(indent, "  <name>", folder_name, "</name>", newline_char)

	_if p_folder_def[:visibility] _isnt _unset
	_then
		vis_str << _if p_folder_def[:visibility] _then "1" _else "0" _endif
		p_stream.write(indent, "  <visibility>", vis_str, "</visibility>", newline_char)
	_endif

	_self.write_feeder_ug_folder_contents(p_stream, folder_name, p_area, indent + "  ")

	p_stream.write(indent, "</Folder>", newline_char)
_endmethod
$

_pragma(classify_level=basic, topic={rwi_export})
_private _method rwi_export_to_aerial_kmz.write_feeder_ug_folder_contents(p_stream, p_folder_name, p_area, p_indent)
	## Write placemarks for underground feeder folders
	## Handles: OLT, JOINT CLOSURE, CABLE, EXISTING HH <spec>, NEW HH <spec>,
	##          SLACK HANGER, BORING MANUAL
	##
	## Parameters:
	##   p_stream - Output stream
	##   p_folder_name - Name of current folder
	##   p_area - Design boundary area
	##   p_indent - Indentation string

	write("Processing UG feeder folder: ", p_folder_name)

	# Handle OLT folder - same collection as aerial (mit_hub)
	_if p_folder_name.index_of_seq("OLT") _isnt _unset
	_then
		write("  Exporting OLTs...")
		all_olts << .gc[:mit_hub].select(
			predicate.interacts(:location, p_area))

		olt_count << 0
		_for olt _over all_olts.fast_elements()
		_loop
			olt_folders << olt.perform(:folders).default("")
			_if olt_folders.index_of_seq(p_folder_name) _isnt _unset
			_then
				.object_writer.write_olt(olt, p_stream, p_indent, p_folder_name)
				olt_count +<< 1
			_endif
		_endloop

		_if olt_count > 0
		_then
			write("  Wrote ", olt_count, " OLTs to folder: ", p_folder_name)
		_endif
	_endif

	# Handle JOINT CLOSURE folder - UG: query sheath_splice directly (no poles)
	_if p_folder_name.index_of_seq("JOINT CLOSURE") _isnt _unset
	_then
		_self.write_ug_closure_for_folder(p_stream, p_area, p_indent)
	_endif

	# Handle CABLE folder - UG cable via underground_route
	_if p_folder_name.index_of_seq("CABLE") _isnt _unset _andif
	    p_folder_name.index_of_seq("BOUNDARY") _is _unset
	_then
		_self.write_ug_cable_for_folder(p_stream, p_area, p_indent)
	_endif

	# Handle EXISTING HH / NEW HH folders - UUB (handhole) objects
	_if p_folder_name.uppercase.index_of_seq("EXISTING HH") _isnt _unset _orif
	    p_folder_name.uppercase.index_of_seq("NEW HH") _isnt _unset
	_then
		_self.write_uub_for_folder(p_stream, p_folder_name, p_area, p_indent)
	_endif

	# Handle SLACK HANGER folder - UG: query figure_eight directly (no poles)
	_if p_folder_name.index_of_seq("SLACK HANGER") _isnt _unset
	_then
		_self.write_ug_figure_eight_for_folder(p_stream, p_area, p_indent)
	_endif

	# Handle BORING MANUAL folder
	_if p_folder_name.uppercase.index_of_seq("BORING MANUAL") _isnt _unset
	_then
		_self.write_boring_manual_for_folder(p_stream, p_area, p_indent)
	_endif

	# Handle SUBDUCT 40/34 folder
	_if p_folder_name.uppercase.index_of_seq("SUBDUCT 40") _isnt _unset
	_then
		_self.write_sub_duct_for_folder(p_stream, p_area, p_indent, "40/34")
	_endif

	# Handle SUBDUCT 32/28 folder
	_if p_folder_name.uppercase.index_of_seq("SUBDUCT 32") _isnt _unset
	_then
		_self.write_sub_duct_for_folder(p_stream, p_area, p_indent, "32/28")
	_endif

	# Handle OPEN TRENCHING folder
	_if p_folder_name.uppercase.index_of_seq("OPEN TRENCHING") _isnt _unset
	_then
		_self.write_open_trenching_for_folder(p_stream, p_area, p_indent)
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={rwi_export})
_private _method rwi_export_to_aerial_kmz.write_open_trenching_for_folder(p_stream, p_area, p_indent, _optional p_line_id, p_fdt_folder)
	## Write open_trenching route chains to folder.
	## Queries open_trenching objects in area, mirrors write_boring_manual_for_folder() pattern.
	##
	## Parameters:
	##   p_stream     - Output stream
	##   p_area       - Design boundary area
	##   p_indent     - Indentation string
	##   p_line_id    - LINE ID letter for filtering (first optional)
	##   p_fdt_folder - FDT folder name for filtering (second optional)

	# Resolve expected LINE type and FDT name
	expected_line_type << _unset
	_if p_line_id _isnt _unset
	_then
		expected_line_type << "LINE " + p_line_id
	_endif

	expected_fdt_name << _unset
	_if p_fdt_folder _isnt _unset
	_then
		expected_fdt_name << p_fdt_folder
		_if p_fdt_folder.index_of_seq("FDT_") _isnt _unset
		_then
			expected_fdt_name << p_fdt_folder.slice(5, p_fdt_folder.size)
		_endif
	_endif

	# Query open_trenching chains in area
	all_ots << .gc[:open_trenching].select(
		predicate.interacts(:route, p_area))

	# Collect valid entries (must have route geometry, LINE and FDT match)
	matching << rope.new()
	_for ot _over all_ots.fast_elements()
	_loop
		route_geom << ot.route
		_if route_geom _is _unset _then _continue _endif

		# Filter by LINE type
		_if expected_line_type _isnt _unset
		_then
			ot_line_type << ot.perform(:line_type).default("")
			_if ot_line_type.uppercase <> expected_line_type.uppercase
			_then
				_continue
			_endif
		_endif

		# Filter by FDT ring name
		_if expected_fdt_name _isnt _unset
		_then
			ot_ring_name << ot.perform(:ring_name).default("")
			_if ot_ring_name <> "" _andif
			    ot_ring_name.uppercase <> expected_fdt_name.uppercase
			_then
				_continue
			_endif
		_endif

		matching.add(ot)
	_endloop

	# Sort by name ascending
	sorted_ots << matching.as_sorted_collection(
		_proc(ot1, ot2)
			name1 << ot1.perform(:name).default("").lowercase
			name2 << ot2.perform(:name).default("").lowercase
			>> name1 < name2
		_endproc)

	ot_count << 0
	_for ot _over sorted_ots.fast_elements()
	_loop
		route_geom << ot.route
		.object_writer.write_open_trenching(ot, route_geom, p_stream, p_indent)
		ot_count +<< 1
	_endloop

	_if ot_count > 0
	_then
		write("  Wrote ", ot_count, " OPEN TRENCHING chains")
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={rwi_export})
_private _method rwi_export_to_aerial_kmz.write_uub_for_folder(p_stream, p_folder_name, p_area, p_indent, _optional p_line_id, p_fdt_folder)
	## Write UUB (handhole/manhole) placemarks to folder.
	## Mirrors pole filtering logic: spec, construction status, LINE type, and FDT ring.
	##   "EXISTING HH <spec>" -> construction_status = "In Service"
	##   "NEW HH <spec>"      -> construction_status != "In Service"
	## LINE filtering: uub.line_type must match "LINE <p_line_id>" (if p_line_id given)
	## FDT filtering:  uub.ring_name must match FDT name from p_fdt_folder (if given)
	##
	## Parameters:
	##   p_stream      - Output stream
	##   p_folder_name - Folder name (e.g., "EXISTING HH 80x80x130")
	##   p_area        - Design boundary area
	##   p_indent      - Indentation string
	##   p_line_id     - LINE ID letter (e.g., "A") for filtering (first optional)
	##   p_fdt_folder  - FDT folder name for filtering (e.g., "FDT001") (second optional)

	# Determine folder intent: existing vs new
	is_existing? << p_folder_name.uppercase.index_of_seq("EXISTING") _isnt _unset

	# Extract spec dimension from folder name
	target_spec << _unset
	_for spec _over {"80x80x130", "40x40x60", "20x20x20"}.fast_elements()
	_loop
		_if p_folder_name.index_of_seq(spec) _isnt _unset
		_then
			target_spec << spec
			_leave
		_endif
	_endloop

	# Resolve expected LINE type string (e.g., "LINE A")
	expected_line_type << _unset
	_if p_line_id _isnt _unset
	_then
		expected_line_type << "LINE " + p_line_id
	_endif

	# Resolve expected FDT name (strip "FDT_" prefix if present)
	expected_fdt_name << _unset
	_if p_fdt_folder _isnt _unset
	_then
		expected_fdt_name << p_fdt_folder
		_if p_fdt_folder.index_of_seq("FDT_") _isnt _unset
		_then
			# Old format: "FDT_FDT001" -> "FDT001"
			expected_fdt_name << p_fdt_folder.slice(5, p_fdt_folder.size)
		_endif
	_endif

	# Query all UUB objects in area
	all_uubs << .gc[:uub].select(
		predicate.interacts(:location, p_area))

	# Collect matching UUBs for sorting
	matching_uubs << rope.new()
	_for uub _over all_uubs.fast_elements()
	_loop
		# Filter by spec dimension (spec_id field contains the dimension string)
		_if target_spec _isnt _unset
		_then
			uub_spec << uub.perform(:spec_id).default("")
			_if uub_spec.lowercase.index_of_seq(target_spec) _is _unset
			_then
				_continue  # Spec does not match
			_endif
		_endif

		# Filter by construction status
		uub_status << uub.perform(:construction_status).default("").lowercase
		uub_is_existing? << uub_status.index_of_seq("in service") _isnt _unset _orif
		                    uub_status.index_of_seq("exist") _isnt _unset

		_if is_existing? <> uub_is_existing?
		_then
			_continue  # Status does not match folder intent
		_endif

		# Filter by LINE type (mirrors pole line_type check)
		_if expected_line_type _isnt _unset
		_then
			uub_line_type << uub.perform(:line_type).default("")
			_if uub_line_type.uppercase <> expected_line_type.uppercase
			_then
				_continue  # LINE does not match
			_endif
		_endif

		# Filter by FDT ring name (mirrors pole ring_name check)
		_if expected_fdt_name _isnt _unset
		_then
			uub_ring_name << uub.perform(:ring_name).default("")
			_if uub_ring_name <> "" _andif
			    uub_ring_name.uppercase <> expected_fdt_name.uppercase
			_then
				_continue  # FDT does not match
			_endif
		_endif

		matching_uubs.add(uub)
	_endloop

	# Sort by label ascending (mirrors pole tag sort)
	sorted_uubs << matching_uubs.as_sorted_collection(
		_proc(u1, u2)
			label1 << u1.perform(:label).default("").lowercase
			label2 << u2.perform(:label).default("").lowercase
			>> label1 < label2
		_endproc)

	uub_count << 0
	_for uub _over sorted_uubs.fast_elements()
	_loop
		.object_writer.write_uub(uub, p_stream, p_indent)
		uub_count +<< 1
		_if is_existing?
		_then
			.total_uub_existing_count +<< 1
		_else
			.total_uub_new_count +<< 1
		_endif
	_endloop

	_if uub_count > 0
	_then
		write("  Wrote ", uub_count, " UUBs to folder: ", p_folder_name)
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={rwi_export})
_private _method rwi_export_to_aerial_kmz.write_boring_manual_for_folder(p_stream, p_area, p_indent, _optional p_line_id, p_fdt_folder)
	## Write boring_manual route chains to folder.
	## Filters by LINE type and FDT ring name (mirrors pole filtering logic).
	##
	## Parameters:
	##   p_stream     - Output stream
	##   p_area       - Design boundary area
	##   p_indent     - Indentation string
	##   p_line_id    - LINE ID letter (e.g., "A") for filtering (first optional)
	##   p_fdt_folder - FDT folder name for filtering (second optional)

	# Resolve expected LINE type and FDT name
	expected_line_type << _unset
	_if p_line_id _isnt _unset
	_then
		expected_line_type << "LINE " + p_line_id
	_endif

	expected_fdt_name << _unset
	_if p_fdt_folder _isnt _unset
	_then
		expected_fdt_name << p_fdt_folder
		_if p_fdt_folder.index_of_seq("FDT_") _isnt _unset
		_then
			expected_fdt_name << p_fdt_folder.slice(5, p_fdt_folder.size)
		_endif
	_endif

	# Query boring_manual chains in area (uses :route geometry like sling_wire)
	all_boring_manuals << .gc[:boring_manual].select(
		predicate.interacts(:route, p_area))

	# Collect valid entries (must have route geometry, LINE and FDT match)
	matching << rope.new()
	_for bm _over all_boring_manuals.fast_elements()
	_loop
		route_geom << bm.route
		_if route_geom _is _unset _then _continue _endif

		# Filter by LINE type
		_if expected_line_type _isnt _unset
		_then
			bm_line_type << bm.perform(:line_type).default("")
			_if bm_line_type.uppercase <> expected_line_type.uppercase
			_then
				_continue
			_endif
		_endif

		# Filter by FDT ring name
		_if expected_fdt_name _isnt _unset
		_then
			bm_ring_name << bm.perform(:ring_name).default("")
			_if bm_ring_name <> "" _andif
			    bm_ring_name.uppercase <> expected_fdt_name.uppercase
			_then
				_continue
			_endif
		_endif

		matching.add(bm)
	_endloop

	# Sort by name ascending
	sorted_bms << matching.as_sorted_collection(
		_proc(bm1, bm2)
			name1 << bm1.perform(:name).default("").lowercase
			name2 << bm2.perform(:name).default("").lowercase
			>> name1 < name2
		_endproc)

	bm_count << 0
	_for bm _over sorted_bms.fast_elements()
	_loop
		route_geom << bm.route
		.object_writer.write_boring_manual(bm, route_geom, p_stream, p_indent)
		bm_count +<< 1
		.total_boring_manual_count +<< 1
	_endloop

	_if bm_count > 0
	_then
		write("  Wrote ", bm_count, " BORING MANUAL chains")
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={rwi_export})
_private _method rwi_export_to_aerial_kmz.write_sub_duct_for_folder(p_stream, p_area, p_indent, _optional p_spec_filter)
	## Write mit_conduit (sub duct) route chains to folder.
	## Conduit path is continuous across UUBs (unlike cable which breaks at each UUB).
	## Pattern:
	##   1. Query underground_routes in area
	##   2. route.conduits to get conduits inside each underground_route
	##   3. Dedup by conduit id (conduit spans multiple routes, must not repeat)
	##   4. Get geometry via route_coordinates (returns coords_rope)
	##
	## Parameters:
	##   p_stream      - Output stream
	##   p_area        - Design boundary area
	##   p_indent      - Indentation string
	##   p_spec_filter - Optional spec filter: "40/34" or "32/28" (first optional)

	# Step 1: Query underground_routes in area
	all_ug_routes << .gc[:underground_route].select(
		predicate.interacts(:route, p_area))

	# Step 2: Collect unique conduits by id (conduit is continuous across UUBs,
	# so the same conduit id appears in multiple route sections)
	seen_ids << set.new()
	unique_conduits << rope.new()
	_for route _over all_ug_routes.fast_elements()
	_loop
		route_conduits << route.conduits
		_if route_conduits _is _unset _then _continue _endif
		_for sd _over route_conduits.fast_elements()
		_loop
			_if seen_ids.includes?(sd.id) _then _continue _endif
			seen_ids.add(sd.id)
			unique_conduits.add(sd)
		_endloop
	_endloop

	# Step 3: Filter by spec and collect geometry via route_coordinates
	matching << rope.new()
	matching_coords << property_list.new()
	_for sd _over unique_conduits.fast_elements()
	_loop
		# Filter by spec if requested
		_if p_spec_filter _isnt _unset
		_then
			sd_spec << sd.perform(:spec_id).default("")
			_if sd_spec.index_of_seq(p_spec_filter) _is _unset
			_then
				_continue
			_endif
		_endif

		# Get geometry via route_coordinates - returns coords_rope
		sd_coords << sd.route_coordinates()
		_if sd_coords _is _unset _orif sd_coords.empty? _then _continue _endif

		matching.add(sd)
		matching_coords[sd.id] << sd_coords
	_endloop

	# Sort by name ascending
	sorted_sds << matching.as_sorted_collection(
		_proc(sd1, sd2)
			name1 << sd1.perform(:name).default("").lowercase
			name2 << sd2.perform(:name).default("").lowercase
			>> name1 < name2
		_endproc)

	sd_count << 0
	_for sd _over sorted_sds.fast_elements()
	_loop
		sd_coords << matching_coords[sd.id]
		.object_writer.write_sub_duct(sd, sd_coords, p_stream, p_indent)
		sd_count +<< 1
	_endloop

	_if sd_count > 0
	_then
		_local spec_msg << _if p_spec_filter _isnt _unset
		                   _then >> write_string(" (", p_spec_filter, ")")
		                   _else >> ""
		                   _endif
		write("  Wrote ", sd_count, " SUB DUCT chains", spec_msg)
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={rwi_export})
_private _method rwi_export_to_aerial_kmz.write_ug_cable_for_folder(p_stream, p_area, p_indent, _optional p_line_id, p_fdt_folder)
	## Write underground cable chains to folder.
	## Delegates to write_cable_for_folder() with :underground_route collection.
	## Same logic as aerial: dedup, LINE/FDT filtering, sector merge, cable length.
	##
	## Parameters:
	##   p_stream   - Output stream
	##   p_area     - Design boundary area
	##   p_indent   - Indentation string
	##   p_line_id  - LINE ID (A/B/C/D) for filtering (first optional)
	##   p_fdt_folder - FDT folder name for filtering (second optional)

	_local cable_count << _self.write_cable_for_folder(
		p_stream, p_area, p_indent, p_line_id, p_fdt_folder, :underground_route)

	_if cable_count > 0
	_then
		.total_ug_cable_count +<< cable_count
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={rwi_export})
_private _method rwi_export_to_aerial_kmz.write_ug_closure_for_folder(p_stream, p_area, p_indent, _optional p_line_id, p_fdt_folder)
	## Write JOINT CLOSURE placemarks for UG topology.
	## Directly queries sheath_splice collection by location - bypasses poles.
	## Filters by LINE type and FDT ring name (mirrors pole filtering logic).
	##
	## Parameters:
	##   p_stream     - Output stream
	##   p_area       - Design boundary area
	##   p_indent     - Indentation string
	##   p_line_id    - LINE ID letter (e.g., "A") for filtering (first optional)
	##   p_fdt_folder - FDT folder name for filtering (second optional)

	# Resolve expected LINE type and FDT name
	expected_line_type << _unset
	_if p_line_id _isnt _unset
	_then
		expected_line_type << "LINE " + p_line_id
	_endif

	expected_fdt_name << _unset
	_if p_fdt_folder _isnt _unset
	_then
		expected_fdt_name << p_fdt_folder
		_if p_fdt_folder.index_of_seq("FDT_") _isnt _unset
		_then
			expected_fdt_name << p_fdt_folder.slice(5, p_fdt_folder.size)
		_endif
	_endif

	# Query sheath_splice directly in area (UG closures have their own location)
	all_splices << .gc[:sheath_splice].select(
		predicate.interacts(:location, p_area))

	closure_count << 0
	_for splice _over all_splices.fast_elements()
	_loop
		splice_type << splice.sheath_splice_object_type
		_if splice_type _is _unset _then _continue _endif

		# Only export CLOSURE type (not FAT/FDT)
		_if splice_type.index_of_seq("Closure") _is _unset _andif
		    splice_type.index_of_seq("Joint") _is _unset
		_then
			_continue
		_endif

		# Use splice's own location geometry
		splice_geom << splice.location
		_if splice_geom _is _unset _then _continue _endif

		# Filter by LINE type
		_if expected_line_type _isnt _unset
		_then
			splice_line_type << splice.perform(:line_type).default("")
			_if splice_line_type.uppercase <> expected_line_type.uppercase
			_then
				_continue
			_endif
		_endif

		# Filter by FDT ring name
		_if expected_fdt_name _isnt _unset
		_then
			splice_ring_name << splice.perform(:ring_name).default("")
			_if splice_ring_name <> "" _andif
			    splice_ring_name.uppercase <> expected_fdt_name.uppercase
			_then
				_continue
			_endif
		_endif

		.object_writer.write_sheath_splice(splice, splice_geom, p_stream, p_indent)
		closure_count +<< 1
		.total_closure_count +<< 1
	_endloop

	_if closure_count > 0
	_then
		write("  Wrote ", closure_count, " JOINT CLOSURE(s)")
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={rwi_export})
_private _method rwi_export_to_aerial_kmz.write_ug_sheath_splices_for_folder(p_stream, p_area, p_indent, p_equipment_type, _optional p_line_id, p_fdt_folder)
	## Write sheath splice equipment (FAT/FDT/CLOSURE) for UG topology.
	## Mirrors write_sheath_splices_for_folder() but navigates through UUBs
	## instead of poles (UG designs have no poles).
	##
	## Parameters:
	##   p_stream        - Output stream
	##   p_area          - Design boundary area
	##   p_indent        - Indentation string
	##   p_equipment_type - "FAT", "FDT", or "CLOSURE"
	##   p_line_id       - LINE ID (A/B/C/D) for filtering (first optional)
	##   p_fdt_folder    - FDT folder name for filtering (second optional)

	# Resolve expected LINE type and FDT name
	expected_line_type << _unset
	_if p_line_id _isnt _unset
	_then
		expected_line_type << "LINE " + p_line_id
	_endif

	expected_fdt_name << _unset
	_if p_fdt_folder _isnt _unset
	_then
		expected_fdt_name << p_fdt_folder
		_if p_fdt_folder.index_of_seq("FDT_") _isnt _unset
		_then
			expected_fdt_name << p_fdt_folder.slice(5, p_fdt_folder.size)
		_endif
	_endif

	# Query UUBs in area (replaces poles)
	all_uubs << .gc[:uub].select(
		predicate.interacts(:location, p_area))

	uubs_checked << 0
	splices_found << 0
	matching_splices << rope.new()

	_for uub _over all_uubs.fast_elements()
	_loop
		uubs_checked +<< 1
		uub_geom << uub.location
		_if uub_geom _is _unset _then _continue _endif

		# Get all equipment on this UUB (same API as pole)
		uub_equipment << uub.get_equipment()
		_if uub_equipment _is _unset _orif uub_equipment.empty? _then _continue _endif

		# Get sheath_splice from equipment
		uub_splices << uub_equipment.select(
			predicate.navigate({:source_collection},
				predicate.eq(:name, :sheath_splice)))

		_if uub_splices.empty? _then _continue _endif

		splices_found +<< uub_splices.size

		_for splice _over uub_splices.fast_elements()
		_loop
			splice_type << splice.sheath_splice_object_type
			_if splice_type _is _unset _then _continue _endif

			# Filter by equipment type
			matches_type? << _false
			_if p_equipment_type = "FAT" _andif
			    splice_type.index_of_seq("FAT") _isnt _unset
			_then
				matches_type? << _true
			_elif p_equipment_type = "FDT" _andif
			      splice_type.index_of_seq("FDT") _isnt _unset
			_then
				matches_type? << _true
			_elif p_equipment_type = "CLOSURE" _andif
			      (splice_type.index_of_seq("Closure") _isnt _unset _orif
			       splice_type.index_of_seq("Joint") _isnt _unset)
			_then
				matches_type? << _true
			_endif

			_if _not matches_type? _then _continue _endif

			# Filter by LINE type (check UUB's line_type, mirrors pole check)
			_if expected_line_type _isnt _unset
			_then
				uub_line_type << uub.perform(:line_type).default("")
				_if uub_line_type.uppercase <> expected_line_type.uppercase
				_then
					_continue
				_endif
			_endif

			# Filter by FDT ring name (check splice's ring_name)
			_if expected_fdt_name _isnt _unset
			_then
				splice_ring_name << splice.perform(:ring_name).default("")
				_if splice_ring_name <> "" _andif
				    splice_ring_name.uppercase <> expected_fdt_name.uppercase
				_then
					_continue
				_endif
			_endif

			matching_splices.add(property_list.new_with(
				:splice, splice,
				:uub_geom, uub_geom,
				:equipment_type, p_equipment_type))
		_endloop
	_endloop

	# Sort splices by name ascending
	sorted_splices << matching_splices.as_sorted_collection(
		_proc(s1, s2)
			name1 << s1[:splice].perform(:name).default("").lowercase
			name2 << s2[:splice].perform(:name).default("").lowercase
			>> name1 < name2
		_endproc)

	# Write sorted splices
	equipment_count << 0
	_for splice_data _over sorted_splices.fast_elements()
	_loop
		splice << splice_data[:splice]
		uub_geom << splice_data[:uub_geom]
		eq_type << splice_data[:equipment_type]

		.object_writer.write_sheath_splice(splice, uub_geom, p_stream, p_indent)
		equipment_count +<< 1

		_if eq_type = "FAT"
		_then
			.total_fat_count +<< 1
		_elif eq_type = "FDT"
		_then
			.total_fdt_count +<< 1
		_elif eq_type = "CLOSURE"
		_then
			.total_closure_count +<< 1
		_endif
	_endloop

	write("  ", p_equipment_type, " summary: Checked ", uubs_checked, " UUBs, found ", splices_found, " total splices, wrote ", equipment_count, " matching ", p_equipment_type)
_endmethod
$

_pragma(classify_level=basic, topic={rwi_export})
_private _method rwi_export_to_aerial_kmz.write_ug_fdt_equipment(p_stream, p_area, p_indent, _optional p_fdt_folder)
	## Write FDT equipment for UG topology.
	## Mirrors write_fdt_equipment() but navigates through UUBs instead of poles.
	## Also includes standalone FDTs (mit_terminal_enclosure) same as aerial.
	##
	## Parameters:
	##   p_stream     - Output stream
	##   p_area       - Design boundary area
	##   p_indent     - Indentation string
	##   p_fdt_folder - FDT folder name for filtering (optional)

	fdt_count << 0
	fdt_list << rope.new()

	# 1. Collect FDTs on UUBs (sheath_splice with type FDT)
	all_uubs << .gc[:uub].select(
		predicate.interacts(:location, p_area))

	_for uub _over all_uubs.fast_elements()
	_loop
		uub_geom << uub.location
		_if uub_geom _is _unset _then _continue _endif

		uub_equipment << uub.get_equipment()
		_if uub_equipment _is _unset _orif uub_equipment.empty? _then _continue _endif

		uub_splices << uub_equipment.select(
			predicate.navigate({:source_collection},
				predicate.eq(:name, :sheath_splice)))

		_for splice _over uub_splices.fast_elements()
		_loop
			splice_type << splice.sheath_splice_object_type
			_if splice_type _is _unset _then _continue _endif

			_if splice_type.uppercase = "FDT"
			_then
				# Filter by FDT folder if specified
				_if p_fdt_folder _isnt _unset
				_then
					fdt_name << splice.perform(:name).default("")
					_if p_fdt_folder.index_of_seq("FDT_") _isnt _unset
					_then
						expected_fdt_name << p_fdt_folder.slice(5, p_fdt_folder.size)
						_if fdt_name.uppercase <> expected_fdt_name.uppercase
						_then
							_continue
						_endif
					_endif
				_endif

				fdt_list.add(property_list.new_with(
					:type, :splice,
					:object, splice,
					:geometry, uub_geom,
					:name, splice.perform(:name).default("")))
			_endif
		_endloop
	_endloop

	# 2. Standalone FDTs (mit_terminal_enclosure) - same as aerial
	terminal_enclosures << .gc[:mit_terminal_enclosure].select(
		predicate.within(:location, p_area))

	_for terminal _over terminal_enclosures.fast_elements()
	_loop
		terminal_geom << terminal.location
		_if terminal_geom _is _unset _then _continue _endif

		_if p_fdt_folder _isnt _unset
		_then
			terminal_name << terminal.perform(:name).default("")
			_if p_fdt_folder.index_of_seq("FDT_") _isnt _unset
			_then
				expected_fdt_name << p_fdt_folder.slice(5, p_fdt_folder.size)
				_if terminal_name.uppercase <> expected_fdt_name.uppercase
				_then
					_continue
				_endif
			_endif
		_endif

		fdt_list.add(property_list.new_with(
			:type, :terminal,
			:object, terminal,
			:geometry, terminal_geom,
			:name, terminal.perform(:name).default("")))
	_endloop

	# Sort FDTs by name ascending
	sorted_fdts << fdt_list.as_sorted_collection(
		_proc(fdt1, fdt2)
			name1 << fdt1[:name].default("").lowercase
			name2 << fdt2[:name].default("").lowercase
			>> name1 < name2
		_endproc)

	# Write sorted FDTs
	_for fdt_data _over sorted_fdts.fast_elements()
	_loop
		fdt_type << fdt_data[:type]
		fdt_object << fdt_data[:object]
		fdt_geom << fdt_data[:geometry]

		_if fdt_type = :splice
		_then
			.object_writer.write_sheath_splice(fdt_object, fdt_geom, p_stream, p_indent)
		_elif fdt_type = :terminal
		_then
			.object_writer.write_terminal_enclosure(fdt_object, fdt_geom, p_stream, p_indent)
		_endif

		fdt_count +<< 1
		.total_fdt_count +<< 1
	_endloop

	_if fdt_count > 0
	_then
		write("  Wrote ", fdt_count, " FDT equipment (UG)")
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={rwi_export})
_private _method rwi_export_to_aerial_kmz.write_ug_figure_eight_for_folder(p_stream, p_area, p_indent, _optional p_line_id, p_fdt_folder)
	## Write SLACK HANGER (figure_eight) placemarks for UG topology.
	## Navigates through UUBs (like aerial navigates through poles) to find
	## figure_eight equipment, using the UUB location as placemark geometry.
	## Filters by LINE type and FDT ring name.
	##
	## Parameters:
	##   p_stream     - Output stream
	##   p_area       - Design boundary area
	##   p_indent     - Indentation string
	##   p_line_id    - LINE ID letter (e.g., "A") for filtering (first optional)
	##   p_fdt_folder - FDT folder name for filtering (second optional)

	# Resolve expected LINE type and FDT name
	expected_line_type << _unset
	_if p_line_id _isnt _unset
	_then
		expected_line_type << "LINE " + p_line_id
	_endif

	expected_fdt_name << _unset
	_if p_fdt_folder _isnt _unset
	_then
		expected_fdt_name << p_fdt_folder
		_if p_fdt_folder.index_of_seq("FDT_") _isnt _unset
		_then
			expected_fdt_name << p_fdt_folder.slice(5, p_fdt_folder.size)
		_endif
	_endif

	# Query UUBs in area - figure_eight is equipment on a UUB, not standalone
	all_uubs << .gc[:uub].select(
		predicate.interacts(:location, p_area))

	# Collect matching figure_eight equipment with their UUB geometry
	matching_figure_eights << rope.new()

	_for uub _over all_uubs.fast_elements()
	_loop
		uub_geom << uub.location
		_if uub_geom _is _unset _then _continue _endif

		# Get all equipment on this UUB
		uub_equipment << _unset
		_try
			uub_equipment << uub.get_equipment()
		_when error
			_continue
		_endtry
		_if uub_equipment _is _unset _orif uub_equipment.empty? _then _continue _endif

		# Find figure_eight items in UUB equipment
		uub_fig8s << uub_equipment.select(
			predicate.navigate({:source_collection},
				predicate.eq(:name, :figure_eight)))

		_if uub_fig8s.empty? _then _continue _endif

		_for fig8 _over uub_fig8s.fast_elements()
		_loop
			# Filter by LINE type (check figure_eight first, fall back to UUB)
			_if expected_line_type _isnt _unset
			_then
				fig8_line_type << fig8.perform(:line_type).default("")
				_if fig8_line_type = ""
				_then
					fig8_line_type << uub.perform(:line_type).default("")
				_endif
				_if fig8_line_type.uppercase <> expected_line_type.uppercase
				_then
					_continue
				_endif
			_endif

			# Filter by FDT ring name (check figure_eight first, fall back to UUB)
			_if expected_fdt_name _isnt _unset
			_then
				fig8_ring_name << fig8.perform(:ring_name).default("")
				_if fig8_ring_name = ""
				_then
					fig8_ring_name << uub.perform(:ring_name).default("")
				_endif
				_if fig8_ring_name <> "" _andif
				    fig8_ring_name.uppercase <> expected_fdt_name.uppercase
				_then
					_continue
				_endif
			_endif

			# Add to matching collection with UUB geometry
			matching_figure_eights.add(property_list.new_with(
				:fig8, fig8,
				:uub_geom, uub_geom))
		_endloop
	_endloop

	# Sort by name ascending
	sorted_figure_eights << matching_figure_eights.as_sorted_collection(
		_proc(f1, f2)
			name1 << f1[:fig8].perform(:name).default("").lowercase
			name2 << f2[:fig8].perform(:name).default("").lowercase
			>> name1 < name2
		_endproc)

	fig8_count << 0
	_for fig8_data _over sorted_figure_eights.fast_elements()
	_loop
		fig8     << fig8_data[:fig8]
		uub_geom << fig8_data[:uub_geom]
		.object_writer.write_figure_eight(fig8, uub_geom, p_stream, p_indent)
		fig8_count +<< 1
		.total_slack_hanger_count +<< 1
	_endloop

	_if fig8_count > 0
	_then
		write("  Wrote ", fig8_count, " SLACK HANGER (figure_eight) object(s)")
	_endif
_endmethod
$

_pragma(classify_level=basic, topic={rwi_export})
_private _method rwi_export_to_aerial_kmz.write_subfeeder_ug_folder(p_stream, p_folder_def, p_area, p_indent)
	## Write a single folder for underground subfeeder.
	## Mirrors write_subfeeder_folder() but routes to UG content writer.
	##
	## Parameters:
	##   p_stream     - Output stream
	##   p_folder_def - Folder definition property_list
	##   p_area       - Design boundary area
	##   p_indent     - Indentation level

	indent << "".fill_up_with(% , p_indent)
	folder_name << p_folder_def[:name]

	p_stream.write(indent, "<Folder>", newline_char)
	p_stream.write(indent, "  <name>", folder_name, "</name>", newline_char)

	_if p_folder_def[:visibility] _isnt _unset
	_then
		vis_str << _if p_folder_def[:visibility] _then "1" _else "0" _endif
		p_stream.write(indent, "  <visibility>", vis_str, "</visibility>", newline_char)
	_endif

	_self.write_subfeeder_ug_folder_contents(p_stream, folder_name, p_area, indent + "  ")

	p_stream.write(indent, "</Folder>", newline_char)
_endmethod
$

_pragma(classify_level=basic, topic={rwi_export})
_private _method rwi_export_to_aerial_kmz.write_subfeeder_ug_folder_contents(p_stream, p_folder_name, p_area, p_indent)
	## Write placemarks for underground subfeeder folders.
	## Mirrors write_subfeeder_folder_contents() with pole -> UUB substitution
	## and all UG route objects (cable, boring manual, slack hanger).
	##
	## Handles:
	##   JOINT CLOSURE  -> write_ug_closure_for_folder (sheath_splice direct, no poles)
	##   CABLE          -> write_ug_cable_for_folder   (underground_route)
	##   EXISTING HH    -> write_uub_for_folder        (replaces EXISTING POLE)
	##   NEW HH         -> write_uub_for_folder        (replaces NEW POLE)
	##   SLACK HANGER   -> write_ug_figure_eight_for_folder (figure_eight direct, no poles)
	##   BORING MANUAL  -> write_boring_manual_for_folder
	##   FDT            -> write_sheath_splices_for_folder  (if present)
	##
	## Parameters:
	##   p_stream      - Output stream
	##   p_folder_name - Name of current folder
	##   p_area        - Design boundary area
	##   p_indent      - Indentation string

	write("Processing UG subfeeder folder: ", p_folder_name)

	# JOINT CLOSURE - sheath_splice direct (no poles in UG)
	_if p_folder_name.index_of_seq("JOINT CLOSURE") _isnt _unset
	_then
		_self.write_ug_closure_for_folder(p_stream, p_area, p_indent)
	_endif

	# CABLE (not BOUNDARY) - underground_route
	_if p_folder_name.index_of_seq("CABLE") _isnt _unset _andif
	    p_folder_name.index_of_seq("BOUNDARY") _is _unset
	_then
		_self.write_ug_cable_for_folder(p_stream, p_area, p_indent)
	_endif

	# EXISTING HH / NEW HH - UUB (replaces EXISTING POLE / NEW POLE)
	_if p_folder_name.uppercase.index_of_seq("EXISTING HH") _isnt _unset _orif
	    p_folder_name.uppercase.index_of_seq("NEW HH") _isnt _unset
	_then
		_self.write_uub_for_folder(p_stream, p_folder_name, p_area, p_indent)
	_endif

	# SLACK HANGER - figure_eight direct (no poles in UG)
	_if p_folder_name.index_of_seq("SLACK HANGER") _isnt _unset
	_then
		_self.write_ug_figure_eight_for_folder(p_stream, p_area, p_indent)
	_endif

	# BORING MANUAL - boring_manual route chains
	_if p_folder_name.uppercase.index_of_seq("BORING MANUAL") _isnt _unset
	_then
		_self.write_boring_manual_for_folder(p_stream, p_area, p_indent)
	_endif

	# SUBDUCT 40/34 - mit_conduit HDPE 40/34
	_if p_folder_name.uppercase.index_of_seq("SUBDUCT 40") _isnt _unset
	_then
		_self.write_sub_duct_for_folder(p_stream, p_area, p_indent, "40/34")
	_endif

	# SUBDUCT 32/28 - mit_conduit HDPE 32/28
	_if p_folder_name.uppercase.index_of_seq("SUBDUCT 32") _isnt _unset
	_then
		_self.write_sub_duct_for_folder(p_stream, p_area, p_indent, "32/28")
	_endif

	# FDT - sheath_splice equipment via UUBs (not poles)
	_if p_folder_name.index_of_seq("FDT") _isnt _unset
	_then
		_self.write_ug_sheath_splices_for_folder(p_stream, p_area, p_indent, "FDT", _unset)
	_endif
_endmethod
$
