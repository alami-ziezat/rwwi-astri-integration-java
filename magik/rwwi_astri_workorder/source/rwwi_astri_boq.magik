#feeder
_global get_count_cable_feeder <<
_proc()

	table_list << rope.new()
	
	s << swg_dsn_admin_engine.get_current_job()
	
	_if s _is _unset
	_then
			write("No Design Selected")
			_leave 
	_endif
	
	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	pj << s.inf_project.write_string
	st << s.status.write_string	
	change_set << mit_scheme_record_change_set.new(s)
	
	_for i _over change_set.fast_elements()
	_loop
	
		
		name <<   i.current_record.source_collection.name
		_if name _is :sheath_with_loc _then
			#_if i.current_record.ring_name=fdt
			#_then
				table_list.add(i.current_record)
			#_endif
			
		_endif
		
	_endloop

	p1 << 0 #.0
	p2 << 0 #.0
	p3 << 0 #.0
	p4 << 0 #.0
	p5 << 0 #.0
	p6 << 0 #.0
	p7 << 0 #.0
	p8 << 0
	p9 << 0
	p10 << 0
	p11 << 0
	p12 << 0
	
	

	_for p  _over table_list.fast_elements()
	_loop
		_if p.construction_status="In Service"
		_then
			_continue
		_endif
		
		_if p.spec_id="SM G652D-ADSS 24C" 
		_then
			y << p.route_sectors()
			
			yy << y.line_length
			y_sec << yy/100
			p1 << 	p1 + y_sec #p.calculated_sheath_length.value_in(:m).as_number()
		
		_elif p.spec_id="SM G652D-ADSS 36C"
		_then
			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p2 << 	p5 + y_sec
			#p2 << 	p2 + p.calculated_sheath_length.value_in(:m).as_number()

		
			
		_elif p.spec_id="SM G652D-ADSS 48C"
		_then
			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p3 << 	p9 + y_sec
		
		_elif p.spec_id="SM G652D-ADSS 72C" 
		_then

			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p4 << 	p4 + y_sec
			#p4 << 	p4 + p.calculated_sheath_length.value_in(:m).as_number()
		_elif p.spec_id="SM G652D-ADSS 96C" 
		_then
			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p5 << 	p5 + y_sec
			#p5 << 	p5 + p.calculated_sheath_length.value_in(:m).as_number()
		_elif p.spec_id="SM G652D-ADSS 144C" 
		_then
			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p6 << 	p6 + y_sec
			#p6 << 	p6 + p.calculated_sheath_length.value_in(:m).as_number()
		_elif p.spec_id="SM G652D-ADSS 288C" 
		_then

			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p7 << 	p7 + y_sec
			#p7 << 	p7 + p.calculated_sheath_length.value_in(:m).as_number()

		_endif

	_endloop

	pp_seq_r << rope.new()
	
	a_values << property_list.new_with(
			    :id,"clr1",
			    :jml,p1)
	
	pp_seq_r.add(a_values)
	
	a_values << property_list.new_with(
			    :id,"clr2",
			    :jml,p2)
	
	pp_seq_r.add(a_values)
	a_values << property_list.new_with(
			    :id,"clr3",
			    :jml,p3)
	
	pp_seq_r.add(a_values)
	
	a_values << property_list.new_with(
			    :id,"clr4",
			    :jml,p4)
	
	pp_seq_r.add(a_values)
	a_values << property_list.new_with(
			    :id,"clr5",
			    :jml,p5)
	
	pp_seq_r.add(a_values)
	
	a_values << property_list.new_with(
			    :id,"clr6",
			    :jml,p6)
	
	pp_seq_r.add(a_values)
	a_values << property_list.new_with(
			    :id,"clr7",
			    :jml,p7)
	
	pp_seq_r.add(a_values)
#	a_values << property_list.new_with(
#			    :id,"clr13",
#			    :jml,p13)
#	
#	pp_seq_r.add(a_values)


>> pp_seq_r	

	

		
_endproc
$



_global get_count_cable <<
_proc()

	table_list << rope.new()
	
	s << swg_dsn_admin_engine.get_current_job()
	
	_if s _is _unset
	_then
			write("No Design Selected")
			_leave 
	_endif
	
	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	pj << s.inf_project.write_string
	st << s.status.write_string	
	change_set << mit_scheme_record_change_set.new(s)
	
	_for i _over change_set.fast_elements()
	_loop
	
		
		name <<   i.current_record.source_collection.name
		_if name _is :sheath_with_loc _then
			table_list.add(i.current_record)
		_endif
		
	_endloop

	p1 << 0.0
	p2 << 0.0
	p3 << 0.0
	p4 << 0.0
	p5 << 0.0
	p6 << 0.0
	p7 << 0.0
	

	_for p  _over table_list.fast_elements()
	_loop
		_if p.construction_status="In Service"
		_then
			_continue
		_endif
		_if p.spec_id="SM G652D-ADSS 24C" 
		_then
			p1 << 	p1 + p.calculated_sheath_length.value_in(:m).as_number()
		_elif p.spec_id="SM G652D-ADSS 36C" 
		_then
			p2 << 	p2 + p.calculated_sheath_length.value_in(:m).as_number()
		_elif p.spec_id="SM G652D-ADSS 48C" 
		_then
			p3 << 	p3 + p.calculated_sheath_length.value_in(:m).as_number()
		_elif p.spec_id="SM G652D-ADSS 72C" 
		_then
			p4 << 	p4 + p.calculated_sheath_length.value_in(:m).as_number()
		_elif p.spec_id="SM G652D-ADSS 96C" 
		_then
			p5 << 	p5 + p.calculated_sheath_length.value_in(:m).as_number()
		_elif p.spec_id="SM G652D-ADSS 144C" 
		_then
			p6 << 	p6 + p.calculated_sheath_length.value_in(:m).as_number()
		_elif p.spec_id="SM G652D-ADSS 288C" 
		_then
			p7 << 	p7 + p.calculated_sheath_length.value_in(:m).as_number()

		_endif

	_endloop

	
>> p1,p2,p3,p4,p5,p6,p7
		
_endproc
$


_global get_count_conduit <<
_proc()

	table_list << rope.new()
	
	s << swg_dsn_admin_engine.get_current_job()
	
	_if s _is _unset
	_then
			write("No Design Selected")
			_leave 
	_endif
	
	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	pj << s.inf_project.write_string
	st << s.status.write_string	
