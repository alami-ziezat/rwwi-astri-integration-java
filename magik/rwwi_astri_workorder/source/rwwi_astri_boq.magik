_global get_count_sling_wire_line <<
_proc(fdt)

	v_gis << gis_program_manager.databases[:gis]
	s_col << v_gis.collections[:sling_wire]
	table_list << rope.new()
	_dynamic !current_world! << v_gis.world
	s << swg_dsn_admin_engine.get_current_job()
	
	_if s _is _unset
	_then
			write("No Design Selected")
			_leave 
	_endif
	
	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	pj << s.inf_project.write_string
	st << s.status.write_string	
	change_set << mit_scheme_record_change_set.new(s)
	_local area << s.project.project_areas.an_element().area
	r << rope.new()
	
#	_for i _over change_set.fast_elements()
#	_loop
#		
#		name <<   i.current_record.source_collection.name
#		_if name _is :pole _orif name _is :ftth!demand_point  _orif name _is :sheath_splice _then
#			r.add(i.current_record.location.coord)
#		_endif
#		
#	_endloop
	
	a_region << area #pseudo_area.new_convex_hull(r)
	#a_region.world << v_gis.world

	pred_m << predicate.within(:route , {a_region})
	table_list << s_col.select(pred_m)


	a_ff << float_format.new_with_properties(
			      :float_format,:fixed,
			      :float_decimal_places,3)

	
	row << 0
	l_total << 0 #0.0
	t_pjg << 0 #0.0

	_for s _over table_list.fast_elements()
	_loop
		_if s.construction_status="In Service" _orif s.ring_name <> fdt
		_then
			_continue
		_endif
		row +<< 1		
		#write(row)
	
		pjg << s.route.line_length/100     #.value_in(:m).as_number()
		a_pjg << a_ff.format(pjg).write_string+"  m"

		l_total << l_total + s.route.line_length

	_endloop


	t_pjg << l_total/100 #.value_in(:m).as_number()#.write_string
	t_a_pjg << a_ff.format(t_pjg).write_string+"  m"
	


	>> t_pjg
_endproc
$


