_global get_count_conduit_line <<
_proc(fdt)

	table_list << rope.new()
	
	s << swg_dsn_admin_engine.get_current_job()
	
	_if s _is _unset
	_then
			write("No Design Selected")
			_leave 
	_endif
	
	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	pj << s.inf_project.write_string
	st << s.status.write_string	
	change_set << mit_scheme_record_change_set.new(s)
	
	_for i _over change_set.fast_elements()
	_loop
	
		
		name <<   i.current_record.source_collection.name
		_if name _is :mit_conduit _then
			_if i.current_record.ring_name=fdt
			_then
				table_list.add(i.current_record)
			_endif
		_endif
		
	_endloop

	p1 << 0.0
	p2 << 0.0
	p3 << 0.0
	p4 << 0.0
	p5 << 0.0
	p6 << 0.0
	p7 << 0.0
	p8 << 0.0
	p9 << 0.0
	

	_for p  _over table_list.fast_elements()
	_loop
		_if p.construction_status="In Service"
		_then
			_continue
		_endif
		_if p.spec_id="Sub Duct / HDPE 32/28" 
		_then
			p1 << 	p1 + p.calculated_length.value_in(:m).as_number()
		_elif p.spec_id="Sub Duct / HDPE 40/34" 
		_then
			p2 << 	p2 + p.calculated_length.value_in(:m).as_number()
		_elif p.spec_id="Cable Duct� 10 x 5 cm" 
		_then
			p3 << 	p3 + p.calculated_length.value_in(:m).as_number()
		_elif p.spec_id="Cable Duct� 10 x 5 cm" 
		_then
			p4 << 	p4 + p.calculated_length.value_in(:m).as_number()
		_elif p.spec_id="Cable Duct� TC-2" 
		_then
			p5 << 	p5 + p.calculated_length.value_in(:m).as_number()
		_elif p.spec_id="Cable Duct� TC-3" 
		_then
			p6 << 	p6 + p.calculated_length.value_in(:m).as_number()
		_elif p.spec_id="Cable Duct� TC-4" 
		_then
			p7 << 	p7 + p.calculated_length.value_in(:m).as_number()
		_elif p.spec_id="Cable Duct� TC-5" 
		_then
			p8 << 	p8 + p.calculated_length.value_in(:m).as_number()
		_elif p.spec_id="Cable Duct� TC-6" 
		_then
			p9 << 	p9 + p.calculated_length.value_in(:m).as_number()


		_endif

	_endloop

	
>> p1,p2,p3,p4,p5,p6,p7,p8,p9
		
_endproc
