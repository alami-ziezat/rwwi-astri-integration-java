_global seq_fdt <<
_proc ()
	# Create a sequence
	table_list << rope.new()
	
	s << swg_dsn_admin_engine.get_current_job()
	
	_if s _is _unset
	_then
			write("No Design Selected")
			_leave 
	_endif
	
	t << rope.new()
	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	pj << s.inf_project.write_string
	st << s.status.write_string	
	change_set << mit_scheme_record_change_set.new(s)
	
	_for i _over change_set.fast_elements()
	_loop
		
		name <<   i.current_record.source_collection.name
		_if name _is :sheath_splice _then
			_if i.current_record.sheath_splice_object_type="FDT"
			_then
				_if i.current_record.construction_status="In Service"
				_then
					_continue
				_else

					t.add(i.current_record.name)

				_endif

			_endif
			#table_list.add(i.current_record)
		_endif
		
	_endloop

	my_seq << equality_set.new_from(t) #{"FDT 1 003", "FDT 1 001", "FDT 1 002"})
	
	# Iterate through the sequence
#	_for i _over my_seq.fast_elements()
#	_loop
#		write(i)
#	_endloop

	>> my_seq
_endproc
$


_global create_boq <<
_proc(design, infra_type)

	#rwwi_astri_workorder.show_messages("test")

	grs << smallworld_product.pni_application() 
	grs.show_message("Pastikan semua aplikasi Excel lainnya sudah ditutup!")
	system.do_command("taskkill /IM excel.exe /f")
	s << swg_dsn_admin_engine.get_current_job()

	_if s _is _unset
	_then
		write("No Design Selected")
		_leave 
	_endif
	
	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	pj << s.inf_project.write_string
	st << s.status.write_string	
	change_set << mit_scheme_record_change_set.new(s)
	
	#		dm << gis_program_manager.databases[:design_admin]
	#		val << s.inf_project.write_string
	#		c << dm.collections[:swg_dsn_project].select(predicate.eq(:name,val))
	#		cur_rec << c.an_element()
	#		project_id << cur_rec.id.write_string 
	#		owner << s.owner.write_string
			#write(project_id,nama)
	
	#ignored except these object
	object_filtered << rope.new_with(:pole,:figure_eight,:sheath_splice,:sheath_with_loc, :mit_terminal_enclosure, :uub, :optical_splitter )
	
	
	#pake equality ->string sebagai key
	obj << equality_hash_table.new()
	
	start << date_time_now()
	
	
	#a_filename << "c:\template_boq\01.2 BOQ Template to Vendor 2024 Final - Distribute to Vendor v2.xlsx"
	#a_filename << %TEMPLATE_BOQ%

	ug << cek_ug()
	ae << cek_ae()

	_if ug _is _true _and ae _is _false 
	_then
		nt << "Underground"
	_elif ae _is _true _and ug _is _false
	_then 
		nt << "Aerial"
	_elif ae _is _true _and ug _is _true
	_then 
		nt << "Aerial & Underground"	
	_endif

	write(infra_type,nt)

	_if infra_type ="cluster" _then
		
		#_local a_filename << system.getenv("TEMPLATE_BOQ_CLUSTER")
		write("nt  :",nt)
		_if nt = "Underground"
		_then
			a_filename << system.getenv("TEMPLATE_BOQ_CLUSTER_UG")
			sht << "BoM CLUSTER UG"
		_elif nt = "Aerial"
		_then
			a_filename << system.getenv("TEMPLATE_BOQ_CLUSTER_AE")
			sht << "BoM CLUSTER AE"

		_else
			a_filename << system.getenv("TEMPLATE_BOQ_CLUSTER_AEUG")
			sht << "BoM CLUSTER AE & UG"
		_endif
		
		Excel_Object << OLE_Client.Create_Object("Excel.Application")
		Excel_Object.Visible << _True
		write(a_filename,"  :  ",sht)
		Workbooks << Excel_Object.Workbooks ()
		WorkBook << Workbooks.add(a_filename)

	
		Sheet << Excel_Object.Sheets (sht)
		Sheet1 << Excel_Object.Sheets ("BoQ NRO Cluster")
		#_if infra_type ="cluster" _then
		#	Sheet << Excel_Object.Sheets ("BoQ NRO Cluster")
		#_else
		#	Sheet << Excel_Object.Sheets ("BoQ NRO All Feeder")
		#_endif
		
		a_ff << float_format.new_with_properties(
				:float_format,:fixed,
				:float_decimal_places,3)
		
		start << date_time_now()


		nm_fdt << seq_fdt()

		count_fdt << 0
		
		_for nm  _over nm_fdt.fast_elements()
		_loop
			count_fdt +<< 1

		
			_if count_fdt = 1  
			_then
				ss << "C"
			_elif count_fdt = 2
			_then
				ss << "D"
			_elif count_fdt = 3
			_then
				ss << "E"
			_elif count_fdt = 4
			_then
				ss << "F"
			_elif count_fdt = 5
			_then
				ss << "G"
			_elif count_fdt = 6
			_then
				ss << "H"
			_elif count_fdt = 7
			_then
				ss << "I"
			_elif count_fdt = 8
			_then
				ss << "J"
			_elif count_fdt = 9
			_then
				ss << "K"
			_elif count_fdt = 10
			_then
				ss << "L"

			_endif

			#pole
			(p1,p2,p3,p4,p5,p6,t_pl) << get_count_pole_line(nm)

			_if p1 > 0 
			_then
				Cell_p1_name << Sheet.Range(ss+"76")
				Cell_p1_name.value << p1.write_string
			_endif
			
			_if p2 > 0 
			_then
				Cell_p11_name << Sheet.Range(ss+"75")
				Cell_p11_name.value << p2.write_string
			_endif
			
			_if p3 > 0 
			_then
				Cell_p2_name << Sheet.Range(ss+"74")
				Cell_p2_name.value << p3.write_string
			_endif
			
			_if p4 > 0 
			_then
				Cell_p22_name << Sheet.Range(ss+"79")
				Cell_p22_name.value << p4.write_string
			_endif
			
			_if p5 > 0 
			_then
				Cell_p3_name << Sheet.Range(ss+"78")
				Cell_p3_name.value << p5.write_string
			_endif
			
			_if p6 > 0 
			_then
				Cell_p33_name << Sheet.Range(ss+"77")
				Cell_p33_name.value << p6.write_string
			_endif

			#pole existing
			px << get_count_pole_emr_existing_line(nm)
			
			_if px > 0 
			_then
				Cell_p38_name << Sheet.Range(ss+"82")
				Cell_p38_name.value << px.write_string
			_endif

			#cable
			#(c1,c2,c3,c4,c5,c6,c7) << get_count_cable_line(nm)
			
			cbl << get_count_cable_cluster_line(nm)

			_for b _over cbl.fast_elements()
			_loop
				_if b[:id]="clr1" _then
					Cell_d55_name << Sheet.Range(ss+"2")
					Cell_d55_name.value << b[:jml].ceiling.write_string
					
				_elif b[:id]="clr2" 
				_then
					Cell_d56_name << Sheet.Range(ss+"3")
					Cell_d56_name.value << b[:jml].ceiling.write_string
					
				_elif b[:id]="clr3"
				_then
					Cell_d57_name << Sheet.Range(ss+"4")
					Cell_d57_name.value << b[:jml].ceiling.write_string
					
				_elif b[:id]="clr4" 
				_then
					Cell_d58_name << Sheet.Range(ss+"5")
					Cell_d58_name.value << b[:jml].ceiling.write_string
					
				_elif b[:id]="clr5"
				_then
					Cell_d59_name << Sheet.Range(ss+"6")
					Cell_d59_name.value << b[:jml].ceiling.write_string
					
				_elif b[:id]="clr6" 
				_then
					Cell_d60_name << Sheet.Range(ss+"7")
					Cell_d60_name.value << b[:jml].ceiling.write_string
					
				
				_elif b[:id]="clr7" 
				_then
					Cell_d61_name << Sheet.Range(ss+"8")
					Cell_d61_name.value << b[:jml].ceiling.write_string
					
				_elif b[:id]="clr8" 
				_then
					Cell_d62_name << Sheet.Range(ss+"9")
					Cell_d62_name.value << b[:jml].ceiling.write_string
				_elif b[:id]="clr9"
				_then
					Cell_d63_name << Sheet.Range(ss+"10")
					Cell_d63_name.value << b[:jml].ceiling.write_string
				_elif b[:id]="clr10" 
				_then
					Cell_d64_name << Sheet.Range(ss+"11")
					Cell_d64_name.value << b[:jml].ceiling.write_string
				_elif b[:id]="clr11" 
				_then
					Cell_d65_name << Sheet.Range(ss+"12")
					Cell_d65_name.value << b[:jml].ceiling.write_string
				_elif b[:id]="clr12"
				_then
					Cell_d66_name << Sheet.Range(ss+"13")
					Cell_d66_name.value << b[:jml].ceiling.write_string
					
				_endif
			_endloop
			
			#slack
			slk << get_count_slack_line(nm)

			#sling		
			slw << get_count_sling_wire_line(nm)
			_if slw > 0 
			_then
				Cell_slw << Sheet.Range(ss+"15")
				Cell_slw.value << slw.ceiling.write_string
			_endif
			
			#fdt
			(fdta,fdtb,fdtc,fdtd) << get_count_fdt_line(nm)
			
			Cell_fdta << Sheet.Range(ss+"38")
			Cell_fdta.value << fdta.write_string

			Cell_fdtb << Sheet.Range(ss+"39")
			Cell_fdtb.value << fdtb.write_string
			
			Cell_fdtc << Sheet.Range(ss+"40")
			Cell_fdtc.value << fdtc.write_string
			
			Cell_fdtd << Sheet.Range(ss+"41")
			Cell_fdtd.value << fdtd.write_string
			


			#fat
			(fata,fatb,fatc,fatd) << get_count_fat_line(nm)
			
			Cell_fata << Sheet.Range(ss+"45")
			Cell_fata.value << fata.write_string

			Cell_fatb << Sheet.Range(ss+"46")
			Cell_fatb.value << fatb.write_string
			
			Cell_fatc << Sheet.Range(ss+"47")
			Cell_fatc.value << fatc.write_string
			
			Cell_fatd << Sheet.Range(ss+"48")
			Cell_fatd.value << fatd.write_string

			#underground
			_if ug _is _true 
			_then
				bm << get_count_boring_manual_line(nm)
				Cell_bm << Sheet.Range(ss+"105")
				Cell_bm.value << bm.ceiling.write_string

				#bmc << get_count_boring_machine_line(nm)
				bmc << get_count_boring_machine()
				Cell_bmc << Sheet1.Range("E119")
				Cell_bmc.value << bmc.ceiling.write_string

			
				tp <<  get_count_tali_pancing_line(nm)
				Cell_tp << Sheet.Range(ss+"123")
				Cell_tp.value << tp.ceiling.write_string

				pi << get_count_pi_line(nm)
				Cell_pi << Sheet.Range(ss+"124")
				Cell_pi.value << pi.write_string


				(cdt1,cdt2,cdt3,cdt4,cdt5,cdt6,cdt7,cdt8,cdt9) << get_count_conduit_line(nm)
				_if cdt1 > 0 
				_then
					Cell_cdt1_name << Sheet.Range(ss+"106")
					Cell_cdt1_name.value << cdt1.ceiling.write_string
				_endif
				
				_if cdt2 > 0 
				_then
					Cell_cdt2_name << Sheet.Range(ss+"107")
					Cell_cdt2_name.value << cdt2.ceiling.write_string
				_endif
				
#				_if c3 > 0 
#				_then
#					Cell_c3_name << Sheet1.Range("D158")
#					Cell_c3_name.value << c3.ceiling.write_string
#				_endif
#				
#				_if c4 > 0 
#				_then
#					Cell_c4_name << Sheet1.Range("D159")
#					Cell_c4_name.value << c4.ceiling.write_string
#				_endif
#				
#				_if c5 > 0 
#				_then
#					Cell_c5_name << Sheet1.Range("D153")
#					Cell_c5_name.value << c5.ceiling.write_string
#				_endif
#				
#				_if c6 > 0 
#				_then
#					Cell_c6_name << Sheet1.Range("D154")
#					Cell_c6_name.value << c6.ceiling.write_string
#				_endif
#				
#				_if c7 > 0 
#				_then
#					Cell_c7_name << Sheet1.Range("D155")
#					Cell_c7_name.value << c7.ceiling.write_string
#				_endif
