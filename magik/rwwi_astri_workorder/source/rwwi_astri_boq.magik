	t_pjg << 0 #0.0

	#write(table_list.size)

	_for s _over table_list.fast_elements()
	_loop
		_if s.construction_status="In Service" _orif  s.ring_name <> fdt
		_then
			_continue
		_endif
		row +<< 1		
		#write(row)
