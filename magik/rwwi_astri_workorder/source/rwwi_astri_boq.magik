	_for i _over change_set.fast_elements()
	_loop
	
		
		name <<   i.current_record.source_collection.name
		_if name _is :sheath_with_loc _then
			_if i.current_record.ring_name=fdt
			_then
				table_list.add(i.current_record)
			_endif
			
		_endif
		
	_endloop

	p1 << 0 #.0
	p2 << 0 #.0
	p3 << 0 #.0
	p4 << 0 #.0
	p5 << 0 #.0
	p6 << 0 #.0
	p7 << 0 #.0
	p8 << 0
	p9 << 0
	p10 << 0
	p11 << 0
	p12 << 0
	
	

	_for p  _over table_list.fast_elements()
	_loop
		_if p.construction_status="In Service"
		_then
			_continue
		_endif
		
		_if p.spec_id="SM G652D-ADSS 24C"  _and p.line_type="Line A"
		_then
			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p1 << 	p1 + y_sec #p.calculated_sheath_length.value_in(:m).as_number()
		_elif p.spec_id="SM G652D-ADSS 24C"  _and p.line_type="Line B"
		_then
			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p2 << 	p2 + y_sec
			#p.calculated_sheath_length.value_in(:m).as_number()

		_elif p.spec_id="SM G652D-ADSS 24C"  _and p.line_type="Line C"
		_then
			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p3 << 	p3 + y_sec
		_elif p.spec_id="SM G652D-ADSS 24C"  _and p.line_type="Line D"
		_then
			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p4 << 	p4 + y_sec
		_elif p.spec_id="SM G652D-ADSS 36C" _and p.line_type="Line A"
		_then
			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p5 << 	p5 + y_sec
			#p2 << 	p2 + p.calculated_sheath_length.value_in(:m).as_number()

		_elif p.spec_id="SM G652D-ADSS 36C" _and p.line_type="Line B"
		_then
			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p6 << 	p6 + y_sec
		_elif p.spec_id="SM G652D-ADSS 36C" _and p.line_type="Line C"
		_then
			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p7 << 	p7 + y_sec
		_elif p.spec_id="SM G652D-ADSS 36C" _and p.line_type="Line D"
		_then
			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p8 << 	p8 + y_sec
			
		_elif p.spec_id="SM G652D-ADSS 48C" _and p.line_type="Line A"
		_then
			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p9 << 	p9 + y_sec
		_elif p.spec_id="SM G652D-ADSS 48C" _and p.line_type="Line B"
		_then
			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p10 << 	p10 + y_sec
			#p3 << 	p3 + p.calculated_sheath_length.value_in(:m).as_number()
		_elif p.spec_id="SM G652D-ADSS 48C" _and p.line_type="Line C"
		_then
			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p11 << 	p11 + y_sec
		_elif p.spec_id="SM G652D-ADSS 48C" _and p.line_type="Line D"
		_then
			y << p.route_sectors()
			yy << y.line_length
			y_sec << yy/100
			p12 << 	p12 + y_sec
