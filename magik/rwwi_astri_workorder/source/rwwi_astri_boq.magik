
_global get_count_closure <<
_proc()

	table_list << rope.new()
	
	s << swg_dsn_admin_engine.get_current_job()
	
	_if s _is _unset
	_then
			write("No Design Selected")
			_leave 
	_endif
	
	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	pj << s.inf_project.write_string
	st << s.status.write_string	
	change_set << mit_scheme_record_change_set.new(s)
	
	_for i _over change_set.fast_elements()
	_loop
		
		name <<   i.current_record.source_collection.name
		_if name _is :sheath_splice _then
			table_list.add(i.current_record)
		_endif
		
	_endloop
	
	p1 << 0
	p2 << 0
	p3 << 0
	p4 << 0
	p5 << 0
	p6 << 0
	p7 << 0
	p8 << 0
	p9 << 0
	p10 << 0
	p11 << 0
	p12 << 0
	p13 << 0
	p14 << 0


	_for p  _over table_list.fast_elements()
	_loop
		_if p.construction_status="In Service"
		_then
			_continue
		_endif

		write(p.spec_id)
		_if p.spec_id="Join Closure In-line 24 Core" 
		_then
			p1 << 	p1 + 1
		_elif p.spec_id="Join Closure In-line 36 Core" 
		_then
			p2 << p2 + 1
		_elif p.spec_id="Join Closure In-line 48 Core" 
		_then
			p3 << p3 + 1
		_elif p.spec_id="Join Closure In-line 96 Core" 
		_then
			p4 << p4 + 1
		_elif p.spec_id="Join Closure In-line 144 Core" 
		_then
			p5 << p5 + 1
		_elif p.spec_id="Join Closure In-line 288 Core" 
		_then
			p6 << p6 + 1
		_elif p.spec_id="Join Closure Dome 24 Core" 
		_then
			p7 << p7 + 1
		_elif p.spec_id="Join Closure Dome 36 Core" 
		_then
			p8 << p8 + 1
		_elif p.spec_id="Join Closure Dome 48 Core" 
		_then
			p9 << p9 + 1
		_elif p.spec_id="Join Closure Dome 72 Core" 
		_then
			p10 << p10 + 1
		_elif p.spec_id="Join Closure Dome 96 Core" 
		_then
			p11 << p11 + 1
		_elif p.spec_id="Join Closure Dome 144 Core" 
		_then
			p12 << p12 + 1
		_elif p.spec_id="Join Closure Dome 288 Core" 
		_then
			p13 << p13 + 1
		_elif p.spec_id="Join Closure In-line 72 Core" 
		_then
			p14 << p14 + 1	
			

		_endif

	_endloop

	pp_seq_r << rope.new()
	
	a_values << property_list.new_with(
			    :id,"clr1",
			    :jml,p1)
	
	pp_seq_r.add(a_values)

	a_values << property_list.new_with(
			    :id,"clr2",
			    :jml,p2)
	
	pp_seq_r.add(a_values)
	a_values << property_list.new_with(
			    :id,"clr3",
			    :jml,p3)
	
	pp_seq_r.add(a_values)

	a_values << property_list.new_with(
			    :id,"clr4",
			    :jml,p4)
	
	pp_seq_r.add(a_values)
	a_values << property_list.new_with(
			    :id,"clr5",
			    :jml,p5)
	
	pp_seq_r.add(a_values)

	a_values << property_list.new_with(
			    :id,"clr6",
			    :jml,p6)
	
	pp_seq_r.add(a_values)
	a_values << property_list.new_with(
			    :id,"clr7",
			    :jml,p7)
	
	pp_seq_r.add(a_values)
	a_values << property_list.new_with(
			    :id,"clr8",
			    :jml,p8)
	
	pp_seq_r.add(a_values)
	a_values << property_list.new_with(
			    :id,"clr9",
			    :jml,p9)
	
	pp_seq_r.add(a_values)
	a_values << property_list.new_with(
			    :id,"clr10",
			    :jml,p10)
	
	pp_seq_r.add(a_values)
	a_values << property_list.new_with(
			    :id,"clr11",
			    :jml,p11)
	
	pp_seq_r.add(a_values)
	a_values << property_list.new_with(
			    :id,"clr12",
			    :jml,p12)
	
	pp_seq_r.add(a_values)
	a_values << property_list.new_with(
			    :id,"clr13",
			    :jml,p13)
	
	pp_seq_r.add(a_values)


>> pp_seq_r		
_endproc
$

_global get_count_fdt <<
_proc()

	table_list << rope.new()
	
	s << swg_dsn_admin_engine.get_current_job()
	
	_if s _is _unset
	_then
			write("No Design Selected")
			_leave 
	_endif
	
	
	id << s.id.write_string 
	nama << s.name.write_string
	owner << s.owner.write_string
	pj << s.inf_project.write_string
	st << s.status.write_string	
	change_set << mit_scheme_record_change_set.new(s)
	
	_for i _over change_set.fast_elements()
	_loop
		
		name <<   i.current_record.source_collection.name
		_if name _is :sheath_splice _then
			table_list.add(i.current_record)
		_endif
		
	_endloop

	p1 << 0
	p2 << 0
	p3 << 0
	p4 << 0
	p5 << 0
	p6 << 0

#	print(.table_list5)
	_for p  _over table_list.fast_elements()
	_loop
		_if p.construction_status="In Service"
		_then
			_continue
		_endif

		_if p.spec_id="48 Core pole mounted FDT" 
		_then
			p1 << 	p1 + 1
		_elif p.spec_id="72 Core pole mounted FDT" 
		_then
			p2 << p2 + 1
		_elif p.spec_id="96 Core pole mounted FDT" 
		_then
			p3 << p3 + 1
		_elif p.spec_id="144 Core Ground mounted FDT" 
		_then
			p4 << p4 + 1
		_elif p.spec_id="288 Core Ground mounted FDT" 
		_then
			p5 << p5 + 1
		_elif p.spec_id="576 Core Ground mounted FDT" 
		_then
			p6 << p6 + 1

		_endif

	_endloop

	
>> p1,p2,p3,p4,p5,p6

	
_endproc
