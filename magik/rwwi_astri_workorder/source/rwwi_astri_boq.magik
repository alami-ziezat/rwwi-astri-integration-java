				_if fa2 > 0
				_then
					Cell_fo << Sheet.Range(ss+"119")
					Cell_fo.value << fa2.write_string
				_endif
				
			_endif

		_endloop

		
		olt_nm << ""
		#clr_nm << ""
		_for i _over change_set.fast_elements()
		_loop
			
		
			name <<   i.current_record.source_collection.name
			_if name _is :sheath_with_loc _then
				olt_nm << i.current_record.olt
				cl_code << i.current_record.cluster_code
			_endif
			
		_endloop

		hdp << get_count_hp()
		Cell_hdp << Sheet1.Range("O5")
		Cell_hdp.value << hdp.write_string


		Cell_olt << Sheet1.Range("O2")
		Cell_olt.value << olt_nm.write_string

		Cell_cluster << Sheet1.Range("O3")
		Cell_cluster.value << nama.write_string

	
		Cell_type << Sheet1.Range("O4")
		_if ug _is _true _and ae _is _false 
