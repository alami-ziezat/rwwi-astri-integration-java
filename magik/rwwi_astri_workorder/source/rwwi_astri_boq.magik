#				_then
#					Cell_c9_name << Sheet1.Range("D157")
#					Cell_c9_name.value << c9.ceiling.write_string
#				_endif
				
				
				(ce1,ce2) << get_count_uub_fdt_line(nm)
				_if ce1 > 0 
				_then
					Cell_ce << Sheet.Range(ss+"114")
					Cell_ce.value << ce1.write_string
				_endif

				_if ce2 > 0
				_then
					Cell_co << Sheet.Range(ss+"118")
					Cell_co.value << ce2.write_string
