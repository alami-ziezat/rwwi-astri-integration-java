#			#p7 << 	p7 + p.calculated_sheath_length.value_in(:m).as_number()
#
		_endif

	_endloop

	pp_seq_r << rope.new()
	
	a_values << property_list.new_with(
			    :id,"clr1",
			    :jml,p1)
	
	pp_seq_r.add(a_values)
	
	a_values << property_list.new_with(
			    :id,"clr2",
			    :jml,p2)
	
	pp_seq_r.add(a_values)
