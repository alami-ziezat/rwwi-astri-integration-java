		_endif

		write("LOG: Adding UUB FDT accessories for", uub_fdt_count, "UUB FDT handholes...")

		# Add material accessories - service pairs auto-added by add_to_boq_result via :service_pair
		# 200000978 (Precast HH for FDT) + 500002102 (Instal) already handled by change_set loop
		_self.add_to_boq_result(result, "200000710", uub_fdt_count)  # Concrete Hand hole for FDT -> auto-adds 500002101

		write("LOG: Added UUB FDT accessories (1 material + 1 service pair) with quantity:", uub_fdt_count)
	_when error
		write("LOG: ERROR adding UUB FDT accessories:", errCond.report_contents_string)
	_endtry
_endmethod
