_private _method rwwi_astri_boq_generator.add_boring_manual(result)
	## Add boring_manual BOQ item (500002117) by total route length in meters
	## Queries boring_manual objects in design area, filters Proposed only
	##
	## Parameters:
	##   result - property_list to update with boring_manual service item

	_try _with errCond
		write("LOG: Querying boring_manual objects...")

		_local bm_col << .dataset.collections[:boring_manual]
		_if bm_col _is _unset
		_then
			write("LOG: WARNING - boring_manual collection not found, skipping")
			_return
		_endif

		_local area << .scheme.project.project_areas.an_element().area
		_if area _is _unset
		_then
			write("LOG: WARNING - No project area for boring_manual query")
			_return
		_endif

		_local boring_manuals << bm_col.select(predicate.interacts(:route, area))

		_local total_length << 0
		_for bm _over boring_manuals.fast_elements()
		_loop
			_if bm.responds_to?(:construction_status) _andif
			    bm.construction_status <> "Proposed"
			_then
				_continue
			_endif

			_local route_geom << bm.route
			_if route_geom _is _unset _then _continue _endif

			_local length_m << route_geom.line_length / 100  # cm to m
			total_length +<< length_m
		_endloop

		_if total_length > 0
		_then
			_self.add_to_boq_result(result, "500002117", total_length.ceiling)
			write("LOG: Boring manual total length:", total_length.rounded, "m -> qty:", total_length.ceiling)
		_else
			write("LOG: No Proposed boring_manual objects found or zero total length")
		_endif

	_when error
		write("LOG: ERROR adding boring_manual to BOQ:", errCond.report_contents_string)
	_endtry
_endmethod
$

