			:name, "Instal Concrete Hand hole for FAT : 40 x 40 x 60 cm",
			:material_slot, :service
		),

		# UG FDT handholes - when FDT is housed in underground handhole (UUB)
		# Each material has a service_pair for auto-installation service
		"200000978", property_list.new_with(
			:code, "200000978",
			:object, "UUB FDT",
			:name, "Precast Hand hole for FDT : 80 x 80 x 130 cm",
			:material_slot, :material,
			:service_pair, "500002102"
		),
		"500002102", property_list.new_with(
			:code, "500002102",
			:object, "UUB FDT",
			:name, "Instal Precast Hand hole for FDT : 80 x 80 x 130 cm",
			:material_slot, :service
		),
		"200000710", property_list.new_with(
			:code, "200000710",
			:object, "UUB FDT",
			:name, "Concrete Hand hole for FDT: 80 x 80 x 130 cm",
			:material_slot, :material,
			:service_pair, "500002101"
		),
		"500002101", property_list.new_with(
			:code, "500002101",
			:object, "UUB FDT",
			:name, "Instal Concrete Hand hole for FDT: 80 x 80 x 130 cm",
			:material_slot, :service
		),

		# Tali pancing / Roding rope (by total route length in meters)
		"200000267", property_list.new_with(
			:code, "200000267",
			:object, "Tali Pancing",
			:name, "Tambang pancing/Roding rope",
			:material_slot, :material
		),

		# Boring manual (manual trenching/boring by length in meters)
		"500002117", property_list.new_with(
			:code, "500002117",
			:object, "Boring Manual",
			:name, "Boring manual 150cm depth",
			:material_slot, :service
		),

		# Boring machine (mechanical boring by length in meters)
		"500000980", property_list.new_with(
			:code, "500000980",
			:object, "Boring Machine",
			:name, "Boring Mesin",
			:material_slot, :service
		),

		# Open trenching / sewer - service only, no material pair
		# 500002115 applies to SUBFEEDER topology (150cm depth)
		# 500002116 applies to CLUSTER topology (30-80cm depth, distribution inside cluster only)
		"500002115", property_list.new_with(
			:code, "500002115",
			:object, "Open Trench",
			:name, "Pekerjaan Trenching 150cm depth",
			:material_slot, :service
		),
		"500002116", property_list.new_with(
			:code, "500002116",
			:object, "Open Trench",
			:name, "Pekerjaan Trenching 30-80 cm depth (distribution inside cluster only)",
			:material_slot, :service
		),

		# Sub Duct / HDPE specs - future objects (not yet implemented in GIS)
		"200001017", property_list.new_with(
			:code, "200001017",
			:object, "Sub Duct",
			:name, "Sub Duct / HDPE 32/28 warna hitam, 3 strip ungu",
			:material_slot, :material,
			:service_pair, "500002144"
		),
		"500002144", property_list.new_with(
			:code, "500002144",
			:object, "Sub Duct",
			:name, "Instal Sub Duct / HDPE 32/28 warna hitam, 3 strip ungu",
			:material_slot, :service
		),
		"200000510", property_list.new_with(
			:code, "200000510",
			:object, "Sub Duct",
			:name, "Sub Duct / HDPE 40/34 warna Ungu, 3 Strip Putih",
			:material_slot, :material,
			:service_pair, "500002146"
		),
		"500002146", property_list.new_with(
			:code, "500002146",
			:object, "Sub Duct",
			:name, "Instal Sub Duct / HDPE 40/34 warna Ungu, 3 Strip Putih",
			:material_slot, :service
		),

		# T-WEY / pulling pit handholes (point_of_interest objects)
		# Each material has a service_pair for auto-installation service
		"200001006", property_list.new_with(
			:code, "200001006",
			:object, "T-WEY",
			:name, "Large Radius Tee (D-LT) 2 x 1 inch	pcs",
			:material_slot, :material
		),
		"200000992", property_list.new_with(
			:code, "200000992",
			:object, "T-WEY",
			:name, "Precast Hand hole for pulling pit : 20x20x20 cm",
			:material_slot, :material,
			:service_pair, "500002061"
		),
		"500002061", property_list.new_with(
			:code, "500002061",
			:object, "T-WEY",
			:name, "Instal Precast Hand hole for pulling pit : 20x20x20 cm",
			:material_slot, :service
		),
		"200001013", property_list.new_with(
			:code, "200001013",
			:object, "T-WEY",
			:name, "Concrete Hand hole for pulling pit : 20x20x20 cm",
			:material_slot, :material,
			:service_pair, "500002063"
		),
		"500002063", property_list.new_with(
			:code, "500002063",
			:object, "T-WEY",
			:name, "Instal Concrete Hand hole for pulling pit : 20x20x20 cm",
			:material_slot, :service
		),

		# Flexible conduit for FDT (qty = total FDT * 2)
		"200001018", property_list.new_with(
			:code, "200001018",
			:object, "FDT",
			:name, "Flexible 3/4 inch",
			:material_slot, :both
		),

		# Plate belt 20mm for FAT (qty = total FAT * 4)
		# Also used for Suspension clamp for Pole (qty = total Pole * 20%)
		# Both share this code and accumulate into one BOQ line item
		"200000148", property_list.new_with(
			:code, "200000148",
			:object, "Pole",
			:name, "Suspension clamp",
			:material_slot, :both
		),

		# Steel clamp for Pole (qty = same as Suspension clamp 200000148 = total Pole * 20%, ceiling)
		"200000166", property_list.new_with(
			:code, "200000166",
			:object, "Pole",
			:name, "Steel clamp",
			:material_slot, :both
		),

		# Plate belt 20mm for FAT (qty = total FAT * 4), fills both material and service slots
		"200000149", property_list.new_with(
			:code, "200000149",
			:object, "FAT",
			:name, "Plate belt 20mm",
			:material_slot, :both
		),

		# Pole clamp single (qty = total Pole * 80%)
		"200000145", property_list.new_with(
			:code, "200000145",
			:object, "Pole",
			:name, "Pole clamp single",
			:material_slot, :both
		),

		# Clamps Dead end Fittings / clamp buaya (qty = Pole clamp single * 2)
		"500001103", property_list.new_with(
			:code, "500001103",
			:object, "Pole",
			:name, "Clamps Dead end Fittings/clamp buaya",
			:material_slot, :both
		),

		# Buldog grip (qty = sum per ring of ROUND(group_sling_qty / 40 * 6))
		"200000172", property_list.new_with(
			:code, "200000172",
			:object, "Pole",
			:name, "Buldog grip",
			:material_slot, :both
		),

		# Label Cable on pole / in Handhole (qty = 10% of total Pole, rounded, service only)
		"200000290", property_list.new_with(
			:code, "200000290",
			:object, "Pole/Handhole",
			:name, "Label Cable (on pole, in Handhole)",
			:material_slot, :service
		),

		# RT/RW Permit — donation-based; injected at end of generate(), not via catalog loop
		# qty_material = 0, qty_service = 1 (fixed)
		# Generated ONLY when boq_params[:donation_value] is present and numeric
		"500002155", property_list.new_with(
			:code,          "500002155",
			:object,        "other",
			:name,          "RT/RW Permit",
			:material_slot, :service
		)
	),
	:public
)
$

# ============================================================================
# Constructor and Initialization Methods
# ============================================================================

_method rwwi_astri_boq_generator.new(params)
	## Create new BoQ generator for current active design
	## Parameters:
	##   params - property_list with BOQ parameters:
	##            :infra_type - Infrastructure type: "cluster", "subfeeder", or "feeder"
	##            :cluster_code - Cluster code (optional)
	##            :vendor_name - Vendor name (optional)
	##            :subcont_vendor_name - Subcontractor vendor name (optional)
	##            :remarks - Remarks (optional, default: "Service")
	##            :phase - Phase (optional, default: "project_opname")
	##            :area - Area (optional)
	##            :area_plant_code - Area plant code (optional)
	##            :override_price_material - Override price for material (optional)
	##            :override_price_service - Override price for service (optional)
	## Returns: New generator instance or _unset if no design active

	_try _with errCond
		_local scheme << swg_dsn_admin_engine.get_current_job()
		_if scheme _is _unset
		_then
			write("LOG: ERROR - No design currently active")
			_return _unset
		_endif

		_return _clone.init(scheme, params)

	_when error
		write("LOG: ERROR creating BoQ generator:", errCond.report_contents_string)
		_return _unset
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.init(scheme, params)
	## Initialize generator with scheme and BOQ parameters
	## Parameters:
	##   scheme - MIT scheme object
	##   params - property_list with BOQ parameters
	## Returns: _self

	.scheme << scheme
	.change_set << mit_scheme_record_change_set.new(scheme)
	.dataset << gis_program_manager.cached_dataset(:gis)

	# Extract infra_type and store all params
	.infra_type << params[:infra_type].default("cluster").lowercase
	.boq_params << params

	# Set defaults for optional fields if not provided
	_if .boq_params[:remarks] _is _unset
	_then
		.boq_params[:remarks] << "Service"
	_endif

	_if .boq_params[:phase] _is _unset
	_then
		.boq_params[:phase] << "drm"
	_endif

	write("LOG: BoQ generator configured for design:", scheme.name, "| Type:", .infra_type)
	>> _self
_endmethod
$

# ============================================================================
# Main Generation Method
# ============================================================================

_method rwwi_astri_boq_generator.generate()
	## Generate complete BoQ for current design
	## Returns: property_list with code keys mapping to BoQ item property_lists

	_try _with errCond
		_if .scheme _is _unset _orif .change_set _is _unset
		_then
			write("LOG: ERROR - Generator not initialized properly")
			condition.raise(:user_error, :string,
				"BoQ generator not initialized. Call set_scheme() first.")
		_endif

		_local result << property_list.new()

		write("LOG: Generating BoQ for design:", .scheme.name)

		# Single-pass iteration through change_set
		_for record_change _over .change_set.fast_elements()
		_loop
			_local rec << record_change.current_record

			_if rec _is _unset _then _continue _endif

			# Only process specific collection types
			_local col_name << rec.source_collection.name
			_if col_name _isnt :sheath_splice _andif
			    col_name _isnt :pole _andif
			    col_name _isnt :riser _andif
			    col_name _isnt :figure_eight _andif
			    col_name _isnt :uub _andif
			    col_name _isnt :point_of_interest
			_then
				_continue
			_endif

			# For non-cluster: figure_eight (Cable Hanger) count is formula-based.
			# Handled by add_figure_eight_non_cluster() after cable length is known.
			_if .infra_type <> "cluster" _andif col_name _is :figure_eight
			_then
				_continue
			_endif

			# Only process Proposed objects
			_if rec.responds_to?(:construction_status) _andif
			    rec.construction_status <> "Proposed"
			_then
				_continue
			_endif

			# Get stf_item_code from object
			_local code << _unset
			_if rec.responds_to?(:stf_item_code)
			_then
				code << rec.stf_item_code
			_endif

			# Skip if no code or not in catalog
			_if code _is _unset _orif _self.MATERIAL_CATALOG[code] _is _unset
			_then
				_continue
			_endif

			# Get quantity/length based on object type
			_local quantity << _self.get_quantity_from_record(rec)
			_if quantity _is _unset _orif quantity = 0
			_then
				_continue
			_endif

			# Add or accumulate in result
			_self.add_to_boq_result(result, code, quantity)
		_endloop

		# Special handling for sling_wire (not in change_set)
		_self.add_sling_wire_to_result(result)

		# Sum all sheath_with_loc lengths per code first, then apply 5% margin + ceiling once
		_self.add_sheath_with_loc_to_result(result)

		# For non-cluster: figure_eight (Cable Hanger 200000185) = ROUNDUP((cable_len/400)+1)
		_if .infra_type <> "cluster"
		_then
			_self.add_figure_eight_non_cluster(result)
		_endif

		# Add fixed service items based on infrastructure type
		_self.add_fixed_service_items(result)

		# Add pole accessories based on total pole count
		_self.add_pole_accessories(result)

		# Add FDT accessories based on total FDT count
		_self.add_fdt_accessories(result)

		# Add FAT accessories based on total FAT count
		_self.add_fat_accessories(result)

		# Add UG-specific items (boring manual/machine, UUB accessories, T-WEY, UG cables)
		_self.add_ug_items_to_result(result)

		# Add open trenching (all infra types: feeder->500002115, subfeeder->500002115, cluster->500002116)
		_self.add_open_trenching(result)

		# Add cable-based services (Project Management and Survey & Design)
		_self.add_cable_based_services(result)

		# RT/RW Permit: only if donation_value is present and numeric.
		# qty_material = 1 (fixed), qty_service = donation_value.
		# Injected directly — bypasses catalog loop intentionally.
		_local donation_value << .boq_params[:donation_value]
		_if donation_value _isnt _unset _andif donation_value <> ""
		_then
			_local donation_numeric << donation_value.as_number()
			_if donation_numeric _isnt _unset
			_then
				result["500002155"] << property_list.new_with(
					:equipment_name,          "500002155",
					:description,             "RT/RW Permit",
					:quantity_material,       0,
					:quantity_service,        1,
					:vendor_name,             .boq_params[:vendor_name].default(""),
					:subcont_vendor_name,     .boq_params[:subcont_vendor_name].default(""),
					:remarks,                 .boq_params[:remarks].default("Service"),
					:phase,                   .boq_params[:phase].default("drm"),
					:area,                    .boq_params[:area].default(""),
					:area_plant_code,         .boq_params[:area_plant_code].default(""),
					:override_price_material, _unset,
					:override_price_service,  donation_numeric)
			_else
				write("LOG: RT/RW Permit skipped - donation_value is non-numeric:", donation_value)
			_endif
		_else
			write("LOG: RT/RW Permit skipped - no donation_value in boq_params")
		_endif

		write("LOG: BoQ generation complete. Total item types:", result.size)

		_return result
	_when error
		write("LOG: ERROR generating BoQ:", errCond.report_contents_string)
		condition.raise(:user_error, :string, errCond)
	_endtry
_endmethod
$

# ============================================================================
# Helper Methods for Single-Pass Generation
# ============================================================================

_private _method rwwi_astri_boq_generator.normalize_infra_type(infra_type)
	## Normalize infrastructure type to match fttx_network_type field values
	## Parameters:
	##   infra_type - Input type (cluster, subfeeder, feeder)
	## Returns: Normalized type string

	_local type << infra_type.default("cluster").lowercase

	_if type = "cluster"
	_then
		_return "Cluster"
	_elif type = "subfeeder"
	_then
		_return "Sub Feeder"
	_elif type = "feeder"
	_then
		_return "Feeder"
	_else
		_return "Cluster"
	_endif
_endmethod
$

_private _method rwwi_astri_boq_generator.get_quantity_from_record(rec)
	## Extract quantity or length from a design record
	## For cables: Returns length in meters + 5% margin
	## Parameters:
	##   rec - Design record
	## Returns:
	##   Numeric quantity/length or _unset

	_local col_name << rec.source_collection.name

	# For all other objects - return count of 1
	_return 1
_endmethod
$

_private _method rwwi_astri_boq_generator.get_infra_code_field_name()
	## Returns the field name for infrastructure code based on infra_type
	## Returns: symbol (:cluster_code, :subfeeder_code, or :feeder_code)

	_if .infra_type = "cluster"
	_then
		_return :cluster_code
	_elif .infra_type = "subfeeder" _orif .infra_type = "sub feeder"
	_then
		_return :subfeeder_code
	_elif .infra_type = "feeder"
	_then
		_return :feeder_code
	_else
		# Default to cluster_code
		_return :cluster_code
	_endif
_endmethod
$

_private _method rwwi_astri_boq_generator.create_boq_item(code, material_qty, service_qty)
	## Create a BoQ item property_list from catalog using code
	## Parameters:
	##   code - Material code string (stf_item_code, e.g., "200001033")
	##   material_qty - Quantity for :quantity_material field (or _unset)
	##   service_qty - Quantity for :quantity_service field (or _unset)
	## Returns:
	##   property_list with BoQ item data in ASTRI API format
	##
	## Note: Codes starting with 200 → quantity_material
	##       Codes starting with 500 → quantity_service

	_try _with errCond
		write("Starting BoQ item creation for code:", code)
		_local catalog_entry << _self.MATERIAL_CATALOG[code]
		_if catalog_entry _is _unset
		_then
			write("LOG: ERROR - Unknown material code:", code)
			condition.raise(:user_error, :string,
				write_string("Unknown material code: ", code))
		_endif

		# Direct assignment - no swapping
		# material_qty goes to quantity_material
		# service_qty goes to quantity_service
		_local mat_value << material_qty.default(0)
		_local svc_value << service_qty.default(0)

		# Create property list with ASTRI API format
		# Get values from boq_params (set during initialization)

		# Get the appropriate infrastructure code field name
		_local infra_code_field << _self.get_infra_code_field_name()

		_local item << property_list.new_with(
			:cluster_code, .boq_params[infra_code_field],  # Dynamic based on infra_type
			:vendor_name, .boq_params[:vendor_name],
			:subcont_vendor_name, .boq_params[:subcont_vendor_name],
			:equipment_name, code,                    # stf_item_code
			:description, catalog_entry[:name],  # Default: "Project Management"
			:quantity_material, mat_value,
			:quantity_service, svc_value,
			:remarks, .boq_params[:remarks],          # Default: "Service"
			:phase, .boq_params[:phase],              # Default: "drm"
			:area, .boq_params[:area],
			:area_plant_code, .boq_params[:area_plant_code],
			:override_price_material, .boq_params[:override_price_material],
			:override_price_service, .boq_params[:override_price_service]
		)

		_return item
	_when error
		write("LOG: ERROR creating BoQ item:", errCond.report_contents_string)
		condition.raise(:user_error, :string, errCond)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_to_boq_result(result, code, qty)
	## Add or accumulate BOQ item in result property_list
	## For pole materials with service_pair, automatically adds the paired service item
	## Parameters:
	##   result - property_list to update
	##   code - material code string
	##   qty - quantity to add (will be placed in correct slot based on catalog)

	_local existing << result[code.as_symbol()]
	_local catalog_entry << _self.MATERIAL_CATALOG[code]
	_local slot_type << catalog_entry[:material_slot]
	# Determine which parameter to pass based on slot type
	_local mat_val << _unset
	_local svc_val << _unset

	_if slot_type = :material
	_then
		mat_val << qty
	_elif slot_type = :service
	_then
		svc_val << qty
	_else 
		mat_val << qty
		svc_val << qty
	_endif

	_if existing _is _unset
	_then
		# Create new BOQ item
		_local item << _self.create_boq_item(code.write_string, mat_val, svc_val)
		result[code.as_symbol()] << item
	_else
		# Accumulate to existing item
		_if slot_type = :material
		_then
			_local current << existing[:quantity_material]
			_if current _is _unset
			_then
				existing[:quantity_material] << qty
			_else
				existing[:quantity_material] << current + qty
			_endif
		_elif slot_type = :service
		_then
			_local current << existing[:quantity_service]
			_if current _is _unset
			_then
				existing[:quantity_service] << qty
			_else
				existing[:quantity_service] << current + qty
			_endif
		_else 
			_local current_m << existing[:quantity_material]
			_if current_m _is _unset
			_then
				existing[:quantity_material] << qty
			_else
				existing[:quantity_material] << current_m + qty
			_endif

			_local current_s << existing[:quantity_service]
			_if current_s _is _unset
			_then
				existing[:quantity_service] << qty
			_else
				existing[:quantity_service] << current_s + qty
			_endif
		_endif
	_endif

	# Auto-add service pair for poles (material items only)
	_if slot_type = :material _andif catalog_entry[:service_pair] _isnt _unset
	_then
		_local service_code << catalog_entry[:service_pair]
		_self.add_to_boq_result(result, service_code, qty)
	_endif
_endmethod
$

_private _method rwwi_astri_boq_generator.add_sling_wire_to_result(result)
	## Query sling_wire objects from area/project and add to result.
	## Groups lengths by ring_name, applies ceiling per group, then sums
	## all groups — same pattern as add_sheath_with_loc_to_result.
	##
	## Formula per ring group: ROUNDUP(raw_length * 1.05, 0)
	## Final qty = sum of all group results.

	_try _with errCond
		_local sling_col << .dataset.collections[:sling_wire]

		_if sling_col _is _unset
		_then
			write("LOG: WARNING - sling_wire collection not found")
			_return
		_endif

		# Query sling_wire in design area
		_local area << .scheme.project.project_areas.an_element().area
		_if area _is _unset
		_then
			write("LOG: WARNING - No project area defined for scheme")
			_return
		_endif

		_local pred << predicate.interacts(:route, area)
		_local sling_wires << sling_col.select(pred)

		# Accumulate raw lengths per ring_name
		_local lengths_by_ring << equality_hash_table.new()

		_for sw _over sling_wires.fast_elements()
		_loop
			_if sw.responds_to?(:construction_status) _andif
			    sw.construction_status <> "Proposed"
			_then
				_continue
			_endif

			_local length << sw.route.line_length / 100.0  # cm -> m

			_local ring << ""
			_if sw.responds_to?(:ring_name) _andif sw.ring_name _isnt _unset
			_then
				ring << sw.ring_name.write_string
			_endif
			lengths_by_ring[ring] << lengths_by_ring[ring].default(0) + length
		_endloop

		# Per ring group: sling wire ceiling(raw * 1.05), then buldog grip = ROUND(group_qty / 40 * 6)
		_local total_length  << 0
		_local total_buldog  << 0
		_for ring, raw_len _over lengths_by_ring.fast_keys_and_elements()
		_loop
			_local group_qty   << (raw_len.ceiling * 1.05).ceiling
			_local buldog_qty  << ((raw_len * 1.05 * 6) / 40.0).rounded
			total_length +<< group_qty
			total_buldog +<< buldog_qty
		_endloop

		_if total_length > 0
		_then
			_self.add_to_boq_result(result, "200001033", total_length)
			#write("LOG: Sling wire total:", total_length, "m (", lengths_by_ring.size, "ring groups)")
		_endif

		_if total_buldog > 0
		_then
			_self.add_to_boq_result(result, "200000172", total_buldog)
			#write("LOG: Buldog grip total:", total_buldog, "(sum of ROUND(group_qty/40*6) per ring)")
		_endif

	_when error
		write("LOG: ERROR querying sling_wire:", errCond.report_contents_string)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_sheath_with_loc_to_result(result)
	## Add sheath_with_loc (cable) lengths to BOQ result.
	##
	## Length calculation uses route_sectors() line_length (in cm, converted to m)
	## for each cable record, grouped by (stf_item_code, ring_name, line_type).
	##
	## Excel formula applied per group:
	##   ROUNDUP((CEILING(base_length) + (fat_count + fdt_count) * 20) * 1.05, 0)
	## where:
	##   base_length  = sum of route_sectors().line_length (cm->m) per group
	##   fat_count    = number of FAT objects sharing the same ring_name AND line_type
	##   fdt_count    = number of FDT objects sharing the same ring_name (1 FDT serves multiple lines)
	##   20           = slack allowance in metres per FAT/FDT
	##   1.05         = 5% tolerance factor
	##
	## Final BOQ quantity per stf_item_code = sum of all group results.
	##
	## Parameters:
	##   result - property_list to update

	_local fat_codes << {"200001047", "100000824"}
	_local fdt_codes << {"200001039", "200001040", "200001041", "200001042", "200001043", "200001044"}

	_try _with errCond
		#write("LOG: Processing sheath_with_loc cables (route_sectors + Excel formula approach)...")

		# ---- Phase 1: count FAT and FDT per ring_name from change_set ----
		_local fat_by_ring << equality_hash_table.new()   # ring -> count
		_local fdt_by_ring << equality_hash_table.new()   # ring -> count

		_for rc _over .change_set.fast_elements()
		_loop
			_local obj << rc.current_record
			_if obj _is _unset _then _continue _endif
			_if obj.responds_to?(:construction_status) _andif
			    obj.construction_status <> "Proposed"
			_then
				_continue
			_endif
			_if _not obj.responds_to?(:stf_item_code) _then _continue _endif
			_local obj_code << obj.stf_item_code
			_if obj_code _is _unset _then _continue _endif

			_local obj_ring << ""
			_if obj.responds_to?(:ring_name) _andif obj.ring_name _isnt _unset
			_then
				obj_ring << obj.ring_name.write_string
			_endif

			_local obj_ltype << ""
			_if obj.responds_to?(:line_type) _andif obj.line_type _isnt _unset
			_then
				obj_ltype << obj.line_type.write_string
			_endif

			_local fat_ring_line_key << write_string(obj_ring, "|", obj_ltype)

			_if fat_codes.eq_includes?(obj_code)
			_then
				fat_by_ring[fat_ring_line_key] << fat_by_ring[fat_ring_line_key].default(0) + 1
			_elif fdt_codes.eq_includes?(obj_code)
			_then
				# FDT keyed by ring only - 1 FDT can serve multiple line types
				fdt_by_ring[obj_ring] << fdt_by_ring[obj_ring].default(0) + 1
			_endif
		_endloop

		# ---- Phase 2: accumulate cable lengths per (code, ring, line_type) group ----
		# key: "code|ring|ltype"  value: total length in metres
		_local lengths_by_group << equality_hash_table.new()
		# key: code string  value: equality_hash_table of "ring|ltype" -> _true
		_local groups_by_code << equality_hash_table.new()
		_local swl_count << 0

		_for record_change _over .change_set.fast_elements()
		_loop
			_local rec << record_change.current_record
			_if rec _is _unset _then _continue _endif
			_if rec.source_collection.name _isnt :sheath_with_loc _then _continue _endif

			_if rec.responds_to?(:construction_status) _andif
			    rec.construction_status <> "Proposed"
			_then
				_continue
			_endif

			_local code << _unset
			_if rec.responds_to?(:stf_item_code)
			_then
				code << rec.stf_item_code
			_endif
			_if code _is _unset _orif _self.MATERIAL_CATALOG[code] _is _unset
			_then
				write("LOG: Skipping SWL record ID:", rec.id, "- invalid or missing stf_item_code")
				_continue
			_endif

			_local ring << ""
			_if rec.responds_to?(:ring_name) _andif rec.ring_name _isnt _unset
			_then
				ring << rec.ring_name.write_string
			_endif

			_local ltype << ""
			_if rec.responds_to?(:line_type) _andif rec.line_type _isnt _unset
			_then
				ltype << rec.line_type.write_string
			_endif

			# Sum route_sectors line_length (cm -> m)
			_local seg_length << rec.route_sectors().line_length / 100
			
			#write("  SWL ID:", rec.id, "code:", code, "ring:", ring, "ltype:", ltype, "length:", seg_length, "m")
			
		    _if seg_length <= 0 _then _continue _endif

			_local group_key << write_string(code, "|", ring, "|", ltype)
			_local prev << lengths_by_group[group_key]
			lengths_by_group[group_key] << prev.default(0) + seg_length

			_local group_set << groups_by_code[code]
			_if group_set _is _unset
			_then
				group_set << equality_hash_table.new()
				groups_by_code[code] << group_set
			_endif
			group_set[write_string(ring, "|", ltype)] << _true

			swl_count +<< 1
		_endloop

		# ---- Phase 3: apply Excel formula per group, sum per code ----
		# Cluster formula:     ROUNDUP((CEILING(base_length) + (fat_count + fdt_count) * 20) * 1.05, 0)
		# Non-cluster formula: ROUNDUP((CEILING(base_length) + ROUNDUP((base_length/400) + 1)) * 1.05, 0)
		#   where slack = ROUNDUP((base_length/400) + 1) — fat/fdt counts ignored
		_local total_by_code << equality_hash_table.new()
		_local is_cluster << .infra_type = "cluster"

		_for code, group_set _over groups_by_code.fast_keys_and_elements()
		_loop
			_local code_total << 0
			_for sub_key _over group_set.fast_keys()
			_loop
				_local group_key << write_string(code, "|", sub_key)
				_local base_len  << lengths_by_group[group_key].default(0)

				_local slack_length
				_local slack_fdt_cnt
				_local slack_cnt
				_if is_cluster
				_then
					# Cluster: FAT keyed by ring|ltype, FDT keyed by ring only
					_local fat_cnt << fat_by_ring[sub_key].default(0)
					_local sep_pos << sub_key.index_of(%|)
					_local grp_ring << _if sep_pos _isnt _unset
					                   _then >> sub_key.slice(1, sep_pos - 1)
					                   _else >> sub_key
					                   _endif
					_local fdt_cnt << fdt_by_ring[grp_ring].default(0)
					slack_fdt_cnt << fdt_cnt
					slack_cnt << fat_cnt + fdt_cnt
					slack_length << slack_cnt * 20
				_else
					# Non-cluster (subfeeder/feeder): ROUNDUP((base_length/400) + 1)
					slack_length << ((base_len / 400.0) + 1).ceiling * 20
				_endif

				write("LOG: SWL group:", group_key, "| base_len:", base_len, "m | slack:", slack_length, "m")

				_local qty << ((base_len.ceiling + slack_length) * 1.05).ceiling
				#write("LOG: SWL code:", code, "|group:", sub_key,
				#      "|base:", base_len, "m |slack:", slack_length, "m -> qty:", qty)
				code_total +<< qty
			_endloop
			write("LOG: SWL code:", code, "| total BOQ qty after formula:", code_total, "m")
			total_by_code[code] << code_total
		_endloop

		# Add final quantities to BOQ result
		_for code, qty _over total_by_code.fast_keys_and_elements()
		_loop
			#write("LOG: SWL code:", code, "| total BOQ qty:", qty, "m")
			_self.add_to_boq_result(result, code, qty)
		_endloop

		# Compute slack_fdt_cnt = sum of fdt_by_ring[ring] for each unique (ring|ltype) group
		# across all cable codes — counts (FDT × line_type) combinations, not just FDT objects.
		_local unique_ring_ltype << equality_hash_table.new()
		_for code, group_set _over groups_by_code.fast_keys_and_elements()
		_loop
			_for sub_key _over group_set.fast_keys()
			_loop
				unique_ring_ltype[sub_key] << _true
			_endloop
		_endloop
		_local total_slack_fdt << 0
		_for sub_key _over unique_ring_ltype.fast_keys()
		_loop
			_local sep_pos << sub_key.index_of(%|)
			_local grp_ring << _if sep_pos _isnt _unset
			                   _then >> sub_key.slice(1, sep_pos - 1)
			                   _else >> sub_key
			                   _endif
			total_slack_fdt +<< fdt_by_ring[grp_ring].default(0)
		_endloop
		.slack_fdt_cnt << total_slack_fdt
		write("LOG: slack_fdt_cnt (FDT x line_type combinations):", .slack_fdt_cnt)

		#write("LOG: Processed", swl_count, "sheath_with_loc records,", groups_by_code.size, "unique codes")
	_when error
		write("LOG: ERROR processing sheath_with_loc:", errCond.report_contents_string)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_figure_eight_non_cluster(result)
	## For subfeeder/feeder: add Cable Hanger (figure_eight, code 200000185)
	## quantity using formula instead of object count.
	##
	## Formula: qty = ROUNDUP((total_cable_length / 400) + 1)
	##   where total_cable_length = sum of all sheath_with_loc route_sectors lengths (cm->m)
	##
	## Parameters:
	##   result - property_list to update

	_try _with errCond
		# Compute total cable length from all sheath_with_loc Proposed objects
		_local total_cable_len << 0.0

		_for rc _over .change_set.fast_elements()
		_loop
			_local rec << rc.current_record
			_if rec _is _unset _then _continue _endif
			_if rec.source_collection.name _isnt :sheath_with_loc _then _continue _endif
			_if rec.responds_to?(:construction_status) _andif
			    rec.construction_status <> "Proposed"
			_then
				_continue
			_endif
			_local seg << rec.route_sectors().line_length / 100
			_if seg > 0 _then total_cable_len +<< seg _endif
		_endloop

		_if total_cable_len <= 0
		_then
			write("LOG: add_figure_eight_non_cluster: no cable length found, skipping")
			_return
		_endif

		# ROUNDUP((total_cable_length / 400) + 1)
		_local formula_qty << ((total_cable_len / 400.0) + 1).ceiling

		_self.add_to_boq_result(result, "200000185", formula_qty)
		write("LOG: Cable Hanger (200000185) non-cluster formula:",
		      "ROUNDUP((", total_cable_len, "/400)+1) =", formula_qty)

	_when error
		write("LOG: ERROR in add_figure_eight_non_cluster:", errCond.report_contents_string)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_fixed_service_items(result)
	## Add fixed service items based on infrastructure type
	## For cluster: Add 500003890, 500004774, 500002108, 500001853 (qty 1 each)
	## For subfeeder: Add 500003890, 500003800, 500002108, 500001853 (qty 1 each)
	##
	## Parameters:
	##   result - property_list to update with fixed service items

	_try _with errCond
		write("LOG: Adding fixed service items for infra_type:", .infra_type)

		_if .infra_type = "cluster"
		_then
			# Cluster fixed services
			_self.add_to_boq_result(result, "500003890", 1)  # Tranportasi, Mobilisasi Dan Demobilisasi
			_self.add_to_boq_result(result, "500004774", 1)  # Pengamanan Perizinan dan K3
			_self.add_to_boq_result(result, "500002108", 1)  # As Built Drawing A1
			_self.add_to_boq_result(result, "500001853", 1)  # Warehouse
			write("LOG: Added 4 fixed cluster service items")

		_elif .infra_type = "subfeeder" _orif .infra_type = "sub feeder"
		_then
			# Subfeeder fixed services
			_self.add_to_boq_result(result, "500003890", 1)  # Tranportasi, Mobilisasi Dan Demobilisasi
			_self.add_to_boq_result(result, "500003800", 1)  # Pengamanan Dan Persiapan
			_self.add_to_boq_result(result, "500002108", 1)  # As Built Drawing A1
			_self.add_to_boq_result(result, "500001853", 1)  # Warehouse
			write("LOG: Added 4 fixed subfeeder service items")

		_else
			# No fixed services for feeder or other types
			write("LOG: No fixed service items for infra_type:", .infra_type)
		_endif

	_when error
		write("LOG: ERROR adding fixed service items:", errCond.report_contents_string)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_pole_accessories(result)
	## Add pole accessories grouped by ring_name.
	## Formulas involving percentage/multiplication are applied per group then summed,
	## so ceiling/rounding is applied per FDT ring rather than on the grand total.
	##
	## Per-group formulas:
	##   200000148 / 200000166 : ceiling(excl_7_2_5 * 0.2)   [excl. Pole 7-2.5 / 200002675]
	##   200000145             : sum(ring_total - suspension_per_ring)
	##   500001103             : sum(clamp_per_ring * 2)
	##   200000290             : rounded(group_poles * 0.1)
	## Flat formula (unaffected by grouping):
	##   200000690             : total_poles (1:1)
	##
	## Parameters:
	##   result - property_list to update with pole accessories

	_try _with errCond
		write("LOG: Calculating pole accessories grouped by ring_name...")

		_local pole_codes << {"200002675", "200001055", "200001183", "200000187", "200001181", "200000169"}

		# Build a fast-lookup set of pole codes
		_local pole_code_set << equality_hash_table.new()
		_for c _over pole_codes.fast_elements()
		_loop
			pole_code_set[c] << _true
		_endloop

		# Phase 1: count poles per ring_name from change_set
		# poles_by_ring      : ring -> total pole count
		# poles_excl_by_ring : ring -> pole count excluding 200002675 (Pole 7-2.5)
		_local poles_by_ring      << equality_hash_table.new()
		_local poles_excl_by_ring << equality_hash_table.new()

		_for rc _over .change_set.fast_elements()
		_loop
			_local obj << rc.current_record
			_if obj _is _unset _then _continue _endif
			_if obj.responds_to?(:construction_status) _andif
			    obj.construction_status <> "Proposed"
			_then
				_continue
			_endif
			_if _not obj.responds_to?(:stf_item_code) _then _continue _endif
			_local obj_code << obj.stf_item_code
			_if obj_code _is _unset _orif _not pole_code_set.includes_key?(obj_code)
			_then
				_continue
			_endif

			_local ring << "default"
			_if obj.responds_to?(:ring_name) _andif obj.ring_name _isnt _unset
			_then
				ring << obj.ring_name.write_string
			_endif

			poles_by_ring[ring] << poles_by_ring[ring].default(0) + 1
			_if obj_code <> "200002675"
			_then
				poles_excl_by_ring[ring] << poles_excl_by_ring[ring].default(0) + 1
			_endif
		_endloop

		# Phase 2: sum total poles (flat formula) and apply per-group formulas
		_local total_poles        << 0
		_local suspension_total   << 0  # 200000148, 200000166
		_local clamp_total        << 0  # 200000145 = sum(ring_total - suspension_per_ring)
		_local clamp_buaya_total  << 0  # 500001103 = sum(clamp_per_ring * 2)
		_local label_cable_total  << 0  # 200000290

		_for ring, ring_total _over poles_by_ring.fast_keys_and_elements()
		_loop
			_local excl_total        << poles_excl_by_ring[ring].default(0)
			_local suspension_per_ring << (excl_total * 0.2).ceiling
			_local clamp_per_ring      << ring_total - (excl_total * 0.2)

			total_poles          +<< ring_total
			suspension_total     +<< suspension_per_ring
			clamp_total          +<< ring_total - suspension_per_ring
			clamp_buaya_total    +<< clamp_per_ring * 2
			label_cable_total    +<< (ring_total * 0.1).rounded

			write("LOG: Ring:", ring, "| poles:", ring_total, "| excl_7_2_5:", excl_total,
			      "| suspension:", suspension_per_ring, "| clamp:", clamp_per_ring)
		_endloop

		# Phase 3: add to BOQ
		_if total_poles > 0
		_then
			# Bahan Pondasi tiang (200000690) - flat 1:1 total, auto-adds 500001742 (Label Pole)
			_self.add_to_boq_result(result, "200000690", total_poles)
			write("LOG: Added Bahan Pondasi tiang (200000690) with quantity:", total_poles)

			# Suspension clamp (200000148) - sum of ceiling(excl_7_2_5 * 0.2) per ring
			_self.add_to_boq_result(result, "200000148", suspension_total)
			write("LOG: Added Suspension clamp (200000148) with quantity:", suspension_total, "(sum of per-ring ceiling(excl_7_2_5 * 20%))")

			# Steel clamp (200000166) - same as Suspension clamp
			_self.add_to_boq_result(result, "200000166", suspension_total)
			write("LOG: Added Steel clamp (200000166) with quantity:", suspension_total, "(same as Suspension clamp)")

			# Pole clamp single (200000145) - sum of (ring_total - suspension_per_ring) per ring
			_self.add_to_boq_result(result, "200000145", clamp_total)
			write("LOG: Added Pole clamp single (200000145) with quantity:", clamp_total, "(sum of per-ring (poles - suspension))")

			# Clamp buaya / Dead end Fittings (500001103) - sum of (clamp_per_ring * 2) per ring
			_self.add_to_boq_result(result, "500001103", clamp_buaya_total.ceiling)
			write("LOG: Added Clamp buaya (500001103) with quantity:", clamp_buaya_total, "(sum of clamp_per_ring * 2 per ring)")

			# Label Cable on pole/in Handhole (200000290) - sum of rounded(poles * 0.1) per ring
			_self.add_to_boq_result(result, "200000290", label_cable_total)
			write("LOG: Added Label Cable (200000290) with quantity:", label_cable_total, "(sum of per-ring rounded(poles * 10%))")
		_else
			write("LOG: No poles found in change_set, skipping pole accessories")
		_endif

	_when error
		write("LOG: ERROR adding pole accessories:", errCond.report_contents_string)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_fdt_accessories(result)
	## Add FDT accessories based on total FDT count
	## Adds 200000273 (Label FDT) with quantity equal to total number of FDTs
	##
	## Parameters:
	##   result - property_list to update with FDT accessories

	_try _with errCond
		write("LOG: Calculating total FDT count for accessories...")

		# List of all FDT material codes
		_local fdt_codes << {"200001039", "200001040", "200001041", "200001042", "200001043", "200001044"}
		_local total_fdts << 0

		# Count total FDTs from all FDT material items
		_for code _over fdt_codes.fast_elements()
		_loop
			_local item << result[code.as_symbol()]
			_if item _isnt _unset
			_then
				_local qty << item[:quantity_material]
				_if qty _isnt _unset
				_then
					total_fdts +<< qty
					write("LOG: FDT code", code, "has quantity:", qty)
				_endif
			_endif
		_endloop

		# If FDTs exist, add the accessories
		_if total_fdts > 0
		_then
			_self.add_to_boq_result(result, "200000273", total_fdts)         # Label FDT
			_self.add_to_boq_result(result, "200001018", .slack_fdt_cnt * 2)     # Flexible 3/4 inch = total (FDT x line_type) combinations
			write("LOG: Added FDT accessories - Label FDT:", total_fdts, "| Flexible 3/4 inch (200001018):", .slack_fdt_cnt * 2, "(slack_fdt_cnt * 2)")
		_else
			write("LOG: No FDTs found, skipping FDT accessories")
		_endif

	_when error
		write("LOG: ERROR adding FDT accessories:", errCond.report_contents_string)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.feeder_splicing_qty()
	## Calculate 500000510 (Splicing) quantity for feeder.
	## Cables sharing the same stf_item_code are treated as one cable:
	##   length is accumulated across all segments; core count used once.
	## Formula per unique code: cores + (cores * (total_length _div 4000))
	## Final result = sum across all unique cable codes.

	_local cable_core_map << equality_hash_table.new_with(
		"200000100", 24,
		"200000975", 36,
		"200001038", 48,
		"200001970", 72,
		"200001630", 96,
		"200001030", 144,
		"200001015", 288)

	# Accumulate total length (m) per stf_item_code
	_local length_by_code << equality_hash_table.new()

	_for rc _over .change_set.fast_elements()
	_loop
		_local rec << rc.current_record
		_if rec _is _unset _then _continue _endif
		_if rec.source_collection.name _isnt :sheath_with_loc _then _continue _endif

		_if rec.responds_to?(:construction_status) _andif
		    rec.construction_status <> "Proposed"
		_then
			_continue
		_endif

		_if _not rec.responds_to?(:stf_item_code) _then _continue _endif
		_local code << rec.stf_item_code
		_if code _is _unset _orif cable_core_map[code] _is _unset _then _continue _endif

		_local seg_len << rec.route_sectors().line_length / 100.0  # cm -> m
		length_by_code[code] << length_by_code[code].default(0) + seg_len
	_endloop

	# Apply formula once per unique code
	_local total << 0
	_for code, total_len _over length_by_code.fast_keys_and_elements()
	_loop
		_local cores      << cable_core_map[code]
		_local length_m   << total_len.ceiling
		_local qty        << cores + (cores * (length_m _div 4000))
		write("LOG: Feeder splicing - code:", code, "cores:", cores, "total_len:", length_m, "m qty:", qty)
		total +<< qty
	_endloop

	write("LOG: Feeder splicing total:", total)
	_return total
_endmethod
$

_private _method rwwi_astri_boq_generator.add_fat_accessories(result)
	## Add FAT accessories based on FAT count
	## Adds:
	##   - 500000510 (Splicing): cluster → ceiling(hp/8); subfeeder → (ceiling(hp/128)+2)×4; feeder → sum(cores+(cores*(len _div 4000)))
	##   - 200000288 (Label FAT include QR Code) with quantity = pole mounted FAT (200001047)
	##   - 200000802 (Label Pedestal) with quantity = pedestal mounted FAT (100000824)
	##   - 500002107 (Testcomm OTDR & OPM FDT - FAT) with quantity = total FAT (both types)
	##
	## Parameters:
	##   result - property_list to update with FAT accessories

	_try _with errCond
		write("LOG: Calculating FAT counts for accessories...")

		# Count pole mounted FAT (200001047)
		_local pole_fat_count << 0
		_local pole_item << result[:|200001047|]
		_if pole_item _isnt _unset
		_then
			_local qty << pole_item[:quantity_material]
			_if qty _isnt _unset
			_then
				pole_fat_count << qty
				write("LOG: Pole mounted FAT (200001047) has quantity:", qty)
			_endif
		_endif

		# Count pedestal mounted FAT (100000824)
		_local pedestal_fat_count << 0
		_local pedestal_item << result[:|100000824|]
		_if pedestal_item _isnt _unset
		_then
			_local qty << pedestal_item[:quantity_material]
			_if qty _isnt _unset
			_then
				pedestal_fat_count << qty
				write("LOG: Pedestal mounted FAT (100000824) has quantity:", qty)
			_endif
		_endif

		# Calculate total FAT count
		_local total_fats << pole_fat_count + pedestal_fat_count

		# Count total FDTs (needed for 200000149 quantity)
		_local fdt_codes << {"200001039", "200001040", "200001041", "200001042", "200001043", "200001044"}
		_local total_fdts << 0
		_for fdt_code _over fdt_codes.fast_elements()
		_loop
			_local fdt_item << result[fdt_code.as_symbol()]
			_if fdt_item _isnt _unset
			_then
				_local fdt_qty << fdt_item[:quantity_material]
				_if fdt_qty _isnt _unset
				_then
					total_fdts +<< fdt_qty
				_endif
			_endif
		_endloop

		# If FATs exist, add the accessories
		_if total_fats > 0
		_then
			# Splicing (500000510) - quantity depends on infra_type and homepass
			_local hp_str << .boq_params[:homepass].default("0")
			_local hp    << _if hp_str _isnt _unset _andif hp_str <> ""
			                _then >> hp_str.as_number().default(0)
			                _else >> 0
			                _endif
			_local splicing_qty
			_if .infra_type = "cluster" _andif hp > 0
			_then
				# ceiling(hp / 8) = (hp + 7) _div 8
				splicing_qty << (hp + 7) _div 8
			_elif .infra_type = "subfeeder" _andif hp > 0
			_then
				# (ceiling(hp / 128) + 2) * 4
				splicing_qty << ((hp + 127) _div 128 + 2) * 4
			_elif .infra_type = "feeder"
			_then
				# sum over cables: cores + (cores * (length _div 4000))
				splicing_qty << _self.feeder_splicing_qty()
			_else
				splicing_qty << total_fats * 2
			_endif
			_self.add_to_boq_result(result, "500000510", splicing_qty)
			write("LOG: Added Splicing (500000510) with quantity:", splicing_qty, " (infra_type:", .infra_type, " hp:", hp, ")")

			# Label FAT (include QR Code) - only for pole mounted FAT
			_if pole_fat_count > 0
			_then
				_self.add_to_boq_result(result, "200000288", pole_fat_count)
				write("LOG: Added Label FAT (200000288) with quantity:", pole_fat_count)
			_endif

			# Label Pedestal - only for pedestal mounted FAT
			_if pedestal_fat_count > 0
			_then
				_self.add_to_boq_result(result, "200000802", pedestal_fat_count)
				write("LOG: Added Label Pedestal (200000802) with quantity:", pedestal_fat_count)
			_endif

			# Testcomm - total FAT count
			_self.add_to_boq_result(result, "500002107", total_fats)
			write("LOG: Added Testcomm (500002107) with quantity:", total_fats)

			# Plate belt 20mm (200000149) - (total FDTs + total FATs) * 4, both slots
			_local plate_belt_qty << (total_fdts + total_fats) * 4
			_self.add_to_boq_result(result, "200000149", plate_belt_qty)
			write("LOG: Added Plate belt 20mm (200000149) with quantity:", plate_belt_qty, "(FDTs:", total_fdts, "+ FATs:", total_fats, "x4)")

			# Micro Splitter 1:8 (200001046) - temporarily disabled
			# _local micro_splitter_qty << (((total_fats * 2) + .slack_fdt_cnt) / 8).ceiling
			# _self.add_to_boq_result(result, "200001046", micro_splitter_qty)
			# write("LOG: Added Micro Splitter 1:8 (200001046) with quantity:", micro_splitter_qty, "((FATs:", total_fats, "x2 + slack_fdt_cnt:", .slack_fdt_cnt, ") / 8, rounded)")

			# Splitter 1:8 Modular (100000826) - temporarily disabled
			# _local splitter_modular_qty << (micro_splitter_qty / 8).ceiling + total_fdts - 1
			# _self.add_to_boq_result(result, "100000826", splitter_modular_qty)
			# write("LOG: Added Splitter 1:8 Modular (100000826) with quantity:", splitter_modular_qty, "(ceiling of", micro_splitter_qty, "/ 8)")

			write("LOG: Added FAT accessories with total FAT count:", total_fats)
		_else
			write("LOG: No FATs found, skipping FAT accessories")
		_endif

	_when error
		write("LOG: ERROR adding FAT accessories:", errCond.report_contents_string)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_cable_based_services(result)
	## Add cable-based services with quantity = total cable (with 5% margin) + sling wire length
	## Note: Cable length already includes 5% margin from get_quantity_from_record()
	## Adds:
	##   - 500001887 (Project Management) with quantity = cable (with 5%) + sling wire
	##   - 500001519 (Survey & Design Asplan) with quantity = cable (with 5%) + sling wire
	##
	## Parameters:
	##   result - property_list to update with cable-based services

	_try _with errCond
		write("LOG: Calculating total cable and sling wire length...")

		# List of all cable material codes
		_local cable_codes << {"200000100", "200000975", "200001038", "200001970", "200001630", "200001030", "200001015"}
		_local total_cable_length << 0

		# Count total cable length from all cable material items
		# Note: Cable length already includes 5% margin from get_quantity_from_record()
		_for code _over cable_codes.fast_elements()
		_loop
			_local item << result[code.as_symbol()]
			_if item _isnt _unset
			_then
				_local qty << item[:quantity_material]
				_if qty _isnt _unset
				_then
					total_cable_length +<< qty
					write("LOG: Cable code", code, "has length:", qty, "m (already includes 5% margin)")
				_endif
			_endif
		_endloop

		# Get sling wire length (code: 200001033, material_slot is :service)
		# 5% margin for sling wire
		_local sling_wire_length << 0
		_local sling_item << result[:|200001033|]
		_if sling_item _isnt _unset
		_then
			_local qty << sling_item[:quantity_service]
			_if qty _isnt _unset
			_then
				sling_wire_length << qty
				write("LOG: Sling wire (200001033) has length:", qty, "m (with 5% margin)")
			_endif
		_endif

		# Calculate total length (cable with 5% + sling wire without margin)
		_local total_length << total_cable_length + sling_wire_length

		# If cables or sling wire exist, add the services
		_if total_length > 0
		_then
			_self.add_to_boq_result(result, "500001887", total_length)  # Project Management
			_self.add_to_boq_result(result, "500001519", total_length)  # Survey & Design (Asplan)
			write("LOG: Added cable-based services with total length:", total_length.rounded, "m (Cable with 5% margin:", total_cable_length.rounded, "m + Sling Wire:", sling_wire_length.rounded, "m)")
		_else
			write("LOG: No cables or sling wire found, skipping cable-based services")
		_endif

	_when error
		write("LOG: ERROR adding cable-based services:", errCond.report_contents_string)
	_endtry
_endmethod
$

# ============================================================================
# Underground (UG) BOQ Methods
# ============================================================================

_private _method rwwi_astri_boq_generator.add_ug_items_to_result(result)
	## Add underground (UG) specific BOQ items
	## Only runs when topology is UG or AE&UG (checked via boq_params or UUB presence)
	## Calls sub-methods for boring_manual, boring_machine, UUB accessories,
	## UG cables via underground_route, and T-WEY accessories
	##
	## Parameters:
	##   result - property_list to update with UG items

	# Check topology from boq_params
	_local topo << .boq_params[:topology].default("").uppercase
	_local is_ug << topo = "UG" _orif topo = "AE&UG"

	# Fallback: detect UG topology by UUB object presence
	_if _not is_ug
	_then
		is_ug << _self.has_uub_objects?()
	_endif

	_if _not is_ug
	_then
		write("LOG: Not UG topology, skipping UG items (topology:", topo, ")")
		_return
	_endif

	write("LOG: Adding UG-specific BOQ items (topology:", topo, ")")

	# UUB FAT accessories (5 items) - based on 200001032 count from change_set
	#_self.add_uub_fat_accessories(result)

	# UUB FDT accessories (3 items) - based on 200000978 count from change_set
	#_self.add_uub_fdt_accessories(result)

	# Boring manual (500002117) - query from area, sum all lengths, ceiling once
	_self.add_boring_manual(result)

	# Boring machine (500000980) - query from area, sum all lengths, ceiling once
	_self.add_boring_machine(result)

	# Tali pancing / Roding rope (200000267) - query from area, sum all lengths, ceiling once
	_self.add_tali_pancing(result)

	# Sub Duct HDPE (material + service pair) - query from area by spec_id, ceiling once
	_self.add_sub_duct(result)

	write("LOG: UG items generation complete")
_endmethod
$

_private _method rwwi_astri_boq_generator.has_uub_objects?()
	## Detect UG topology by checking for UUB (handhole) objects in design area
	## Returns: _true if any UUB objects found, _false otherwise

	_try _with errCond
		_local uub_col << .dataset.collections[:uub]
		_if uub_col _is _unset
		_then
			_return _false
		_endif

		_local area << .scheme.project.project_areas.an_element().area
		_if area _is _unset
		_then
			_return _false
		_endif

		_local uubs << uub_col.select(predicate.interacts(:location, area))
		_return uubs.size > 0
	_when error
		write("LOG: ERROR checking UUB objects:", errCond.report_contents_string)
		_return _false
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_uub_fat_accessories(result)
	## Add UUB FAT accessories (5 items) based on 200001032 count in result
	## 200001032 (Precast Hand hole for FAT) comes from :uub objects in change_set
	## Remaining 5 accessories are calculated from that count
	##
	## Parameters:
	##   result - property_list to update with UUB FAT accessories

	_try _with errCond
		write("LOG: Adding UUB FAT accessories based on 200001032 count...")

		# Count from 200001032 (Precast Hand hole for FAT) - populated by :uub objects in change_set
		_local uub_fat_count << 0
		_local uub_fat_item << result[:|200001032|]
		_if uub_fat_item _isnt _unset
		_then
			uub_fat_count << uub_fat_item[:quantity_material].default(0)
		_endif

		_if uub_fat_count = 0
		_then
			write("LOG: No UUB FAT handhole objects (200001032) found in result, skipping FAT accessories")
			_return
		_endif

		write("LOG: Adding UUB FAT accessories for", uub_fat_count, "UUB FAT handholes...")

		# Add material accessories - service pairs auto-added by add_to_boq_result via :service_pair
		# 200001032 (Precast HH for FAT) + 500002060 (Instal) already handled by change_set loop
		_self.add_to_boq_result(result, "200000165", uub_fat_count)  # Underground Pedestal SPH920 -> auto-adds 500002113
		_self.add_to_boq_result(result, "200000613", uub_fat_count)  # Concrete Hand hole for FAT -> auto-adds 500001316

		write("LOG: Added UUB FAT accessories (2 material + 2 service pairs) with quantity:", uub_fat_count)
	_when error
		write("LOG: ERROR adding UUB FAT accessories:", errCond.report_contents_string)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_uub_fdt_accessories(result)
	## Add UUB FDT accessories (3 items) based on 200000978 count in result
	## 200000978 (Precast Hand hole for FDT) comes from :uub objects in change_set
	## Remaining 3 accessories are calculated from that count
	##
	## Parameters:
	##   result - property_list to update with UUB FDT accessories

	_try _with errCond
		write("LOG: Adding UUB FDT accessories based on 200000978 count...")

		# Count from 200000978 (Precast Hand hole for FDT) - populated by :uub objects in change_set
		_local uub_fdt_count << 0
		_local uub_fdt_item << result[:|200000978|]
		_if uub_fdt_item _isnt _unset
		_then
			uub_fdt_count << uub_fdt_item[:quantity_material].default(0)
		_endif

		_if uub_fdt_count = 0
		_then
			write("LOG: No UUB FDT handhole objects (200000978) found in result, skipping FDT accessories")
			_return
		_endif

		write("LOG: Adding UUB FDT accessories for", uub_fdt_count, "UUB FDT handholes...")

		# Add material accessories - service pairs auto-added by add_to_boq_result via :service_pair
		# 200000978 (Precast HH for FDT) + 500002102 (Instal) already handled by change_set loop
		_self.add_to_boq_result(result, "200000710", uub_fdt_count)  # Concrete Hand hole for FDT -> auto-adds 500002101

		write("LOG: Added UUB FDT accessories (1 material + 1 service pair) with quantity:", uub_fdt_count)
	_when error
		write("LOG: ERROR adding UUB FDT accessories:", errCond.report_contents_string)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_boring_manual(result)
	## Add boring_manual BOQ item (500002117) by total route length in meters
	## Queries boring_manual objects in design area, filters Proposed only
	##
	## Parameters:
	##   result - property_list to update with boring_manual service item

	_try _with errCond
		write("LOG: Querying boring_manual objects...")

		_local bm_col << .dataset.collections[:boring_manual]
		_if bm_col _is _unset
		_then
			write("LOG: WARNING - boring_manual collection not found, skipping")
			_return
		_endif

		_local area << .scheme.project.project_areas.an_element().area
		_if area _is _unset
		_then
			write("LOG: WARNING - No project area for boring_manual query")
			_return
		_endif

		_local boring_manuals << bm_col.select(predicate.interacts(:route, area))

		_local total_length << 0
		_for bm _over boring_manuals.fast_elements()
		_loop
			_if bm.responds_to?(:construction_status) _andif
			    bm.construction_status <> "Proposed"
			_then
				_continue
			_endif

			_local route_geom << bm.route
			_if route_geom _is _unset _then _continue _endif

			_local length_m << route_geom.line_length / 100  # cm to m
			total_length +<< length_m
		_endloop

		_if total_length > 0
		_then
			_self.add_to_boq_result(result, "500002117", total_length.ceiling)
			write("LOG: Boring manual total length:", total_length.rounded, "m -> qty:", total_length.ceiling)
		_else
			write("LOG: No Proposed boring_manual objects found or zero total length")
		_endif

	_when error
		write("LOG: ERROR adding boring_manual to BOQ:", errCond.report_contents_string)
	_endtry
_endmethod
$

