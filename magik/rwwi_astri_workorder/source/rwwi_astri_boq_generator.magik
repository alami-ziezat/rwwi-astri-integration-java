		# List of all FDT material codes
		_local fdt_codes << {"200001039", "200001040", "200001041", "200001042", "200001043", "200001044"}
		_local total_fdts << 0

		# Count total FDTs from all FDT material items
		_for code _over fdt_codes.fast_elements()
		_loop
			_local item << result[code.as_symbol()]
			_if item _isnt _unset
			_then
				_local qty << item[:quantity_material]
				_if qty _isnt _unset
				_then
					total_fdts +<< qty
