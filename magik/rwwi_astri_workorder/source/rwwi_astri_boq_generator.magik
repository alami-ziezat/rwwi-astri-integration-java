			:material_slot, :service
		),
		"200000710", property_list.new_with(
			:code, "200000710",
			:object, "UUB FDT",
			:name, "Concrete Hand hole for FDT: 80 x 80 x 130 cm",
			:material_slot, :material,
			:service_pair, "500002101"
		),
		"500002101", property_list.new_with(
			:code, "500002101",
			:object, "UUB FDT",
			:name, "Instal Concrete Hand hole for FDT: 80 x 80 x 130 cm",
			:material_slot, :service
		),

		# Tali pancing / Roding rope (by total route length in meters)
		"200000267", property_list.new_with(
			:code, "200000267",
			:object, "Tali Pancing",
			:name, "Tambang pancing/Roding rope",
			:material_slot, :material
		),

		# Boring manual (manual trenching/boring by length in meters)
		"500002117", property_list.new_with(
			:code, "500002117",
			:object, "Boring Manual",
			:name, "Boring manual 150cm depth",
			:material_slot, :service
		),

		# Boring machine (mechanical boring by length in meters)
		"500000980", property_list.new_with(
			:code, "500000980",
			:object, "Boring Machine",
			:name, "Boring Mesin",
			:material_slot, :service
		),

		# Open trenching / sewer - service only, no material pair
		# 500002115 applies to SUBFEEDER topology (150cm depth)
		# 500002116 applies to CLUSTER topology (30-80cm depth, distribution inside cluster only)
		"500002115", property_list.new_with(
			:code, "500002115",
			:object, "Open Trench",
			:name, "Pekerjaan Trenching 150cm depth",
			:material_slot, :service
		),
		"500002116", property_list.new_with(
			:code, "500002116",
			:object, "Open Trench",
			:name, "Pekerjaan Trenching 30-80 cm depth (distribution inside cluster only)",
			:material_slot, :service
		),

		# Sub Duct / HDPE specs - future objects (not yet implemented in GIS)
		"200001017", property_list.new_with(
			:code, "200001017",
			:object, "Sub Duct",
			:name, "Sub Duct / HDPE 32/28 warna hitam, 3 strip ungu",
			:material_slot, :material,
			:service_pair, "500002144"
		),
		"500002144", property_list.new_with(
			:code, "500002144",
			:object, "Sub Duct",
			:name, "Instal Sub Duct / HDPE 32/28 warna hitam, 3 strip ungu",
			:material_slot, :service
		),
		"200000510", property_list.new_with(
			:code, "200000510",
			:object, "Sub Duct",
			:name, "Sub Duct / HDPE 40/34 warna Ungu, 3 Strip Putih",
			:material_slot, :material,
			:service_pair, "500002146"
		),
		"500002146", property_list.new_with(
			:code, "500002146",
			:object, "Sub Duct",
			:name, "Instal Sub Duct / HDPE 40/34 warna Ungu, 3 Strip Putih",
			:material_slot, :service
		),

		# T-WEY / pulling pit handholes (point_of_interest objects)
		# Each material has a service_pair for auto-installation service
		"200001006", property_list.new_with(
			:code, "200001006",
			:object, "T-WEY",
			:name, "Large Radius Tee (D-LT) 2 x 1 inch	pcs",
			:material_slot, :material
		),
		"200000992", property_list.new_with(
			:code, "200000992",
			:object, "T-WEY",
			:name, "Precast Hand hole for pulling pit : 20x20x20 cm",
			:material_slot, :material,
			:service_pair, "500002061"
		),
		"500002061", property_list.new_with(
			:code, "500002061",
			:object, "T-WEY",
			:name, "Instal Precast Hand hole for pulling pit : 20x20x20 cm",
			:material_slot, :service
		),
		"200001013", property_list.new_with(
			:code, "200001013",
			:object, "T-WEY",
			:name, "Concrete Hand hole for pulling pit : 20x20x20 cm",
			:material_slot, :material,
			:service_pair, "500002063"
		),
		"500002063", property_list.new_with(
			:code, "500002063",
			:object, "T-WEY",
			:name, "Instal Concrete Hand hole for pulling pit : 20x20x20 cm",
			:material_slot, :service
		)
	),
	:public
)
$

# ============================================================================
# Constructor and Initialization Methods
# ============================================================================

_method rwwi_astri_boq_generator.new(params)
	## Create new BoQ generator for current active design
	## Parameters:
	##   params - property_list with BOQ parameters:
	##            :infra_type - Infrastructure type: "cluster", "subfeeder", or "feeder"
	##            :cluster_code - Cluster code (optional)
	##            :vendor_name - Vendor name (optional)
	##            :subcont_vendor_name - Subcontractor vendor name (optional)
	##            :remarks - Remarks (optional, default: "Service")
	##            :phase - Phase (optional, default: "project_opname")
	##            :area - Area (optional)
	##            :area_plant_code - Area plant code (optional)
	##            :override_price_material - Override price for material (optional)
	##            :override_price_service - Override price for service (optional)
	## Returns: New generator instance or _unset if no design active

	_try _with errCond
		_local scheme << swg_dsn_admin_engine.get_current_job()
		_if scheme _is _unset
		_then
			write("LOG: ERROR - No design currently active")
			_return _unset
		_endif

		_return _clone.init(scheme, params)

	_when error
		write("LOG: ERROR creating BoQ generator:", errCond.report_contents_string)
		_return _unset
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.init(scheme, params)
	## Initialize generator with scheme and BOQ parameters
	## Parameters:
	##   scheme - MIT scheme object
	##   params - property_list with BOQ parameters
	## Returns: _self

	.scheme << scheme
	.change_set << mit_scheme_record_change_set.new(scheme)
	.dataset << gis_program_manager.cached_dataset(:gis)

	# Extract infra_type and store all params
	.infra_type << params[:infra_type].default("cluster").lowercase
	.boq_params << params

	# Set defaults for optional fields if not provided
	_if .boq_params[:remarks] _is _unset
	_then
		.boq_params[:remarks] << "Service"
	_endif

	_if .boq_params[:phase] _is _unset
	_then
		.boq_params[:phase] << "drm"
	_endif

	write("LOG: BoQ generator configured for design:", scheme.name, "| Type:", .infra_type)
	>> _self
_endmethod
$

# ============================================================================
# Main Generation Method
# ============================================================================

_method rwwi_astri_boq_generator.generate()
	## Generate complete BoQ for current design
	## Returns: property_list with code keys mapping to BoQ item property_lists

	_try _with errCond
		_if .scheme _is _unset _orif .change_set _is _unset
		_then
			write("LOG: ERROR - Generator not initialized properly")
			condition.raise(:user_error, :string,
				"BoQ generator not initialized. Call set_scheme() first.")
		_endif

		_local result << property_list.new()

		write("LOG: Generating BoQ for design:", .scheme.name)

		# Single-pass iteration through change_set
		_for record_change _over .change_set.fast_elements()
		_loop
			_local rec << record_change.current_record

			_if rec _is _unset _then _continue _endif

			# Only process specific collection types
			_local col_name << rec.source_collection.name
			_if col_name _isnt :sheath_splice _andif
			    col_name _isnt :pole _andif
			    col_name _isnt :riser _andif
			    col_name _isnt :figure_eight _andif
			    col_name _isnt :uub _andif
			    col_name _isnt :point_of_interest
			_then
				_continue
			_endif

			# Only process Proposed objects
			_if rec.responds_to?(:construction_status) _andif
			    rec.construction_status <> "Proposed"
			_then
				_continue
			_endif

			# Get stf_item_code from object
			_local code << _unset
			_if rec.responds_to?(:stf_item_code)
			_then
				code << rec.stf_item_code
			_endif

			# Skip if no code or not in catalog
			_if code _is _unset _orif _self.MATERIAL_CATALOG[code] _is _unset
			_then
				_continue
			_endif

			# Get quantity/length based on object type
			_local quantity << _self.get_quantity_from_record(rec)
			_if quantity _is _unset _orif quantity = 0
			_then
				_continue
			_endif

			# Add or accumulate in result
			_self.add_to_boq_result(result, code, quantity)
		_endloop

		# Special handling for sling_wire (not in change_set)
		_self.add_sling_wire_to_result(result)

		# Sum all sheath_with_loc lengths per code first, then apply 5% margin + ceiling once
		_self.add_sheath_with_loc_to_result(result)

		# Add fixed service items based on infrastructure type
		_self.add_fixed_service_items(result)

		# Add pole accessories based on total pole count
		_self.add_pole_accessories(result)

		# Add FDT accessories based on total FDT count
		_self.add_fdt_accessories(result)

		# Add FAT accessories based on total FAT count
		_self.add_fat_accessories(result)

		# Add UG-specific items (boring manual/machine, UUB accessories, T-WEY, UG cables)
		_self.add_ug_items_to_result(result)

		# Add open trenching (all infra types: feeder->500002115, subfeeder->500002115, cluster->500002116)
		_self.add_open_trenching(result)

		# Add cable-based services (Project Management and Survey & Design)
		_self.add_cable_based_services(result)

		write("LOG: BoQ generation complete. Total item types:", result.size)

		_return result
	_when error
		write("LOG: ERROR generating BoQ:", errCond.report_contents_string)
		condition.raise(:user_error, :string, errCond)
	_endtry
_endmethod
$

# ============================================================================
# Helper Methods for Single-Pass Generation
# ============================================================================

_private _method rwwi_astri_boq_generator.normalize_infra_type(infra_type)
	## Normalize infrastructure type to match fttx_network_type field values
	## Parameters:
	##   infra_type - Input type (cluster, subfeeder, feeder)
	## Returns: Normalized type string

	_local type << infra_type.default("cluster").lowercase

	_if type = "cluster"
	_then
		_return "Cluster"
	_elif type = "subfeeder"
	_then
		_return "Sub Feeder"
	_elif type = "feeder"
	_then
		_return "Feeder"
	_else
		_return "Cluster"
	_endif
_endmethod
$

_private _method rwwi_astri_boq_generator.get_quantity_from_record(rec)
	## Extract quantity or length from a design record
	## For cables: Returns length in meters + 5% margin
	## Parameters:
	##   rec - Design record
	## Returns:
	##   Numeric quantity/length or _unset

	_local col_name << rec.source_collection.name

	# For all other objects - return count of 1
	_return 1
_endmethod
$

_private _method rwwi_astri_boq_generator.get_infra_code_field_name()
	## Returns the field name for infrastructure code based on infra_type
	## Returns: symbol (:cluster_code, :subfeeder_code, or :feeder_code)

	_if .infra_type = "cluster"
	_then
		_return :cluster_code
	_elif .infra_type = "subfeeder" _orif .infra_type = "sub feeder"
	_then
		_return :subfeeder_code
	_elif .infra_type = "feeder"
	_then
		_return :feeder_code
	_else
		# Default to cluster_code
		_return :cluster_code
	_endif
_endmethod
$

_private _method rwwi_astri_boq_generator.create_boq_item(code, material_qty, service_qty)
	## Create a BoQ item property_list from catalog using code
	## Parameters:
	##   code - Material code string (stf_item_code, e.g., "200001033")
	##   material_qty - Quantity for :quantity_material field (or _unset)
	##   service_qty - Quantity for :quantity_service field (or _unset)
	## Returns:
	##   property_list with BoQ item data in ASTRI API format
	##
	## Note: Codes starting with 200 → quantity_material
	##       Codes starting with 500 → quantity_service

	_try _with errCond
		write("Starting BoQ item creation for code:", code)
		_local catalog_entry << _self.MATERIAL_CATALOG[code]
		_if catalog_entry _is _unset
		_then
			write("LOG: ERROR - Unknown material code:", code)
			condition.raise(:user_error, :string,
				write_string("Unknown material code: ", code))
		_endif

		# Direct assignment - no swapping
		# material_qty goes to quantity_material
		# service_qty goes to quantity_service
		_local mat_value << material_qty.default(0)
		_local svc_value << service_qty.default(0)

		# Create property list with ASTRI API format
		# Get values from boq_params (set during initialization)

		# Get the appropriate infrastructure code field name
		_local infra_code_field << _self.get_infra_code_field_name()

		_local item << property_list.new_with(
			:cluster_code, .boq_params[infra_code_field],  # Dynamic based on infra_type
			:vendor_name, .boq_params[:vendor_name],
			:subcont_vendor_name, .boq_params[:subcont_vendor_name],
			:equipment_name, code,                    # stf_item_code
			:description, catalog_entry[:name],  # Default: "Project Management"
			:quantity_material, mat_value,
			:quantity_service, svc_value,
			:remarks, .boq_params[:remarks],          # Default: "Service"
			:phase, .boq_params[:phase],              # Default: "drm"
			:area, .boq_params[:area],
			:area_plant_code, .boq_params[:area_plant_code],
			:override_price_material, .boq_params[:override_price_material],
			:override_price_service, .boq_params[:override_price_service]
		)

		_return item
	_when error
		write("LOG: ERROR creating BoQ item:", errCond.report_contents_string)
		condition.raise(:user_error, :string, errCond)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_to_boq_result(result, code, qty)
	## Add or accumulate BOQ item in result property_list
	## For pole materials with service_pair, automatically adds the paired service item
	## Parameters:
	##   result - property_list to update
	##   code - material code string
	##   qty - quantity to add (will be placed in correct slot based on catalog)

	_local existing << result[code.as_symbol()]
	_local catalog_entry << _self.MATERIAL_CATALOG[code]
	_local slot_type << catalog_entry[:material_slot]
	# Determine which parameter to pass based on slot type
	_local mat_val << _unset
	_local svc_val << _unset

	_if slot_type = :material
	_then
		mat_val << qty
	_elif slot_type = :service
	_then
		svc_val << qty
	_endif

	_if existing _is _unset
	_then
		# Create new BOQ item
		_local item << _self.create_boq_item(code.write_string, mat_val, svc_val)
		result[code.as_symbol()] << item
	_else
		# Accumulate to existing item
		_if slot_type = :material
		_then
			_local current << existing[:quantity_material]
			_if current _is _unset
			_then
				existing[:quantity_material] << qty
			_else
				existing[:quantity_material] << current + qty
			_endif
		_elif slot_type = :service
		_then
			_local current << existing[:quantity_service]
			_if current _is _unset
			_then
				existing[:quantity_service] << qty
			_else
				existing[:quantity_service] << current + qty
			_endif
		_endif
	_endif

	# Auto-add service pair for poles (material items only)
	_if slot_type = :material _andif catalog_entry[:service_pair] _isnt _unset
	_then
		_local service_code << catalog_entry[:service_pair]
		_self.add_to_boq_result(result, service_code, qty)
	_endif
_endmethod
$

_private _method rwwi_astri_boq_generator.add_sling_wire_to_result(result)
	## Query sling_wire objects from area/project and add to result
	## Sling wires are not in change_set, so need special query

	_try _with errCond
		write("LOG: Querying sling_wire objects...")

		_local total_length << 0
		_local sling_col << .dataset.collections[:sling_wire]

		_if sling_col _is _unset
		_then
			write("LOG: WARNING - sling_wire collection not found")
			_return
		_endif

		# Query sling_wire in design area
		_local area << .scheme.project.project_areas.an_element().area
		_if area _is _unset
		_then
			write("LOG: WARNING - No project area defined for scheme")
			_return
		_endif

		_local pred << predicate.interacts(:route, area)
		_local sling_wires << sling_col.select(pred)
	
		_local filter_type << _self.normalize_infra_type(.infra_type)

		_for sw _over sling_wires.fast_elements()
		_loop
			# Only count Proposed sling wires with matching infra type
			_if sw.responds_to?(:construction_status) _andif
			    sw.construction_status = "Proposed"
			_then
				# Check infrastructure type
				#_if sw.responds_to?(:fttx_network_type)
				#_then
				#	_local sw_type << sw.fttx_network_type.default("").lowercase
				#	_if sw_type <> filter_type
				#	_then
				#		_continue
				#	_endif
				#_endif

				_local length << sw.route.line_length / 100  # Convert cm to m
				total_length +<< length
			_endif
		_endloop

		_if total_length > 0
		_then
			# Sling wire code is "200001033", material_slot is :service
			_self.add_to_boq_result(result, "200001033", total_length)
			write("LOG: Sling wire total length:", total_length, "m")
		_endif

	_when error
		write("LOG: ERROR querying sling_wire:", errCond.report_contents_string)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_sheath_with_loc_to_result(result)
	## Add sheath_with_loc (cable) lengths to BOQ result.
	## Groups all SWL records by (stf_item_code, ring_name), sums raw lengths
	## per group, applies 5% margin + ceiling once per group, then sums all
	## ceiling values per stf_item_code across ring_names for the final BOQ qty.
	##
	## Parameters:
	##   result - property_list to update

	_try _with errCond
		write("LOG: Processing sheath_with_loc cables (sum-then-margin per ring approach)...")

		# Accumulate raw base lengths per (stf_item_code, ring_name) pair
		# key: write_string(code, "|", ring_name), value: total raw length in meters
		raw_lengths_by_code_ring << equality_hash_table.new()
		# Track which ring names belong to each code
		# key: code string, value: equality_hash_table of ring_name -> _true
		rings_by_code << equality_hash_table.new()
		swl_count << 0

		_for record_change _over .change_set.fast_elements()
		_loop
			_local rec << record_change.current_record
			_if rec _is _unset _then _continue _endif

			_if rec.source_collection.name _isnt :sheath_with_loc _then _continue _endif

			# Only Proposed objects
			_if rec.responds_to?(:construction_status) _andif
			    rec.construction_status <> "Proposed"
			_then
				_continue
			_endif

			# Must have a valid stf_item_code in catalog
			_local code << _unset
			_if rec.responds_to?(:stf_item_code)
			_then
				code << rec.stf_item_code
			_endif
			_if code _is _unset _orif _self.MATERIAL_CATALOG[code] _is _unset
			_then
				_continue
			_endif

			# Get ring_name (use empty string as fallback for records without one)
			_local ring << ""
			_if rec.responds_to?(:ring_name) _andif rec.ring_name _isnt _unset
			_then
				ring << rec.ring_name.write_string
			_endif

			# Get raw base length (no margin, no ceiling yet)
			_if _not rec.responds_to?(:calculated_sheath_length) _then _continue _endif
			_local base_length << rec.calculated_sheath_length.value_in(:m).as_number()
			_if base_length _is _unset _orif base_length <= 0 _then _continue _endif

			write("  SWL ID:", rec.id, "code:", code, "ring:", ring, "base_length:", base_length, "m")

			# Accumulate raw length per (code, ring) pair
			_local pair_key << write_string(code, "|", ring)
			_local existing_len << raw_lengths_by_code_ring[pair_key]
			_if existing_len _is _unset
			_then
				raw_lengths_by_code_ring[pair_key] << base_length
			_else
				raw_lengths_by_code_ring[pair_key] << existing_len + base_length
			_endif

			# Track ring names per code
			_local ring_set << rings_by_code[code]
			_if ring_set _is _unset
			_then
				ring_set << equality_hash_table.new()
				rings_by_code[code] << ring_set
			_endif
			ring_set[ring] << _true

			swl_count +<< 1
		_endloop

		# For each stf_item_code, apply ceiling per ring then sum across rings
		_for code, ring_set _over rings_by_code.fast_keys_and_elements()
		_loop
			_local total_ceiled << 0
			_for ring _over ring_set.fast_keys()
			_loop
				_local pair_key << write_string(code, "|", ring)
				_local raw_for_ring << raw_lengths_by_code_ring[pair_key]
				_if raw_for_ring _is _unset _then _continue _endif
				#_local ceiled_for_ring << (raw_for_ring * 1.05).ceiling
				_local ceiled_for_ring << raw_for_ring.ceiling
				write("LOG: SWL code:", code, " |ring:", ring, "|raw:", raw_for_ring, "m -> ceiling:", ceiled_for_ring, "m")
				total_ceiled +<< ceiled_for_ring
			_endloop
			total_plus_05 << (total_ceiled * 1.05).ceiling  # Sum of ceiled lengths across rings for this code
			write("LOG: SWL code:", code, "|total across rings:", total_ceiled, "m", "-> +5% ceiling:", total_plus_05, "m")
			_self.add_to_boq_result(result, code, total_plus_05)
		_endloop

		write("LOG: Processed", swl_count, "sheath_with_loc records,", rings_by_code.size, "unique codes")
	_when error
		write("LOG: ERROR processing sheath_with_loc:", errCond.report_contents_string)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_fixed_service_items(result)
	## Add fixed service items based on infrastructure type
	## For cluster: Add 500003890, 500004774, 500002108, 500001853 (qty 1 each)
	## For subfeeder: Add 500003890, 500003800, 500002108, 500001853 (qty 1 each)
	##
	## Parameters:
	##   result - property_list to update with fixed service items

	_try _with errCond
		write("LOG: Adding fixed service items for infra_type:", .infra_type)

		_if .infra_type = "cluster"
		_then
			# Cluster fixed services
			_self.add_to_boq_result(result, "500003890", 1)  # Tranportasi, Mobilisasi Dan Demobilisasi
			_self.add_to_boq_result(result, "500004774", 1)  # Pengamanan Perizinan dan K3
			_self.add_to_boq_result(result, "500002108", 1)  # As Built Drawing A1
			_self.add_to_boq_result(result, "500001853", 1)  # Warehouse
			write("LOG: Added 4 fixed cluster service items")

		_elif .infra_type = "subfeeder" _orif .infra_type = "sub feeder"
		_then
			# Subfeeder fixed services
			_self.add_to_boq_result(result, "500003890", 1)  # Tranportasi, Mobilisasi Dan Demobilisasi
			_self.add_to_boq_result(result, "500003800", 1)  # Pengamanan Dan Persiapan
			_self.add_to_boq_result(result, "500002108", 1)  # As Built Drawing A1
			_self.add_to_boq_result(result, "500001853", 1)  # Warehouse
			write("LOG: Added 4 fixed subfeeder service items")

		_else
			# No fixed services for feeder or other types
			write("LOG: No fixed service items for infra_type:", .infra_type)
		_endif

	_when error
		write("LOG: ERROR adding fixed service items:", errCond.report_contents_string)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_pole_accessories(result)
	## Add pole accessories based on total pole count
	## Adds 200000690 (Bahan Pondasi tiang) and 500001742 (Label Pole)
	## with quantity equal to total number of poles
	##
	## Parameters:
	##   result - property_list to update with pole accessories

	_try _with errCond
		write("LOG: Calculating total pole count for accessories...")

		# List of all pole material codes
		_local pole_codes << {"200002675", "200001055", "200001183", "200000187", "200001181", "200000169"}
		_local total_poles << 0

		# Count total poles from all pole material items
		_for code _over pole_codes.fast_elements()
		_loop
			_local item << result[code.as_symbol()]
			_if item _isnt _unset
			_then
				_local qty << item[:quantity_material]
				_if qty _isnt _unset
				_then
					total_poles +<< qty
					write("LOG: Pole code", code, "has quantity:", qty)
				_endif
			_endif
		_endloop

		# If poles exist, add the accessories
		_if total_poles > 0
		_then
			_self.add_to_boq_result(result, "200000690", total_poles)  # Bahan Pondasi tiang -> auto-adds 500001742 (Label Pole)
			write("LOG: Added pole accessories (1 material + 1 service pair) with total pole count:", total_poles)
		_else
			write("LOG: No poles found, skipping pole accessories")
		_endif

	_when error
		write("LOG: ERROR adding pole accessories:", errCond.report_contents_string)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_fdt_accessories(result)
	## Add FDT accessories based on total FDT count
	## Adds 200000273 (Label FDT) with quantity equal to total number of FDTs
	##
	## Parameters:
	##   result - property_list to update with FDT accessories

	_try _with errCond
