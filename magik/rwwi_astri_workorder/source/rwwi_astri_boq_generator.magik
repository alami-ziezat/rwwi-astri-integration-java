_private _method rwwi_astri_boq_generator.add_tali_pancing(result)
	## Add tali_pancing (Tambang pancing/Roding rope) BOQ item (200000267)
	## by total route length in meters.
	## Queries tali_pancing objects in design area, filters Proposed only,
	## sums all route lengths, then applies ceiling once on the total.
	##
	## Parameters:
	##   result - property_list to update with tali_pancing material item

	_try _with errCond
		write("LOG: Querying tali_pancing objects...")

		_local tp_col << .dataset.collections[:tali_pancing]
		_if tp_col _is _unset
		_then
			write("LOG: WARNING - tali_pancing collection not found, skipping")
			_return
		_endif

		_local area << .scheme.project.project_areas.an_element().area
		_if area _is _unset
		_then
			write("LOG: WARNING - No project area for tali_pancing query")
			_return
		_endif

		_local tali_pancangs << tp_col.select(predicate.interacts(:route, area))

		_local total_length << 0
		_for tp _over tali_pancangs.fast_elements()
		_loop
			_if tp.responds_to?(:construction_status) _andif
			    tp.construction_status <> "Proposed"
			_then
				_continue
			_endif

			_local route_geom << tp.route
			_if route_geom _is _unset _then _continue _endif

			_local length_m << route_geom.line_length / 100  # cm to m
			total_length +<< length_m
		_endloop

		_if total_length > 0
		_then
			_self.add_to_boq_result(result, "200000267", total_length.ceiling)
			write("LOG: Tali pancing total length:", total_length.rounded, "m -> qty:", total_length.ceiling)
		_else
			write("LOG: No Proposed tali_pancing objects found or zero total length")
		_endif

	_when error
		write("LOG: ERROR adding tali_pancing to BOQ:", errCond.report_contents_string)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_sub_duct(result)
	## Add Sub Duct / HDPE BOQ items (material + service pairs).
	##
	## Queries mit_conduit objects in the design area, groups by spec_id:
	##   "Sub Duct / HDPE 40/34"  -> material 200000510 + service 500002146
	##   "Sub Duct / HDPE 32/28"  -> material 200001017 + service 500002144
	##
	## Sums total route lengths per spec, applies ceiling once.
	##
	## Parameters:
	##   result - property_list to update with sub duct items

	_try _with errCond
		write("LOG: Querying mit_conduit objects for sub duct BOQ...")

		_local sd_col << .dataset.collections[:mit_conduit]
		_if sd_col _is _unset
		_then
			write("LOG: WARNING - mit_conduit collection not found, skipping sub duct BOQ")
			_return
		_endif

		_local area << _unset
		_try
			area << .scheme.project.project_areas.an_element().area
		_when error
		_endtry
		_if area _is _unset
		_then
			write("LOG: WARNING - No project area for sub duct query")
			_return
		_endif

		_local sd_list << sd_col.select(predicate.interacts(:route, area))

		# Accumulate raw lengths per spec
		_local len_40 << 0
		_local len_32 << 0

		_for sd _over sd_list.fast_elements()
		_loop
			# Only Proposed objects
			_local cstatus << sd.perform(:construction_status).default("").lowercase
			_if cstatus <> "proposed" _then _continue _endif

			_local spec << sd.perform(:spec_id).default("")
			_local route_geom << sd.perform(:route)
			_if route_geom _is _unset _then _continue _endif

			_local length_cm << route_geom.line_length
			_local length_m  << length_cm / 100.0

			_if spec.index_of_seq("40/34") _isnt _unset
			_then
				len_40 +<< length_m
			_elif spec.index_of_seq("32/28") _isnt _unset
			_then
				len_32 +<< length_m
			_endif
		_endloop

		# Apply ceiling once per spec and add to result
		_if len_40 > 0
		_then
			_local qty_40 << len_40.ceiling
			_self.add_to_boq_result(result, "200000510", qty_40)
			_self.add_to_boq_result(result, "500002146", qty_40)
			write("LOG: Sub Duct 40/34 total:", len_40.rounded, "m -> qty:", qty_40)
		_endif
		_if len_32 > 0
		_then
			_local qty_32 << len_32.ceiling
			_self.add_to_boq_result(result, "200001017", qty_32)
			_self.add_to_boq_result(result, "500002144", qty_32)
			write("LOG: Sub Duct 32/28 total:", len_32.rounded, "m -> qty:", qty_32)
		_endif

		_if len_40 = 0 _andif len_32 = 0
		_then
			write("LOG: No Proposed mit_conduit objects found or zero total length")
		_endif

	_when error
		write("LOG: ERROR adding sub_duct to BOQ:", errCond.report_contents_string)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_open_trenching(result)
	## Add open trenching BOQ items (service only, no material pair).
	##
	## Queries open_trenching objects in the design area, groups by stf_item_code:
	##   500002115 -> Pekerjaan Trenching 150cm depth  (feeder / subfeeder)
	##   500002116 -> Pekerjaan Trenching 30-80cm depth (cluster)
	##
	## Sums total route lengths per code, applies ceiling once.
	##
	## Parameters:
	##   result - property_list to update with open trenching items

	_try _with errCond
		write("LOG: Querying open_trenching objects for BOQ...")

		_local ot_col << .dataset.collections[:open_trenching]
		_if ot_col _is _unset
		_then
			write("LOG: WARNING - open_trenching collection not found, skipping")
			_return
		_endif

		_local area << _unset
		_try
			area << .scheme.project.project_areas.an_element().area
		_when error
		_endtry
		_if area _is _unset
		_then
			write("LOG: WARNING - No project area for open_trenching query")
			_return
		_endif

		_local ot_list << ot_col.select(predicate.interacts(:route, area))

		# Accumulate raw lengths per STF code
		_local len_115 << 0   # feeder/subfeeder (150cm)
		_local len_116 << 0   # cluster (30-80cm)

		_for ot _over ot_list.fast_elements()
		_loop
			# Only Proposed objects
			_local cstatus << ot.perform(:construction_status).default("").lowercase
			_if cstatus <> "proposed" _then _continue _endif

			_local stf << ot.perform(:stf_item_code).default("")
			_local route_geom << ot.perform(:route)
			_if route_geom _is _unset _then _continue _endif

			_local length_m << route_geom.line_length / 100.0

			_if stf = "500002115"
			_then
				len_115 +<< length_m
			_elif stf = "500002116"
			_then
				len_116 +<< length_m
			_endif
		_endloop

		# Apply ceiling once per code and add to result
		_if len_115 > 0
		_then
			_local qty_115 << len_115.ceiling
			_self.add_to_boq_result(result, "500002115", qty_115)
			write("LOG: Open Trenching 150cm total:", len_115.rounded, "m -> qty:", qty_115)
		_endif
		_if len_116 > 0
		_then
			_local qty_116 << len_116.ceiling
			_self.add_to_boq_result(result, "500002116", qty_116)
			write("LOG: Open Trenching 30-80cm total:", len_116.rounded, "m -> qty:", qty_116)
		_endif

		_if len_115 = 0 _andif len_116 = 0
		_then
			write("LOG: No Proposed open_trenching objects found or zero total length")
		_endif

	_when error
		write("LOG: ERROR adding open_trenching to BOQ:", errCond.report_contents_string)
	_endtry
_endmethod
$

_private _method rwwi_astri_boq_generator.add_underground_cable_to_result(result)
	## Add underground cable BOQ items via underground_route objects
	## Maps each route's spec_id to a material code (same cable codes as aerial)
	## Length includes 5% margin
	##
	## Parameters:
	##   result - property_list to update with underground cable items

	_try _with errCond
		write("LOG: Querying underground_route objects for cables...")

		_local ur_col << .dataset.collections[:underground_route]
		_if ur_col _is _unset
		_then
			write("LOG: WARNING - underground_route collection not found, skipping")
			_return
		_endif

		_local area << .scheme.project.project_areas.an_element().area
		_if area _is _unset
		_then
			write("LOG: WARNING - No project area for underground_route query")
			_return
		_endif

		_local ug_routes << ur_col.select(predicate.interacts(:route, area))

		_local total_count << 0
		_for ur _over ug_routes.fast_elements()
		_loop
			_if ur.responds_to?(:construction_status) _andif
			    ur.construction_status <> "Proposed"
			_then
				_continue
			_endif

			# Get cable spec_id for catalog lookup
			_local spec_id << _unset
			_if ur.responds_to?(:spec_id)
			_then
				spec_id << ur.spec_id
			_endif
			_if spec_id _is _unset _then _continue _endif

			# Find catalog entry matching this spec_id
			_local matched_code << _unset
			_for cat_code, cat_entry _over _self.MATERIAL_CATALOG.fast_keys_and_elements()
			_loop
				_if cat_entry[:spec_id] _isnt _unset _andif
				    cat_entry[:spec_id] = spec_id
				_then
					matched_code << cat_code
					_leave
				_endif
			_endloop

			_if matched_code _is _unset
			_then
				write("LOG: WARNING - No catalog match for underground_route spec_id:", spec_id)
				_continue
			_endif

			# Get route length with 5% margin
			_local route_geom << ur.route
			_if route_geom _is _unset _then _continue _endif
			_local length_m << route_geom.line_length / 100  # cm to m
			_local length_with_margin << (length_m * 1.05).ceiling

			_self.add_to_boq_result(result, matched_code, length_with_margin)
			total_count +<< 1
			write("LOG: Underground route spec:", spec_id, "->", matched_code, "length:", length_with_margin, "m (+5%)")
		_endloop

		write("LOG: Processed", total_count, "underground_route cable objects")
	_when error
		write("LOG: ERROR adding underground cables to BOQ:", errCond.report_contents_string)
	_endtry
_endmethod
$