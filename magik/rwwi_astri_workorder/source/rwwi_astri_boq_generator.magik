		# Count from 200000978 (Precast Hand hole for FDT) - populated by :uub objects in change_set
		_local uub_fdt_count << 0
		_local uub_fdt_item << result[:|200000978|]
		_if uub_fdt_item _isnt _unset
		_then
			uub_fdt_count << uub_fdt_item[:quantity_material].default(0)
		_endif

		_if uub_fdt_count = 0
		_then
			write("LOG: No UUB FDT handhole objects (200000978) found in result, skipping FDT accessories")
