#% text_encoding = iso8859_1
_package user
$

## ASTRI Work Order Dialog - Donation Work Order Methods
## Handles fetching donation values for the loaded WO list and for BOQ generation.
##
## Two entry points:
##   1. get_donation_work_orders_for_list() - button action, populates all WOs in wo_cache
##   2. fetch_donation_value_for_wo(wo, infra_type) - private helper for BOQ auto-fetch

# =============================================================================
# Button Action: Get Donation WO (list-level)
# =============================================================================

_pragma(classify_level=debug, topic={astri_integration})
_method rwwi_astri_workorder_dialog.get_donation_work_orders_for_list()
	## Fetch donation values for ALL work orders in the current loaded list.
	## Loops each WO in wo_cache and calls the donation API once per infra_code.
	## Stores donation_value directly in each WO property_list.
	## Also propagates to selected_wo if one is currently selected.
	##
	## Called by the "Get Donation WO" button (beside Apply Filters).
	## Disabled for feeder infrastructure type.

	_if .wo_cache _is _unset _orif .wo_cache.empty?
	_then
		_self.user_info("No work orders loaded. Apply filters first.")
		_return
	_endif

	_local infra_type << .filters[:infrastructure_type].default("cluster").lowercase
	_if infra_type = "feeder"
	_then
		_self.user_info("Donation WO is not applicable for Feeder infrastructure.")
		_return
	_endif

	_self.log_separator()
	_self.log_info("FETCHING DONATION VALUES FOR ALL WORK ORDERS")
	_self.log_separator()
	_self.log_info("Infrastructure type: " + infra_type)
	_self.log_info("Total WOs to fetch:  " + .wo_cache.size.write_string)
	_self.log_info("")

	_local matched   << 0
	_local unmatched << 0
	_local idx       << 0

	_for cache_key _over .wo_cache.keys()
	_loop
		_local wo << .wo_cache[cache_key]
		idx +<< 1

		_local infra_code << wo[:infra_code].default("")
		_self.log_info(write_string("[", idx, "/", .wo_cache.size, "] ", infra_code))

		_local val << _self.fetch_donation_value_for_wo(wo, infra_type)

		_if val _isnt _unset _andif val <> ""
		_then
			wo[:donation_value] << val
			matched +<< 1
			_self.log_info("  -> " + val)
		_else
			unmatched +<< 1
			_self.log_info("  -> (not found)")
		_endif
	_endloop

	# Propagate to selected_wo if currently selected
	_if .selected_wo _isnt _unset
	_then
		_local sel_key << .selected_wo[:infra_code].default("").as_symbol()
		_local cached  << .wo_cache[sel_key]
		_if cached _isnt _unset _andif cached[:donation_value] _isnt _unset
		_then
			.selected_wo[:donation_value] << cached[:donation_value]
		_endif
	_endif

	_self.log_separator()
	_self.log_success("DONATION FETCH COMPLETE")
	_self.log_separator()
	_self.log_info("Donation:   " + matched.write_string)
	_self.log_info("Not Donation: " + unmatched.write_string)
	_self.log_separator()

	# Refresh the table so the Donation column shows the new values.
	_self.changed(:workorder_list, :renew)
_endmethod
$

# =============================================================================
# Private Helper: Fetch donation value for a single WO (used by BOQ auto-fetch)
# =============================================================================

_pragma(classify_level=debug, topic={astri_integration})
_private _method rwwi_astri_workorder_dialog.fetch_donation_value_for_wo(wo, infra_type)
	## Fetch the donation value for a single work order.
	## Calls the API with target_cluster_code set to wo[:infra_code] to narrow results.
	## Matches by wo_number; falls back to first result.
	##
	## Parameters:
	##   wo        - property_list: the selected work order
	##   infra_type - string: "cluster" or "subfeeder"
	##
	## Returns: donation value string, or _unset if not found / on error.

	_local filters << property_list.new_with(
		:assigned_vendor_name, "--not internal",
		:target_cluster_code,  wo[:infra_code].default(""),
		:latest_status_name,   "--not cancelled",
		:permit_status,        "DONATION APPROVED")

	_local donation_field << _if infra_type = "cluster"
	                         _then >> :target_cluster_final_donation_value
	                         _else >> :target_cluster_subfeeder_donation_value
	                         _endif

	_local json_response << astri_get_donation_work_orders(100, 0, filters)

	_if json_response _is _unset _orif json_response = ""
	_then >> _unset
	_endif

	_try
		_local json_obj << json_parser.parse(json_response)
		_local data     << json_obj[:data]
		
		# API always returns success:true — empty data means not found
		_if data _is _unset _orif data.size = 0
		_then >> _unset
		_endif

		_local matched_value << data[1][donation_field].write_string

		>> matched_value
	_when error
		_self.log_error("Donation single-fetch failed: " +
		                condition.report_contents_string)
		>> _unset
	_endtry
_endmethod
$
