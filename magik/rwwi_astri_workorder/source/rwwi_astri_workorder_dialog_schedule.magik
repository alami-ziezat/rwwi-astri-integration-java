#% text_encoding = iso8859_1

_package user
$

## Schedule WO dialog handler
## Inserts selected work order into smallworld.drm_etl_scheduler_log
## (the automated ETL scheduler table). Requires the WO's apd_kmz_upload_date
## to be newer than H-1 (yesterday), and stores a formatted 'subject'.

_pragma(classify_level=basic, topic={astri_integration})
_method rwwi_astri_workorder_dialog.schedule_wo()
	## Button handler: validate then insert selected WO into drm_etl_scheduler_log.
	## All fields are auto-populated from the selected row - no user input required.
	##
	## Validation blocks:
	##   1. Smallworld project/design already exists for this WO number
	##   2. apd_kmz_upload_date is NOT newer than H-1 (yesterday)
	##   3. An ETL scheduler log record already exists for this infra_code

	_if .selected_wo _is _unset
	_then
		_self.log_warning("No work order selected")
		_return
	_endif

	_local wo         << .selected_wo
	_local wo_number  << wo[:wo_number].default("")
	_local infra_code << wo[:infra_code].default("")
	_local infra_type << wo[:infrastructure_type].default(
		.filters[:infrastructure_type].default("cluster"))

	# --- Validation 1: Smallworld design already exists ---
	_local (has_project, has_design) << _self.check_project_and_design_exist(wo)

	_if has_design
	_then
		_self.show_alert(
			write_string("Design already created for WO: ", wo_number,
			             %newline, "Scheduling is blocked."))
		_self.log_warning("Schedule blocked - design exists for: " + wo_number)
		_return
	_endif

	_if has_project
	_then
		_self.show_alert(
			write_string("Project exists but has no design yet for WO: ", wo_number,
			             %newline, "Scheduling is blocked."))
		_self.log_warning("Schedule blocked - project exists (no design) for: " + wo_number)
		_return
	_endif

	# --- Validation 2: apd_kmz_upload_date must be within the last month ---
	_local upload_date << wo[:apd_kmz_upload_date].default("")
	_local upload_date_disp << _if upload_date = "" _then >> "(none)" _else >> upload_date _endif
	_if _not .engine.apd_kmz_recent?(infra_type, infra_code)
	_then
		_self.show_alert(
			write_string("Cannot schedule WO: ", infra_code,
			             %newline,
			             "Current APD KMZ upload date: ", upload_date_disp,
			             %newline,
			             "Must be within the last month.",
			             %newline, "Scheduling is blocked."))
		_self.log_warning(write_string(
			"Schedule blocked - apd_kmz_upload_date older than 1 month: ", infra_code,
			" (upload_date=", upload_date_disp, ")"))
		_return
	_endif

	# --- Validation 3: Already in ETL scheduler log (per infra_code + infra_type) ---
	_local existing_status << .engine.get_etl_scheduler_log_status(infra_code, infra_type)

	_if existing_status _isnt _unset _andif existing_status <> ""
	_then
		_self.show_alert(
			write_string("WO ", infra_code, " is already in the ETL scheduler",
			             %newline, "with status: ", existing_status,
			             %newline, "Scheduling is blocked."))
		_self.log_warning(
			write_string("Schedule blocked - existing ETL record for: ",
			             infra_code, " (status: ", existing_status, ")"))
		_return
	_endif

	# --- Build params from selected row (all auto-populated) ---
	_local username << gis_program_manager.cached_dataset(:gis).auth_view.current_user.name.default("unknown")

	_local topology << wo[:topology].default("")
	_local uuid     << wo[:kmz_uuid].default("")
	_local subject  << _self.build_etl_subject(infra_type)

	_local params << property_list.new_with(
		:infra_code,         infra_code,
		:name,               wo[:infra_name].default(""),
		:infra_type,         infra_type,
		:username,           username,
		:scheduler_username, username,
		:status,             "scheduled",
		:topology,           topology,
		:uuid,               uuid,
		:subject,            subject,
		:description,        "SINGLE")

	# --- Insert into ETL scheduler table ---
	_local ok? << .engine.insert_etl_scheduler_log(params)

	_if ok?
	_then
		_self.log_success(
			write_string("WO scheduled (ETL): ", wo_number,
			             " [", infra_code, "]",
			             " subject=", subject))
	_else
		_self.log_error("Failed to schedule WO (ETL): " + wo_number)
	_endif
_endmethod
$

_pragma(classify_level=restricted, topic={astri_integration})
_private _method rwwi_astri_workorder_dialog.build_etl_subject(infra_type)
	## Build the ETL 'subject' string:
	##   "[SMALLWORLD] - SUMMARY ETL [<TYPE>] [<YYYY-MM-DD>]"
	## Type label: cluster -> CLUSTER, subfeeder -> SUB-FEEDER, feeder -> FEEDER.

	_local type_label << _if infra_type = "subfeeder"
	                     _then >> "SUB-FEEDER"
	                     _else >> infra_type.uppercase
	                     _endif

	_local d << date_time.now().date
	_local pad << _proc(n)
		_if n < 10 _then >> "0" + n.write_string _endif
		>> n.write_string
	_endproc
	_local date_str << write_string(d.year, "-", pad(d.month), "-", pad(d.day))

	>> write_string("[SMALLWORLD] - SUMMARY ETL [", type_label, "] [", date_str, "]")
_endmethod
$

