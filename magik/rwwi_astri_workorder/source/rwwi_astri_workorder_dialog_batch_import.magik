#% text_encoding = iso8859_1

_package user
$

## Batch Import WO from TXT file
## Reads infra_code list from a plain-text file and loads / schedules WOs in bulk.
##
## TXT file format:
##   Line 1: infra_type  (CLUSTER, SUBFEEDER, or FEEDER - case-insensitive)
##   Line 2+: one infra_code per line, blank lines are ignored
##
## Example:
##   CLUSTER
##   JKT00001
##   JKT00002

_pragma(classify_level=basic, topic={astri_integration})
_method rwwi_astri_workorder_dialog.browse_batch_list()
	## Open file dialog to select an infra_code list (.txt file).

	_local fd << file_dialog.new(_self, :ok_batch_list|()|)
	fd.filter << {"Text files (*.txt)", "*.txt"}

	_local current_path << .items[:batch_list_path].value.default("")
	_if current_path <> ""
	_then
		fd.directory << current_path
	_else
		fd.directory << system.getenv("TEMP").default("C:\")
	_endif

	fd.activate()
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_method rwwi_astri_workorder_dialog.ok_batch_list(path)
	## Callback from file_dialog — store selected path and enable Load WO List.

	.items[:batch_list_path].value << path
	.items[:batch_clear_btn].enabled?  << _true
	.items[:load_wo_list_btn].enabled? << _true
	.items[:schedule_all_btn].enabled? << _false
	write("Batch list file selected: ", path)
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_method rwwi_astri_workorder_dialog.clear_batch_list()
	## Clear the batch import path, filter, and disable dependent buttons.

	.items[:batch_list_path].value     << ""
	.items[:batch_clear_btn].enabled?  << _false
	.items[:load_wo_list_btn].enabled? << _false
	.items[:schedule_all_btn].enabled? << _false
	.batch_infra_codes << _unset
	write("Batch list cleared.")
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_method rwwi_astri_workorder_dialog.load_wo_list()
	## Parse the selected .txt file and load matching WOs into the dialog table.
	## Sets the infrastructure type filter from line 1 of the file.

	_local path << .items[:batch_list_path].value.default("")
	_if path = ""
	_then
		_self.log_warning("No file selected. Use Browse List to select a .txt file.")
		_return
	_endif

	_local (infra_type, infra_codes) << _self._parse_batch_file(path)

	_if infra_type _is _unset
	_then
		_self.user_error("Could not parse file." + %newline.write_string +
			"Ensure line 1 is CLUSTER, SUBFEEDER, or FEEDER.")
		_return
	_endif

	_if infra_codes.empty?
	_then
		_self.user_error("No infra_codes found in file (lines 2+).")
		_return
	_endif

	# Build equality_hash_table for O(1) lookup in workorder_list_data()
	_local codes_ht << equality_hash_table.new()
	_for code _over infra_codes.fast_elements()
	_loop
		codes_ht[code] << _true
	_endloop
	.batch_infra_codes << codes_ht

	# Sync the infrastructure type filter UI
	_self._set_infra_type_filter(infra_type)

	# Maximise limit so all batch entries can be found in one call
	.items[:filter_limit].value  << "100"
	.items[:filter_offset].value << "0"

	_self.log_separator()
	_self.log_info(write_string("Batch load: ", infra_codes.size,
		" infra_codes [", infra_type, "] from: ", path))

	# Reload table — workorder_list_data() will apply the batch filter
	_self.apply_filters()

	# Enable Schedule All only if at least one WO was found
	_local found << .wo_cache _isnt _unset _andif _not .wo_cache.empty?
	.items[:schedule_all_btn].enabled? << found

	_self.log_info(write_string("Batch load complete. Found: ",
		.wo_cache.size.write_string, " / ", infra_codes.size, " WOs."))
_endmethod
$

_pragma(classify_level=basic, topic={astri_integration})
_method rwwi_astri_workorder_dialog.schedule_all_wo()
	## Schedule all work orders currently displayed in the table.
	## Applies the same two validations as schedule_wo() for each row:
	##   1. No existing Smallworld project/design
	##   2. Not already present in drm_scheduler_logs
	## Reports a summary popup on completion.

	_if .wo_cache _is _unset _orif .wo_cache.empty?
	_then
		_self.log_warning("No work orders loaded. Use Load WO List first.")
		_return
	_endif

	_local username << gis_program_manager.cached_dataset(:gis).auth_view.current_user.name.default("unknown")
	_local scheduled_count << 0
	_local skipped_design   << 0
	_local skipped_dup      << 0
	_local failed_count     << 0

	_self.log_separator()
	_self.log_info(write_string("Schedule All — processing ", .wo_cache.size, " work orders..."))

	_for _infra_sym, wo _over .wo_cache.fast_keys_and_elements()
	_loop
		_local infra_code << wo[:infra_code].default("")
		_local wo_number  << wo[:wo_number].default("")

		# Validation 1: Smallworld project or design already exists
		_local (has_project, has_design) << _self.check_project_and_design_exist(wo)
		_if has_design _orif has_project
		_then
			skipped_design +<< 1
			_self.log_warning("Skipped (design/project exists): " + wo_number)
			_continue
		_endif

		# Validation 2: Already in scheduler log
		_local existing_status << .engine.get_scheduler_log_status(infra_code)
		_if existing_status _isnt _unset _andif existing_status <> ""
		_then
			skipped_dup +<< 1
			_self.log_warning(write_string("Skipped (already scheduled): ",
				infra_code, " [", existing_status, "]"))
			_continue
		_endif

		# Build params — same fields as schedule_wo()
		_local topology   << wo[:topology].default("")
		_local uuid       << wo[:kmz_uuid].default("")
		_local infra_type << wo[:infrastructure_type].default(
			.filters[:infrastructure_type].default("cluster"))

		_local params << property_list.new_with(
			:infra_code,         infra_code,
			:name,               wo[:infra_name].default(""),
			:infra_type,         infra_type,
			:username,           username,
			:scheduler_username, username,
			:status,             "scheduled",
			:topology,           topology,
			:uuid,               uuid)

		_local ok? << .engine.insert_scheduler_log(params)
		_if ok?
		_then
			scheduled_count +<< 1
			_self.log_success(write_string("Scheduled: ", wo_number,
				" [", infra_code, "] topology=", topology))
		_else
			failed_count +<< 1
			_self.log_error("Failed to schedule: " + wo_number)
		_endif
	_endloop

	_local summary << write_string(
		"Schedule All complete.", %newline,
		"  Scheduled                       : ", scheduled_count, %newline,
		"  Skipped (design/project exists) : ", skipped_design, %newline,
		"  Skipped (already scheduled)     : ", skipped_dup)
	_if failed_count > 0
	_then
		summary << summary + write_string(%newline, "  Failed : ", failed_count)
	_endif

	_self.log_separator()
	_self.log_success(summary)
	_self.show_alert(summary)
_endmethod
$

_pragma(classify_level=restricted, topic={astri_integration})
_private _method rwwi_astri_workorder_dialog._parse_batch_file(path)
	## Parse a .txt batch file.
	## Line 1 (first non-blank): infra_type — CLUSTER, SUBFEEDER, or FEEDER
	## Lines 2+: one infra_code per line, blank lines skipped.
	##
	## Returns: (infra_type_string, infra_codes_rope)
	## Returns: (_unset, _unset) on parse error or invalid infra_type.

	_local infra_type  << _unset
	_local infra_codes << rope.new()
	_local line_num    << 0

	_try
		_local stream << external_text_input_stream.new(path)
		_protect
			_loop
				_local line << stream.get_line()
				_if line _is _unset _then _leave _endif
				_local trimmed << line.trim_spaces()
				_if trimmed = "" _then _continue _endif

				line_num +<< 1

				_if line_num = 1
				_then
					_local type_upper << trimmed.uppercase
					_if type_upper = "CLUSTER" _orif
					    type_upper = "SUBFEEDER" _orif
					    type_upper = "FEEDER"
					_then
						infra_type << type_upper.lowercase
					_else
						write("ERROR: invalid infra_type in batch file: ", trimmed)
						_return _unset, _unset
					_endif
				_else
					infra_codes.add(trimmed)
				_endif
			_endloop
		_protection
			stream.close()
		_endprotect
	_when error
		write("ERROR reading batch file: ", condition.report_contents_string)
		_return _unset, _unset
	_endtry

	_return infra_type, infra_codes
_endmethod
$

_pragma(classify_level=restricted, topic={astri_integration})
_private _method rwwi_astri_workorder_dialog._set_infra_type_filter(infra_type)
	## Set the infrastructure type dropdown to infra_type and update all
	## dependent UI elements (topology visibility, label text, filters slot).

	.items[:filter_infrastructure].value << infra_type
	_self.infrastructure_type_changed()
_endmethod
$
