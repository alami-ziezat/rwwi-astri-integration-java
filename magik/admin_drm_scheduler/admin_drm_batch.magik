# # ################################################################################
# #
# #  DRM Scheduler - run migration + e-mail the HTML summary report (via cmail)
# #  yudo.ariyanto
# #
# #  Shared script for BOTH schedulers. The calling .bat selects the run type
# #  via the DRM_RUN_TYPE environment variable:
# #     (unset / manual) -> manual run  (drm_scheduler_logs)
# #     etl              -> automated run (drm_etl_scheduler_log)
# #
# ###################################################################################

!global_auto_declare?!  << _true
$

## Run a DRM scheduler migration and e-mail its HTML summary report using cmail.
##
## run_type:
##   :manual (default) -> migrate_scheduled_objects()     (drm_scheduler_logs)
##   :etl              -> migrate_etl_scheduled_objects()  (drm_etl_scheduler_log)
##
## The report is now HTML, so cmail is invoked with -body-html:<file> (sends a
## UTF-8 HTML body). The e-mail subject is the report's base file name (no
## extension), taken directly from the migrator via last_log_name().
##
## Returns: _true if an e-mail was sent, _false if no report was produced.
_global run_drm_scheduler_and_email << _proc(_optional run_type)

	_local filename << "cmail.exe"

	# Scheduler directory (holds cmail.exe + recipients.txt) from the
	# DRM_SCHEDULER_DIR environment variable set by the calling .bat.
	# Falls back to the original hardcoded paths if the var is not set.
	_local sched_dir << system.getenv("DRM_SCHEDULER_DIR")
	_local pathlist << _if sched_dir _isnt _unset _andif sched_dir <> ""
			   _then >> {sched_dir}
			   _else >> {"F:SW5\Scheduler\" ,
				     "F:\SW5\Scheduler\ADMIN_DRM_scheduler\"
				    }
			   _endif
	_local cmf << system.find_file_in_path(filename, pathlist)

	_local recipients_file << "recipients.txt"
	_local te << system.find_file_in_path(recipients_file, pathlist)

#	mail_host << write_string(" -host:etlsmallworld@gmail.com:pzphynzordvrftls@smtp.gmail.com:465",
#				  " -from:etlsmallworld@gmail.com",
#				  " -to:@",te
#		     )
	_local mail_host << write_string(" -host:172.17.12.165",
					 " -from:no-reply@morarepublic.co.id",
					 " -to:@", te
				    )

	# --- Run the requested scheduler ---
	_local migrator << astri_data_migrator.new(gis_program_manager.databases[:gis])
	_if run_type _is :etl
	_then
		migrator.migrate_etl_scheduled_objects()
	_else
		migrator.migrate_scheduled_objects()
	_endif

	# Full path of the HTML report, and its base file name (no extension)
	_local log_path << migrator.last_log_file()
	_local log_name << migrator.last_log_name()

	_if log_path _is _unset
	_then
		write("No summary log produced - skipping e-mail.")
		_return _false
	_endif

	# HTML body (cmail: -body-html:<file> sends a UTF-8 HTML body)
	_local mail_body << write_string(" ", %", "-body-html:", log_path, %")

	# Subject = report base name (no extension); quoted because it has spaces
	_local subject_text << log_name.default("SMALLWORLD - SUMMARY ETL")
	_local mail_subject << write_string(" ", %", "-subject:", subject_text, %")

	_local l_command << write_string(cmf,
					 mail_host,
					 mail_subject,
					 mail_body
				    )
	write(l_command)

	_local output << system.do_command(l_command)
	write(output)
	_return _true
_endproc
$

_block
	# Run type is selected by the DRM_RUN_TYPE environment variable set in the
	# calling .bat: "etl" -> automated ETL run, anything else -> manual run.
	# One shared script serves both schedulers (see the two .bat files).
	_local mode_str << system.getenv("DRM_RUN_TYPE").default("manual").lowercase
	_local mode << _if mode_str = "etl" _then >> :etl _else >> :manual _endif
	write("DRM_RUN_TYPE = ", mode_str, "  ->  running ", mode)
	run_drm_scheduler_and_email(mode)
_endblock
$
